diff --git a/Source/gs/GSH_OpenGL/GSH_OpenGL_Fsr.cpp b/Source/gs/GSH_OpenGL/GSH_OpenGL_Fsr.cpp
new file mode 100644
index 0000000..eae183d
--- /dev/null
+++ b/Source/gs/GSH_OpenGL/GSH_OpenGL_Fsr.cpp
@@ -0,0 +1,289 @@
+//AMD FidelityFX Super Resolution 1 (FSR 1) on the final image: EASU scales the displayed
+//framebuffer to the window (edge-adaptive, 12 taps) into a texture, then RCAS sharpens it onto
+//the screen. GLSL ES 3.0 port of ffx_fsr1.h (FsrEasuF / FsrRcasF, MIT license, Copyright (c)
+//2021 Advanced Micro Devices, Inc.), with plain texel fetches instead of gathers (WebGL2 has none).
+//Used only when the window is larger than the rendered image (an upscale).
+
+#include "GSH_OpenGL.h"
+#include <cstdio>
+#include <sstream>
+
+#ifdef GLES_COMPATIBILITY
+#define GLSL_VERSION "#version 300 es"
+#else
+#define GLSL_VERSION "#version 150"
+#endif
+
+namespace
+{
+	const char* g_fsrVertexShader = R"(
+in vec2 a_position;
+void main()
+{
+	gl_Position = vec4(a_position, 0, 1);
+}
+)";
+
+	//Colour math in mediump (FP16 on phone GPUs, twice the throughput, like ffx_fsr1.h's FsrEasuH);
+	//positions in highp. Flat 2x2 neighbourhoods (most of a frame) take a bilinear shortcut: EASU
+	//clamps its result to the 2x2's range, so there it can't differ by more than that range.
+	const char* g_fsrEasuShader = R"(
+precision mediump float;
+precision highp int;
+uniform highp sampler2D g_source;
+uniform highp vec2 g_scale;   //source pixels per output pixel
+uniform ivec2 g_srcMax;       //last source pixel
+out vec4 fragColor;
+
+vec3 Fetch(ivec2 p)
+{
+	return texelFetch(g_source, clamp(p, ivec2(0), g_srcMax), 0).rgb;
+}
+
+float Luma(vec3 c)
+{
+	return c.b * 0.5 + (c.r * 0.5 + c.g);
+}
+
+//Direction and length of the edge around one of the 4 central texels (a '+' of 5 lumas)
+void EasuSet(inout vec2 dir, inout float len, float w, float lA, float lB, float lC, float lD, float lE)
+{
+	float dc = lD - lC;
+	float cb = lC - lB;
+	float dirX = lD - lB;
+	float lenX = clamp(abs(dirX) / max(max(abs(dc), abs(cb)), 1.0e-4), 0.0, 1.0);
+	dir.x += dirX * w;
+	len += lenX * lenX * w;
+	float ec = lE - lC;
+	float ca = lC - lA;
+	float dirY = lE - lA;
+	float lenY = clamp(abs(dirY) / max(max(abs(ec), abs(ca)), 1.0e-4), 0.0, 1.0);
+	dir.y += dirY * w;
+	len += lenY * lenY * w;
+}
+
+//One tap of the approximated, edge-stretched Lanczos 2 kernel
+void EasuTap(inout vec3 aC, inout float aW, vec2 off, vec2 dir, vec2 len, float lob, float clp, vec3 c)
+{
+	vec2 v = vec2(off.x * dir.x + off.y * dir.y, off.x * -dir.y + off.y * dir.x) * len;
+	float d2 = min(v.x * v.x + v.y * v.y, clp);
+	float wB = (2.0 / 5.0) * d2 - 1.0;
+	float wA = lob * d2 - 1.0;
+	wB *= wB;
+	wA *= wA;
+	wB = (25.0 / 16.0) * wB - (25.0 / 16.0 - 1.0);
+	float w = wB * wA;
+	aC += c * w;
+	aW += w;
+}
+
+void main()
+{
+	//    b c
+	//  e f g h
+	//  i j k l
+	//    n o
+	highp vec2 pp = gl_FragCoord.xy * g_scale - 0.5;
+	highp vec2 fp = floor(pp);
+	ivec2 p = ivec2(fp);
+	vec2 t = vec2(pp - fp);
+	vec3 fC = Fetch(p);
+	vec3 gC = Fetch(p + ivec2(1, 0));
+	vec3 jC = Fetch(p + ivec2(0, 1));
+	vec3 kC = Fetch(p + ivec2(1, 1));
+	vec3 min4 = min(min(fC, gC), min(jC, kC));
+	vec3 max4 = max(max(fC, gC), max(jC, kC));
+	vec3 range = max4 - min4;
+	if(max(range.r, max(range.g, range.b)) < (2.0 / 255.0))
+	{
+		fragColor = vec4(mix(mix(fC, gC, t.x), mix(jC, kC, t.x), t.y), 1.0);
+		return;
+	}
+	vec3 bC = Fetch(p + ivec2(0, -1));
+	vec3 cC = Fetch(p + ivec2(1, -1));
+	vec3 eC = Fetch(p + ivec2(-1, 0));
+	vec3 hC = Fetch(p + ivec2(2, 0));
+	vec3 iC = Fetch(p + ivec2(-1, 1));
+	vec3 lC = Fetch(p + ivec2(2, 1));
+	vec3 nC = Fetch(p + ivec2(0, 2));
+	vec3 oC = Fetch(p + ivec2(1, 2));
+	float bL = Luma(bC), cL = Luma(cC), eL = Luma(eC), fL = Luma(fC), gL = Luma(gC), hL = Luma(hC);
+	float iL = Luma(iC), jL = Luma(jC), kL = Luma(kC), lL = Luma(lC), nL = Luma(nC), oL = Luma(oC);
+
+	vec2 dir = vec2(0.0);
+	float len = 0.0;
+	EasuSet(dir, len, (1.0 - t.x) * (1.0 - t.y), bL, eL, fL, gL, jL);
+	EasuSet(dir, len, t.x * (1.0 - t.y), cL, fL, gL, hL, kL);
+	EasuSet(dir, len, (1.0 - t.x) * t.y, fL, iL, jL, kL, nL);
+	EasuSet(dir, len, t.x * t.y, gL, jL, kL, lL, oL);
+
+	vec2 dir2 = dir * dir;
+	float dirR = dir2.x + dir2.y;
+	bool zro = dirR < (1.0 / 4096.0);
+	dirR = zro ? 1.0 : inversesqrt(dirR);
+	dir.x = zro ? 1.0 : dir.x;
+	dir *= dirR;
+	len = len * 0.5;
+	len *= len;
+	float stretch = (dir.x * dir.x + dir.y * dir.y) / max(abs(dir.x), abs(dir.y));
+	vec2 len2 = vec2(1.0 + (stretch - 1.0) * len, 1.0 - 0.5 * len);
+	float lob = 0.5 + ((1.0 / 4.0 - 0.04) - 0.5) * len;
+	float clp = 1.0 / lob;
+
+	vec3 aC = vec3(0.0);
+	float aW = 0.0;
+	EasuTap(aC, aW, vec2(0.0, -1.0) - t, dir, len2, lob, clp, bC);
+	EasuTap(aC, aW, vec2(1.0, -1.0) - t, dir, len2, lob, clp, cC);
+	EasuTap(aC, aW, vec2(-1.0, 1.0) - t, dir, len2, lob, clp, iC);
+	EasuTap(aC, aW, vec2(0.0, 1.0) - t, dir, len2, lob, clp, jC);
+	EasuTap(aC, aW, vec2(0.0, 0.0) - t, dir, len2, lob, clp, fC);
+	EasuTap(aC, aW, vec2(-1.0, 0.0) - t, dir, len2, lob, clp, eC);
+	EasuTap(aC, aW, vec2(1.0, 1.0) - t, dir, len2, lob, clp, kC);
+	EasuTap(aC, aW, vec2(2.0, 1.0) - t, dir, len2, lob, clp, lC);
+	EasuTap(aC, aW, vec2(2.0, 0.0) - t, dir, len2, lob, clp, hC);
+	EasuTap(aC, aW, vec2(1.0, 0.0) - t, dir, len2, lob, clp, gC);
+	EasuTap(aC, aW, vec2(1.0, 2.0) - t, dir, len2, lob, clp, oC);
+	EasuTap(aC, aW, vec2(0.0, 2.0) - t, dir, len2, lob, clp, nC);
+
+	//No ringing: stay within the 2x2 around the sample
+	fragColor = vec4(min(max4, max(min4, aC / aW)), 1.0);
+}
+)";
+
+	const char* g_fsrRcasShader = R"(
+precision mediump float;
+precision highp int;
+uniform highp sampler2D g_source;
+uniform highp vec4 g_viewport; //x, y, width, height of the picture on the screen
+uniform float g_sharpness; //exp2(-stops): 1 = sharpest
+out vec4 fragColor;
+
+vec3 Fetch(ivec2 p, ivec2 pMax)
+{
+	return texelFetch(g_source, clamp(p, ivec2(0), pMax), 0).rgb;
+}
+
+void main()
+{
+	//The scaled image's rows go top-down, the screen's bottom-up
+	ivec2 size = ivec2(g_viewport.zw);
+	ivec2 p = ivec2(gl_FragCoord.xy - g_viewport.xy);
+	p.y = size.y - 1 - p.y;
+	ivec2 pMax = size - 1;
+	//    b
+	//  d e f
+	//    h
+	vec3 b = Fetch(p + ivec2(0, -1), pMax);
+	vec3 d = Fetch(p + ivec2(-1, 0), pMax);
+	vec3 e = Fetch(p, pMax);
+	vec3 f = Fetch(p + ivec2(1, 0), pMax);
+	vec3 h = Fetch(p + ivec2(0, 1), pMax);
+	vec3 mn4 = min(min(b, d), min(f, h));
+	vec3 mx4 = max(max(b, d), max(f, h));
+	//Largest negative lobe that keeps the result within [0, 1]
+	const float peakX = 1.0;
+	const float peakY = -4.0;
+	vec3 hitMin = min(mn4, e) / max(4.0 * mx4, vec3(1.0e-4));
+	vec3 hitMax = (peakX - max(mx4, e)) / min(4.0 * mn4 + peakY, vec3(-1.0e-4));
+	vec3 lobeRGB = max(-hitMin, hitMax);
+	float lobe = max(-(0.25 - (1.0 / 16.0)), min(max(lobeRGB.r, max(lobeRGB.g, lobeRGB.b)), 0.0)) * g_sharpness;
+	vec3 pix = (lobe * (b + d + h + f) + e) / (4.0 * lobe + 1.0);
+	fragColor = vec4(clamp(pix, 0.0, 1.0), 1.0);
+}
+)";
+
+	Framework::OpenGl::ProgramPtr BuildFsrProgram(const char* pixelSource, GLuint positionAttrib)
+	{
+		Framework::OpenGl::CShader vertexShader(GL_VERTEX_SHADER);
+		Framework::OpenGl::CShader pixelShader(GL_FRAGMENT_SHADER);
+		std::string vertex = std::string(GLSL_VERSION) + "\n" + g_fsrVertexShader;
+		std::string pixel = std::string(GLSL_VERSION) + "\n" + pixelSource;
+		vertexShader.SetSource(vertex.c_str());
+		pixelShader.SetSource(pixel.c_str());
+		if(!vertexShader.Compile() || !pixelShader.Compile()) return Framework::OpenGl::ProgramPtr();
+		auto program = std::make_shared<Framework::OpenGl::CProgram>();
+		program->AttachShader(vertexShader);
+		program->AttachShader(pixelShader);
+		glBindAttribLocation(*program, positionAttrib, "a_position");
+		if(!program->Link()) return Framework::OpenGl::ProgramPtr();
+		return program;
+	}
+}
+
+bool CGSH_OpenGL::PresentFsr(GLuint sourceTexture, uint32 srcWidth, uint32 srcHeight, const PRESENTATION_VIEWPORT& viewport)
+{
+	if(!m_fsrEnabled || m_fsrFailed) return false;
+	if((viewport.width <= static_cast<int32>(srcWidth)) || (viewport.height <= 0) || (srcWidth == 0) || (srcHeight == 0)) return false;
+
+	if(!m_fsrEasuProgram)
+	{
+		const auto position = static_cast<GLuint>(PRIM_VERTEX_ATTRIB::POSITION);
+		m_fsrEasuProgram = BuildFsrProgram(g_fsrEasuShader, position);
+		m_fsrRcasProgram = BuildFsrProgram(g_fsrRcasShader, position);
+		if(!m_fsrEasuProgram || !m_fsrRcasProgram)
+		{
+			std::printf("[fsr] shaders failed to build: plain scaling\n");
+			m_fsrFailed = true;
+			return false;
+		}
+		m_fsrEasuSourceUniform = glGetUniformLocation(*m_fsrEasuProgram, "g_source");
+		m_fsrEasuScaleUniform = glGetUniformLocation(*m_fsrEasuProgram, "g_scale");
+		m_fsrEasuSrcMaxUniform = glGetUniformLocation(*m_fsrEasuProgram, "g_srcMax");
+		m_fsrRcasSourceUniform = glGetUniformLocation(*m_fsrRcasProgram, "g_source");
+		m_fsrRcasViewportUniform = glGetUniformLocation(*m_fsrRcasProgram, "g_viewport");
+		m_fsrRcasSharpnessUniform = glGetUniformLocation(*m_fsrRcasProgram, "g_sharpness");
+		std::printf("[fsr] FSR 1 upscaling on\n");
+	}
+
+	//The scaled image, at the size it has on the screen
+	const uint32 outWidth = viewport.width;
+	const uint32 outHeight = viewport.height;
+	if((m_fsrWidth != outWidth) || (m_fsrHeight != outHeight))
+	{
+		if(m_fsrFramebuffer) glDeleteFramebuffers(1, &m_fsrFramebuffer);
+		if(m_fsrTexture) glDeleteTextures(1, &m_fsrTexture);
+		glGenTextures(1, &m_fsrTexture);
+		glBindTexture(GL_TEXTURE_2D, m_fsrTexture);
+		glTexStorage2D(GL_TEXTURE_2D, 1, GL_RGBA8, outWidth, outHeight);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+		glGenFramebuffers(1, &m_fsrFramebuffer);
+		glBindFramebuffer(GL_FRAMEBUFFER, m_fsrFramebuffer);
+		glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, m_fsrTexture, 0);
+		m_fsrWidth = outWidth;
+		m_fsrHeight = outHeight;
+	}
+
+	glDisable(GL_BLEND);
+	glDisable(GL_DEPTH_TEST);
+	glDisable(GL_SCISSOR_TEST);
+	glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+	glBindBuffer(GL_ARRAY_BUFFER, m_presentVertexBuffer);
+	glBindVertexArray(m_presentVertexArray);
+	glActiveTexture(GL_TEXTURE1);
+	glBindTexture(GL_TEXTURE_2D, 0);
+	glActiveTexture(GL_TEXTURE0);
+
+	//EASU: displayed part of the framebuffer -> scaled image
+	glBindFramebuffer(GL_FRAMEBUFFER, m_fsrFramebuffer);
+	glViewport(0, 0, outWidth, outHeight);
+	glBindTexture(GL_TEXTURE_2D, sourceTexture);
+	glUseProgram(*m_fsrEasuProgram);
+	glUniform1i(m_fsrEasuSourceUniform, 0);
+	glUniform2f(m_fsrEasuScaleUniform, static_cast<float>(srcWidth) / static_cast<float>(outWidth),
+	            static_cast<float>(srcHeight) / static_cast<float>(outHeight));
+	glUniform2i(m_fsrEasuSrcMaxUniform, srcWidth - 1, srcHeight - 1);
+	glDrawArrays(GL_TRIANGLES, 0, 3);
+
+	//RCAS: scaled image -> screen, sharpened
+	glBindFramebuffer(GL_FRAMEBUFFER, m_presentFramebuffer);
+	glViewport(viewport.offsetX, viewport.offsetY, outWidth, outHeight);
+	glBindTexture(GL_TEXTURE_2D, m_fsrTexture);
+	glUseProgram(*m_fsrRcasProgram);
+	glUniform1i(m_fsrRcasSourceUniform, 0);
+	glUniform4f(m_fsrRcasViewportUniform, static_cast<float>(viewport.offsetX), static_cast<float>(viewport.offsetY),
+	            static_cast<float>(outWidth), static_cast<float>(outHeight));
+	glUniform1f(m_fsrRcasSharpnessUniform, 0.87f); //exp2(-0.2): AMD's default sharpness
+	glDrawArrays(GL_TRIANGLES, 0, 3);
+	return true;
+}
