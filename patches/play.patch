+uint32 CBasicBlock::GetWasmChainIndex() const
+{
+	return m_function.GetWasmChainIndex();
+}
+
+uint32 CBasicBlock::GetWasmFunctionPointer() const
+{
+	return static_cast<uint32>(reinterpret_cast<uintptr_t>(m_function.GetCode()));
+}
+#endif
