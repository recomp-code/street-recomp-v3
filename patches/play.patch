+	switch(bltBuf.nDstPsm)
+	{
+	case PSMCT32:
+		blockWidth = 8, blockHeight = 8, bits = 32;
+		break;
+	case PSMT8:
+		blockWidth = 16, blockHeight = 16, bits = 8;
+		break;
+	case PSMT4:
+		blockWidth = 32, blockHeight = 16, bits = 4;
+		break;
+	default:
+		m_producerDirect[0]++;
+		return;
+	}
+	const uint32 width = trxReg.nRRW, height = trxReg.nRRH;
+	if(((trxPos.nDSAX | width) % blockWidth) != 0 || ((trxPos.nDSAY | height) % blockHeight) != 0 || (width == 0) || (height == 0))
+	{
+		m_producerDirect[1]++;
+		return;
+	}
+	//(Odd buffer widths for PSMT8/PSMT4 use the same page arithmetic as the GS thread's handlers.)
+	if((bltBuf.nDstWidth == 0) || (trxPos.nDIR != 0) || (trxPos.nDSAX + width > 2048) || (trxPos.nDSAY + height > 2048))
+	{
+		m_producerDirect[2]++;
+		return;
+	}
+	transfer.psm = bltBuf.nDstPsm;
+	transfer.dstPtr = bltBuf.GetDstPtr();
+	transfer.dstWidth = bltBuf.nDstWidth;
+	transfer.x = trxPos.nDSAX;
+	transfer.y = trxPos.nDSAY;
+	transfer.width = width;
+	transfer.height = height;
+	transfer.size = (width * height * bits) / 8;
+	transfer.data.reserve(transfer.size);
+	transfer.active = true;
+}
