+	void HdEvict();
+	void HdUploadQueued(uint32 count);
+	void FinishShader(const Framework::OpenGl::ProgramPtr&);
+	void PumpShaderPrecompile();
+	ShaderMap m_pendingShaders;
+	std::deque<uint64> m_precompileQueue;
+	std::vector<uint64> m_newShaderCaps;
