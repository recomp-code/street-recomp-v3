+
 void CVuExecutor::PartitionFunction(uint32 startAddress)
+{
+	if(!m_microMemoryHashValid)
+	{
+		auto map = m_context.m_pMemoryMap->GetInstructionMap(0);
+		m_microMemoryHash = XXH3_64bits(map->pPointer, m_maxAddress);
+		m_microMemoryHashValid = true;
+	}
+	const auto partitionKey = std::make_pair(m_microMemoryHash, startAddress);
+	if(auto partition = m_partitions.find(partitionKey); partition != std::end(m_partitions))
+	{
+		//Same code as when this block was made: reuse it as is
+		const auto& known = partition->second;
+		if(!m_context.HasBreakpointInRange(startAddress, known.endAddress))
+		{
+			ResetBlockOutLinks(known.block.get());
+			m_blockLookup.AddBlock(known.block.get());
+			m_blocks.insert(known.block);
+			if(static_cast<CVuBasicBlock*>(known.block.get())->IsLinkable())
+			{
+				SetupBlockLinks(startAddress, known.endAddress, known.branchAddress);
+			}
+			return;
+		}
+	}
+	PartitionNewFunction(startAddress, partitionKey);
+}
+
+void CVuExecutor::PartitionNewFunction(uint32 startAddress, const std::pair<uint64, uint32>& partitionKey)
 {
 	uint32 endAddress = std::min<uint32>(startAddress + MAX_BLOCK_SIZE - 4, m_maxAddress - 4);
 	uint32 branchAddress = MIPS_INVALID_PC;
@@ -132,4 +169,10 @@ void CVuExecutor::PartitionFunction(uint32 startAddress)
 	{
 		SetupBlockLinks(startAddress, endAddress, branchAddress);
 	}
+	if(m_partitions.size() >= 16384) m_partitions.clear(); //bounded: a few hundred programs' worth
+	PARTITION partition;
+	partition.endAddress = endAddress;
+	partition.branchAddress = branchAddress;
+	partition.block = block->shared_from_this();
+	m_partitions[partitionKey] = std::move(partition);
 }
