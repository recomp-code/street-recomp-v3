+void CGSH_OpenGL::PrecompileShaders(const uint64* caps, size_t count)
+{
+	for(size_t i = 0; i < count; i++)
+		m_precompileQueue.push_back(caps[i]);
+}
+
+//Once per frame: starts queued compilations (all of them when the driver builds in the background,
+//one per frame otherwise, so a frame never waits for many) and finishes the ones that are built.
+void CGSH_OpenGL::PumpShaderPrecompile()
+{
+#ifndef GL_COMPLETION_STATUS_KHR
+#define GL_COMPLETION_STATUS_KHR 0x91B1
+#endif
+	uint32 starts = m_parallelShaderCompile ? 32 : 1;
+	while(!m_precompileQueue.empty() && starts != 0)
+	{
+		auto caps = make_convertible<SHADERCAPS>(m_precompileQueue.front());
+		m_precompileQueue.pop_front();
+		if(m_shaders.count(caps) || m_pendingShaders.count(caps)) continue;
+		m_pendingShaders.insert(std::make_pair(static_cast<ShaderCapsInt>(caps), GenerateShader(caps)));
+		m_shadersPrecompiled++;
+		starts--;
+	}
+	uint32 checks = 16;
+	for(auto pendingIterator = m_pendingShaders.begin(); pendingIterator != m_pendingShaders.end() && checks != 0; checks--)
+	{
+		if(m_parallelShaderCompile)
+		{
+			GLint done = GL_FALSE;
+			glGetProgramiv(*pendingIterator->second, GL_COMPLETION_STATUS_KHR, &done);
+			if(done != GL_TRUE)
+			{
+				++pendingIterator;
+				continue;
+			}
+		}
+		FinishShader(pendingIterator->second);
+		m_shaders.insert(*pendingIterator);
+		pendingIterator = m_pendingShaders.erase(pendingIterator);
+		if(!m_parallelShaderCompile) break;
+	}
+}
