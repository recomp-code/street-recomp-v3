diff --git a/Source/gs/GSH_OpenGL/GSH_OpenGL_HdTextures.cpp b/Source/gs/GSH_OpenGL/GSH_OpenGL_HdTextures.cpp
new file mode 100644
index 0000000..2d1ddfa
--- /dev/null
+++ b/Source/gs/GSH_OpenGL/GSH_OpenGL_HdTextures.cpp
@@ -0,0 +1,320 @@
+//HD texture replacements in PCSX2's texture pack format.
+//
+//A pack file is named <texture hash>-<palette hash>-<bits>.png, where:
+//- texture hash: XXH3-64 of the texture's 256-byte GS memory blocks, in the order PCSX2's
+//  GSLocalMemory reads them (GSTextureCache.cpp, HashTextureLevel's block path)
+//- palette hash: XXH3-64 of the 16 or 256 32-bit palette colours (paletted formats only)
+//- bits: PSM | TW << 6 | TH << 10
+//Covered: PSMCT32, PSMT8 and PSMT4 textures at least one block in size, with 32-bit palettes and
+//no region clamp (PCSX2 hashes those through another path).
+//
+//The images are read on demand from <base>/<name>.png (the browser decodes them off-thread) and
+//only while they are in use: the least recently used ones are dropped past a limit.
+
+#include "GSH_OpenGL.h"
+#include "../GsPixelFormats.h"
+#include <algorithm>
+#include <array>
+#include <cstdio>
+#include <cstring>
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+#endif
+#define XXH_INLINE_ALL
+#include "../../../deps/Dependencies/xxHash/xxhash.h"
+
+namespace
+{
+	//Block number inside a page (PCSX2's GSTables.cpp), indexed [y & 7][x & 7]
+	constexpr uint8 g_blockTable32[8][8] =
+	    {
+	        {0, 1, 4, 5, 16, 17, 20, 21},
+	        {2, 3, 6, 7, 18, 19, 22, 23},
+	        {8, 9, 12, 13, 24, 25, 28, 29},
+	        {10, 11, 14, 15, 26, 27, 30, 31},
+	        {0, 1, 4, 5, 16, 17, 20, 21},
+	        {2, 3, 6, 7, 18, 19, 22, 23},
+	        {8, 9, 12, 13, 24, 25, 28, 29},
+	        {10, 11, 14, 15, 26, 27, 30, 31},
+	};
+	constexpr uint8 g_blockTable4[8][8] =
+	    {
+	        {0, 2, 8, 10, 0, 2, 8, 10},
+	        {1, 3, 9, 11, 1, 3, 9, 11},
+	        {4, 6, 12, 14, 4, 6, 12, 14},
+	        {5, 7, 13, 15, 5, 7, 13, 15},
+	        {16, 18, 24, 26, 16, 18, 24, 26},
+	        {17, 19, 25, 27, 17, 19, 25, 27},
+	        {20, 22, 28, 30, 20, 22, 28, 30},
+	        {21, 23, 29, 31, 21, 23, 29, 31},
+	};
+
+	struct PSM_LAYOUT
+	{
+		uint32 pageShiftX, pageShiftY;   //log2 of the page size in pixels
+		uint32 blockShiftX, blockShiftY; //log2 of the block size in pixels
+		const uint8 (*blockTable)[8];
+	};
+
+	bool GetLayout(uint32 psm, PSM_LAYOUT& layout)
+	{
+		switch(psm)
+		{
+		case CGSHandler::PSMCT32:
+			layout = {6, 5, 3, 3, g_blockTable32};
+			return true;
+		case CGSHandler::PSMT8:
+			layout = {7, 6, 4, 4, g_blockTable32};
+			return true;
+		case CGSHandler::PSMT4:
+			layout = {7, 7, 5, 4, g_blockTable4};
+			return true;
+		default:
+			return false;
+		}
+	}
+
+	constexpr uint32 MAX_HD_TEXTURES_LOADED = 160;
+	constexpr uint32 GS_PAGE_COUNT = 512;
+}
+
+#ifdef __EMSCRIPTEN__
+EM_JS_DEPS(ps2xHdTextures, "$UTF8ToString,$stringToNewUTF8");
+extern "C" EMSCRIPTEN_KEEPALIVE void ps2xHdTextureLoaded(CGSH_OpenGL* gs, uint32 slot, uint32 textureName)
+{
+	gs->HdTextureLoaded(slot, textureName);
+}
+#endif
+
+void CGSH_OpenGL::EnableHdTextures(const char* baseUrl)
+{
+#ifdef __EMSCRIPTEN__
+	m_hdBaseUrl = baseUrl;
+	char* list = reinterpret_cast<char*>(EM_ASM_PTR({
+		try
+		{
+			const request = new XMLHttpRequest();
+			request.open('GET', UTF8ToString($0) + '/index.txt', false);
+			request.send();
+			if(request.status != 200) return 0;
+			return stringToNewUTF8(request.responseText);
+		}
+		catch(e)
+		{
+			return 0;
+		}
+	}, baseUrl));
+	if(!list)
+	{
+		std::printf("[hd] no texture pack at %s\n", baseUrl);
+		return;
+	}
+	for(char* line = std::strtok(list, "\r\n"); line; line = std::strtok(nullptr, "\r\n"))
+	{
+		//<hash>-<clut hash>-<bits> or <hash>-<bits>; names with a region are not handled
+		uint64 hash = 0, clutHash = 0;
+		uint32 bits = 0;
+		char end = 0;
+		if(std::strstr(line, "-r")) continue;
+		if(std::sscanf(line, "%llx-%llx-%x%c", &hash, &clutHash, &bits, &end) != 3)
+		{
+			clutHash = 0;
+			if(std::sscanf(line, "%llx-%x%c", &hash, &bits, &end) != 2) continue;
+		}
+		HD_TEXTURE texture;
+		texture.name = line;
+		m_hdIndex[std::make_tuple(hash, clutHash, bits)] = static_cast<uint32>(m_hdTextures.size());
+		m_hdTextures.push_back(std::move(texture));
+	}
+	std::free(list);
+	m_hdEnabled = !m_hdTextures.empty();
+	std::printf("[hd] %u HD textures available\n", static_cast<unsigned>(m_hdTextures.size()));
+#endif
+}
+
+void CGSH_OpenGL::HdTextureLoaded(uint32 slot, uint32 textureName)
+{
+	auto& texture = m_hdTextures[slot];
+	texture.loading = false;
+	texture.handle = textureName;
+	texture.lastUse = m_hdFrame;
+	m_hdTexturesLoaded++;
+	//The loader bound its texture: Play's bindings have to be set again
+	m_validGlState &= ~GLSTATE_TEXTURE;
+	m_hdGen++;
+	HdEvict();
+}
+
+void CGSH_OpenGL::HdEvict()
+{
+	uint32 loaded = 0;
+	for(const auto& texture : m_hdTextures)
+		if(texture.handle) loaded++;
+	while(loaded > MAX_HD_TEXTURES_LOADED)
+	{
+		HD_TEXTURE* oldest = nullptr;
+		for(auto& texture : m_hdTextures)
+			if(texture.handle && (texture.lastUse != m_hdFrame) && (!oldest || texture.lastUse < oldest->lastUse))
+				oldest = &texture;
+		if(!oldest) break;
+		glDeleteTextures(1, &oldest->handle);
+		oldest->handle = 0;
+		loaded--;
+		m_renderState.isValid = false;
+		m_hdGen++;
+	}
+}
+
+void CGSH_OpenGL::HdInvalidate(uint32 start, uint32 size)
+{
+	if(!m_hdEnabled || size == 0) return;
+	uint32 first = start / 8192;
+	uint32 last = (start + size - 1) / 8192;
+	for(uint32 page = first; page <= last; page++)
+		m_hdPageGen[page % GS_PAGE_COUNT]++;
+	m_hdGen++;
+}
+
+uint32 CGSH_OpenGL::HdPageGenSum(uint32 firstPage, uint32 pageCount) const
+{
+	uint32 sum = 0;
+	for(uint32 i = 0; i < pageCount; i++)
+		sum += m_hdPageGen[(firstPage + i) % GS_PAGE_COUNT];
+	return sum;
+}
+
+uint64 CGSH_OpenGL::HdHashTexture(const TEX0& tex0, uint32& firstPage, uint32& pageCount) const
+{
+	//PCSX2's GSOffset::BNHelper walk over the texture's blocks
+	PSM_LAYOUT layout;
+	GetLayout(tex0.nPsm, layout);
+	const int bwPages = static_cast<int>(tex0.nBufWidth) >> (layout.pageShiftX - 6);
+	const int blocksWide = static_cast<int>(tex0.GetWidth()) >> layout.blockShiftX;
+	const int blocksHigh = static_cast<int>(tex0.GetHeight()) >> layout.blockShiftY;
+	const int pageMaskX = (1 << (layout.pageShiftX - layout.blockShiftX)) - 1;
+	const int pageMaskY = (1 << (layout.pageShiftY - layout.blockShiftY)) - 1;
+
+	XXH3_state_t state;
+	XXH3_64bits_reset(&state);
+	int baseBp = static_cast<int>(tex0.nBufPtr);
+	uint32 minBlock = ~0U, maxBlock = 0;
+	for(int blkY = 0; blkY < blocksHigh;)
+	{
+		int bp = baseBp;
+		for(int blkX = 0; blkX < blocksWide;)
+		{
+			uint32 block = static_cast<uint32>(bp + layout.blockTable[blkY & 7][blkX & 7]) % (RAMSIZE / 256);
+			XXH3_64bits_update(&state, m_pRAM + block * 256, 256);
+			minBlock = std::min(minBlock, block);
+			maxBlock = std::max(maxBlock, block);
+			blkX++;
+			if(!(blkX & pageMaskX)) bp += 32;
+		}
+		blkY++;
+		if(!(blkY & pageMaskY)) baseBp += 32 * bwPages;
+	}
+	firstPage = minBlock / 32;
+	pageCount = (maxBlock / 32) - firstPage + 1;
+	return XXH3_64bits_digest(&state);
+}
+
+GLuint CGSH_OpenGL::HdLookup(uint64 tex0Reg, uint64 clampReg)
+{
+	if((tex0Reg == m_hdMemoTex0) && (clampReg == m_hdMemoClamp) && (m_hdGen == m_hdMemoGen) && (m_clutVersion == m_hdMemoClut))
+	{
+		if(m_hdMemoHandle != 0)
+		{
+			for(auto& texture : m_hdTextures)
+				if(texture.handle == m_hdMemoHandle) texture.lastUse = m_hdFrame;
+		}
+		return m_hdMemoHandle;
+	}
+	m_hdMemoTex0 = tex0Reg;
+	m_hdMemoClamp = clampReg;
+	m_hdMemoGen = m_hdGen;
+	m_hdMemoClut = m_clutVersion;
+	m_hdMemoHandle = 0;
+
+	auto tex0 = make_convertible<TEX0>(tex0Reg);
+	auto clamp = make_convertible<CLAMP>(clampReg);
+	PSM_LAYOUT layout;
+	if(!GetLayout(tex0.nPsm, layout)) return 0;
+	const uint32 tw = tex0.nWidth;
+	const uint32 th = tex0.nPad0 | (tex0.nPad1 << 2);
+	if((tw < layout.blockShiftX) || (th < layout.blockShiftY) || (tw > 10) || (th > 10)) return 0;
+
+	//Region clamp/repeat: PCSX2 names those textures differently (SourceRegion::Create)
+	if((clamp.nWMS == CLAMP_MODE_REGION_CLAMP && clamp.GetMaxU() >= clamp.GetMinU() &&
+	    ((clamp.GetMaxU() - clamp.GetMinU() + 1) < (1u << tw) || clamp.GetMaxU() >= (1u << tw))) ||
+	   (clamp.nWMS == CLAMP_MODE_REGION_REPEAT && clamp.GetMinU() != 0) ||
+	   (clamp.nWMT == CLAMP_MODE_REGION_CLAMP && clamp.GetMaxV() >= clamp.GetMinV() &&
+	    ((clamp.GetMaxV() - clamp.GetMinV() + 1) < (1u << th) || clamp.GetMaxV() >= (1u << th))) ||
+	   (clamp.nWMT == CLAMP_MODE_REGION_REPEAT && clamp.GetMinV() != 0))
+		return 0;
+
+	uint64 clutHash = 0;
+	if(CGsPixelFormats::IsPsmIDTEX(tex0.nPsm))
+	{
+		if((tex0.nCPSM != PSMCT32) && (tex0.nCPSM != PSMCT24)) return 0;
+		std::array<uint32, 256> clut;
+		MakeLinearCLUT(tex0, clut);
+		clutHash = XXH3_64bits(clut.data(), sizeof(uint32) * (CGsPixelFormats::IsPsmIDTEX4(tex0.nPsm) ? 16 : 256));
+	}
+
+	//The texture's hash, again only when its memory changed
+	const uint64 hashKey = tex0Reg & ((1ULL << 34) - 1); //TBP0, TBW, PSM, TW, TH
+	auto& cached = m_hdHashes[hashKey];
+	if(cached.pageCount == 0 || cached.pageGenSum != HdPageGenSum(cached.firstPage, cached.pageCount))
+	{
+		cached.hash = HdHashTexture(tex0, cached.firstPage, cached.pageCount);
+		cached.pageGenSum = HdPageGenSum(cached.firstPage, cached.pageCount);
+	}
+
+	const uint32 bits = tex0.nPsm | (tw << 6) | (th << 10);
+	auto indexIterator = m_hdIndex.find(std::make_tuple(cached.hash, clutHash, bits));
+	if(indexIterator == std::end(m_hdIndex)) return 0;
+
+	uint32 slot = indexIterator->second;
+	auto& texture = m_hdTextures[slot];
+	texture.lastUse = m_hdFrame;
+	if(texture.handle != 0)
+	{
+		m_hdTexturesShown++;
+		m_hdMemoHandle = texture.handle;
+		return texture.handle;
+	}
+#ifdef __EMSCRIPTEN__
+	if(!texture.loading)
+	{
+		texture.loading = true;
+		//Fetched and decoded by the browser; the GL texture is made in this thread (its context)
+		EM_ASM({
+			const gs = $0;
+			const slot = $1;
+			const url = UTF8ToString($2) + '/' + UTF8ToString($3) + '.png';
+			fetch(url)
+			    .then((response) => { if(!response.ok) throw new Error(response.status); return response.blob(); })
+			    .then((blob) => createImageBitmap(blob, {premultiplyAlpha: 'none', colorSpaceConversion: 'none'}))
+			    .then((image) => {
+				    const gl = GLctx;
+				    const previous = gl.getParameter(gl.TEXTURE_BINDING_2D);
+				    const texture = gl.createTexture();
+				    gl.bindTexture(gl.TEXTURE_2D, texture);
+				    gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, false);
+				    gl.pixelStorei(gl.UNPACK_PREMULTIPLY_ALPHA_WEBGL, false);
+				    gl.pixelStorei(gl.UNPACK_COLORSPACE_CONVERSION_WEBGL, gl.NONE);
+				    gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, image);
+				    gl.generateMipmap(gl.TEXTURE_2D);
+				    gl.bindTexture(gl.TEXTURE_2D, previous);
+				    image.close();
+				    const name = GL.getNewId(GL.textures);
+				    texture.name = name;
+				    GL.textures[name] = texture;
+				    _ps2xHdTextureLoaded(gs, slot, name);
+			    })
+			    .catch((error) => { console.log('[hd] ' + url + ': ' + error); });
+		}, this, slot, m_hdBaseUrl.c_str(), texture.name.c_str());
+	}
+#endif
+	return 0;
+}
