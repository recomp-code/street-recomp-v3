+			//Blocks end on the last word of their last instruction (VU: the upper word, +4)
+			if(begin == ((m_lastEnd + 4) & ~(instructionSize - 1)) && begin > m_lastBegin) stats.fallThrough++;
+			if(begin == m_lastBegin) stats.sameBlock++;
+			m_blockSuccessors[m_lastBegin][begin]++;
+			if(m_blockEntries[begin]++ == 0 && CBasicBlock::s_keepCode)
+			{
+				auto& kept = m_blockCode[begin];
+				kept.end = block->GetEndAddress();
+				kept.code = block->GetCode();
+				for(uint32 address = begin; address <= kept.end; address += 4)
+				{
+					char mnemonic[32] = {}, operands[64] = {}, line[128];
+					const uint32 opcode = m_context.m_pMemoryMap->GetInstruction(address);
