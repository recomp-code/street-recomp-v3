+void CGSHandler::ProducerBeginTransfer(uint64 trxDir)
+{
+	auto& transfer = m_producerTransfer;
+	transfer.active = false;
+	transfer.data.clear();
+	if((trxDir & 3) != 0)
+	{
+		m_producerDirect[4]++;
+		return;
+	}
+	auto bltBuf = make_convertible<BITBLTBUF>(m_producerBitbltbuf);
+	auto trxPos = make_convertible<TRXPOS>(m_producerTrxpos);
+	auto trxReg = make_convertible<TRXREG>(m_producerTrxreg);
