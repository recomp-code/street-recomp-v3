+	//(texture hash, palette hash, bits, region width | region height << 16) -> m_hdTextures slot
+	std::map<std::tuple<uint64, uint64, uint32, uint32>, uint32> m_hdIndex;
+	std::unordered_map<uint64, HD_HASH> m_hdHashes;
+	std::map<std::pair<uint64, uint64>, HD_HASH> m_hdRegionHashes; //(TEX0 bits, region rect)
