+//The blocks' functions become functions of one module (one instance), made from the modules they
+//were compiled to (kept with SetKeepModule): block chaining between them then stays within that
+//instance, much cheaper for browsers than jumping into other instances. False (and nothing
+//changed) if the modules can't be merged.
+bool CBasicBlock::GroupModules(const std::vector<CBasicBlock*>& blocks, uint32 group)
+{
+#ifndef AOT_USE_CACHE
+	std::vector<const std::vector<uint8>*> modules;
+	modules.reserve(blocks.size());
+	for(auto* block : blocks)
+	{
+		if(block->m_code.empty()) return false;
+		modules.push_back(&block->m_code);
+	}
+	std::vector<uint8> merged;
+	if(!CWasmModuleBuilder::MergeModules(modules, merged)) return false;
+	auto functions = CMemoryFunction::CreateGroup(merged.data(), merged.size(), static_cast<uint32>(blocks.size()));
+	for(size_t i = 0; i < blocks.size(); i++)
+	{
+		blocks[i]->m_function = std::move(functions[i]);
+		blocks[i]->m_moduleGroup = group;
+	}
+	return true;
+#else
+	return false;
+#endif
+}
+#endif
