+//CVuBasicBlock's compilation also reads the instruction before the block (integer branch delay of a
+//branch at its start), the one after it (E bit in a delay slot) and the targets of B instructions
+//(B followed by a conditional branch in its delay slot): blocks with the same contents are only
+//shared where these are the same too.
+uint64 CVuExecutor::HashBlockSurroundings(uint32 begin, uint32 end) const
+{
+	std::vector<uint32> words;
+	auto add = [&](uint32 address) {
+		address &= m_addressMask;
+		words.push_back(m_context.m_pMemoryMap->GetInstruction(address));
+		words.push_back(m_context.m_pMemoryMap->GetInstruction(address + 4));
+	};
+	add(begin - 8);
+	add(end + 4);
+	for(uint32 address = begin; address < end; address += 8)
+	{
+		uint32 opcodeLo = m_context.m_pMemoryMap->GetInstruction(address);
+		if(((opcodeLo >> 25) & 0x7F) == 0x20) //B
+			add(address + VUShared::GetBranch(opcodeLo & 0x7FF) + 8);
+	}
+	return XXH3_64bits(words.data(), words.size() * sizeof(uint32));
+}
