+template <typename Storage>
+void CGSHandler::ProducerSwizzleBlocks(const PRODUCER_TRANSFER& transfer, uint8* out, uint32 blockWidth, uint32 blockHeight)
+{
+	typedef typename Storage::Unit Unit;
+	const uint32* pageOffsets = CGsPixelFormats::CPixelIndexor<Storage>::GetPageOffsets();
+	const uint32 pagesPerRow = (transfer.dstWidth * 64) / Storage::PAGEWIDTH;
+	const Unit* src = reinterpret_cast<const Unit*>(transfer.data.data());
+	for(uint32 by = 0; by < transfer.height; by += blockHeight)
+	{
+		for(uint32 bx = 0; bx < transfer.width; bx += blockWidth)
+		{
+			uint32* blockAddress = reinterpret_cast<uint32*>(out);
+			uint8* block = out + 4;
+			for(uint32 py = 0; py < blockHeight; py++)
+			{
+				const uint32 y = transfer.y + by + py;
+				const uint32* rowOffsets = pageOffsets + (y % Storage::PAGEHEIGHT) * Storage::PAGEWIDTH;
+				const uint32 rowPage = (y / Storage::PAGEHEIGHT) * pagesPerRow;
+				const Unit* srcRow = src + (by + py) * transfer.width + bx;
+				for(uint32 px = 0; px < blockWidth; px++)
+				{
+					const uint32 x = transfer.x + bx + px;
+					const uint32 address = transfer.dstPtr + ((x / Storage::PAGEWIDTH) + rowPage) * CGsPixelFormats::PAGESIZE + rowOffsets[x % Storage::PAGEWIDTH];
+					if((py == 0) && (px == 0)) *blockAddress = (address & ~0xFFU) & (RAMSIZE - 1);
+					memcpy(block + (address & 0xFF), &srcRow[px], sizeof(Unit));
+				}
+			}
+			out += 4 + 256;
+		}
+	}
+}
+
+void CGSHandler::ProducerSwizzleBlocksPSMT4(const PRODUCER_TRANSFER& transfer, uint8* out)
+{
+	typedef CGsPixelFormats::STORAGEPSMT4 Storage;
+	const uint32* places = GetPsmt4PagePlaces();
+	const uint32 pagesPerRow = (transfer.dstWidth * 64) / Storage::PAGEWIDTH;
+	const uint8* src = transfer.data.data();
+	for(uint32 by = 0; by < transfer.height; by += 16)
+	{
+		for(uint32 bx = 0; bx < transfer.width; bx += 32)
+		{
+			uint32* blockAddress = reinterpret_cast<uint32*>(out);
+			uint8* block = out + 4;
+			memset(block, 0, 256);
+			for(uint32 py = 0; py < 16; py++)
+			{
+				const uint32 y = transfer.y + by + py;
+				const uint32* rowPlaces = places + (y % Storage::PAGEHEIGHT) * Storage::PAGEWIDTH;
+				const uint32 rowPage = (y / Storage::PAGEHEIGHT) * pagesPerRow;
+				const uint32 rowStart = (by + py) * transfer.width + bx; //pixel index in the stream
+				for(uint32 px = 0; px < 32; px++)
+				{
+					const uint32 x = transfer.x + bx + px;
+					const uint32 place = rowPlaces[x % Storage::PAGEWIDTH];
+					const uint32 address = transfer.dstPtr + ((x / Storage::PAGEWIDTH) + rowPage) * CGsPixelFormats::PAGESIZE + (place >> 5);
+					if((py == 0) && (px == 0)) *blockAddress = (address & ~0xFFU) & (RAMSIZE - 1);
+					const uint32 i = rowStart + px;
+					const uint32 pixel = (src[i >> 1] >> ((i & 1) * 4)) & 0x0F;
+					const uint32 shift = place & 0x1F;
+					block[(address & 0xFF) + (shift >> 3)] |= static_cast<uint8>(pixel << (shift & 4));
+				}
+			}
+			out += 4 + 256;
+		}
+	}
+}
+
+void CGSHandler::ProducerFinishTransfer()
+{
+	//Swizzled right here, in the thread that feeds the GS (the web host runs the GIF in a thread of
+	//its own with room to spare; waking a helper thread for each of the thousands of transfers per
+	//second cost more than the swizzling)
+	m_producerTransfer.active = false;
+	m_producerSwizzled++;
+	SWIZZLE_JOB job;
+	job.transfer = std::move(m_producerTransfer);
+	m_producerTransfer = PRODUCER_TRANSFER();
+	SwizzleJob(job);
+	uint8* blocks = job.blocks;
+	const uint32 blockCount = job.blockCount;
+	const uint32 length = job.transfer.size;
+	m_producerSending = true;
+	SendGSCall(
+	    [this, blocks, blockCount, length]() {
+		    ApplyTransferBlocks(blocks, blockCount, length);
+		    delete[] blocks;
+	    });
+	m_producerSending = false;
+}
+
+void CGSHandler::SwizzleJob(SWIZZLE_JOB& job)
+{
+	const auto& transfer = job.transfer;
+	uint32 blockWidth = 8, blockHeight = 8;
+	if(transfer.psm == PSMT8) blockWidth = 16, blockHeight = 16;
+	if(transfer.psm == PSMT4) blockWidth = 32, blockHeight = 16;
+	job.blockCount = (transfer.width / blockWidth) * (transfer.height / blockHeight);
+	job.blocks = new uint8[job.blockCount * (4 + 256)];
+	switch(transfer.psm)
+	{
+	case PSMCT32:
+		ProducerSwizzleBlocks<CGsPixelFormats::STORAGEPSMCT32>(transfer, job.blocks, 8, 8);
+		break;
+	case PSMT8:
+		ProducerSwizzleBlocks<CGsPixelFormats::STORAGEPSMT8>(transfer, job.blocks, 16, 16);
+		break;
+	case PSMT4:
+		ProducerSwizzleBlocksPSMT4(transfer, job.blocks);
+		break;
+	}
+	job.transfer.data = std::vector<uint8>(); //the GS thread only needs the blocks
+}
+
+//GS thread: the transfer's data, already in GS block order
+void CGSHandler::ApplyTransferBlocks(const uint8* blocks, uint32 blockCount, uint32 length)
+{
+	if(m_trxCtx.nSize == 0) return; //no transfer expected (as FeedImageDataImpl)
+	const auto transferStart = std::chrono::steady_clock::now();
+	struct TransferTimer
+	{
+		CGSHandler& gs;
+		std::chrono::steady_clock::time_point start;
+		~TransferTimer() { gs.m_currentFrameTimes.transfers += std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start).count(); }
+	} transferTimer{*this, transferStart};
+	bool dirty = false;
+	for(uint32 i = 0; i < blockCount; i++, blocks += 4 + 256)
+	{
+		uint32 address = 0;
+		memcpy(&address, blocks, 4);
+		if(memcmp(m_pRAM + address, blocks + 4, 256) != 0)
+		{
+			memcpy(m_pRAM + address, blocks + 4, 256);
+			dirty = true;
+		}
+	}
+	m_trxCtx.nDirty |= dirty;
+	m_trxCtx.nSize -= std::min(length, m_trxCtx.nSize);
+	if(m_trxCtx.nSize == 0)
+	{
+		ProcessHostToLocalTransfer();
+	}
+}
