+	std::vector<uint8> DumpHotBlocks(size_t count) const
+	{
+		std::vector<std::pair<uint64, uint32>> hot;
+		for(const auto& [begin, entries] : m_blockEntries)
+			hot.emplace_back(entries, begin);
+		std::sort(hot.begin(), hot.end(), std::greater<>());
+		std::vector<uint8> blob;
+		for(size_t i = 0; i < std::min(count, hot.size()); i++)
+		{
+			auto codeIterator = m_blockCode.find(hot[i].second);
+			if(codeIterator == m_blockCode.end()) continue;
+			const auto& code = codeIterator->second.code;
+			const auto& text = codeIterator->second.text;
+			uint32 header[5] = {hot[i].second, codeIterator->second.end, static_cast<uint32>(hot[i].first), static_cast<uint32>(code.size()),
+			                    static_cast<uint32>(text.size())};
