+//WebAssembly: the next block from the guest pc, entered directly (see Jitter::WASM_BLOCK_CHAIN)
+void CBasicBlock::CompileChain(CMipsJitter* jitter)
+{
+#ifdef __EMSCRIPTEN__
+	if(!m_context.m_executor || !CanChain()) return;
+	if(auto chain = m_context.m_executor->GetBlockChain())
+	{
+		//Inside its own conditional block, as the native trampolines: the Jitter writes the registers
+		//it holds (nPC among them) back to the context at block boundaries, and the chaining code
+		//reads nPC from the context
+		jitter->PushRel(offsetof(CMIPS, m_State.nHasException));
+		jitter->PushCst(0);
+		jitter->BeginIf(Jitter::CONDITION_EQ);
+		{
+			jitter->JumpToDynamic(const_cast<void*>(chain));
+		}
+		jitter->EndIf();
+	}
+#endif
+}
