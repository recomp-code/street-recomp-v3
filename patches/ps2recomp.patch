+static std::unique_ptr<VerifyRun> beginVerify(PS2Runtime *runtime, uint8_t *rdram, const R5900Context *ctx, uint32_t targetPc, uint32_t returnPc)
+{
+    VerifyState &state = verifyState();
+    if (state.perFunction <= 0 || state.depth > 0)
+        return nullptr;
+    // PS2X_VERIFY_FROM=<seconds>: only verify calls made after that point of the run, to focus
+    // the per-function budget on one phase (e.g. a stalled load).
+    static const double verifyFrom = [] { const char *e = std::getenv("PS2X_VERIFY_FROM"); return e ? std::atof(e) : 0.0; }();
+    static const auto verifyOrigin = std::chrono::steady_clock::now();
+    if (verifyFrom > 0.0 && std::chrono::duration<double>(std::chrono::steady_clock::now() - verifyOrigin).count() < verifyFrom)
+        return nullptr;
+    uint32_t &attempts = state.attempts[targetPc];
+    if (attempts >= static_cast<uint32_t>(state.perFunction))
+        return nullptr;
+    ++attempts;
+    ++state.depth;
+    auto run = std::make_unique<VerifyRun>();
+    run->entry = *ctx;
+    const bool ok = ps2_interpreter::verifyCall(rdram, *ctx, runtime, returnPc, run->expected, run->writes);
+    --state.depth;
+    if (!ok)
+    {
+        ++state.skipped;
+        return nullptr;
+    }
+    return run;
+}
+
+static void finishVerify(const VerifyRun &run, const uint8_t *rdram, const R5900Context &actual, uint32_t targetPc)
+{
+    VerifyState &state = verifyState();
+    ++state.verified;
+    std::ostringstream diffs;
+    int count = 0;
+    auto note = [&](const std::string &text)
+    {
+        if (count < 12)
+            diffs << " " << text;
+        ++count;
+    };
+    auto hex = [](uint64_t v)
+    {
+        std::ostringstream o;
+        o << "0x" << std::hex << v;
+        return o.str();
+    };
+
+    // By default only what the MIPS EABI lets a caller observe is compared: v0/v1, f0, the
+    // callee-saved GPRs/FPRs, VU0 state (games keep matrices in VU0 across calls) and memory
+    // outside the callee's dead stack frame. PS2X_VERIFY_STRICT=1 compares everything.
+    static const bool strict = [] { const char *e = std::getenv("PS2X_VERIFY_STRICT"); return e && *e == '1'; }();
+    const uint32_t entrySp = static_cast<uint32_t>(_mm_cvtsi128_si32(run.entry.r[29]));
+    auto observableGpr = [&](int r)
+    {
+        return strict || r == 2 || (r >= 16 && r <= 23) || r == 28 || r == 29 || r == 30;
+    };
+    auto observableFpr = [&](int f)
+    {
+        return strict || f == 0 || f >= 20;
+    };
+
+    for (int r = 1; r < 32; ++r)
+    {
+        if (r == 26 || r == 27 || !observableGpr(r))
+            continue;
+        alignas(16) uint64_t e[2], a[2];
+        _mm_store_si128(reinterpret_cast<__m128i *>(e), run.expected.r[r]);
+        _mm_store_si128(reinterpret_cast<__m128i *>(a), actual.r[r]);
+        if (!strict && (r == 2 || r == 3))
+            e[1] = a[1];
+        if (e[0] != a[0] || e[1] != a[1])
+            note("r" + std::to_string(r) + "=" + hex(a[0]) + (a[1] != e[1] ? ":" + hex(a[1]) : std::string()) +
+                 "(interp " + hex(e[0]) + (a[1] != e[1] ? ":" + hex(e[1]) : std::string()) + ")");
+    }
+    if (strict && (run.expected.hi != actual.hi || run.expected.lo != actual.lo))
+        note("hi/lo=" + hex(actual.hi) + "/" + hex(actual.lo) + "(interp " + hex(run.expected.hi) + "/" + hex(run.expected.lo) + ")");
+    if (strict && (run.expected.hi1 != actual.hi1 || run.expected.lo1 != actual.lo1))
+        note("hi1/lo1=" + hex(actual.hi1) + "/" + hex(actual.lo1) + "(interp " + hex(run.expected.hi1) + "/" + hex(run.expected.lo1) + ")");
+    for (int f = 0; f < 32; ++f)
+    {
+        if (!observableFpr(f))
+            continue;
+        uint32_t e, a;
+        std::memcpy(&e, &run.expected.f[f], 4);
+        std::memcpy(&a, &actual.f[f], 4);
+        if (!floatsMatch(e, a))
+            note("f" + std::to_string(f) + "=" + std::to_string(actual.f[f]) + "(interp " + std::to_string(run.expected.f[f]) + ")");
+    }
+    if (strict && (run.expected.fcr31 & 0x00800000u) != (actual.fcr31 & 0x00800000u))
+        note("fcc=" + std::to_string((actual.fcr31 >> 23) & 1u) + "(interp " + std::to_string((run.expected.fcr31 >> 23) & 1u) + ")");
+    for (int v = 1; v < 32; ++v)
+    {
+        alignas(16) uint32_t e[4], a[4];
+        std::memcpy(e, &run.expected.vu0_vf[v], 16);
+        std::memcpy(a, &actual.vu0_vf[v], 16);
+        for (int lane = 0; lane < 4; ++lane)
+        {
+            if (!floatsMatch(e[lane], a[lane]))
+            {
+                float fe, fa;
+                std::memcpy(&fe, &e[lane], 4);
+                std::memcpy(&fa, &a[lane], 4);
+                note("vf" + std::to_string(v) + "." + "xyzw"[lane] + "=" + std::to_string(fa) + "(interp " + std::to_string(fe) + ")");
+            }
+        }
+    }
+    {
+        uint32_t e, a;
+        std::memcpy(&e, &run.expected.vu0_q, 4);
+        std::memcpy(&a, &actual.vu0_q, 4);
+        if (!floatsMatch(e, a))
+            note("Q=" + std::to_string(actual.vu0_q) + "(interp " + std::to_string(run.expected.vu0_q) + ")");
+    }
+    for (int i = 1; i < 16; ++i)
+        if (run.expected.vi[i] != actual.vi[i])
+            note("vi" + std::to_string(i) + "=" + hex(actual.vi[i]) + "(interp " + hex(run.expected.vi[i]) + ")");
+
+    uint32_t memDiffs = 0u;
+    uint32_t firstMemDiff = 0u;
+    for (const auto &[address, value] : run.writes)
+    {
+        if (!strict && address < entrySp && address + 0x10000u >= entrySp)
+            continue; // the callee's own (now dead) stack frame
+        if (rdram[address & PS2_RAM_MASK] != value)
+        {
+            if (memDiffs++ == 0u)
+                firstMemDiff = address;
+        }
+    }
+    if (memDiffs != 0u)
+        note("mem: " + std::to_string(memDiffs) + " bytes differ, first at " + hex(firstMemDiff) + " native=" +
+             hex(rdram[firstMemDiff & PS2_RAM_MASK]) + "(interp " +
+             hex(std::find_if(run.writes.begin(), run.writes.end(), [&](const auto &w) { return w.first == firstMemDiff; })->second) + ")");
+
+    if (count > 0)
+    {
+        ++state.mismatched;
+        if (state.reported.insert(targetPc).second && state.reported.size() <= 400u)
+        {
+            std::fprintf(stderr, "[verify] MISMATCH fn=0x%X ra=0x%X a0=0x%X a1=0x%X:%s%s\n", targetPc,
+                         static_cast<uint32_t>(_mm_extract_epi32(run.entry.r[31], 0)),
+                         static_cast<uint32_t>(_mm_extract_epi32(run.entry.r[4], 0)),
+                         static_cast<uint32_t>(_mm_extract_epi32(run.entry.r[5], 0)),
+                         diffs.str().c_str(), count > 12 ? " ..." : "");
+        }
+    }
+    if ((state.verified % 2000u) == 0u)
+    {
+        std::fprintf(stderr, "[verify] verified=%llu mismatched=%llu skipped=%llu functions=%zu\n",
+                     static_cast<unsigned long long>(state.verified), static_cast<unsigned long long>(state.mismatched),
+                     static_cast<unsigned long long>(state.skipped), state.attempts.size());
+    }
+}
