+// ps2recomp: minimal stand-in for PCSX2's common/ScopedGuard.h.
+#pragma once
+
+#include <optional>
+#include <utility>
+
+template <typename T>
+class ScopedGuard final
+{
+public:
+    ScopedGuard(T &&func) : m_func(std::forward<T>(func)) {}
+    ScopedGuard(const ScopedGuard &) = delete;
+    ScopedGuard &operator=(const ScopedGuard &) = delete;
+    ~ScopedGuard() { Run(); }
+
+    void Run()
+    {
+        if (m_func.has_value())
+        {
+            (*m_func)();
+            m_func.reset();
+        }
+    }
+
+    void Cancel() { m_func.reset(); }
+
+private:
+    std::optional<T> m_func;
+};
