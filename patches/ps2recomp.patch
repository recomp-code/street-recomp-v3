@@ -0,0 +1,54 @@
+// SPDX-FileCopyrightText: 2002-2026 PCSX2 Dev Team
+// SPDX-License-Identifier: GPL-3.0+
+
+#pragma once
+#include <atomic>
+#include <mutex>
+#ifdef _WIN32
+#include <winsock2.h>
+#elif defined(__POSIX__)
+#define INVALID_SOCKET -1
+#include <sys/socket.h>
+#endif
+
+#include "DEV9/Sessions/BaseSession.h"
+#include "UDP_BaseSession.h"
+#include "UDP_Session.h"
+
+namespace Sessions
+{
+	class UDP_FixedPort : public BaseSession
+	{
+	private:
+		std::atomic<bool> open{false};
+
+#ifdef _WIN32
+		SOCKET client = INVALID_SOCKET;
+#elif defined(__POSIX__)
+		int client = INVALID_SOCKET;
+#endif
+
+	public:
+		const u16 port = 0;
+
+	private:
+		std::mutex connectionSentry;
+		std::vector<UDP_BaseSession*> connections;
+
+	public:
+		UDP_FixedPort(ConnectionKey parKey, PacketReader::IP::IP_Address parAdapterIP, u16 parPort);
+
+		void Init();
+
+		virtual std::optional<ReceivedPayload> Recv();
+		virtual bool Send(PacketReader::IP::IP_Payload* payload);
+		virtual void Reset();
+
+		UDP_Session* NewClientSession(ConnectionKey parNewKey, bool parIsBrodcast, bool parIsMulticast);
+
+		virtual ~UDP_FixedPort();
+
+	private:
+		void HandleChildConnectionClosed(BaseSession* sender);
+	};
+} // namespace Sessions
diff --git a/ps2xIOP/src/emulator/dev9/DEV9/Sessions/UDP_Session/UDP_Relay.cpp b/ps2xIOP/src/emulator/dev9/DEV9/Sessions/UDP_Session/UDP_Relay.cpp
new file mode 100644
index 0000000..3b7ca22
--- /dev/null
+++ b/ps2xIOP/src/emulator/dev9/DEV9/Sessions/UDP_Session/UDP_Relay.cpp
@@ -0,0 +1,191 @@
+// ps2recomp: P2P UDP relay through the game server (see UDP_Relay.h).
+
+#include <bit>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <string>
+#include <cstdio>
+
+#include "common/Console.h"
+
+#ifdef _WIN32
+#include "common/RedtapeWindows.h"
+#include <winsock2.h>
+#include <ws2tcpip.h>
+#endif
+
+#include "UDP_Relay.h"
+#include "DEV9/PacketReader/IP/UDP/UDP_Packet.h"
+#include "DEV9/PacketReader/Payload.h"
+
+using namespace PacketReader;
+using namespace PacketReader::IP;
+using namespace PacketReader::IP::UDP;
+
+namespace Sessions
+{
+	namespace
+	{
+		constexpr int kDataHeader = 4 + 4 + 2 + 2 + 6; // client -> server
+		constexpr int kRecvHeader = 4 + 4 + 2 + 2;     // server -> client
+
+		u16 readBE16(const u8* p) { return static_cast<u16>((p[0] << 8) | p[1]); }
+		std::string HexPreview(const u8* p, int length)
+		{
+			std::string out;
+			char hex[4];
+			for (int i = 0; i < length && i < 32; ++i)
+			{
+				std::snprintf(hex, sizeof(hex), "%02x", p[i]);
+				out += hex;
+			}
+			return out;
+		}
+		void writeBE16(u8* p, u16 v)
+		{
+			p[0] = static_cast<u8>(v >> 8);
+			p[1] = static_cast<u8>(v);
+		}
+	} // namespace
+
+	bool UDP_Relay::Enabled()
+	{
+		static const bool enabled = [] {
+			const char* relay = std::getenv("PS2X_NET_RELAY");
+			if (relay && *relay == '0')
+				return false;
+			const char* server = std::getenv("PS2X_NET_SERVER");
+			return server && *server;
+		}();
+		return enabled;
+	}
+
+	UDP_Relay::UDP_Relay(ConnectionKey parKey, IP_Address parAdapterIP, MAC_Address parMac)
+		: BaseSession(parKey, parAdapterIP)
+		, mac(parMac)
+	{
+	}
+
+	bool UDP_Relay::Init()
+	{
+		const char* host = std::getenv("PS2X_NET_SERVER");
+		const char* portText = std::getenv("PS2X_NET_RELAY_PORT");
+		const int port = portText && *portText ? std::atoi(portText) : 21003;
+
+		server.sin_family = AF_INET;
+		server.sin_port = htons(static_cast<u16>(port));
+		if (inet_pton(AF_INET, host, &server.sin_addr) != 1)
+		{
+			// A host name: resolve it once.
+			addrinfo hints{};
+			hints.ai_family = AF_INET;
+			hints.ai_socktype = SOCK_DGRAM;
+			addrinfo* result = nullptr;
+			if (getaddrinfo(host, nullptr, &hints, &result) != 0 || !result)
+			{
+				Console.Error("DEV9: Relay: cannot resolve server %s", host);
+				return false;
+			}
+			server.sin_addr = reinterpret_cast<sockaddr_in*>(result->ai_addr)->sin_addr;
+			freeaddrinfo(result);
+		}
+
+		client = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+		if (client == INVALID_SOCKET)
+		{
+			Console.Error("DEV9: Relay: socket failed (%d)", WSAGetLastError());
+			return false;
+		}
+		u_long nonBlocking = 1;
+		ioctlsocket(client, FIONBIO, &nonBlocking);
+		// Windows reports an ICMP "port unreachable" (server not up yet) as WSAECONNRESET on the
+		// next recv; turn that off so the relay just keeps trying.
+		BOOL newBehavior = FALSE;
+		DWORD bytesReturned = 0;
+		WSAIoctl(client, _WSAIOW(IOC_VENDOR, 12) /* SIO_UDP_CONNRESET */, &newBehavior, sizeof(newBehavior), nullptr, 0, &bytesReturned, nullptr, nullptr);
+
+		char text[32];
+		inet_ntop(AF_INET, &server.sin_addr, text, sizeof(text));
+		Console.WriteLn("DEV9: Relay: peer traffic to 10.200.x.x goes through %s:%d (MAC %02x:%02x:%02x:%02x:%02x:%02x)",
+			text, port, mac.bytes[0], mac.bytes[1], mac.bytes[2], mac.bytes[3], mac.bytes[4], mac.bytes[5]);
+		SendHello();
+		return true;
+	}
+
+	void UDP_Relay::SendHello()
+	{
+		u8 packet[10];
+		std::memcpy(packet, "NBRH", 4);
+		std::memcpy(packet + 4, mac.bytes, 6);
+		sendto(client, reinterpret_cast<const char*>(packet), sizeof(packet), 0, reinterpret_cast<const sockaddr*>(&server), sizeof(server));
+		lastHello = std::chrono::steady_clock::now();
+	}
+
+	bool UDP_Relay::SendTo(const IP_Address& dest, u16 srcPort, u16 dstPort, const u8* data, int length)
+	{
+		if (client == INVALID_SOCKET || length < 0 || length > 65000)
+			return false;
+		std::unique_ptr<u8[]> packet = std::make_unique<u8[]>(kDataHeader + length);
+		std::memcpy(packet.get(), "NBR1", 4);
+		std::memcpy(packet.get() + 4, dest.bytes, 4);
+		writeBE16(packet.get() + 8, srcPort);
+		writeBE16(packet.get() + 10, dstPort);
+		std::memcpy(packet.get() + 12, mac.bytes, 6);
+		if (length)
+			std::memcpy(packet.get() + kDataHeader, data, length);
+		const int ret = sendto(client, reinterpret_cast<const char*>(packet.get()), kDataHeader + length, 0,
+			reinterpret_cast<const sockaddr*>(&server), sizeof(server));
+		static int s_sendLogs = 0;
+		if (s_sendLogs++ < 30)
+			Console.WriteLn("DEV9: Relay: send %d.%d.%d.%d:%u <- :%u (%d bytes) %s", dest.bytes[0], dest.bytes[1], dest.bytes[2], dest.bytes[3], dstPort, srcPort, length, HexPreview(data, length).c_str());
+		if (ret == SOCKET_ERROR)
+		{
+			Console.Error("DEV9: Relay: send error %d", WSAGetLastError());
+			return false;
+		}
+		return true;
+	}
+
+	std::optional<ReceivedPayload> UDP_Relay::Recv()
+	{
+		if (client == INVALID_SOCKET)
+			return std::nullopt;
+		if (std::chrono::steady_clock::now() - lastHello > std::chrono::seconds(5))
+			SendHello();
+
+		u8 buffer[65536];
+		sockaddr_in from{};
+		int fromLen = sizeof(from);
+		const int ret = recvfrom(client, reinterpret_cast<char*>(buffer), sizeof(buffer), 0, reinterpret_cast<sockaddr*>(&from), &fromLen);
+		if (ret == SOCKET_ERROR || ret < kRecvHeader || std::memcmp(buffer, "NBR1", 4) != 0)
+			return std::nullopt;
+
+		IP_Address source;
+		std::memcpy(source.bytes, buffer + 4, 4);
+		const int length = ret - kRecvHeader;
+		PayloadData* data = new PayloadData(length);
+		if (length)
+			std::memcpy(data->data.get(), buffer + kRecvHeader, length);
+		static int s_recvLogs = 0;
+		if (s_recvLogs++ < 30)
+			Console.WriteLn("DEV9: Relay: recv from %d.%d.%d.%d:%u -> :%u (%d bytes) %s", source.bytes[0], source.bytes[1], source.bytes[2], source.bytes[3], readBE16(buffer + 8), readBE16(buffer + 10), length, HexPreview(buffer + kRecvHeader, length).c_str());
+		std::unique_ptr<UDP_Packet> udp = std::make_unique<UDP_Packet>(data);
+		udp->sourcePort = readBE16(buffer + 8);
+		udp->destinationPort = readBE16(buffer + 10);
+		return ReceivedPayload{source, std::move(udp)};
+	}
+
+	bool UDP_Relay::Send(IP_Payload* payload)
+	{
+		(void)payload;
+		return false;
+	}
+
+	UDP_Relay::~UDP_Relay()
+	{
+		if (client != INVALID_SOCKET)
+			closesocket(client);
+		client = INVALID_SOCKET;
+	}
+} // namespace Sessions
diff --git a/ps2xIOP/src/emulator/dev9/DEV9/Sessions/UDP_Session/UDP_Relay.h b/ps2xIOP/src/emulator/dev9/DEV9/Sessions/UDP_Session/UDP_Relay.h
new file mode 100644
index 0000000..b810855
--- /dev/null
+++ b/ps2xIOP/src/emulator/dev9/DEV9/Sessions/UDP_Session/UDP_Relay.h
@@ -0,0 +1,55 @@
+// ps2recomp: peer-to-peer UDP through the game server ("relay"), so online matches work behind
+// any NAT/router and with several instances on one PC.
+//
+// The NBA Street V3 server hands every player a virtual address in 10.200.0.0/16 instead of its
+// real IP. UDP the PS2 sends to such an address is wrapped and sent to the server's relay port,
+// which forwards it to the other player's relay socket; packets coming back are delivered to the
+// PS2 as if they came straight from the peer's virtual address.
+//
+//   client -> server  "NBR1" dstIP[4] srcPort[2] dstPort[2] mac[6] payload
+//   server -> client  "NBR1" srcIP[4] srcPort[2] dstPort[2] payload
+//   client -> server  "NBRH" mac[6]          (hello/keepalive: tells the server where we are)
+//
+// PS2X_NET_RELAY=0 disables it; PS2X_NET_RELAY_PORT (default 21003) is the server's UDP port.
+
+#pragma once
+
+#include "DEV9/Sessions/BaseSession.h"
+#include "DEV9/PacketReader/MAC_Address.h"
+
+#include <chrono>
+#include <optional>
+
+#ifdef _WIN32
+#include "common/RedtapeWindows.h"
+#include <winsock2.h>
+#endif
+
+namespace Sessions
+{
+	class UDP_Relay : public BaseSession
+	{
+	public:
+		// The virtual peer range handed out by the server.
+		static bool IsRelayAddress(const PacketReader::IP::IP_Address& ip) { return ip.bytes[0] == 10 && ip.bytes[1] == 200; }
+		static bool Enabled();
+
+		UDP_Relay(ConnectionKey parKey, PacketReader::IP::IP_Address parAdapterIP, PacketReader::MAC_Address parMac);
+		~UDP_Relay() override;
+
+		bool Init();
+		bool SendTo(const PacketReader::IP::IP_Address& dest, u16 srcPort, u16 dstPort, const u8* data, int length);
+
+		std::optional<ReceivedPayload> Recv() override;
+		bool Send(PacketReader::IP::IP_Payload* payload) override; // unused: use SendTo
+		void Reset() override {}
+
+	private:
+		void SendHello();
+
+		SOCKET client = INVALID_SOCKET;
+		sockaddr_in server{};
+		PacketReader::MAC_Address mac;
+		std::chrono::steady_clock::time_point lastHello{};
+	};
+} // namespace Sessions
diff --git a/ps2xIOP/src/emulator/dev9/DEV9/Sessions/UDP_Session/UDP_Session.cpp b/ps2xIOP/src/emulator/dev9/DEV9/Sessions/UDP_Session/UDP_Session.cpp
new file mode 100644
index 0000000..276a2a4
--- /dev/null
+++ b/ps2xIOP/src/emulator/dev9/DEV9/Sessions/UDP_Session/UDP_Session.cpp
@@ -0,0 +1,267 @@
+// SPDX-FileCopyrightText: 2002-2026 PCSX2 Dev Team
+// SPDX-License-Identifier: GPL-3.0+
+
+#include "common/Assertions.h"
+#include "common/Console.h"
+
+#ifdef __POSIX__
+#define SOCKET_ERROR -1
+#include <errno.h>
+#include <sys/ioctl.h>
+#include <sys/select.h>
+#include <netinet/in.h>
+#endif
+
+#ifdef _WIN32
+#include "common/RedtapeWindows.h"
+#include <winsock2.h>
+#else
+#include <unistd.h>
+#endif
+
+#include "UDP_Session.h"
+#include "UDP_Common.h"
+#include "DEV9/PacketReader/IP/UDP/UDP_Packet.h"
+
+using namespace PacketReader;
+using namespace PacketReader::IP;
+using namespace PacketReader::IP::UDP;
+
+using namespace std::chrono_literals;
+
+namespace Sessions
+{
+	const std::chrono::duration<std::chrono::steady_clock::rep, std::chrono::steady_clock::period>
+		UDP_Session::MAX_IDLE = 120s; // See RFC 4787 section 4.3
+
+	UDP_Session::UDP_Session(ConnectionKey parKey, IP_Address parAdapterIP)
+		: UDP_BaseSession(parKey, parAdapterIP)
+		, isBroadcast(false)
+		, isMulticast(false)
+		, isFixedPort(false)
+		, deathClockStart(std::chrono::steady_clock::now())
+	{
+	}
+
+#ifdef _WIN32
+	UDP_Session::UDP_Session(ConnectionKey parKey, IP_Address parAdapterIP, bool parIsBroadcast, bool parIsMulticast, SOCKET parClient)
+#elif defined(__POSIX__)
+	UDP_Session::UDP_Session(ConnectionKey parKey, IP_Address parAdapterIP, bool parIsBroadcast, bool parIsMulticast, int parClient)
+#endif
+		: UDP_BaseSession(parKey, parAdapterIP)
+		, open(true)
+		, client(parClient)
+		, srcPort(parKey.ps2Port)
+		, destPort(parKey.srvPort)
+		, isBroadcast(parIsBroadcast)
+		, isMulticast(parIsMulticast)
+		, isFixedPort(true)
+		, deathClockStart(std::chrono::steady_clock::now())
+	{
+	}
+
+	std::optional<ReceivedPayload> UDP_Session::Recv()
+	{
+		if (!open.load())
+			return std::nullopt;
+
+		if (isFixedPort)
+		{
+			if (std::chrono::steady_clock::now() - deathClockStart.load() > MAX_IDLE)
+			{
+				Console.WriteLn("DEV9: UDP: Fixed port max idle reached");
+				open.store(false);
+				RaiseEventConnectionClosed();
+			}
+			return std::nullopt;
+		}
+
+		std::optional<ReceivedPayload> ret;
+		bool success;
+		std::tie(ret, success) = UDP_Common::RecvFrom(client, srcPort);
+
+		if (!success)
+		{
+			RaiseEventConnectionClosed();
+			return std::nullopt;
+		}
+		else if (ret.has_value())
+			return ret;
+
+		if (std::chrono::steady_clock::now() - deathClockStart.load() > MAX_IDLE)
+		{
+			Console.WriteLn("DEV9: UDP: Max idle reached");
+			RaiseEventConnectionClosed();
+		}
+
+		return std::nullopt;
+	}
+
+	bool UDP_Session::WillRecive(IP_Address parDestIP)
+	{
+		if (!open.load())
+			return false;
+
+		if (isBroadcast || isMulticast || (parDestIP == destIP))
+		{
+			deathClockStart.store(std::chrono::steady_clock::now());
+			return true;
+		}
+		return false;
+	}
+
+	bool UDP_Session::Send(PacketReader::IP::IP_Payload* payload)
+	{
+		deathClockStart.store(std::chrono::steady_clock::now());
+
+		IP_PayloadPtr* ipPayload = static_cast<IP_PayloadPtr*>(payload);
+		UDP_Packet udp(ipPayload->data, ipPayload->GetLength());
+
+		if (destPort != 0)
+		{
+			// Already created client!?
+			if (!(udp.destinationPort == destPort && udp.sourcePort == srcPort))
+			{
+				Console.Error("DEV9: UDP: Packet invalid for current session (duplicate key?)");
+				return false;
+			}
+		}
+		else
+		{
+			// Create client
+			destPort = udp.destinationPort;
+			srcPort = udp.sourcePort;
+
+			client = UDP_Common::CreateSocket(adapterIP, std::nullopt);
+			if (client == INVALID_SOCKET)
+			{
+				RaiseEventConnectionClosed();
+				return false;
+			}
+
+			sockaddr_in endpoint{};
+			endpoint.sin_family = AF_INET;
+			endpoint.sin_addr = std::bit_cast<in_addr>(destIP);
+			endpoint.sin_port = htons(destPort);
+
+			const int ret = connect(client, reinterpret_cast<const sockaddr*>(&endpoint), sizeof(endpoint));
+
+			if (ret == SOCKET_ERROR)
+			{
+				Console.Error("DEV9: UDP: Failed to connect socket. Error: %d",
+#ifdef _WIN32
+					WSAGetLastError());
+#elif defined(__POSIX__)
+					errno);
+#endif
+				RaiseEventConnectionClosed();
+				return false;
+			}
+
+			if (srcPort != 0)
+				open.store(true);
+		}
+
+		PayloadPtr* udpPayload = static_cast<PayloadPtr*>(udp.GetPayload());
+
+		// Send Packet
+		int ret = SOCKET_ERROR;
+		if (isBroadcast)
+		{
+			sockaddr_in endpoint{};
+			endpoint.sin_family = AF_INET;
+			endpoint.sin_addr.s_addr = INADDR_BROADCAST;
+			endpoint.sin_port = htons(destPort);
+
+			ret = sendto(client, reinterpret_cast<const char*>(udpPayload->data), udpPayload->GetLength(), 0, reinterpret_cast<const sockaddr*>(&endpoint), sizeof(endpoint));
+		}
+		else if (isFixedPort)
+		{
+			sockaddr_in endpoint{};
+			endpoint.sin_family = AF_INET;
+			endpoint.sin_addr = std::bit_cast<in_addr>(destIP);
+			endpoint.sin_port = htons(destPort);
+
+			ret = sendto(client, reinterpret_cast<const char*>(udpPayload->data), udpPayload->GetLength(), 0, reinterpret_cast<const sockaddr*>(&endpoint), sizeof(endpoint));
+		}
+		else
+			ret = send(client, reinterpret_cast<const char*>(udpPayload->data), udpPayload->GetLength(), 0);
+
+		if (ret == SOCKET_ERROR)
+		{
+#ifdef _WIN32
+			ret = WSAGetLastError();
+#elif defined(__POSIX__)
+			ret = errno;
+#endif
+			Console.Error("DEV9: UDP: Send error %d", ret);
+
+			/*
+			 * We can receive an ICMP Port Unreacable error, which can get raised in send (and maybe sendto?)
+			 * On Windows this is an WSAECONNRESET error, although I've not been able to reproduce in testing
+			 * On Linux this is an ECONNREFUSED error (Testing needed to confirm full behaviour)
+			 * We ignore the error and resend to allow packet capture (i.e. wireshark) for server resurrection projects
+			 */
+#ifdef _WIN32
+			if (ret == WSAECONNRESET)
+#elif defined(__POSIX__)
+			if (ret == ECONNREFUSED)
+#endif
+			{
+				pxAssert(isBroadcast == false && isMulticast == false);
+				if (isFixedPort)
+				{
+					sockaddr_in endpoint{};
+					endpoint.sin_family = AF_INET;
+					endpoint.sin_addr = std::bit_cast<in_addr>(destIP);
+					endpoint.sin_port = htons(destPort);
+
+					ret = sendto(client, reinterpret_cast<const char*>(udpPayload->data), udpPayload->GetLength(), 0, reinterpret_cast<const sockaddr*>(&endpoint), sizeof(endpoint));
+				}
+				else
+					ret = send(client, reinterpret_cast<const char*>(udpPayload->data), udpPayload->GetLength(), 0);
+
+				if (ret == SOCKET_ERROR)
+				{
+					Console.Error("DEV9: UDP: Send error (second attempt) %d",
+#ifdef _WIN32
+						WSAGetLastError());
+#elif defined(__POSIX__)
+						errno);
+#endif
+					return false;
+				}
+			}
+			else
+			{
+				RaiseEventConnectionClosed();
+				return false;
+			}
+		}
+		pxAssert(ret == udpPayload->GetLength());
+
+		if (srcPort == 0)
+			RaiseEventConnectionClosed();
+
+		return true;
+	}
+
+	void UDP_Session::Reset()
+	{
+		RaiseEventConnectionClosed();
+	}
+
+	UDP_Session::~UDP_Session()
+	{
+		open.store(false);
+		if (!isFixedPort && client != INVALID_SOCKET)
+		{
+#ifdef _WIN32
+			closesocket(client);
+#elif defined(__POSIX__)
+			::close(client);
+#endif
+			client = INVALID_SOCKET;
+		}
+	}
+} // namespace Sessions
diff --git a/ps2xIOP/src/emulator/dev9/DEV9/Sessions/UDP_Session/UDP_Session.h b/ps2xIOP/src/emulator/dev9/DEV9/Sessions/UDP_Session/UDP_Session.h
