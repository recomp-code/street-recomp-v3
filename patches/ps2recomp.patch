diff --git a/ps2xRuntime/src/lib/vif1_irq_queue.h b/ps2xRuntime/src/lib/vif1_irq_queue.h
new file mode 100644
index 0000000..053babc
--- /dev/null
+++ b/ps2xRuntime/src/lib/vif1_irq_queue.h
@@ -0,0 +1,30 @@
+#pragma once
+
+#include <cstdint>
+
+// VIF1 "i-bit" interrupts (INTC cause 5).
+//
+// On hardware a VIFcode with bit 31 set makes VIF1 stall after executing it and raises
+// INTC_VIF1; VIF1_CODE holds that VIFcode until the CPU cancels the stall with
+// VIF1_FBRST.STC. The runtime decodes VIF1 data synchronously, so it records each
+// interrupting VIFcode here and delivers them one at a time: the next one is only handed
+// out after the guest handler (or anyone else) writes FBRST.STC.
+namespace ps2_vif1_irq
+{
+    void push(uint32_t vifCode);
+    // Returns true and the VIFcode when an interrupt should be raised now.
+    bool takeNext(uint32_t &vifCode);
+    // FBRST.STC / RST: the current stall is over.
+    void acknowledge();
+    void reset();
+
+    // Real i-bit stall for VIF1 DMA chains. Games use it as a rendezvous (EA's movie player
+    // only lets VIF1 draw a batch of texture strips once PATH3 has uploaded them), so data
+    // after the interrupting VIFcode must not be decoded before FBRST.STC. While a caller
+    // allows stalling, processVIF1Data stops right after such a VIFcode and records how many
+    // bytes it consumed; the caller keeps the rest and resumes it on STC.
+    void setStallAllowed(bool allowed);
+    bool stallAllowed();
+    void noteStall(uint32_t consumedBytes);
+    bool takeStall(uint32_t &consumedBytes);
+}
