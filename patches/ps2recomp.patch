diff --git a/ps2xRuntime/src/lib/ps2_crash_handler.cpp b/ps2xRuntime/src/lib/ps2_crash_handler.cpp
new file mode 100644
index 0000000..563c74f
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_crash_handler.cpp
@@ -0,0 +1,220 @@
+// Last-chance diagnostics: a native crash (access violation, stack overflow, uncaught C++
+// exception) otherwise ends the process silently. Prints what failed and where, plus the
+// runtime's recent guest dispatch history, to stderr.
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <algorithm>
+#include <atomic>
+#include <exception>
+#include <string>
+#include <thread>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+#if defined(_WIN32)
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+#include <timeapi.h>
+#pragma comment(lib, "winmm.lib")
+#endif
+
+// Last guest function looked up for dispatch (any thread); sampled by the profiler.
+std::atomic<uint32_t> g_ps2ProfLastGuestFn{0u};
+// pc field of the guest thread the EE scheduler is running (generated code updates it per
+// instruction), so samples show the exact guest instruction, e.g. which wait loop spins.
+std::atomic<const uint32_t *> g_ps2ProfGuestPc{nullptr};
+
+// Maintained by PS2Runtime::dispatchGuestBranch (nesting of native guest calls on this thread).
+thread_local uint32_t g_ps2GuestCallDepth = 0u;
+thread_local uint32_t g_ps2LastGuestPc = 0u;
+
+namespace
+{
+    std::string (*g_describeGuestState)() = nullptr;
+
+    void printGuestState()
+    {
+        if (g_describeGuestState)
+        {
+            const std::string state = g_describeGuestState();
+            std::fprintf(stderr, "[crash] guest dispatch history: %s\n", state.c_str());
+        }
+        std::fflush(stderr);
+        std::fflush(stdout);
+    }
+
+#if defined(_WIN32)
+    LONG WINAPI unhandledFilter(EXCEPTION_POINTERS *info)
+    {
+        const EXCEPTION_RECORD *record = info->ExceptionRecord;
+        const uintptr_t base = reinterpret_cast<uintptr_t>(GetModuleHandleW(nullptr));
+        const uintptr_t address = reinterpret_cast<uintptr_t>(record->ExceptionAddress);
+        std::fprintf(stderr, "[crash] exception 0x%08lX at %p (exe+0x%llX) thread=%lu\n",
+                     static_cast<unsigned long>(record->ExceptionCode), record->ExceptionAddress,
+                     static_cast<unsigned long long>(address - base), GetCurrentThreadId());
+        PWSTR threadName = nullptr;
+        if (SUCCEEDED(GetThreadDescription(GetCurrentThread(), &threadName)) && threadName)
+        {
+            std::fprintf(stderr, "[crash] thread name: %ls\n", threadName);
+            LocalFree(threadName);
+        }
+        ULONG_PTR stackLow = 0, stackHigh = 0;
+        GetCurrentThreadStackLimits(&stackLow, &stackHigh);
+        std::fprintf(stderr, "[crash] stack: size=0x%llX rsp=0x%llX low=0x%llX guestCallDepth=%u lastGuestPc=0x%X\n",
+                     static_cast<unsigned long long>(stackHigh - stackLow),
+                     static_cast<unsigned long long>(info->ContextRecord->Rsp),
+                     static_cast<unsigned long long>(stackLow), g_ps2GuestCallDepth, g_ps2LastGuestPc);
+        if (record->ExceptionCode == EXCEPTION_ACCESS_VIOLATION && record->NumberParameters >= 2)
+        {
+            std::fprintf(stderr, "[crash] access violation %s address 0x%llX\n",
+                         record->ExceptionInformation[0] == 0 ? "reading" : (record->ExceptionInformation[0] == 1 ? "writing" : "executing"),
+                         static_cast<unsigned long long>(record->ExceptionInformation[1]));
+        }
+        printGuestState();
+        return EXCEPTION_CONTINUE_SEARCH;
+    }
+#endif
+
+    void terminateHandler()
+    {
+        std::fprintf(stderr, "[crash] std::terminate called");
+        if (std::exception_ptr current = std::current_exception())
+        {
+            try
+            {
+                std::rethrow_exception(current);
+            }
+            catch (const std::exception &e)
+            {
+                std::fprintf(stderr, " (uncaught exception: %s)", e.what());
+            }
+            catch (...)
+            {
+                std::fprintf(stderr, " (uncaught non-std exception)");
+            }
+        }
+        std::fprintf(stderr, "\n");
+        printGuestState();
+        std::abort();
+    }
+}
+
+// PS2X_PROFILE=1: sampling profiler for the calling thread (the EE "GameThread"). Every ~1 ms
+// it captures the thread's native instruction pointer; every 10 s it prints the hottest exe
+// offsets ("[prof] exe+0x...") which tools\profile_report.ps1 maps to functions via the .map.
+void ps2StartSamplingProfilerForCurrentThread()
+{
+#if defined(_WIN32)
+    const char *env = std::getenv("PS2X_PROFILE");
+    if (!env || !env[0] || env[0] == '0')
+        return;
+    HANDLE target = nullptr;
+    if (!DuplicateHandle(GetCurrentProcess(), GetCurrentThread(), GetCurrentProcess(), &target,
+                         THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION, FALSE, 0))
+        return;
+    std::thread([target]()
+    {
+        const uintptr_t base = reinterpret_cast<uintptr_t>(GetModuleHandleW(nullptr));
+        std::unordered_map<uint64_t, uint32_t> hits;
+        std::unordered_map<uint32_t, uint32_t> guestHits;
+        std::unordered_map<uint32_t, uint32_t> pcHits;
+        std::unordered_map<uint64_t, uint32_t> extHits;
+        const auto *dos = reinterpret_cast<const IMAGE_DOS_HEADER *>(base);
+        const auto *nt = reinterpret_cast<const IMAGE_NT_HEADERS *>(base + dos->e_lfanew);
+        const uintptr_t imageSize = nt->OptionalHeader.SizeOfImage;
+        uint64_t total = 0;
+        ULONGLONG lastReport = GetTickCount64();
+        timeBeginPeriod(1);
+        for (;;)
+        {
+            Sleep(1);
+            if (SuspendThread(target) == static_cast<DWORD>(-1))
+                break;
+            CONTEXT context{};
+            context.ContextFlags = CONTEXT_FULL;
+            const BOOL ok = GetThreadContext(target, &context);
+            // Samples outside the exe (OS waits, CRT): walk the stack to the first exe frame
+            // so "[prof:ext]" says which runtime code is blocking.
+            uint64_t extCaller = 0;
+            if (ok && (context.Rip < base || context.Rip >= base + imageSize))
+            {
+                CONTEXT walk = context;
+                for (int depth = 0; depth < 24; ++depth)
+                {
+                    DWORD64 imageBase = 0;
+                    PRUNTIME_FUNCTION fn = RtlLookupFunctionEntry(walk.Rip, &imageBase, nullptr);
+                    if (!fn)
+                    {
+                        walk.Rip = *reinterpret_cast<DWORD64 *>(walk.Rsp);
+                        walk.Rsp += 8;
+                    }
+                    else
+                    {
+                        PVOID handlerData = nullptr;
+                        DWORD64 establisher = 0;
+                        RtlVirtualUnwind(UNW_FLAG_NHANDLER, imageBase, walk.Rip, fn, &walk, &handlerData, &establisher, nullptr);
+                    }
+                    if (walk.Rip == 0)
+                        break;
+                    if (walk.Rip >= base && walk.Rip < base + imageSize)
+                    {
+                        extCaller = walk.Rip - base;
+                        break;
+                    }
+                }
+            }
+            ResumeThread(target);
+            if (!ok)
+                continue;
+            ++hits[static_cast<uint64_t>(context.Rip - base)];
+            if (extCaller)
+                ++extHits[extCaller];
+            ++guestHits[g_ps2ProfLastGuestFn.load(std::memory_order_relaxed)];
+            if (const uint32_t *guestPc = g_ps2ProfGuestPc.load(std::memory_order_relaxed))
+                ++pcHits[*guestPc];
+            ++total;
+            if (GetTickCount64() - lastReport >= 10000)
+            {
+                lastReport = GetTickCount64();
+                std::vector<std::pair<uint64_t, uint32_t>> sorted(hits.begin(), hits.end());
+                std::sort(sorted.begin(), sorted.end(), [](const auto &a, const auto &b) { return a.second > b.second; });
+                std::fprintf(stderr, "[prof] samples=%llu\n", static_cast<unsigned long long>(total));
+                for (size_t i = 0; i < sorted.size() && i < 400; ++i)
+                    std::fprintf(stderr, "[prof] exe+0x%llX %u\n", static_cast<unsigned long long>(sorted[i].first), sorted[i].second);
+                std::vector<std::pair<uint32_t, uint32_t>> guestSorted(guestHits.begin(), guestHits.end());
+                std::sort(guestSorted.begin(), guestSorted.end(), [](const auto &a, const auto &b) { return a.second > b.second; });
+                for (size_t i = 0; i < guestSorted.size() && i < 40; ++i)
+                    std::fprintf(stderr, "[prof:guest] 0x%X %u\n", guestSorted[i].first, guestSorted[i].second);
+                std::vector<std::pair<uint32_t, uint32_t>> pcSorted(pcHits.begin(), pcHits.end());
+                std::sort(pcSorted.begin(), pcSorted.end(), [](const auto &a, const auto &b) { return a.second > b.second; });
+                for (size_t i = 0; i < pcSorted.size() && i < 40; ++i)
+                    std::fprintf(stderr, "[prof:pc] 0x%X %u\n", pcSorted[i].first, pcSorted[i].second);
+                pcHits.clear();
+                std::vector<std::pair<uint64_t, uint32_t>> extSorted(extHits.begin(), extHits.end());
+                std::sort(extSorted.begin(), extSorted.end(), [](const auto &a, const auto &b) { return a.second > b.second; });
+                for (size_t i = 0; i < extSorted.size() && i < 30; ++i)
+                    std::fprintf(stderr, "[prof:ext] exe+0x%llX %u\n", static_cast<unsigned long long>(extSorted[i].first), extSorted[i].second);
+                std::fflush(stderr);
+                hits.clear();
+                guestHits.clear();
+                extHits.clear();
+                total = 0;
+            }
+        }
+    }).detach();
+#endif
+}
+
+void ps2InstallCrashHandler(std::string (*describeGuestState)())
+{
+    g_describeGuestState = describeGuestState;
+#if defined(_WIN32)
+    SetUnhandledExceptionFilter(&unhandledFilter);
+    ULONG stackGuarantee = 64 * 1024; // room to report a stack overflow
+    SetThreadStackGuarantee(&stackGuarantee);
+#endif
+    std::set_terminate(&terminateHandler);
+}
