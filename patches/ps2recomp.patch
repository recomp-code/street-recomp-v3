+void ps2UpdateCop0Count(R5900Context *ctx)
+{
+    // The TSC is read on every guest dispatch, so it is converted to EE cycles with a ratio
+    // calibrated once against the steady clock instead of calling the clock each time.
+    struct CountClock
+    {
+        uint64_t tscBase;
+        double eeCyclesPerTick;
+        CountClock()
+        {
+            const auto t0 = std::chrono::steady_clock::now();
+            const uint64_t c0 = __rdtsc();
+            std::this_thread::sleep_for(std::chrono::milliseconds(20));
+            const auto t1 = std::chrono::steady_clock::now();
+            const uint64_t c1 = __rdtsc();
+            const double seconds = std::chrono::duration<double>(t1 - t0).count();
+            const double tscHz = (c1 > c0 && seconds > 0.0) ? static_cast<double>(c1 - c0) / seconds : 3.0e9;
+            eeCyclesPerTick = 294912000.0 / tscHz;
+            tscBase = c1;
+        }
+    };
+    static const CountClock clock;
+    ctx->cop0_count = static_cast<uint32_t>(static_cast<uint64_t>(static_cast<double>(__rdtsc() - clock.tscBase) * clock.eeCyclesPerTick));
+}
