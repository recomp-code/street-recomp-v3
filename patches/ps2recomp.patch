+// ps2recomp: minimal stand-in for PCSX2's common/BitUtils.h.
+#pragma once
+
+#include <type_traits>
+
+namespace Common
+{
+    template <typename T>
+    constexpr T AlignUpPow2(T value, unsigned int alignment)
+    {
+        return (value + static_cast<T>(alignment - 1)) & static_cast<T>(~static_cast<T>(alignment - 1));
+    }
+}
diff --git a/ps2xIOP/src/emulator/dev9/shim/common/Console.h b/ps2xIOP/src/emulator/dev9/shim/common/Console.h
