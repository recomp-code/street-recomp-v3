diff --git a/ps2xIOP/src/emulator/core/iop_dev9.cpp b/ps2xIOP/src/emulator/core/iop_dev9.cpp
new file mode 100644
index 0000000..e383599
--- /dev/null
+++ b/ps2xIOP/src/emulator/core/iop_dev9.cpp
@@ -0,0 +1,309 @@
+#include "iop_dev9.h"
+
+#include "DEV9/DEV9.h"
+#include "DEV9/net.h"
+
+#include <atomic>
+#include <cstdarg>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <string_view>
+#ifdef _WIN32
+#include <winsock2.h>
+#include <ws2tcpip.h>
+#else
+#include <arpa/inet.h>
+#include <netdb.h>
+#endif
+
+// ---- Symbols the PCSX2 DEV9 code expects from the rest of PCSX2 -------------------------------
+
+Pcsx2Config EmuConfig;
+
+extern std::mutex rx_mutex; // net.cpp: guards the SMAP RX FIFO against the receive thread
+
+namespace
+{
+    // Smallest pending interrupt delay requested by the DEV9 core (0 = none).
+    std::atomic<uint32_t> g_irqDelay{0u};
+    std::atomic<bool> g_dmaDone{false};
+    bool g_opened = false;
+
+    int readLogLevel()
+    {
+        const char *value = std::getenv("PS2X_NET_LOG");
+        if (!value || !*value)
+            return 1;
+        return std::atoi(value);
+    }
+
+    bool parseIp(std::string_view text, u8 out[4])
+    {
+        unsigned parts[4]{};
+        char tail = 0;
+        const std::string copy(text);
+        if (std::sscanf(copy.c_str(), "%u.%u.%u.%u%c", &parts[0], &parts[1], &parts[2], &parts[3], &tail) != 4)
+            return false;
+        for (int i = 0; i < 4; ++i)
+        {
+            if (parts[i] > 255u)
+                return false;
+            out[i] = static_cast<u8>(parts[i]);
+        }
+        return true;
+    }
+
+    // PS2X_NET_SERVER may be a host name (e.g. a domain for a public server): the EA host
+    // overrides need an IPv4 address, so resolve it once with the PC's own resolver.
+    std::string resolveServer(const char *server)
+    {
+        u8 probe[4];
+        if (parseIp(server, probe))
+            return server;
+#ifdef _WIN32
+        WSADATA wsa;
+        WSAStartup(MAKEWORD(2, 2), &wsa);
+#endif
+        addrinfo hints{};
+        hints.ai_family = AF_INET;
+        hints.ai_socktype = SOCK_STREAM;
+        addrinfo *result = nullptr;
+        std::string ip;
+        if (getaddrinfo(server, nullptr, &hints, &result) == 0 && result)
+        {
+            char text[INET_ADDRSTRLEN] = {};
+            inet_ntop(AF_INET, &reinterpret_cast<sockaddr_in *>(result->ai_addr)->sin_addr, text, sizeof(text));
+            ip = text;
+            freeaddrinfo(result);
+            std::fprintf(stderr, "[dev9] server %s -> %s\n", server, ip.c_str());
+        }
+        else
+        {
+            std::fprintf(stderr, "[dev9] cannot resolve server %s (no internet / DNS?)\n", server);
+        }
+        return ip;
+    }
+
+    void addHost(std::string_view name, std::string_view ip)
+    {
+        Pcsx2Config::DEV9Options::HostEntry entry;
+        entry.Url = std::string(name);
+        entry.Desc = "ps2recomp";
+        entry.Enabled = true;
+        if (!parseIp(ip, entry.Address))
+        {
+            std::fprintf(stderr, "[dev9] ignoring bad host override %.*s=%.*s\n",
+                         static_cast<int>(name.size()), name.data(), static_cast<int>(ip.size()), ip.data());
+            return;
+        }
+        std::fprintf(stderr, "[dev9] DNS override %s -> %u.%u.%u.%u\n", entry.Url.c_str(),
+                     entry.Address[0], entry.Address[1], entry.Address[2], entry.Address[3]);
+        EmuConfig.DEV9.EthHosts.push_back(entry);
+    }
+
+    void configure()
+    {
+        auto &options = EmuConfig.DEV9;
+        options = {};
+        options.EthEnable = true;
+        options.EthApi = Pcsx2Config::DEV9Options::NetApi::Sockets;
+        if (const char *adapter = std::getenv("PS2X_NET_ADAPTER"); adapter && *adapter)
+            options.EthDevice = adapter;
+        else
+            options.EthDevice = "Auto";
+        // The PS2 asks our internal DNS server, which answers the overrides below and forwards
+        // everything else to the host's resolver.
+        options.ModeDNS1 = Pcsx2Config::DEV9Options::DnsMode::Internal;
+        options.ModeDNS2 = Pcsx2Config::DEV9Options::DnsMode::Internal;
+        options.EthLogDNS = readLogLevel() >= 2;
+        options.EthLogDHCP = readLogLevel() >= 2;
+
+        if (const char *server = std::getenv("PS2X_NET_SERVER"); server && *server)
+        {
+            // Hosts the game contacts for EA Online (from the ELF's strings).
+            const std::string ip = resolveServer(server);
+            if (!ip.empty())
+                for (const char *name : {"ps2nbastreet05.ea.com", "peach.pogocorp.com", "plum.pogocorp.com",
+                                         "easo.ea.com", "demangler.ea.com"})
+                    addHost(name, ip);
+        }
+        if (const char *hosts = std::getenv("PS2X_NET_HOSTS"); hosts && *hosts)
+        {
+            std::string_view list(hosts);
+            while (!list.empty())
+            {
+                const size_t end = list.find(';');
+                const std::string_view item = list.substr(0, end);
+                const size_t eq = item.find('=');
+                if (eq != std::string_view::npos)
+                    addHost(item.substr(0, eq), item.substr(eq + 1));
+                if (end == std::string_view::npos)
+                    break;
+                list.remove_prefix(end + 1);
+            }
+        }
+    }
+}
+
+namespace ps2x::dev9
+{
+    int netLogLevel()
+    {
+        static const int level = readLogLevel();
+        return level;
+    }
+
+    void netLogV(const char *prefix, const char *fmt, va_list args)
+    {
+        char buffer[1024];
+        std::vsnprintf(buffer, sizeof(buffer), fmt, args);
+        size_t length = std::strlen(buffer);
+        while (length > 0 && (buffer[length - 1] == '\n' || buffer[length - 1] == '\r'))
+            buffer[--length] = '\0';
+        std::fprintf(stderr, "[dev9] %s%s\n", prefix, buffer);
+    }
+}
+
+void dev9Irq(int cycles)
+{
+    const uint32_t delay = static_cast<uint32_t>(cycles < 1 ? 1 : cycles);
+    uint32_t current = g_irqDelay.load(std::memory_order_relaxed);
+    while ((current == 0u || delay < current) &&
+           !g_irqDelay.compare_exchange_weak(current, delay, std::memory_order_acq_rel))
+    {
+    }
+}
+
+void psxDMA8Interrupt()
+{
+    g_dmaDone.store(true, std::memory_order_release);
+}
+
+// ---- IOP side ----------------------------------------------------------------------------------
+
+namespace ps2x::iop::detail
+{
+    bool Dev9::enabled()
+    {
+        static const bool on = []
+        {
+            const char *value = std::getenv("PS2X_NET");
+            return value && *value && *value != '0';
+        }();
+        return on;
+    }
+
+    bool Dev9::contains(uint32_t phys)
+    {
+        if (!enabled())
+            return false;
+        return (phys >= 0x10000000u && phys < 0x10020000u) || (phys & ~1u) == 0x1F80146Eu;
+    }
+
+    void Dev9::ensureOpen()
+    {
+        if (g_opened)
+            return;
+        g_opened = true;
+        configure();
+        DEV9init();
+        // Opens the sockets adapter on the IOP thread (its send path must stay on this thread).
+        DEV9open();
+        std::fprintf(stderr, "[dev9] network adapter %s\n", EmuConfig.DEV9.EthEnable ? "ready" : "FAILED");
+    }
+
+    void Dev9::reset()
+    {
+        if (!g_opened)
+            return;
+        // IOP reboot: back to power-on registers, keep the host network session.
+        std::lock_guard lock(rx_mutex);
+        u16 *eepromData = ::dev9.eeprom;
+        DEV9init();
+        ::dev9.eeprom = eepromData;
+        g_irqDelay.store(0u);
+        g_dmaDone.store(false);
+    }
+
+    uint8_t Dev9::read8(uint32_t phys)
+    {
+        ensureOpen();
+        return DEV9read8(phys);
+    }
+
+    uint16_t Dev9::read16(uint32_t phys)
+    {
+        ensureOpen();
+        return DEV9read16(phys);
+    }
+
+    uint32_t Dev9::read32(uint32_t phys)
+    {
+        ensureOpen();
+        if (phys >= 0x10000100u)
+            return DEV9read32(phys);
+        // SPEED registers are 16-bit.
+        return static_cast<uint32_t>(DEV9read16(phys)) | (static_cast<uint32_t>(DEV9read16(phys + 2u)) << 16u);
+    }
+
+    void Dev9::write8(uint32_t phys, uint8_t value)
+    {
+        ensureOpen();
+        DEV9write8(phys, value);
+    }
+
+    void Dev9::write16(uint32_t phys, uint16_t value)
+    {
+        ensureOpen();
+        DEV9write16(phys, value);
+    }
+
+    void Dev9::write32(uint32_t phys, uint32_t value)
+    {
+        ensureOpen();
+        if (phys >= 0x10000100u)
+        {
+            DEV9write32(phys, value);
+            return;
+        }
+        DEV9write16(phys, static_cast<uint16_t>(value));
+        DEV9write16(phys + 2u, static_cast<uint16_t>(value >> 16u));
+    }
+
+    bool Dev9::dma(uint8_t *memory, uint32_t bytes, bool toDevice)
+    {
+        ensureOpen();
+        g_dmaDone.store(false);
+        // PCSX2's psxDma8 passes blocks*words*8 and DEV9 halves it.
+        const int size = static_cast<int>(bytes * 2u);
+        if (toDevice)
+            DEV9writeDMA8Mem(reinterpret_cast<u32 *>(memory), size);
+        else
+            DEV9readDMA8Mem(reinterpret_cast<u32 *>(memory), size);
+        const bool done = g_dmaDone.exchange(false);
+        if (ps2x::dev9::netLogLevel() >= 2)
+            std::fprintf(stderr, "[dev9] dma ch8 %s %u bytes -> %s\n", toDevice ? "write" : "read", bytes, done ? "done" : "pending");
+        return done;
+    }
+
+    std::optional<uint64_t> Dev9::poll()
+    {
+        if (!g_opened)
+            return std::nullopt;
+        DEV9async(1);
+        const uint32_t delay = g_irqDelay.exchange(0u);
+        if (delay == 0u)
+            return std::nullopt;
+        if (ps2x::dev9::netLogLevel() >= 2)
+            std::fprintf(stderr, "[dev9] irq raised cause=%04x mask=%04x\n", ::dev9.irqcause, ::dev9.irqmask);
+        return delay;
+    }
+
+    bool Dev9::irqLevel() const
+    {
+        return g_opened && DEV9irqHandler() != 0;
+    }
+}
diff --git a/ps2xIOP/src/emulator/core/iop_dev9.h b/ps2xIOP/src/emulator/core/iop_dev9.h
new file mode 100644
index 0000000..c62ecf3
--- /dev/null
+++ b/ps2xIOP/src/emulator/core/iop_dev9.h
@@ -0,0 +1,49 @@
+#pragma once
+
+#include <cstdint>
+#include <optional>
+
+namespace ps2x::iop::detail
+{
+    // DEV9 expansion bay with the SMAP network adapter. The register model and the user-mode
+    // network stack (sockets NAT + internal DHCP/DNS) are PCSX2's DEV9 code (src/emulator/dev9);
+    // this class routes IOP accesses to it and turns its interrupts into IOP events.
+    //
+    // Disabled unless PS2X_NET=1 (then the disc's DEV9.IRX detects a CXD9611 expansion bay).
+    // PS2X_NET_HOSTS="name=a.b.c.d;..." adds DNS overrides, PS2X_NET_SERVER=a.b.c.d maps the
+    // game's EA Online hosts to that address, PS2X_NET_LOG=0/1/2 sets the log level.
+    class Dev9
+    {
+    public:
+        static constexpr int kIrqLine = 13;      // INTC line of the SPEED chip
+        static constexpr int kDmaIrq = 0x29;     // intrman number of DMA channel 8 completion
+        static constexpr uint32_t kDmaMadr = 0x1F801510u;
+        static constexpr uint32_t kDmaBcr = 0x1F801514u;
+        static constexpr uint32_t kDmaChcr = 0x1F801518u;
+
+        [[nodiscard]] static bool enabled();
+        [[nodiscard]] static bool contains(uint32_t phys);
+
+        void reset();
+
+        [[nodiscard]] uint8_t read8(uint32_t phys);
+        [[nodiscard]] uint16_t read16(uint32_t phys);
+        [[nodiscard]] uint32_t read32(uint32_t phys);
+        void write8(uint32_t phys, uint8_t value);
+        void write16(uint32_t phys, uint16_t value);
+        void write32(uint32_t phys, uint32_t value);
+
+        // DMA channel 8. Returns true when the transfer completed (DMA interrupt due).
+        bool dma(uint8_t *memory, uint32_t bytes, bool toDevice);
+
+        // Polled from the IOP scheduler: moves received frames into the SMAP interrupt cause and
+        // returns the delay (IOP cycles) of a pending DEV9 interrupt, if one was raised.
+        [[nodiscard]] std::optional<uint64_t> poll();
+        // Level of the SPEED interrupt output (cause & mask), used to re-raise an interrupt the
+        // driver left pending.
+        [[nodiscard]] bool irqLevel() const;
+
+    private:
+        void ensureOpen();
+    };
+}
