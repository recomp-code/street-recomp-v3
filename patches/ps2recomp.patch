+        // Shared area: 0x760 + core * 0x28 (MVOL, EVOL, AVOL, BVOL, ...), then SPDIF/IRQINFO.
+        constexpr uint32_t kSharedBase = 0x760u;
+        constexpr uint32_t kSharedStride = 0x28u;
+        constexpr uint32_t kRegIrqInfo = 0x7C2u;
+
+        constexpr int32_t kFilterPos[5] = {0, 60, 115, 98, 122};
+        constexpr int32_t kFilterNeg[5] = {0, 0, -52, -55, -60};
+
+        int16_t clamp16(int32_t value)
+        {
+            return static_cast<int16_t>(std::clamp(value, -32768, 32767));
+        }
+    }
+
+    Spu2::Spu2() : m_ram(kRamWords)
+    {
+        reset();
+    }
+
+    void Spu2::reset()
+    {
+        std::fill(m_ram.begin(), m_ram.end(), uint16_t{0});
+        m_raw.fill(0u);
+        for (Core &core : m_cores)
+            core = Core{};
+        m_irqInfo = 0u;
+        m_irqPending = false;
+        m_lastCycle = 0u;
+        m_cycleInitialized = false;
+    }
+
+    int32_t Spu2::volumeOf(uint16_t reg)
+    {
+        // Fixed volume: 15-bit signed value in bits 0-14. Sweep mode (bit 15) is approximated by
+        // its target magnitude, full scale.
+        if ((reg & 0x8000u) != 0u)
+            return 0x7FFF;
+        return static_cast<int16_t>(static_cast<uint16_t>(reg << 1u));
+    }
+
+    bool Spu2::autoDmaActive(int core) const
+    {
+        return m_cores[static_cast<size_t>(core) & 1u].admas != 0u;
+    }
+
+    void Spu2::checkIrq(uint32_t address)
+    {
+        address &= kRamMask;
+        for (int c = 0; c < 2; ++c)
+        {
+            const Core &core = m_cores[static_cast<size_t>(c)];
+            if ((core.attr & 0x40u) != 0u && core.irqa == address)
+            {
+                m_irqInfo |= static_cast<uint16_t>(4u << c);
+                m_irqPending = true;
+                ++m_statIrqs;
+            }
+        }
+    }
+
+    bool Spu2::takeIrq()
+    {
+        const bool pending = m_irqPending;
+        m_irqPending = false;
+        return pending;
+    }
+
+    uint16_t Spu2::read16(uint32_t phys)
+    {
+        const uint32_t offset = (phys - kBase) & 0x7FEu;
+        if (offset >= kSharedBase)
+        {
+            if (offset == kRegIrqInfo)
+            {
+                const uint16_t value = m_irqInfo;
+                m_irqInfo = 0u;
+                return value;
+            }
+            return raw(offset);
+        }
+
+        const int coreIndex = offset >= 0x400u ? 1 : 0;
+        Core &core = m_cores[static_cast<size_t>(coreIndex)];
+        const uint32_t reg = offset & 0x3FFu;
+
+        if (reg < 0x180u)
+        {
+            const Voice &voice = core.voices[reg >> 4u];
+            switch (reg & 0xFu)
+            {
+            case 0xA: return static_cast<uint16_t>(voice.env);
+            case 0xC: return static_cast<uint16_t>(voice.outVolL);
+            case 0xE: return static_cast<uint16_t>(voice.outVolR);
+            default: return raw(offset);
+            }
+        }
+        if (reg >= kRegVoiceAddr && reg < kRegVoiceAddrEnd)
+        {
+            const uint32_t rel = reg - kRegVoiceAddr;
+            const Voice &voice = core.voices[rel / 0xCu];
+            switch (rel % 0xCu)
+            {
+            case 0x0: return static_cast<uint16_t>(voice.ssa >> 16u);
+            case 0x2: return static_cast<uint16_t>(voice.ssa);
+            case 0x4: return static_cast<uint16_t>(voice.lsa >> 16u);
+            case 0x6: return static_cast<uint16_t>(voice.lsa);
+            case 0x8: return static_cast<uint16_t>(voice.nax >> 16u);
+            default: return static_cast<uint16_t>(voice.nax);
+            }
+        }
+        switch (reg)
+        {
+        case kRegIrqaHi: return static_cast<uint16_t>(core.irqa >> 16u);
+        case kRegIrqaLo: return static_cast<uint16_t>(core.irqa);
+        case kRegTsaHi: return static_cast<uint16_t>(core.tsa >> 16u);
+        case kRegTsaLo: return static_cast<uint16_t>(core.tsa);
+        case kRegData:
+        {
+            const uint16_t value = m_ram[core.tsa];
+            core.tsa = (core.tsa + 1u) & kRamMask;
+            return value;
+        }
+        case kRegAdmas: return core.admas;
+        case kRegEndxLo: return static_cast<uint16_t>(core.endx);
+        case kRegEndxHi: return static_cast<uint16_t>(core.endx >> 16u);
+        case kRegStatx: return core.statx;
+        default: return raw(offset);
+        }
+    }
+
+    void Spu2::write16(uint32_t phys, uint16_t value)
+    {
+        const uint32_t offset = (phys - kBase) & 0x7FEu;
+        raw(offset) = value;
+        if (offset >= kSharedBase)
+            return;
+
+        const int coreIndex = offset >= 0x400u ? 1 : 0;
+        Core &core = m_cores[static_cast<size_t>(coreIndex)];
+        const uint32_t reg = offset & 0x3FFu;
+
+        if (reg < 0x180u)
+        {
+            Voice &voice = core.voices[reg >> 4u];
+            switch (reg & 0xFu)
+            {
+            case 0x0: voice.volL = value; break;
+            case 0x2: voice.volR = value; break;
+            case 0x4: voice.pitch = value; break;
+            case 0x6: voice.adsr1 = value; break;
+            case 0x8: voice.adsr2 = value; break;
+            case 0xA: voice.env = std::clamp<int32_t>(static_cast<int16_t>(value), 0, 0x7FFF); break;
+            default: break;
+            }
+            return;
+        }
+        if (reg >= kRegVoiceAddr && reg < kRegVoiceAddrEnd)
+        {
+            const uint32_t rel = reg - kRegVoiceAddr;
+            Voice &voice = core.voices[rel / 0xCu];
+            switch (rel % 0xCu)
+            {
+            case 0x0: voice.ssa = setHi(voice.ssa, value); break;
+            case 0x2: voice.ssa = setLo(voice.ssa, value); break;
+            case 0x4: voice.lsa = setHi(voice.lsa, value); voice.lsaWritten = true; break;
+            case 0x6: voice.lsa = setLo(voice.lsa, value); voice.lsaWritten = true; break;
+            case 0x8: voice.nax = setHi(voice.nax, value); break;
+            default: voice.nax = setLo(voice.nax, value); break;
+            }
+            return;
+        }
+
+        switch (reg)
+        {
+        case kRegVmixlLo: core.vmixl = (core.vmixl & 0xFF0000u) | value; break;
+        case kRegVmixlHi: core.vmixl = (core.vmixl & 0xFFFFu) | ((static_cast<uint32_t>(value) & 0xFFu) << 16u); break;
+        case kRegVmixrLo: core.vmixr = (core.vmixr & 0xFF0000u) | value; break;
+        case kRegVmixrHi: core.vmixr = (core.vmixr & 0xFFFFu) | ((static_cast<uint32_t>(value) & 0xFFu) << 16u); break;
+        case kRegAttr:
+            core.attr = value;
+            if ((value & 0x40u) == 0u)
+                m_irqInfo &= static_cast<uint16_t>(~(4u << coreIndex));
+            break;
+        case kRegIrqaHi: core.irqa = setHi(core.irqa, value); break;
+        case kRegIrqaLo: core.irqa = setLo(core.irqa, value); break;
+        case kRegKon0:
+        case kRegKon1:
+            for (int bit = 0; bit < 16; ++bit)
+            {
+                const int voiceIndex = bit + (reg == kRegKon1 ? 16 : 0);
+                if ((value & (1u << bit)) != 0u && voiceIndex < 24)
+                    keyOn(core, coreIndex, voiceIndex);
+            }
+            break;
+        case kRegKof0:
+        case kRegKof1:
+            for (int bit = 0; bit < 16; ++bit)
+            {
+                const int voiceIndex = bit + (reg == kRegKof1 ? 16 : 0);
+                if ((value & (1u << bit)) != 0u && voiceIndex < 24)
+                    keyOff(core.voices[static_cast<size_t>(voiceIndex)]);
+            }
+            break;
+        case kRegTsaHi: core.tsa = setHi(core.tsa, value); break;
+        case kRegTsaLo: core.tsa = setLo(core.tsa, value); break;
+        case kRegData:
+            m_ram[core.tsa] = value;
+            checkIrq(core.tsa);
+            core.tsa = (core.tsa + 1u) & kRamMask;
+            break;
+        case kRegAdmas:
+            core.admas = value;
+            if (value == 0u)
+            {
+                core.admaL.clear();
+                core.admaR.clear();
+            }
+            break;
+        case kRegEndxLo: core.endx &= 0xFF0000u; break;
+        case kRegEndxHi: core.endx &= 0x00FFFFu; break;
+        case kRegStatx: core.statx = value; break;
+        default: break;
+        }
+    }
+
+    void Spu2::dmaWrite(int coreIndex, const uint8_t *data, uint32_t bytes)
+    {
+        Core &core = m_cores[static_cast<size_t>(coreIndex) & 1u];
+        core.statx |= 0x80u;
+        m_statDmaBytes += bytes;
+        if (core.admas != 0u)
+        {
+            // AutoDMA input: blocks of 512 bytes left channel, then 512 bytes right channel.
+            for (uint32_t chunk = 0; chunk < bytes; chunk += 1024u)
+            {
+                const uint32_t chunkBytes = std::min<uint32_t>(1024u, bytes - chunk);
+                const uint32_t half = chunkBytes / 2u;
+                for (uint32_t i = 0; i + 1u < half; i += 2u)
+                {
+                    int16_t left;
+                    std::memcpy(&left, data + chunk + i, sizeof(left));
+                    core.admaL.push_back(left);
+                    if (half + i + 1u < chunkBytes)
+                    {
+                        int16_t right;
+                        std::memcpy(&right, data + chunk + half + i, sizeof(right));
+                        core.admaR.push_back(right);
+                    }
+                }
+            }
+            // Bound the backlog (about a quarter second) so a stalled consumer cannot grow it.
+            while (core.admaL.size() > 12000u)
+                core.admaL.pop_front();
+            while (core.admaR.size() > 12000u)
+                core.admaR.pop_front();
+            return;
+        }
+
+        for (uint32_t i = 0; i + 1u < bytes; i += 2u)
+        {
+            uint16_t word;
+            std::memcpy(&word, data + i, sizeof(word));
+            m_ram[core.tsa] = word;
+            checkIrq(core.tsa);
+            core.tsa = (core.tsa + 1u) & kRamMask;
+        }
+    }
+
+    void Spu2::dmaRead(int coreIndex, uint8_t *data, uint32_t bytes)
+    {
+        Core &core = m_cores[static_cast<size_t>(coreIndex) & 1u];
+        core.statx |= 0x80u;
+        for (uint32_t i = 0; i + 1u < bytes; i += 2u)
+        {
+            const uint16_t word = m_ram[core.tsa];
+            std::memcpy(data + i, &word, sizeof(word));
+            checkIrq(core.tsa);
+            core.tsa = (core.tsa + 1u) & kRamMask;
+        }
+    }
+
+    void Spu2::keyOn(Core &core, int coreIndex, int voiceIndex)
+    {
+        (void)coreIndex;
+        Voice &voice = core.voices[static_cast<size_t>(voiceIndex)];
+        ++m_statKeyOns;
+        voice.phase = Phase::Attack;
+        voice.env = 0;
+        voice.envDelay = 0;
+        voice.blockAddr = voice.ssa & kRamMask;
+        voice.nax = voice.blockAddr;
+        voice.sampleIndex = 0;
+        voice.counter = 0;
+        voice.prev1 = 0;
+        voice.prev2 = 0;
+        voice.lsaWritten = false;
+        core.endx &= ~(1u << voiceIndex);
+        decodeBlock(voice);
+    }
+
+    void Spu2::keyOff(Voice &voice)
+    {
+        if (voice.phase != Phase::Off)
+            voice.phase = Phase::Release;
+        voice.envDelay = 0;
+    }
+
+    void Spu2::decodeBlock(Voice &voice)
+    {
+        const uint32_t base = voice.blockAddr & kRamMask;
+        for (uint32_t i = 0; i < 8u; ++i)
+            checkIrq(base + i);
+
+        const uint16_t header = m_ram[base];
+        int shift = header & 0xF;
+        if (shift > 12)
+            shift = 9;
+        int filter = (header >> 4) & 0x7;
+        if (filter > 4)
+            filter = 4;
+        voice.blockFlags = static_cast<uint8_t>(header >> 8u);
+        if ((voice.blockFlags & 0x4u) != 0u && !voice.lsaWritten)
+            voice.lsa = base;
+
+        for (int word = 0; word < 7; ++word)
+        {
+            const uint16_t packed = m_ram[(base + 1u + static_cast<uint32_t>(word)) & kRamMask];
+            for (int nibble = 0; nibble < 4; ++nibble)
+            {
+                const int16_t raw4 = static_cast<int16_t>(static_cast<uint16_t>(((packed >> (nibble * 4)) & 0xF) << 12));
+                int32_t sample = raw4 >> shift;
+                sample += (voice.prev1 * kFilterPos[filter] + voice.prev2 * kFilterNeg[filter] + 32) >> 6;
+                sample = std::clamp(sample, -32768, 32767);
+                voice.prev2 = voice.prev1;
+                voice.prev1 = sample;
+                voice.samples[static_cast<size_t>(word * 4 + nibble)] = static_cast<int16_t>(sample);
+            }
+        }
+    }
+
+    void Spu2::tickEnvelope(Voice &voice)
+    {
+        bool increase = false;
+        bool exponential = false;
+        int rate = 0x7F;
+        switch (voice.phase)
+        {
+        case Phase::Attack:
+            increase = true;
+            exponential = (voice.adsr1 & 0x8000u) != 0u;
+            rate = (voice.adsr1 >> 8u) & 0x7F;
+            break;
+        case Phase::Decay:
+            exponential = true;
+            rate = ((voice.adsr1 >> 4u) & 0xF) << 2;
+            break;
+        case Phase::Sustain:
+            increase = (voice.adsr2 & 0x4000u) == 0u;
+            exponential = (voice.adsr2 & 0x8000u) != 0u;
+            rate = (voice.adsr2 >> 6u) & 0x7F;
+            break;
+        case Phase::Release:
+            exponential = (voice.adsr2 & 0x20u) != 0u;
+            rate = (voice.adsr2 & 0x1F) << 2;
+            break;
+        case Phase::Off:
+            return;
+        }
+
+        if (rate != 0x7F || voice.phase == Phase::Release || voice.phase == Phase::Decay)
+        {
+            if (voice.envDelay > 0)
+            {
+                --voice.envDelay;
+            }
+            else
+            {
+                const int shift = rate >> 2;
+                const int32_t baseStep = increase ? (7 - (rate & 3)) : (-8 + (rate & 3));
+                int32_t cycles = 1 << std::max(0, shift - 11);
+                int32_t step = baseStep * (1 << std::max(0, 11 - shift));
+                if (exponential && increase && voice.env > 0x6000)
+                    cycles *= 4;
+                if (exponential && !increase)
+                    step = static_cast<int32_t>((static_cast<int64_t>(step) * voice.env) >> 15);
+                voice.env = std::clamp(voice.env + step, 0, 0x7FFF);
+                voice.envDelay = cycles - 1;
+            }
+        }
+
+        switch (voice.phase)
+        {
+        case Phase::Attack:
+            if (voice.env >= 0x7FFF)
+            {
+                voice.env = 0x7FFF;
+                voice.phase = Phase::Decay;
+                voice.envDelay = 0;
+            }
+            break;
+        case Phase::Decay:
+        {
+            const int32_t sustainLevel = ((voice.adsr1 & 0xF) + 1) * 0x800;
+            if (voice.env <= sustainLevel)
+            {
+                voice.phase = Phase::Sustain;
+                voice.envDelay = 0;
+            }
+            break;
+        }
+        case Phase::Release:
+            if (voice.env <= 0)
+            {
+                voice.env = 0;
+                voice.phase = Phase::Off;
+            }
+            break;
+        default:
+            break;
+        }
+    }
+
+    int32_t Spu2::renderVoice(Core &core, int coreIndex, int voiceIndex)
+    {
+        (void)coreIndex;
+        Voice &voice = core.voices[static_cast<size_t>(voiceIndex)];
+        if (voice.phase == Phase::Off)
+            return 0;
+
+        const int32_t sample = voice.samples[static_cast<size_t>(voice.sampleIndex)];
+        tickEnvelope(voice);
+        const int32_t out = (sample * voice.env) >> 15;
+
+        voice.counter += std::min<uint32_t>(voice.pitch, 0x3FFFu);
+        while (voice.counter >= 0x1000u)
+        {
+            voice.counter -= 0x1000u;
+            if (++voice.sampleIndex < 28)
+                continue;
+            voice.sampleIndex = 0;
+            const uint8_t flags = voice.blockFlags;
+            if ((flags & 0x1u) != 0u)
+            {
+                core.endx |= 1u << voiceIndex;
+                if ((flags & 0x2u) != 0u)
+                {
+                    voice.blockAddr = voice.lsa & kRamMask;
+                }
+                else
+                {
+                    // Loop end without repeat: the voice stops (and is left silent).
+                    voice.blockAddr = voice.lsa & kRamMask;
+                    voice.phase = Phase::Off;
+                    voice.env = 0;
+                }
+            }
+            else
+            {
+                voice.blockAddr = (voice.blockAddr + 8u) & kRamMask;
+            }
+            decodeBlock(voice);
+            voice.nax = voice.blockAddr;
+            if (voice.phase == Phase::Off)
+                break;
+        }
+        return out;
+    }
+
+    void Spu2::mixSample()
+    {
+        int32_t coreOutL[2] = {0, 0};
+        int32_t coreOutR[2] = {0, 0};
+        for (int c = 0; c < 2; ++c)
+        {
+            Core &core = m_cores[static_cast<size_t>(c)];
+            int32_t dryL = 0;
+            int32_t dryR = 0;
+            for (int v = 0; v < 24; ++v)
+            {
+                Voice &voice = core.voices[static_cast<size_t>(v)];
+                if (voice.phase == Phase::Off)
+                {
+                    voice.outVolL = 0;
+                    voice.outVolR = 0;
+                    continue;
+                }
+                const int32_t out = renderVoice(core, c, v);
+                const int32_t volL = volumeOf(voice.volL);
+                const int32_t volR = volumeOf(voice.volR);
+                voice.outVolL = static_cast<int16_t>(volL);
+                voice.outVolR = static_cast<int16_t>(volR);
+                if ((core.vmixl & (1u << v)) != 0u)
+                    dryL += (out * volL) >> 15;
+                if ((core.vmixr & (1u << v)) != 0u)
+                    dryR += (out * volR) >> 15;
+            }
+
+            const uint32_t shared = kSharedBase + static_cast<uint32_t>(c) * kSharedStride;
+            // AutoDMA (sound data input), BVOL.
+            if (!core.admaL.empty() || !core.admaR.empty())
+            {
+                const int32_t inL = core.admaL.empty() ? 0 : core.admaL.front();
+                const int32_t inR = core.admaR.empty() ? 0 : core.admaR.front();
+                if (!core.admaL.empty())
+                    core.admaL.pop_front();
+                if (!core.admaR.empty())
+                    core.admaR.pop_front();
+                // BVOL/AVOL are plain signed 16-bit volumes (no sweep mode).
+                dryL += (inL * static_cast<int16_t>(raw(shared + 0xC))) >> 15;
+                dryR += (inR * static_cast<int16_t>(raw(shared + 0xE))) >> 15;
+            }
+            // Core 1 receives core 0's output as its external input, AVOL.
+            if (c == 1)
+            {
+                dryL += (coreOutL[0] * static_cast<int16_t>(raw(shared + 0x8))) >> 15;
+                dryR += (coreOutR[0] * static_cast<int16_t>(raw(shared + 0xA))) >> 15;
+            }
+            // Master volume, MVOL.
+            coreOutL[c] = clamp16((dryL * volumeOf(raw(shared + 0x0))) >> 15);
+            coreOutR[c] = clamp16((dryR * volumeOf(raw(shared + 0x2))) >> 15);
+        }
+
+        m_outBlock.push_back(static_cast<int16_t>(coreOutL[1]));
+        m_outBlock.push_back(static_cast<int16_t>(coreOutR[1]));
+    }
+
+    void Spu2::advanceTo(uint64_t iopCycle)
+    {
+        if (!m_cycleInitialized)
+        {
+            m_cycleInitialized = true;
+            m_lastCycle = iopCycle;
+            return;
+        }
+        if (iopCycle <= m_lastCycle)
+            return;
+        uint64_t samples = (iopCycle - m_lastCycle) / kIopCyclesPerSample;
+        if (samples == 0u)
+            return;
+        m_lastCycle += samples * kIopCyclesPerSample;
+        // A huge jump (e.g. a long pause) only needs its recent tail rendered.
+        if (samples > 48000u)
+            samples = 48000u;
+        m_outBlock.clear();
+        m_outBlock.reserve(static_cast<size_t>(samples) * 2u);
+        for (uint64_t i = 0; i < samples; ++i)
+            mixSample();
+        ps2x::iop::pushAudioFrames(m_outBlock.data(), static_cast<size_t>(samples));
+
+        m_statSamples += samples;
+        for (size_t i = 0; i < m_outBlock.size(); ++i)
+            m_statPeak = std::max<int32_t>(m_statPeak, std::abs(static_cast<int32_t>(m_outBlock[i])));
+        if (m_statSamples >= 48000u * 5u)
+        {
+            int active = 0;
+            for (const Core &core : m_cores)
+                for (const Voice &voice : core.voices)
+                    active += voice.phase != Phase::Off ? 1 : 0;
+            std::fprintf(stderr, "[spu2] keyOns=%u active=%d admaQueued=%zu/%zu dmaBytes=%u irqs=%u peak=%d mvol0=%04x mvol1=%04x bvol0=%04x avol1=%04x attr0=%04x attr1=%04x\n",
+                         m_statKeyOns, active, m_cores[0].admaL.size(), m_cores[1].admaL.size(), m_statDmaBytes, m_statIrqs,
+                         m_statPeak, raw(kSharedBase), raw(kSharedBase + kSharedStride), raw(kSharedBase + 0xC),
+                         raw(kSharedBase + kSharedStride + 0x8), m_cores[0].attr, m_cores[1].attr);
+            m_statSamples = 0u;
+            m_statKeyOns = 0u;
+            m_statDmaBytes = 0u;
+            m_statIrqs = 0u;
+            m_statPeak = 0;
+        }
+    }
+}
