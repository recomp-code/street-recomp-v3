+namespace ps2x::iop::detail
+{
+    // SPU2, the PS2 sound processor behind the IOP: its registers, 2 MB of sound RAM, 2 cores x 24
+    // ADPCM voices with ADSR envelopes, loop/end flags (NAX/ENDX), the address IRQ, DMA and
+    // AutoDMA input, and a 48 kHz stereo mix pushed to the host audio queue (see iop_audio.h).
+    // Reverb is not emulated (dry mix only).
+    class Spu2
+    {
+    public:
+        static constexpr uint32_t kBase = 0x1F900000u;
+        static constexpr uint32_t kEnd = 0x1F900800u;
+        static constexpr uint64_t kIopCyclesPerSample = 768u; // 36.864 MHz / 48 kHz
+        static constexpr int kIrqLine = 9;
+
+        Spu2();
+        void reset();
+
+        [[nodiscard]] static bool contains(uint32_t phys) noexcept { return phys >= kBase && phys < kEnd; }
+        uint16_t read16(uint32_t phys);
+        void write16(uint32_t phys, uint16_t value);
+
+        [[nodiscard]] bool autoDmaActive(int core) const;
+        // IOP DMA channel 4 (core 0) / 7 (core 1), memory -> SPU2.
+        void dmaWrite(int core, const uint8_t *data, uint32_t bytes);
+        // SPU2 -> memory.
+        void dmaRead(int core, uint8_t *data, uint32_t bytes);
+
+        // Mixes every 48 kHz sample up to the given IOP cycle.
+        void advanceTo(uint64_t iopCycle);
+        // True once for each raised SPU2 interrupt (IOP interrupt line 9).
+        bool takeIrq();
+
+    private:
+        enum class Phase : uint8_t
+        {
+            Off,
+            Attack,
+            Decay,
+            Sustain,
+            Release,
+        };
+
+        struct Voice
+        {
+            uint16_t volL = 0;
+            uint16_t volR = 0;
+            uint16_t pitch = 0;
+            uint16_t adsr1 = 0;
+            uint16_t adsr2 = 0;
+            uint32_t ssa = 0;
+            uint32_t lsa = 0;
+            uint32_t nax = 0;
+            bool lsaWritten = false;
+
+            Phase phase = Phase::Off;
+            int32_t env = 0;
+            int32_t envDelay = 0;
+            uint32_t blockAddr = 0;
+            std::array<int16_t, 28> samples{};
+            uint8_t blockFlags = 0;
+            int sampleIndex = 0;
+            uint32_t counter = 0;
+            int32_t prev1 = 0;
+            int32_t prev2 = 0;
+            int16_t outVolL = 0;
+            int16_t outVolR = 0;
+        };
+
+        struct Core
+        {
+            std::array<Voice, 24> voices{};
+            uint32_t vmixl = 0;
+            uint32_t vmixr = 0;
+            uint16_t attr = 0;
+            uint32_t irqa = 0;
+            uint32_t tsa = 0;
+            uint16_t admas = 0;
+            uint32_t endx = 0;
+            uint16_t statx = 0;
+            std::deque<int16_t> admaL;
+            std::deque<int16_t> admaR;
+        };
+
+        uint16_t &raw(uint32_t offset) { return m_raw[(offset & 0x7FEu) >> 1u]; }
+        void keyOn(Core &core, int coreIndex, int voiceIndex);
+        void keyOff(Voice &voice);
+        void decodeBlock(Voice &voice);
+        void checkIrq(uint32_t address);
+        void tickEnvelope(Voice &voice);
+        int32_t renderVoice(Core &core, int coreIndex, int voiceIndex);
+        void mixSample();
+        static int32_t volumeOf(uint16_t reg);
+        static uint32_t setHi(uint32_t value, uint16_t hi) { return ((static_cast<uint32_t>(hi) & 0xFu) << 16u) | (value & 0xFFFFu); }
+        static uint32_t setLo(uint32_t value, uint16_t lo) { return (value & 0xF0000u) | lo; }
+
+        std::vector<uint16_t> m_ram;           // 1M 16-bit words
+        std::array<uint16_t, 0x400> m_raw{};   // register file (0x1F900000-0x1F9007FF)
+        std::array<Core, 2> m_cores{};
+        uint16_t m_irqInfo = 0;
+        bool m_irqPending = false;
+        uint64_t m_lastCycle = 0;
+        bool m_cycleInitialized = false;
+        std::vector<int16_t> m_outBlock;
+        uint64_t m_statSamples = 0u;
+        uint32_t m_statKeyOns = 0u;
+        uint32_t m_statDmaBytes = 0u;
+        uint32_t m_statIrqs = 0u;
+        int32_t m_statPeak = 0;
+    };
+}
