+
+    bool IopIoman::parsePath(const std::string &full, ParsedPath &out)
+    {
+        const size_t colon = full.find(':');
+        if (colon == std::string::npos || colon == 0)
+            return false;
+        std::string device = full.substr(0, colon);
+        size_t digits = device.size();
+        while (digits > 0 && std::isdigit(static_cast<unsigned char>(device[digits - 1])))
+            --digits;
+        out.unit = digits < device.size() ? std::atoi(device.c_str() + digits) : 0;
+        device.resize(digits);
+        for (char &c : device)
+            c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+        out.device = device;
+        out.path = full.substr(colon + 1);
+        return true;
+    }
+
+    int IopIoman::findGuestDevice(const std::string &name) const
+    {
+        // The memory card, CD and host devices are served from host files: the real MCMAN/CDVD
+        // drivers registered by the game talk to hardware (SIO2...) that is emulated at a higher
+        // level (the EE-side memory card HLE uses the same mc0 folder).
+        if (name == "mc" || name == "cdrom" || name == "host")
+            return -1;
+        for (size_t i = 0; i < m_devices.size(); ++i)
+        {
+            std::string lower = m_devices[i].name;
+            for (char &c : lower)
+                c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+            if (lower == name)
+                return static_cast<int>(i);
+        }
+        return -1;
+    }
+
+    std::string IopIoman::hostPathFor(const std::string &full) const
+    {
+        ParsedPath parsed;
+        if (!parsePath(full, parsed))
+            return {};
+        // Only the first memory card slot exists.
+        if (parsed.device == "mc" && parsed.unit != 0)
+            return {};
+        if (parsed.device != "mc" && parsed.device != "cdrom" && parsed.device != "host")
+            return {};
+        return m_host.translateGuestPath(full);
+    }
+
+    int32_t IopIoman::callDeviceOp(IopGuestExecutor &executor, size_t device, uint32_t index,
+                                   uint32_t a0, uint32_t a1, uint32_t a2, uint32_t a3)
+    {
+        const Device &d = m_devices[device];
+        const uint32_t ops = m_memory.read32(d.address + 16u);
+        const uint32_t function = ops ? m_memory.read32(ops + index * 4u) : 0u;
+        if (function == 0u)
+            return kEINVAL;
+        return static_cast<int32_t>(executor.executeGuestFunction(function, a0, a1, a2, a3, d.gp));
+    }
+
+    uint32_t IopIoman::allocateFileStruct(int unit, size_t device)
+    {
+        // iop_file_t: mode, unit, device, privdata (+ room for iomanX extensions).
+        const uint32_t address = m_memory.allocate(32u, 16u);
+        if (address == 0u)
+            return 0u;
+        (void)m_memory.zeroRam(address, 32u);
+        m_memory.write32(address + 4u, static_cast<uint32_t>(unit));
+        m_memory.write32(address + 8u, m_devices[device].address);
+        return address;
+    }
+
+    void IopIoman::writeStat(uint32_t address, const std::string &hostPath, bool directory)
+    {
+        // iox_stat_t: mode, attr, size, ctime[8], atime[8], mtime[8], hisize, private[6].
+        (void)m_memory.zeroRam(address, 64u);
+        std::error_code ec;
+        uint64_t size = 0;
+        if (!directory)
+            size = std::filesystem::file_size(hostPath, ec);
+        const uint32_t mode = (directory ? 0x1000u : 0x2000u) | 0x1FFu;
+        const uint32_t attr = directory ? 0x8427u : 0x8417u; // memory card style attributes
+        m_memory.write32(address + 0u, mode);
+        m_memory.write32(address + 4u, attr);
+        m_memory.write32(address + 8u, static_cast<uint32_t>(size));
+        const std::time_t now = std::time(nullptr);
+        std::tm tm{};
+#ifdef _WIN32
+        localtime_s(&tm, &now);
+#else
+        localtime_r(&now, &tm);
+#endif
+        for (uint32_t t = 0; t < 3; ++t)
+        {
+            const uint32_t base = address + 12u + t * 8u;
+            m_memory.write8(base + 1u, static_cast<uint8_t>(tm.tm_sec));
+            m_memory.write8(base + 2u, static_cast<uint8_t>(tm.tm_min));
+            m_memory.write8(base + 3u, static_cast<uint8_t>(tm.tm_hour));
+            m_memory.write8(base + 4u, static_cast<uint8_t>(tm.tm_mday));
+            m_memory.write8(base + 5u, static_cast<uint8_t>(tm.tm_mon + 1));
+            m_memory.write16(base + 6u, static_cast<uint16_t>(tm.tm_year + 1900));
+        }
+        m_memory.write32(address + 36u, static_cast<uint32_t>(size >> 32u));
+    }
+
+    int32_t IopIoman::open(IopGuestExecutor &executor, const std::string &full, uint32_t flags, uint32_t mode)
+    {
+        if (m_files.size() >= 64u)
+            return kEMFILE;
+        ParsedPath parsed;
+        if (!parsePath(full, parsed))
+            return kENODEV;
+
+        if (const int device = findGuestDevice(parsed.device); device >= 0)
+        {
+            const uint32_t fileStruct = allocateFileStruct(parsed.unit, static_cast<size_t>(device));
+            const uint32_t nameAddress = m_memory.allocate(static_cast<uint32_t>(parsed.path.size() + 1u), 4u);
+            if (fileStruct == 0u || nameAddress == 0u)
+                return kEMFILE;
+            m_memory.write32(fileStruct, flags);
+            (void)m_memory.writeRam(nameAddress, parsed.path.c_str(), parsed.path.size() + 1u);
+            const int32_t result = callDeviceOp(executor, static_cast<size_t>(device), kOpOpen, fileStruct, nameAddress, flags, mode);
+            (void)m_memory.freeAllocation(nameAddress);
+            if (result < 0)
+            {
+                (void)m_memory.freeAllocation(fileStruct);
+                return result;
+            }
+            OpenFile file;
+            file.guest = true;
+            file.device = static_cast<size_t>(device);
+            file.fileStruct = fileStruct;
+            const int fd = m_nextFd++;
+            m_files[fd] = std::move(file);
+            return fd;
+        }
+
+        const std::string hostPath = hostPathFor(full);
+        if (hostPath.empty())
+            return kENODEV;
+        std::error_code ec;
+        const bool exists = std::filesystem::exists(hostPath, ec);
+        if (exists && (flags & kCreate) && (flags & kExclusive))
+            return kEEXIST;
+        if (!exists && !(flags & kCreate))
+            return kENOENT;
+        if (exists && std::filesystem::is_directory(hostPath, ec))
+            return kEINVAL;
+        const char *fopenMode = "rb";
+        if (flags & kWrite)
+        {
+            if (!exists || (flags & kTruncate))
+                fopenMode = (flags & kRead) ? "w+b" : "wb";
+            else if (flags & kAppend)
+                fopenMode = (flags & kRead) ? "a+b" : "ab";
+            else
+                fopenMode = "r+b";
+        }
+        std::FILE *fp = std::fopen(hostPath.c_str(), fopenMode);
+        if (!fp)
+            return kENOENT;
+        OpenFile file;
+        file.file = fp;
+        file.hostPath = hostPath;
+        const int fd = m_nextFd++;
+        m_files[fd] = std::move(file);
+        return fd;
     }
 
