+namespace ps2x::iop
+{
+    namespace
+    {
+        // Host-facing queue of mixed audio (about one second; the oldest frames are dropped when
+        // nobody is consuming them).
+        constexpr size_t kQueueFrames = 48000u;
+        std::mutex g_audioMutex;
+        std::vector<int16_t> g_audioQueue(kQueueFrames * 2u);
+        size_t g_audioRead = 0u;  // in frames
+        size_t g_audioCount = 0u; // in frames
+
+        void pushAudioFrames(const int16_t *samples, size_t frames)
+        {
+            std::lock_guard<std::mutex> lock(g_audioMutex);
+            for (size_t i = 0; i < frames; ++i)
+            {
+                if (g_audioCount == kQueueFrames)
+                {
+                    g_audioRead = (g_audioRead + 1u) % kQueueFrames;
+                    --g_audioCount;
+                }
+                const size_t slot = (g_audioRead + g_audioCount) % kQueueFrames;
+                g_audioQueue[slot * 2u] = samples[i * 2u];
+                g_audioQueue[slot * 2u + 1u] = samples[i * 2u + 1u];
+                ++g_audioCount;
+            }
+        }
+    }
+
+    size_t readAudioFrames(int16_t *dst, size_t frames)
+    {
+        std::lock_guard<std::mutex> lock(g_audioMutex);
+        const size_t count = std::min(frames, g_audioCount);
+        for (size_t i = 0; i < count; ++i)
+        {
+            const size_t slot = (g_audioRead + i) % kQueueFrames;
+            dst[i * 2u] = g_audioQueue[slot * 2u];
+            dst[i * 2u + 1u] = g_audioQueue[slot * 2u + 1u];
+        }
+        g_audioRead = (g_audioRead + count) % kQueueFrames;
+        g_audioCount -= count;
+        return count;
+    }
+
+    size_t queuedAudioFrames()
+    {
+        std::lock_guard<std::mutex> lock(g_audioMutex);
+        return g_audioCount;
+    }
+}
