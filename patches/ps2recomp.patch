+    std::string IopKernel::describeThreads() const
+    {
+        std::string out;
+        char item[128];
+        for (const auto &[id, thread] : m_threads)
+        {
+            std::snprintf(item, sizeof(item), "{%d st=%u pc=0x%x ra=0x%x wait=%d prio=%u entry=0x%x}",
+                          id, static_cast<unsigned>(thread.state), thread.cpu.pc, thread.cpu.gpr[31],
+                          thread.waitId, thread.priority, thread.entry);
+            out += item;
+        }
+        return out;
+    }
