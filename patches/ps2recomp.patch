+                case 18: SET_GPR_VEC(ctx, rd, _mm_or_si128(a, b)); return;        // POR
+                case 19: SET_GPR_VEC(ctx, rd, _mm_xor_si128(_mm_or_si128(a, b), _mm_set1_epi32(-1))); return; // PNOR
+                case 26: SET_GPR_VEC(ctx, rd, _mm_shufflehi_epi16(_mm_shufflelo_epi16(b, 0xD8), 0xD8)); return; // PEXCH
+                case 27: SET_GPR_VEC(ctx, rd, _mm_shufflehi_epi16(_mm_shufflelo_epi16(b, 0x00), 0x00)); return; // PCPYH
+                case 30: SET_GPR_VEC(ctx, rd, _mm_shuffle_epi32(b, 0xD8)); return; // PEXCW
+                default: break;
+                }
+                break;
+            default:
+                break;
+            }
+            if (!abortIfVerifying()) reportUnimplemented(ctx, pc, insn, "MMI");
+        }
+
+        void Interpreter::executeCop0(uint32_t pc, uint32_t insn)
+        {
+            const uint32_t rt = rtOf(insn), rd = rdOf(insn);
+            switch (rsOf(insn))
+            {
+            case 0x00: // MFC0
+            {
+                uint32_t value = 0u;
+                switch (rd)
+                {
+                case 8: value = ctx->cop0_badvaddr; break;
+                case 9: ps2UpdateCop0Count(ctx); value = ctx->cop0_count; break;
+                case 11: value = ctx->cop0_compare; break;
+                case 12: value = ctx->cop0_status; break;
+                case 13: value = ctx->cop0_cause; break;
+                case 14: value = ctx->cop0_epc; break;
+                case 15: value = ctx->cop0_prid; break;
+                case 16: value = ctx->cop0_config; break;
+                case 30: value = ctx->cop0_errorepc; break;
+                default: break;
+                }
+                SET_GPR_S32(ctx, rt, (int32_t)value);
+                return;
+            }
+            case 0x04: // MTC0
+            {
+                const uint32_t value = GPR_U32(ctx, rt);
+                switch (rd)
+                {
+                case 9: ctx->cop0_count = value; break;
+                case 11: ctx->cop0_compare = value; break;
+                case 12: ctx->cop0_status = value; break;
+                case 13: ctx->cop0_cause = value; break;
+                case 14: ctx->cop0_epc = value; break;
+                case 30: ctx->cop0_errorepc = value; break;
+                default: break;
+                }
+                return;
+            }
+            case 0x10: // C0
+                switch (insn & 0x3Fu)
+                {
+                case 0x38: ctx->cop0_status |= 0x10000u; return;  // EI
+                case 0x39: ctx->cop0_status &= ~0x10000u; return; // DI
+                case 0x02: case 0x06: case 0x08: return;          // TLBWI/TLBWR/TLBP
+                default: break;
+                }
+                break;
+            default:
+                break;
+            }
+            if (!abortIfVerifying()) reportUnimplemented(ctx, pc, insn, "COP0");
+        }
+
+        void Interpreter::executeCop1(uint32_t pc, uint32_t insn)
+        {
+            const uint32_t fmt = rsOf(insn);
+            const uint32_t ft = rtOf(insn), fs = rdOf(insn), fd = saOf(insn);
+            switch (fmt)
+            {
+            case 0x00: // MFC1
+            {
+                uint32_t bits;
+                std::memcpy(&bits, &ctx->f[fs], sizeof(bits));
+                SET_GPR_S32(ctx, ft, (int32_t)bits);
+                return;
+            }
+            case 0x02: // CFC1
+                SET_GPR_S32(ctx, ft, (int32_t)(fs == 31u ? ctx->fcr31 : (fs == 0u ? 0x2E00u : 0u)));
+                return;
+            case 0x04: // MTC1
+            {
+                const uint32_t bits = GPR_U32(ctx, ft);
+                std::memcpy(&ctx->f[fs], &bits, sizeof(bits));
+                return;
+            }
+            case 0x06: // CTC1
+                if (fs == 31u)
+                    ctx->fcr31 = GPR_U32(ctx, ft);
+                return;
+            case 0x10: // S
+            {
+                const float s = ctx->f[fs], t = ctx->f[ft];
+                switch (insn & 0x3Fu)
+                {
+                case 0x00: ctx->f[fd] = FPU_ADD_S(s, t); return;
+                case 0x01: ctx->f[fd] = FPU_SUB_S(s, t); return;
+                case 0x02: ctx->f[fd] = FPU_MUL_S(s, t); return;
+                case 0x03: ctx->f[fd] = (t != 0.0f) ? FPU_DIV_S(s, t) : ((std::signbit(s) != std::signbit(t)) ? -3.4028235e38f : 3.4028235e38f); return;
+                case 0x04: ctx->f[fd] = FPU_SQRT_S(std::fabs(t)); return;
+                case 0x05: ctx->f[fd] = FPU_ABS_S(s); return;
+                case 0x06: ctx->f[fd] = s; return;
+                case 0x07: ctx->f[fd] = FPU_NEG_S(s); return;
+                case 0x16: ctx->f[fd] = (t != 0.0f) ? s / std::sqrt(std::fabs(t)) : 3.4028235e38f; return; // RSQRT
+                case 0x18: ctx->f_acc = s + t; return;  // ADDA
+                case 0x19: ctx->f_acc = s - t; return;  // SUBA
+                case 0x1A: ctx->f_acc = s * t; return;  // MULA
+                case 0x1C: ctx->f[fd] = ctx->f_acc + s * t; return; // MADD
+                case 0x1D: ctx->f[fd] = ctx->f_acc - s * t; return; // MSUB
+                case 0x1E: ctx->f_acc = ctx->f_acc + s * t; return; // MADDA
+                case 0x1F: ctx->f_acc = ctx->f_acc - s * t; return; // MSUBA
+                case 0x24: // CVT.W.S
+                {
+                    int32_t value;
+                    if (s >= 2147483647.0f)
+                        value = INT32_MAX;
+                    else if (s <= -2147483648.0f)
+                        value = INT32_MIN;
+                    else
+                        value = (int32_t)s;
+                    std::memcpy(&ctx->f[fd], &value, sizeof(value));
+                    return;
+                }
+                case 0x28: ctx->f[fd] = s > t ? s : t; return; // MAX
+                case 0x29: ctx->f[fd] = s < t ? s : t; return; // MIN
+                case 0x30: setFpuCondition(false); return;     // C.F
+                case 0x32: setFpuCondition(s == t); return;    // C.EQ
+                case 0x34: setFpuCondition(s < t); return;     // C.LT
+                case 0x36: setFpuCondition(s <= t); return;    // C.LE
+                default: break;
+                }
+                break;
+            }
+            case 0x14: // W
+                if ((insn & 0x3Fu) == 0x20u) // CVT.S.W
+                {
+                    int32_t value;
+                    std::memcpy(&value, &ctx->f[fs], sizeof(value));
+                    ctx->f[fd] = (float)value;
+                    return;
+                }
+                break;
+            default:
+                break;
+            }
+            if (!abortIfVerifying()) reportUnimplemented(ctx, pc, insn, "COP1");
+        }
+
+        // VU0 floats never hold infinities or NaNs: overflow saturates to +/-FLT_MAX.
+        inline float vuFix(float value)
+        {
+            if (!std::isfinite(value))
+                return std::signbit(value) ? -3.4028235e38f : 3.4028235e38f;
+            return value;
+        }
+
+        void Interpreter::executeCop2(uint32_t pc, uint32_t insn)
+        {
+            const uint32_t rt = rtOf(insn), rd = rdOf(insn);
+            if ((insn & 0x02000000u) == 0u)
+            {
+                switch (rsOf(insn))
+                {
+                case 0x01: SET_GPR_VEC(ctx, rt, _mm_castps_si128(ctx->vu0_vf[rd])); return; // QMFC2
+                case 0x02:                                                                     // CFC2
+                {
+                    uint32_t value = 0u;
+                    if (rd < 16u)
+                        value = ctx->vi[rd];
+                    else if (rd == 16u)
+                        value = ctx->vu0_status;
+                    else if (rd == 17u)
+                        value = ctx->vu0_mac_flags;
+                    else if (rd == 18u)
+                        value = ctx->vu0_clip_flags & 0xFFFFFFu;
+                    else if (rd == 21u)
+                        std::memcpy(&value, &ctx->vu0_i, sizeof(value));
+                    else if (rd == 22u)
+                        std::memcpy(&value, &ctx->vu0_q, sizeof(value));
+                    else if (abortIfVerifying())
+                        return;
+                    SET_GPR_S32(ctx, rt, (int32_t)value);
+                    return;
+                }
+                case 0x05: // QMTC2
+                    if (rd != 0u)
+                        ctx->vu0_vf[rd] = _mm_castsi128_ps(GPR_VEC(ctx, rt));
+                    return;
+                case 0x06: // CTC2
+                {
+                    const uint32_t value = GPR_U32(ctx, rt);
+                    if (rd > 0u && rd < 16u)
+                        ctx->vi[rd] = (uint16_t)value;
+                    else if (rd == 16u)
+                        ctx->vu0_status = (uint16_t)value;
+                    else if (rd == 18u)
+                        ctx->vu0_clip_flags = value & 0xFFFFFFu;
+                    else if (rd == 21u)
+                        std::memcpy(&ctx->vu0_i, &value, sizeof(value));
+                    else if (rd == 22u)
+                        std::memcpy(&ctx->vu0_q, &value, sizeof(value));
+                    else if (rd != 0u && abortIfVerifying())
+                        return;
+                    return;
+                }
+                default:
+                    break;
+                }
+                if (!abortIfVerifying())
+                    reportUnimplemented(ctx, pc, insn, "COP2");
+                return;
+            }
+
+            // ---- VU0 macro operations ----
+            const uint32_t dest = (insn >> 21) & 0xFu; // bit3 = x, bit2 = y, bit1 = z, bit0 = w
+            const uint32_t ft = rt, fs = rd, fd = saOf(insn);
+            const uint32_t funct = insn & 0x3Fu;
+            auto load = [&](uint32_t reg, float out[4])
+            {
+                if (reg == 0u)
+                {
+                    out[0] = 0.0f; out[1] = 0.0f; out[2] = 0.0f; out[3] = 1.0f;
+                    return;
+                }
+                std::memcpy(out, &ctx->vu0_vf[reg], 16);
+            };
+            auto store = [&](uint32_t reg, const float in[4])
+            {
+                if (reg == 0u)
+                    return;
+                float cur[4];
+                std::memcpy(cur, &ctx->vu0_vf[reg], 16);
+                for (int i = 0; i < 4; ++i)
+                    if ((dest >> (3 - i)) & 1u)
+                        cur[i] = in[i];
+                std::memcpy(&ctx->vu0_vf[reg], cur, 16);
+            };
+            auto storeAcc = [&](const float in[4])
+            {
+                float cur[4];
+                std::memcpy(cur, &ctx->vu0_acc, 16);
+                for (int i = 0; i < 4; ++i)
+                    if ((dest >> (3 - i)) & 1u)
+                        cur[i] = in[i];
+                std::memcpy(&ctx->vu0_acc, cur, 16);
+            };
+            float s[4], t[4], acc[4], r[4];
+            load(fs, s);
+            load(ft, t);
+            std::memcpy(acc, &ctx->vu0_acc, 16);
+            const float q = ctx->vu0_q;
+            const float iv = ctx->vu0_i;
+
+            // kind: 0 add, 1 sub, 2 madd (acc + s*b), 3 msub (acc - s*b), 4 max, 5 min, 6 mul
+            auto arith = [&](int kind, const float b[4], float out[4])
+            {
+                for (int i = 0; i < 4; ++i)
+                {
+                    float v = 0.0f;
+                    switch (kind)
+                    {
+                    case 0: v = s[i] + b[i]; break;
+                    case 1: v = s[i] - b[i]; break;
+                    case 2: v = acc[i] + s[i] * b[i]; break;
+                    case 3: v = acc[i] - s[i] * b[i]; break;
+                    case 4: v = std::max(s[i], b[i]); break;
+                    case 5: v = std::min(s[i], b[i]); break;
+                    default: v = s[i] * b[i]; break;
+                    }
+                    out[i] = vuFix(v);
+                }
+            };
+            auto splat = [](float v, float out[4]) { out[0] = out[1] = out[2] = out[3] = v; };
+
+            if (funct < 0x3Cu)
+            {
+                float b[4];
+                if (funct < 0x1Cu)
+                {
+                    splat(t[funct & 3u], b);
+                    static const int kKinds[7] = {0, 1, 2, 3, 4, 5, 6};
+                    arith(kKinds[funct >> 2], b, r);
+                    store(fd, r);
+                    return;
+                }
+                switch (funct)
+                {
+                case 0x1C: splat(q, b); arith(6, b, r); store(fd, r); return;  // VMULq
+                case 0x1D: splat(iv, b); arith(4, b, r); store(fd, r); return; // VMAXi
+                case 0x1E: splat(iv, b); arith(6, b, r); store(fd, r); return; // VMULi
+                case 0x1F: splat(iv, b); arith(5, b, r); store(fd, r); return; // VMINIi
+                case 0x20: splat(q, b); arith(0, b, r); store(fd, r); return;  // VADDq
+                case 0x21: splat(q, b); arith(2, b, r); store(fd, r); return;  // VMADDq
+                case 0x22: splat(iv, b); arith(0, b, r); store(fd, r); return; // VADDi
+                case 0x23: splat(iv, b); arith(2, b, r); store(fd, r); return; // VMADDi
+                case 0x24: splat(q, b); arith(1, b, r); store(fd, r); return;  // VSUBq
+                case 0x25: splat(q, b); arith(3, b, r); store(fd, r); return;  // VMSUBq
+                case 0x26: splat(iv, b); arith(1, b, r); store(fd, r); return; // VSUBi
+                case 0x27: splat(iv, b); arith(3, b, r); store(fd, r); return; // VMSUBi
+                case 0x28: arith(0, t, r); store(fd, r); return;               // VADD
+                case 0x29: arith(2, t, r); store(fd, r); return;               // VMADD
+                case 0x2A: arith(6, t, r); store(fd, r); return;               // VMUL
+                case 0x2B: arith(4, t, r); store(fd, r); return;               // VMAX
+                case 0x2C: arith(1, t, r); store(fd, r); return;               // VSUB
+                case 0x2D: arith(3, t, r); store(fd, r); return;               // VMSUB
+                case 0x2E:                                                     // VOPMSUB
+                    r[0] = vuFix(acc[0] - s[1] * t[2]);
+                    r[1] = vuFix(acc[1] - s[2] * t[0]);
+                    r[2] = vuFix(acc[2] - s[0] * t[1]);
+                    r[3] = 0.0f;
+                    store(fd, r);
+                    return;
+                case 0x2F: arith(5, t, r); store(fd, r); return; // VMINI
+                case 0x30: if ((fd & 15u) != 0u) ctx->vi[fd & 15u] = (uint16_t)(ctx->vi[fs & 15u] + ctx->vi[ft & 15u]); return; // VIADD
+                case 0x31: if ((fd & 15u) != 0u) ctx->vi[fd & 15u] = (uint16_t)(ctx->vi[fs & 15u] - ctx->vi[ft & 15u]); return; // VISUB
+                case 0x32:                                                                                                    // VIADDI
+                {
+                    const int32_t imm5 = (fd & 0x10u) ? (int32_t)(fd | ~0x1Fu) : (int32_t)fd;
+                    if ((ft & 15u) != 0u)
+                        ctx->vi[ft & 15u] = (uint16_t)(ctx->vi[fs & 15u] + imm5);
+                    return;
+                }
+                case 0x34: if ((fd & 15u) != 0u) ctx->vi[fd & 15u] = (uint16_t)(ctx->vi[fs & 15u] & ctx->vi[ft & 15u]); return; // VIAND
+                case 0x35: if ((fd & 15u) != 0u) ctx->vi[fd & 15u] = (uint16_t)(ctx->vi[fs & 15u] | ctx->vi[ft & 15u]); return; // VIOR
+                case 0x38: // VCALLMS
+                    if (abortIfVerifying())
+                        return;
+                    runtime->vu0StartMicroProgram(rdram, ctx, ((insn >> 6) & 0x7FFFu) << 3);
+                    return;
+                case 0x39: // VCALLMSR
+                    if (abortIfVerifying())
+                        return;
+                    runtime->vu0StartMicroProgram(rdram, ctx, (uint32_t)ctx->vu0_cmsar0 << 3);
+                    return;
+                default:
+                    break;
+                }
+            }
+            else
+            {
+                const uint32_t op2 = (((insn >> 6) & 0x1Fu) << 2) | (insn & 3u);
+                float b[4];
+                if (op2 < 0x10u || (op2 >= 0x18u && op2 < 0x1Cu))
+                {
+                    splat(t[op2 & 3u], b);
+                    const uint32_t group = op2 >> 2; // 0 adda, 1 suba, 2 madda, 3 msuba, 6 mula
+                    const int kind = group == 0u ? 0 : group == 1u ? 1 : group == 2u ? 2 : group == 3u ? 3 : 6;
+                    arith(kind, b, r);
+                    storeAcc(r);
+                    return;
+                }
+                switch (op2)
+                {
+                case 0x10: case 0x11: case 0x12: case 0x13: // VITOF0/4/12/15
+                {
+                    static const float kScale[4] = {1.0f, 1.0f / 16.0f, 1.0f / 4096.0f, 1.0f / 32768.0f};
+                    int32_t bits[4];
+                    std::memcpy(bits, s, 16);
+                    for (int i = 0; i < 4; ++i)
+                        r[i] = (float)bits[i] * kScale[op2 & 3u];
+                    store(ft, r);
+                    return;
+                }
+                case 0x14: case 0x15: case 0x16: case 0x17: // VFTOI0/4/12/15
+                {
+                    static const float kScale[4] = {1.0f, 16.0f, 4096.0f, 32768.0f};
+                    int32_t bits[4];
+                    for (int i = 0; i < 4; ++i)
+                    {
+                        const float v = s[i] * kScale[op2 & 3u];
+                        bits[i] = v >= 2147483647.0f ? INT32_MAX : v <= -2147483648.0f ? INT32_MIN : (int32_t)v;
+                    }
+                    std::memcpy(r, bits, 16);
+                    store(ft, r);
+                    return;
+                }
+                case 0x1C: splat(q, b); arith(6, b, r); storeAcc(r); return;     // VMULAq
+                case 0x1D: for (int i = 0; i < 4; ++i) r[i] = std::fabs(s[i]); store(ft, r); return; // VABS
+                case 0x1E: splat(iv, b); arith(6, b, r); storeAcc(r); return;    // VMULAi
+                case 0x1F:                                                       // VCLIPw
+                {
+                    const float w = std::fabs(t[3]);
+                    uint32_t flags = 0u;
+                    for (int i = 0; i < 3; ++i)
+                    {
+                        if (s[i] > w) flags |= 1u << (i * 2);
+                        if (s[i] < -w) flags |= 2u << (i * 2);
+                    }
+                    ctx->vu0_clip_flags = ((ctx->vu0_clip_flags << 6) | flags) & 0xFFFFFFu;
+                    return;
+                }
+                case 0x20: splat(q, b); arith(0, b, r); storeAcc(r); return;  // VADDAq
+                case 0x21: splat(q, b); arith(2, b, r); storeAcc(r); return;  // VMADDAq
+                case 0x22: splat(iv, b); arith(0, b, r); storeAcc(r); return; // VADDAi
+                case 0x23: splat(iv, b); arith(2, b, r); storeAcc(r); return; // VMADDAi
+                case 0x24: splat(q, b); arith(1, b, r); storeAcc(r); return;  // VSUBAq
+                case 0x25: splat(q, b); arith(3, b, r); storeAcc(r); return;  // VMSUBAq
+                case 0x26: splat(iv, b); arith(1, b, r); storeAcc(r); return; // VSUBAi
+                case 0x27: splat(iv, b); arith(3, b, r); storeAcc(r); return; // VMSUBAi
+                case 0x28: arith(0, t, r); storeAcc(r); return;               // VADDA
+                case 0x29: arith(2, t, r); storeAcc(r); return;               // VMADDA
+                case 0x2A: arith(6, t, r); storeAcc(r); return;               // VMULA
+                case 0x2C: arith(1, t, r); storeAcc(r); return;               // VSUBA
+                case 0x2D: arith(3, t, r); storeAcc(r); return;               // VMSUBA
+                case 0x2E:                                                    // VOPMULA
+                    r[0] = vuFix(s[1] * t[2]);
+                    r[1] = vuFix(s[2] * t[0]);
+                    r[2] = vuFix(s[0] * t[1]);
+                    r[3] = acc[3];
+                    storeAcc(r);
+                    return;
+                case 0x2F: return; // VNOP
+                case 0x30: store(ft, s); return; // VMOVE
+                case 0x31:                       // VMR32
+                    r[0] = s[1]; r[1] = s[2]; r[2] = s[3]; r[3] = s[0];
+                    store(ft, r);
+                    return;
+                case 0x38: // VDIV Q, fs.fsf, ft.ftf
+                case 0x39: // VSQRT Q, ft.ftf
+                case 0x3A: // VRSQRT Q, fs.fsf, ft.ftf
+                {
+                    const float num = s[(insn >> 21) & 3u];
+                    const float den = t[(insn >> 23) & 3u];
+                    if (op2 == 0x39u)
+                        ctx->vu0_q = std::sqrt(std::fabs(den));
+                    else if (op2 == 0x38u)
+                        ctx->vu0_q = den != 0.0f ? vuFix(num / den) : ((std::signbit(num) != std::signbit(den)) ? -3.4028235e38f : 3.4028235e38f);
+                    else
+                        ctx->vu0_q = den != 0.0f ? vuFix(num / std::sqrt(std::fabs(den))) : (std::signbit(num) ? -3.4028235e38f : 3.4028235e38f);
+                    return;
+                }
+                case 0x3B: return; // VWAITQ
+                case 0x3C:         // VMTIR it, fs.fsf
+                {
+                    uint32_t bits;
+                    std::memcpy(&bits, &s[(insn >> 21) & 3u], sizeof(bits));
+                    if ((ft & 15u) != 0u)
+                        ctx->vi[ft & 15u] = (uint16_t)bits;
+                    return;
+                }
+                case 0x3D: // VMFIR ft, is
+                {
+                    const int32_t value = (int16_t)ctx->vi[fs & 15u];
+                    float fv;
+                    std::memcpy(&fv, &value, sizeof(fv));
+                    splat(fv, r);
+                    store(ft, r);
+                    return;
+                }
+                default:
+                    break;
+                }
+            }
+            if (!abortIfVerifying())
+                reportUnimplemented(ctx, pc, insn, "VU0 macro");
+        }
+
+        void Interpreter::executeSimple(uint32_t pc, uint32_t insn)
+        {
+            const uint32_t rs = rsOf(insn), rt = rtOf(insn);
+            const uint32_t addr = ADD32(GPR_U32(ctx, rs), (uint32_t)simm(insn));
+            switch (insn >> 26)
+            {
+            case 0x00: executeSpecial(pc, insn); return;
+            case 0x08: // ADDI
+            case 0x09: SET_GPR_S32(ctx, rt, (int32_t)ADD32(GPR_U32(ctx, rs), (uint32_t)simm(insn))); return; // ADDIU
+            case 0x0A: SET_GPR_U64(ctx, rt, GPR_S64(ctx, rs) < (int64_t)simm(insn) ? 1u : 0u); return;      // SLTI
+            case 0x0B: SET_GPR_U64(ctx, rt, GPR_U64(ctx, rs) < (uint64_t)(int64_t)simm(insn) ? 1u : 0u); return; // SLTIU
+            case 0x0C: SET_GPR_U64(ctx, rt, GPR_U64(ctx, rs) & uimm(insn)); return;
+            case 0x0D: SET_GPR_U64(ctx, rt, GPR_U64(ctx, rs) | uimm(insn)); return;
+            case 0x0E: SET_GPR_U64(ctx, rt, GPR_U64(ctx, rs) ^ uimm(insn)); return;
+            case 0x0F: SET_GPR_S32(ctx, rt, (int32_t)(uimm(insn) << 16)); return; // LUI
+            case 0x10: executeCop0(pc, insn); return;
+            case 0x11: executeCop1(pc, insn); return;
+            case 0x12: executeCop2(pc, insn); return;
+            case 0x18: // DADDI
+            case 0x19: SET_GPR_U64(ctx, rt, GPR_U64(ctx, rs) + (uint64_t)(int64_t)simm(insn)); return; // DADDIU
+            case 0x1A: // LDL
+            {
+                const uint32_t offset = addr & 7u;
+                const uint64_t memValue = mem->read64(addr & ~7u);
+                const uint32_t shift = (7u - offset) << 3;
+                const uint64_t keep = shift == 0 ? 0ull : ((1ull << shift) - 1ull);
+                SET_GPR_U64(ctx, rt, (GPR_U64(ctx, rt) & keep) | (memValue << shift));
+                return;
+            }
+            case 0x1B: // LDR
+            {
+                const uint32_t offset = addr & 7u;
+                const uint64_t memValue = mem->read64(addr & ~7u);
+                const uint32_t shift = offset << 3;
+                const uint64_t keep = shift == 0 ? 0ull : ~(~0ull >> shift);
+                SET_GPR_U64(ctx, rt, (GPR_U64(ctx, rt) & keep) | (memValue >> shift));
+                return;
+            }
+            case 0x1C: executeMmi(pc, insn); return;
+            case 0x1E: SET_GPR_VEC(ctx, rt, mem->read128(addr)); return; // LQ
+            case 0x1F: mem->write128(addr, GPR_VEC(ctx, rt)); return;    // SQ
+            case 0x20: SET_GPR_S32(ctx, rt, (int32_t)(int8_t)mem->read8(addr)); return;
+            case 0x21: SET_GPR_S32(ctx, rt, (int32_t)(int16_t)mem->read16(addr)); return;
+            case 0x22: // LWL
+            {
+                const uint32_t offset = addr & 3u;
+                const uint32_t memValue = mem->read32(addr & ~3u);
+                const uint32_t shift = (3u - offset) << 3;
+                const uint32_t keep = shift == 0 ? 0u : ((1u << shift) - 1u);
+                SET_GPR_S32(ctx, rt, (int32_t)((GPR_U32(ctx, rt) & keep) | (memValue << shift)));
+                return;
+            }
+            case 0x23: SET_GPR_S32(ctx, rt, (int32_t)mem->read32(addr)); return;
+            case 0x24: SET_GPR_U64(ctx, rt, (uint64_t)mem->read8(addr)); return;
+            case 0x25: SET_GPR_U64(ctx, rt, (uint64_t)mem->read16(addr)); return;
+            case 0x26: // LWR
+            {
+                const uint32_t offset = addr & 3u;
+                const uint32_t memValue = mem->read32(addr & ~3u);
+                const uint32_t shift = offset << 3;
+                const uint32_t keep = shift == 0 ? 0u : ~(0xFFFFFFFFu >> shift);
+                const uint32_t merged = (GPR_U32(ctx, rt) & keep) | (memValue >> shift);
+                if (offset == 0u)
+                    SET_GPR_S32(ctx, rt, (int32_t)merged);
+                else
+                    SET_GPR_U64(ctx, rt, (GPR_U64(ctx, rt) & 0xFFFFFFFF00000000ull) | merged);
+                return;
+            }
+            case 0x27: SET_GPR_U64(ctx, rt, (uint64_t)mem->read32(addr)); return; // LWU
+            case 0x28: mem->write8(addr, (uint8_t)GPR_U32(ctx, rt)); return;
+            case 0x29: mem->write16(addr, (uint16_t)GPR_U32(ctx, rt)); return;
+            case 0x2A: // SWL
+            {
+                const uint32_t aligned = addr & ~3u, offset = addr & 3u;
+                const uint32_t memValue = mem->read32(aligned);
+                const uint32_t shift = (3u - offset) << 3;
+                const uint32_t keep = offset == 3u ? 0u : ~(0xFFFFFFFFu >> shift);
+                mem->write32(aligned, (memValue & keep) | (GPR_U32(ctx, rt) >> shift));
+                return;
+            }
+            case 0x2B: mem->write32(addr, GPR_U32(ctx, rt)); return;
+            case 0x2C: // SDL
+            {
+                const uint32_t aligned = addr & ~7u, offset = addr & 7u;
+                const uint64_t memValue = mem->read64(aligned);
+                const uint32_t shift = (7u - offset) << 3;
+                const uint64_t keep = offset == 7u ? 0ull : ~(~0ull >> shift);
+                mem->write64(aligned, (memValue & keep) | (GPR_U64(ctx, rt) >> shift));
+                return;
+            }
+            case 0x2D: // SDR
+            {
+                const uint32_t aligned = addr & ~7u, offset = addr & 7u;
+                const uint64_t memValue = mem->read64(aligned);
+                const uint32_t shift = offset << 3;
+                const uint64_t keep = shift == 0 ? 0ull : ((1ull << shift) - 1ull);
+                mem->write64(aligned, (memValue & keep) | (GPR_U64(ctx, rt) << shift));
+                return;
+            }
+            case 0x2E: // SWR
+            {
+                const uint32_t aligned = addr & ~3u, offset = addr & 3u;
+                const uint32_t memValue = mem->read32(aligned);
+                const uint32_t shift = offset << 3;
+                const uint32_t keep = shift == 0 ? 0u : ((1u << shift) - 1u);
+                mem->write32(aligned, (memValue & keep) | (GPR_U32(ctx, rt) << shift));
+                return;
+            }
+            case 0x2F: return; // CACHE
+            case 0x31:         // LWC1
+            {
+                const uint32_t bits = mem->read32(addr);
+                std::memcpy(&ctx->f[rt], &bits, sizeof(bits));
+                return;
+            }
+            case 0x33: return; // PREF
+            case 0x36:         // LQC2
+                if (rt != 0u)
+                    ctx->vu0_vf[rt] = _mm_castsi128_ps(mem->read128(addr));
+                return;
+            case 0x37: SET_GPR_U64(ctx, rt, mem->read64(addr)); return; // LD
+            case 0x39:                                            // SWC1
+            {
+                uint32_t bits;
+                std::memcpy(&bits, &ctx->f[rt], sizeof(bits));
+                mem->write32(addr, bits);
+                return;
+            }
+            case 0x3E: mem->write128(addr, _mm_castps_si128(ctx->vu0_vf[rt])); return; // SQC2
+            case 0x3F: mem->write64(addr, GPR_U64(ctx, rt)); return;                    // SD
+            default:
+                break;
+            }
+            if (!abortIfVerifying()) reportUnimplemented(ctx, pc, insn, "opcode");
+        }
+
+        enum class Flow
+        {
+            None,      // not a control transfer
+            Branch,    // conditional branch / jump: target in 'target', 'taken' set
+        };
+
+        struct Decoded
+        {
+            Flow flow = Flow::None;
+            bool taken = false;
+            bool likely = false;
+            uint32_t target = 0u;
+            int linkReg = -1;
+        };
+
+        Decoded decodeControl(const R5900Context *ctx, uint32_t pc, uint32_t insn)
+        {
+            Decoded d;
+            const uint32_t op = insn >> 26;
+            const uint32_t rs = rsOf(insn), rt = rtOf(insn);
+            const uint32_t branchTarget = pc + 4u + ((uint32_t)simm(insn) << 2);
+            auto branch = [&](bool cond, bool likely, int link = -1)
+            {
+                d.flow = Flow::Branch;
+                d.taken = cond;
+                d.likely = likely;
+                d.target = branchTarget;
+                d.linkReg = link;
+            };
+            switch (op)
+            {
+            case 0x00:
+                if ((insn & 0x3Fu) == 0x08u) // JR
+                {
+                    d.flow = Flow::Branch;
+                    d.taken = true;
+                    d.target = GPR_U32(ctx, rs);
+                }
+                else if ((insn & 0x3Fu) == 0x09u) // JALR
+                {
+                    d.flow = Flow::Branch;
+                    d.taken = true;
+                    d.target = GPR_U32(ctx, rs);
+                    d.linkReg = (int)rdOf(insn);
+                }
+                break;
+            case 0x01:
+                switch (rt)
+                {
+                case 0x00: branch(GPR_S64(ctx, rs) < 0, false); break;
+                case 0x01: branch(GPR_S64(ctx, rs) >= 0, false); break;
+                case 0x02: branch(GPR_S64(ctx, rs) < 0, true); break;
+                case 0x03: branch(GPR_S64(ctx, rs) >= 0, true); break;
+                case 0x10: branch(GPR_S64(ctx, rs) < 0, false, 31); break;
+                case 0x11: branch(GPR_S64(ctx, rs) >= 0, false, 31); break;
+                case 0x12: branch(GPR_S64(ctx, rs) < 0, true, 31); break;
+                case 0x13: branch(GPR_S64(ctx, rs) >= 0, true, 31); break;
+                default: break;
+                }
+                break;
+            case 0x02: // J
+            case 0x03: // JAL
+                d.flow = Flow::Branch;
+                d.taken = true;
+                d.target = ((pc + 4u) & 0xF0000000u) | ((insn & 0x03FFFFFFu) << 2);
+                d.linkReg = op == 0x03 ? 31 : -1;
+                break;
+            case 0x04: branch(GPR_U64(ctx, rs) == GPR_U64(ctx, rt), false); break;
+            case 0x05: branch(GPR_U64(ctx, rs) != GPR_U64(ctx, rt), false); break;
+            case 0x06: branch(GPR_S64(ctx, rs) <= 0, false); break;
+            case 0x07: branch(GPR_S64(ctx, rs) > 0, false); break;
+            case 0x14: branch(GPR_U64(ctx, rs) == GPR_U64(ctx, rt), true); break;
+            case 0x15: branch(GPR_U64(ctx, rs) != GPR_U64(ctx, rt), true); break;
+            case 0x16: branch(GPR_S64(ctx, rs) <= 0, true); break;
+            case 0x17: branch(GPR_S64(ctx, rs) > 0, true); break;
+            case 0x11: // BC1x
+                if (rs == 0x08u)
+                {
+                    const bool cond = (ctx->fcr31 & 0x00800000u) != 0u;
+                    switch (rt & 3u)
+                    {
+                    case 0: branch(!cond, false); break;
+                    case 1: branch(cond, false); break;
+                    case 2: branch(!cond, true); break;
+                    case 3: branch(cond, true); break;
+                    }
+                }
+                break;
+            default:
+                break;
+            }
+            return d;
+        }
+    }
+
+    bool canInterpret(uint32_t pc)
+    {
+        if (pc == 0u || (pc & 3u) != 0u)
+            return false;
+        const uint32_t phys = physical(pc);
+        return phys >= 0x00001000u && phys < PS2_RAM_SIZE;
+    }
+
+    uint64_t interpretedInstructionCount()
+    {
+        return g_interpretedInstructions.load(std::memory_order_relaxed);
+    }
+
+    bool verifyCall(uint8_t *rdram, const R5900Context &entry, PS2Runtime *runtime, uint32_t returnPc,
+                    R5900Context &outContext, std::vector<std::pair<uint32_t, uint8_t>> &outWrites)
+    {
+        outContext = entry;
+        outWrites.clear();
+        bool memoryAborted = false;
+        OverlayMemory overlay(rdram, &memoryAborted);
+        Interpreter interp{rdram, &outContext, runtime, &overlay};
+        interp.verify = true;
+        R5900Context *ctx = &outContext;
+        constexpr uint32_t kVerifyBudget = 4u << 20;
+        for (uint32_t step = 0; step < kVerifyBudget; ++step)
+        {
+            const uint32_t pc = ctx->pc;
+            // A recursive callee can pass through returnPc at a deeper level; the call is
+            // over only once its stack frame is gone.
+            if (pc == returnPc && step != 0u &&
+                static_cast<uint32_t>(_mm_cvtsi128_si32(ctx->r[29])) >= static_cast<uint32_t>(_mm_cvtsi128_si32(entry.r[29])))
+            {
+                outWrites.reserve(overlay.bytes.size());
+                for (const auto &entryByte : overlay.bytes)
+                    outWrites.emplace_back(entryByte.first, entryByte.second);
+                return true;
+            }
+            if (!canInterpret(pc))
+                return false;
+
+            const uint32_t insn = fetch(rdram, pc);
+            const Decoded control = decodeControl(ctx, pc, insn);
+            if (control.flow == Flow::None)
+            {
+                ctx->pc = pc;
+                interp.executeSimple(pc, insn);
+                if (interp.aborted || memoryAborted)
+                    return false;
+                ctx->pc = pc + 4u;
+                continue;
+            }
+            if (control.linkReg >= 0)
+                SET_GPR_U32(ctx, control.linkReg, pc + 8u);
+            if (control.likely && !control.taken)
+            {
+                ctx->pc = pc + 8u;
+                continue;
+            }
+            const uint32_t slot = fetch(rdram, pc + 4u);
+            ctx->pc = pc + 4u;
+            interp.executeSimple(pc + 4u, slot);
+            if (interp.aborted || memoryAborted)
+                return false;
+            ctx->pc = control.taken ? control.target : pc + 8u;
+        }
+        return false;
+    }
+
+    void interpretGuest(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        LiveMemory live(rdram, ctx, runtime);
+        Interpreter interp{rdram, ctx, runtime, &live};
+        if (g_entryReports.fetch_add(1u, std::memory_order_relaxed) < 32u)
+        {
+            std::cerr << "[interp] entering interpreter at pc=0x" << std::hex << ctx->pc
+                      << " ra=0x" << GPR_U32(ctx, 31) << std::dec << std::endl;
+        }
+
+        uint64_t executed = 0u;
+        for (uint32_t step = 0; step < kStepBudget; ++step)
+        {
+            const uint32_t pc = ctx->pc;
+            if (step != 0u && runtime->hasFunction(pc))
+                break;
+            if (!canInterpret(pc))
+                break;
+
+            const uint32_t insn = fetch(rdram, pc);
+            const Decoded control = decodeControl(ctx, pc, insn);
+            ++executed;
+
+            if (control.flow == Flow::None)
+            {
+                ctx->pc = pc;
+                interp.executeSimple(pc, insn);
+                ctx->pc = pc + 4u;
+                continue;
+            }
+
+            if (control.linkReg >= 0)
+                SET_GPR_U32(ctx, control.linkReg, pc + 8u);
+
+            if (control.likely && !control.taken)
+            {
+                ctx->pc = pc + 8u; // likely branch not taken: delay slot annulled
+                continue;
+            }
+
+            // Delay slot.
+            const uint32_t slot = fetch(rdram, pc + 4u);
+            ctx->pc = pc + 4u;
+            ctx->in_delay_slot = true;
+            ctx->branch_pc = pc;
+            interp.executeSimple(pc + 4u, slot);
+            ctx->in_delay_slot = false;
+            ++executed;
+
+            if (!control.taken)
+            {
+                ctx->pc = pc + 8u;
+                continue;
+            }
+
+            ctx->pc = control.target;
+            if (control.target <= pc && runtime->eeCheckpointDue())
+                break;
+        }
+        g_interpretedInstructions.fetch_add(executed, std::memory_order_relaxed);
+    }
+}
