+#pragma once
+
+// Native replacements for hot IOP guest routines (game IRX code that the interpreter spends most
+// of its time in). Each one is only used when the guest code at its address matches the expected
+// instructions word for word, and it charges the same IOP cycles the interpreted code would take,
+// so timing seen by the IOP threads does not change.
+
+#include <cstdint>
+#include <cstring>
+
+namespace ps2x::iop::detail::hle
+{
+    // NBA Street V3 (SLUS-21126) EA sound driver, software mixer at IOP 0x00052D50: for 2 time
+    // halves x 2 channels it resamples 192 input samples (16-bit source + 32-bit accumulators
+    // >> 7, accumulators cleared after use) into 256 clamped 16-bit output samples (3:4 linear
+    // interpolation, carrying the last sample of each channel in a table). a0 = source, a1 = output.
+    constexpr uint32_t kEaMixerAddress = 0x00052D50u;
+
+    struct GuestWord
+    {
+        uint32_t address;
+        uint32_t value;
+    };
+    // Prologue (with the three hard-coded table addresses), head and inner loop.
+    constexpr GuestWord kEaMixerSignature[] = {
+        {0x52D50u, 0x27BDFFD8u}, {0x52D54u, 0xAFB40020u}, {0x52D58u, 0x0080A021u}, {0x52D5Cu, 0x00A05021u},
+        {0x52D6Cu, 0x3C020006u}, {0x52D74u, 0x2453E278u}, {0x52D8Cu, 0x2447A300u}, {0x52DB4u, 0x2467A2F8u},
+        {0x52E1Cu, 0x8C6500C8u}, {0x52E34u, 0x000211C3u}, {0x52F14u, 0x8D8202FCu}, {0x52F18u, 0x8564017Eu},
+        {0x52F6Cu, 0x240B00F8u}, {0x52F70u, 0x8CE20000u}, {0x52FB0u, 0xACE00000u}, {0x53054u, 0x8CE2000Cu},
+        {0x530A0u, 0x0561FFB3u}, {0x530A8u, 0xAD8002FCu}, {0x530E0u, 0x03E00008u}, {0x530E4u, 0x27BD0028u},
+    };
+    // Instructions the interpreter executes for one call (prologue/epilogue + 4 blocks).
+    constexpr uint32_t kEaMixerCycles = 34u + 4u * (90u + 63u * 44u + 6u) + 10u;
+
+    inline bool eaMixerMatches(const uint8_t *ram)
+    {
+        for (const GuestWord &word : kEaMixerSignature)
+        {
+            uint32_t value;
+            std::memcpy(&value, ram + word.address, sizeof(value));
+            if (value != word.value)
+                return false;
+        }
+        return true;
+    }
+
+    // The guest's 40-byte stack frame (saved s0-s4 and the two index tables), dead after it
+    // returns; written anyway so memory ends up byte-identical to the interpreted run.
+    inline void eaMixerStackFrame(uint8_t *ram, uint32_t sp, const uint32_t savedS0toS4[5])
+    {
+        uint8_t *frame = ram + ((sp - 40u) & 0x1FFFFFu);
+        std::memcpy(frame + 0, ram + 0x5A300u, 8);
+        std::memcpy(frame + 8, ram + 0x5A2F8u, 8);
+        for (int i = 0; i < 5; ++i)
+            std::memcpy(frame + 16 + 4 * i, &savedS0toS4[i], 4);
+    }
+
+    // ram: the 2 MB IOP RAM. Mirrors the guest code exactly (same reads, writes and order).
+    inline void eaMixer(uint8_t *ram, uint32_t source, uint32_t output)
+    {
+        auto at = [ram](uint32_t address) { return ram + (address & 0x1FFFFFu); };
+        auto s16 = [&](uint32_t address) -> int32_t { int16_t v; std::memcpy(&v, at(address), 2); return v; };
+        auto u16 = [&](uint32_t address) -> uint16_t { uint16_t v; std::memcpy(&v, at(address), 2); return v; };
+        auto acc = [&](uint32_t address) -> int32_t { int32_t v; std::memcpy(&v, at(address), 4); return v >> 7; };
+        auto put16 = [&](uint32_t address, uint16_t v) { std::memcpy(at(address), &v, 2); };
+        auto zero32 = [&](uint32_t address) { const uint32_t z = 0; std::memcpy(at(address), &z, 4); };
+        auto clamp16 = [&](uint32_t address, int32_t v) {
+            put16(address, static_cast<uint16_t>(v < -32768 ? -32768 : (v > 32767 ? 32767 : v)));
+        };
+
+        constexpr uint32_t kAccTables = 0x5E278u; // s3: accumulator buffer pointers at +200
+        constexpr uint32_t kLastSample = 0x5E298u; // t8: last output sample per channel
+        int16_t sourceIndex[4], accIndex[4];       // the 8-byte tables copied to the stack
+        std::memcpy(sourceIndex, at(0x5A300u), sizeof(sourceIndex));
+        std::memcpy(accIndex, at(0x5A2F8u), sizeof(accIndex));
+
+        uint32_t out = output;
+        for (uint32_t half = 0; half < 2u; ++half)
+        {
+            for (uint32_t channel = 0; channel < 2u; ++channel)
+            {
+                const uint32_t k = half * 2u + channel;
+                const uint32_t last = kLastSample + channel * 2u;
+                uint32_t accBase;
+                std::memcpy(&accBase, at(kAccTables + static_cast<uint32_t>(static_cast<int32_t>(accIndex[k]) * 4) + 200u), 4);
+                const uint32_t accs = accBase + half * 768u;
+                const uint32_t src = source + static_cast<uint32_t>(static_cast<int32_t>(sourceIndex[k]) * 2);
+
+                // Head: output 0..3 from the previous block's last sample and inputs 0..2.
+                put16(out, u16(last));
+                const int32_t prev = s16(last);
+                const int32_t x0 = s16(src) + acc(accs);
+                clamp16(out + 2u, (prev + 3 * x0) >> 2);
+                const int32_t x1 = s16(src + 2u) + acc(accs + 4u);
+                zero32(accs);
+                clamp16(out + 4u, (x0 + x1) >> 1);
+                zero32(accs + 4u);
+                clamp16(out + 6u, (3 * x1 + s16(src + 4u) + acc(accs + 8u)) >> 2);
+                clamp16(last, s16(src + 382u) + acc(accs + 764u));
+
+                // Body: 63 x (3 inputs -> 4 outputs), outputs 4..255.
+                uint32_t in = src + 4u, a = accs + 8u, o = out + 8u;
+                for (int count = 248; count >= 0; count -= 4)
+                {
+                    const int32_t y0 = s16(in) + acc(a);
+                    clamp16(o, y0);
+                    const int32_t raw1 = acc(a + 4u);
+                    zero32(a);
+                    const int32_t y1 = s16(in + 2u) + raw1;
+                    clamp16(o + 2u, (y0 + 3 * y1) >> 2);
+                    const int32_t raw2 = acc(a + 8u);
+                    zero32(a + 4u);
+                    const int32_t y2 = s16(in + 4u) + raw2;
+                    clamp16(o + 4u, (y1 + y2) >> 1);
+                    zero32(a + 8u);
+                    const int32_t raw3 = s16(in + 6u);
+                    clamp16(o + 6u, (3 * y2 + raw3 + acc(a + 12u)) >> 2);
+                    in += 6u;
+                    a += 12u;
+                    o += 8u;
+                }
+                zero32(accs + 764u);
+                out += 512u;
+            }
+        }
+    }
+}
