+            case 0x3A: SET_GPR_U64(ctx, rd, GPR_U64(ctx, rt) >> sa); break;
+            case 0x3B: SET_GPR_S64(ctx, rd, GPR_S64(ctx, rt) >> sa); break;
+            case 0x3C: SET_GPR_U64(ctx, rd, GPR_U64(ctx, rt) << (32u + sa)); break;
+            case 0x3E: SET_GPR_U64(ctx, rd, GPR_U64(ctx, rt) >> (32u + sa)); break;
