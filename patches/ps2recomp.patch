+        if (std::fabs(fa) >= 1e37f && std::fabs(fb) >= 1e37f && std::signbit(fa) == std::signbit(fb))
+            return true;
+        const float scale = std::max(std::max(std::fabs(fa), std::fabs(fb)), 1e-20f);
+        return std::fabs(fa - fb) <= scale * 2e-5f;
+    }
+}
