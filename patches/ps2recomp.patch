+        return 0u;
+    }
+    const uint32_t parsed = static_cast<uint32_t>(std::strtoul(value, nullptr, 0));
+    std::free(value);
+    return parsed;
+#else
+    const char *env = std::getenv("PS2X_DUMP_ADDR");
+    return env ? static_cast<uint32_t>(std::strtoul(env, nullptr, 0)) : 0u;
+#endif
+}
