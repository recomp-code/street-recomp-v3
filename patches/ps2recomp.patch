+            std::fprintf(stderr, "[vu:stats] VU1 %.0f cycles/s %.0f runs/s busy=%.0f%% (%.1f ns/cycle) | VU0 %.0f cycles/s busy=%.0f%%\n",
+                         s_cycles[1] / secs, s_runs[1] / secs, s_ns[1] / (secs * 1e7),
+                         s_cycles[1] ? double(s_ns[1]) / double(s_cycles[1]) : 0.0,
+                         s_cycles[0] / secs, s_ns[0] / (secs * 1e7));
+            s_cycles[0] = s_cycles[1] = s_runs[0] = s_runs[1] = s_ns[0] = s_ns[1] = 0;
+            s_last = now;
+        }
+    }
 }
