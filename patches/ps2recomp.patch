+// PS2X_CALL_WATCH="0xADDR,0xADDR,...": logs the first calls of the listed guest functions
+// (caller, arguments, time) to stderr, to follow game logic without a debugger.
+namespace
+{
+    struct CallWatch
+    {
+        uint32_t addr[32];
+        uint32_t hits[32];
+        int count = 0;
+    };
+
+    CallWatch &callWatch()
+    {
+        static CallWatch watch = []
+        {
+            CallWatch w{};
+            if (const char *env = std::getenv("PS2X_CALL_WATCH"))
+            {
+                std::string list(env);
+                size_t pos = 0;
+                while (pos < list.size() && w.count < 32)
+                {
+                    size_t next = list.find(',', pos);
+                    if (next == std::string::npos)
+                        next = list.size();
+                    const std::string item = list.substr(pos, next - pos);
+                    if (!item.empty())
+                        w.addr[w.count++] = static_cast<uint32_t>(std::strtoul(item.c_str(), nullptr, 16));
+                    pos = next + 1;
+                }
+            }
+            return w;
+        }();
+        return watch;
+    }
+
+    // PS2X_CALL_HIST="startSec,durationSec[,file]": counts every guest call (target, call site)
+    // in the window, with the v0 each returned, then writes the table sorted by count. Functions
+    // polled every frame that always return the same value show what the game is waiting for.
+    struct CallHistEntry
+    {
+        uint64_t count = 0;
+        uint32_t firstV0 = 0;
+        uint32_t lastV0 = 0;
+        bool v0Varies = false;
+        bool returned = false;
+    };
+
+    struct CallHist
+    {
+        bool configured = false;
+        bool enabled = false;
+        bool active = false;
+        bool written = false;
+        double start = 0.0, duration = 0.0;
+        std::string file;
+        std::chrono::steady_clock::time_point origin;
+        std::unordered_map<uint64_t, CallHistEntry> entries;
+    };
+
+    CallHist &callHist()
+    {
+        static CallHist hist = []
+        {
+            CallHist h;
+            h.origin = std::chrono::steady_clock::now();
+            if (const char *env = std::getenv("PS2X_CALL_HIST"))
+            {
+                char file[260] = {};
+                const int n = std::sscanf(env, "%lf,%lf,%259s", &h.start, &h.duration, file);
+                h.enabled = n >= 2;
+                h.file = (n >= 3) ? file : "call_hist.txt";
+            }
+            h.configured = true;
+            return h;
+        }();
+        return hist;
+    }
+
+    CallHistEntry *callHistBegin(uint32_t targetPc, uint32_t sourcePc)
+    {
+        CallHist &h = callHist();
+        if (!h.enabled || h.written)
+            return nullptr;
+        const double t = std::chrono::duration<double>(std::chrono::steady_clock::now() - h.origin).count();
+        if (t < h.start)
+            return nullptr;
+        if (t >= h.start + h.duration)
+        {
+            h.written = true;
+            std::vector<std::pair<uint64_t, CallHistEntry>> rows(h.entries.begin(), h.entries.end());
+            std::sort(rows.begin(), rows.end(), [](const auto &a, const auto &b) { return a.second.count > b.second.count; });
+            if (FILE *f = std::fopen(h.file.c_str(), "w"))
+            {
+                std::fprintf(f, "count target site v0(first..last) varies\n");
+                for (const auto &[key, e] : rows)
+                {
+                    std::fprintf(f, "%llu 0x%X 0x%X %s0x%X..0x%X %s\n", static_cast<unsigned long long>(e.count),
+                                 static_cast<uint32_t>(key >> 32), static_cast<uint32_t>(key), e.returned ? "" : "noret ",
+                                 e.firstV0, e.lastV0, e.v0Varies ? "varies" : "const");
+                }
+                std::fclose(f);
+            }
+            std::fprintf(stderr, "[callhist] wrote %zu rows to %s\n", rows.size(), h.file.c_str());
+            return nullptr;
+        }
+        CallHistEntry &e = h.entries[(static_cast<uint64_t>(targetPc) << 32) | sourcePc];
+        ++e.count;
+        return &e;
+    }
+
+    void callHistEnd(CallHistEntry *e, const R5900Context *ctx)
+    {
+        const uint32_t v0 = static_cast<uint32_t>(_mm_cvtsi128_si32(ctx->r[2]));
+        if (!e->returned)
+        {
+            e->returned = true;
+            e->firstV0 = v0;
+        }
+        else if (v0 != e->lastV0)
+        {
+            e->v0Varies = true;
+        }
+        e->lastV0 = v0;
+    }
+
+    void noteWatchedCall(const R5900Context *ctx, uint32_t targetPc, uint32_t sourcePc)
+    {
+        CallWatch &w = callWatch();
+        for (int i = 0; i < w.count; ++i)
+        {
+            if (w.addr[i] != targetPc)
+                continue;
+            const uint32_t n = ++w.hits[i];
+            if (n <= 40u || (n & (n - 1u)) == 0u)
+            {
+                static const auto start = std::chrono::steady_clock::now();
+                const double t = std::chrono::duration<double>(std::chrono::steady_clock::now() - start).count();
+                std::fprintf(stderr, "[call] fn=0x%X #%u from=0x%X a0=0x%X a1=0x%X a2=0x%X a3=0x%X f12=%g t=%.2f\n",
+                             targetPc, n, sourcePc,
+                             static_cast<uint32_t>(_mm_cvtsi128_si32(ctx->r[4])), static_cast<uint32_t>(_mm_cvtsi128_si32(ctx->r[5])),
+                             static_cast<uint32_t>(_mm_cvtsi128_si32(ctx->r[6])), static_cast<uint32_t>(_mm_cvtsi128_si32(ctx->r[7])),
+                             ctx->f[12], t);
+            }
+            return;
+        }
+    }
+}
