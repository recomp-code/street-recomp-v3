@@ -0,0 +1,50 @@
+// ps2recomp: minimal stand-in for PCSX2's common/Console.h. Messages go to stderr; DevCon
+// (verbose) output only when PS2X_NET_LOG=2, normal output unless PS2X_NET_LOG=0.
+#pragma once
+
+#include "common/Pcsx2Defs.h"
+
+#include <cstdarg>
+
+namespace ps2x::dev9
+{
+    // 0 = errors only, 1 = normal (default), 2 = verbose (DevCon).
+    int netLogLevel();
+    void netLogV(const char *prefix, const char *fmt, va_list args);
+}
+
+struct Ps2xConsoleWriter
+{
+    int level;
+
+    void WriteLn(const char *fmt, ...) const
+    {
+        if (ps2x::dev9::netLogLevel() < level)
+            return;
+        va_list args;
+        va_start(args, fmt);
+        ps2x::dev9::netLogV("", fmt, args);
+        va_end(args);
+    }
+
+    void Warning(const char *fmt, ...) const
+    {
+        if (ps2x::dev9::netLogLevel() < level)
+            return;
+        va_list args;
+        va_start(args, fmt);
+        ps2x::dev9::netLogV("warning: ", fmt, args);
+        va_end(args);
+    }
+
+    void Error(const char *fmt, ...) const
+    {
+        va_list args;
+        va_start(args, fmt);
+        ps2x::dev9::netLogV("error: ", fmt, args);
+        va_end(args);
+    }
+};
