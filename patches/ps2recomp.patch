 #include "../iop_emulator_const.h"
 
 #include <algorithm>
+#include <cstdio>
 
 namespace ps2x::iop::detail
 {
@@ -28,9 +29,11 @@ namespace ps2x::iop::detail
         m_threads.clear();
         m_semaphores.clear();
         m_eventFlags.clear();
+        m_messageBoxes.clear();
         m_nextThreadId = 1;
         m_nextSemaphoreId = 1;
         m_nextEventFlagId = 1;
+        m_nextMessageBoxId = 1;
         m_currentThread = nullptr;
     }
 
@@ -322,6 +325,7 @@ namespace ps2x::iop::detail
         case IopThreadState::Delay:
         case IopThreadState::Semaphore:
         case IopThreadState::EventFlag:
+        case IopThreadState::MessageBox:
             status = 0x04u;
             break;
         case IopThreadState::Suspended:
@@ -717,6 +721,175 @@ namespace ps2x::iop::detail
         cleanupDeadThreads();
     }
 
+    // thmsgbx: CreateMbx(4) DeleteMbx(5) SendMbx(6) iSendMbx(7) ReceiveMbx(8) PollMbx(9)
+    // iPollMbx(10) ReferMbxStatus(11) iReferMbxStatus(12). ReceiveMbx/PollMbx take
+    // (void **msgvar, int mbxid); messages are guest pointers to iop_message_t.
+    bool IopKernel::dispatchMessageBoxImport(uint16_t ordinal, IopCpuState &cpu)
+    {
+        constexpr int32_t kErrorUnknownMbx = -410; // KE_UNKNOWN_MBXID
+        constexpr int32_t kErrorNoMessage = -424;  // KE_MBOX_NOMSG
+        const auto setV0 = [&](int32_t value)
+        {
+            cpu.gpr[2] = static_cast<uint32_t>(value);
+        };
+
+        switch (ordinal)
+        {
+        case 4:
+        {
+            const uint32_t descriptor = cpu.gpr[4];
+            MessageBox box;
+            box.id = static_cast<int>(m_nextMessageBoxId++);
+            if (descriptor != 0u)
+            {
+                box.attr = m_memory.read32(descriptor + 0u);
+                box.option = m_memory.read32(descriptor + 4u);
+            }
+            const int id = box.id;
+            m_messageBoxes.emplace(id, std::move(box));
+            setV0(id);
+            return true;
+        }
+        case 5:
+        {
+            const int id = static_cast<int>(cpu.gpr[4]);
+            if (m_messageBoxes.erase(id) == 0u)
+            {
+                setV0(kErrorUnknownMbx);
+                return true;
+            }
+            for (auto &[threadId, thread] : m_threads)
+            {
+                if (thread.state == IopThreadState::MessageBox && thread.waitId == id)
+                {
+                    thread.state = IopThreadState::Ready;
+                    thread.waitId = 0;
+                    thread.cpu.gpr[2] = static_cast<uint32_t>(-425); // KE_WAIT_DELETE
+                }
+            }
+            setV0(0);
+            return true;
+        }
+        case 6:
+        case 7:
+        {
+            const int id = static_cast<int>(cpu.gpr[4]);
+            const uint32_t message = cpu.gpr[5];
+            const auto it = m_messageBoxes.find(id);
+            if (it == m_messageBoxes.end())
+            {
+                setV0(kErrorUnknownMbx);
+                return true;
+            }
+            IopThread *receiver = nullptr;
+            for (auto &[threadId, thread] : m_threads)
+            {
+                if (thread.state != IopThreadState::MessageBox || thread.waitId != id)
+                    continue;
+                if (receiver == nullptr || thread.priority < receiver->priority)
+                    receiver = &thread;
+            }
+            if (receiver != nullptr)
+            {
+                if (receiver->waitResultAddress != 0u)
+                    m_memory.write32(receiver->waitResultAddress, message);
+                receiver->cpu.gpr[2] = 0u;
+                receiver->state = IopThreadState::Ready;
+                receiver->waitId = 0;
+                receiver->waitResultAddress = 0u;
+            }
+            else
+            {
+                it->second.messages.push_back(message);
+            }
+            setV0(0);
+            return true;
+        }
+        case 8:
+        case 9:
+        case 10:
+        {
+            const uint32_t messageVariable = cpu.gpr[4];
+            const int id = static_cast<int>(cpu.gpr[5]);
+            const auto it = m_messageBoxes.find(id);
+            if (it == m_messageBoxes.end())
+            {
+                setV0(kErrorUnknownMbx);
+                return true;
+            }
+            if (!it->second.messages.empty())
+            {
+                const uint32_t message = it->second.messages.front();
+                it->second.messages.pop_front();
+                if (messageVariable != 0u)
+                    m_memory.write32(messageVariable, message);
+                setV0(0);
+            }
+            else if (ordinal != 8)
+            {
+                setV0(kErrorNoMessage);
+            }
+            else if (m_currentThread != nullptr)
+            {
+                m_currentThread->state = IopThreadState::MessageBox;
+                m_currentThread->waitId = id;
+                m_currentThread->waitResultAddress = messageVariable;
+                cpu.yielded = true;
+                setV0(0);
+            }
+            else
+            {
+                setV0(kErrorNoMessage);
+            }
+            return true;
+        }
+        case 11:
+        case 12:
+        {
+            const int id = static_cast<int>(cpu.gpr[4]);
+            const auto it = m_messageBoxes.find(id);
+            if (it == m_messageBoxes.end())
+            {
+                setV0(kErrorUnknownMbx);
+                return true;
+            }
+            const uint32_t outputAddress = cpu.gpr[5];
+            if (outputAddress != 0u)
+            {
+                uint32_t waiters = 0u;
+                for (const auto &[threadId, thread] : m_threads)
+                {
+                    if (thread.state == IopThreadState::MessageBox && thread.waitId == id)
+                        ++waiters;
+                }
+                m_memory.write32(outputAddress + 0u, it->second.attr);
+                m_memory.write32(outputAddress + 4u, it->second.option);
+                m_memory.write32(outputAddress + 8u, waiters);
+                m_memory.write32(outputAddress + 12u, static_cast<uint32_t>(it->second.messages.size()));
+                m_memory.write32(outputAddress + 16u, it->second.messages.empty() ? 0u : it->second.messages.front());
+            }
+            setV0(0);
+            return true;
+        }
+        default:
+            return false;
+        }
+    }
