+        // THBASE alarms: SetAlarm/iSetAlarm(iop_sys_clock_t *, handler, arg), CancelAlarm/
+        // iCancelAlarm(handler, arg). The handler runs in interrupt context when the time is up and
+        // returns the next interval in system clock ticks (0 = stop). SMAP polls the PHY link with
+        // one; without it INET never sees the link and never starts DHCP.
+        bool dispatchAlarmImport(uint16_t ordinal, CpuState &cpu)
+        {
+            constexpr uint32_t kErrorNotFound = static_cast<uint32_t>(-418); // KE_NOTFOUND_HANDLER
+            switch (ordinal)
+            {
+            case 35: // SetAlarm
+            case 36: // iSetAlarm
+            {
+                const uint64_t ticks = static_cast<uint64_t>(memory.read32(cpu.gpr[4])) |
+                                       (static_cast<uint64_t>(memory.read32(cpu.gpr[4] + 4u)) << 32u);
+                Alarm alarm{cpu.gpr[5], cpu.gpr[6], cpu.gpr[28]};
+                for (auto it = alarms.begin(); it != alarms.end(); ++it)
+                    if (it->second.handler == alarm.handler && it->second.argument == alarm.argument)
+                    {
+                        cpu.gpr[2] = static_cast<uint32_t>(-419); // KE_FOUND_HANDLER
+                        return true;
+                    }
+                alarms.emplace(totalCycles + std::max<uint64_t>(ticks, 1u), alarm);
+                cpu.gpr[2] = 0u;
+                return true;
+            }
+            case 37: // CancelAlarm
+            case 38: // iCancelAlarm
+                for (auto it = alarms.begin(); it != alarms.end(); ++it)
+                    if (it->second.handler == cpu.gpr[4] && it->second.argument == cpu.gpr[5])
+                    {
+                        alarms.erase(it);
+                        cpu.gpr[2] = 0u;
+                        return true;
+                    }
+                cpu.gpr[2] = kErrorNotFound;
+                return true;
+            default:
+                return false;
+            }
+        }
