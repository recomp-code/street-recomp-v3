+	}
+	else if (addr >= SMAP_BD_RX_BASE && addr < (SMAP_BD_RX_BASE + SMAP_BD_SIZE))
+	{
+		//int rx_index=(addr - SMAP_BD_RX_BASE)>>3;
+		if (dev9.bd_swap)
+			value = (value >> 8) | (value << 8);
+		dev9Ru16(addr) = value;
+		/*
