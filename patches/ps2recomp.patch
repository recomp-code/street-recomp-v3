+                while (!alarms.empty() && alarms.begin()->first <= totalCycles)
+                {
+                    const Alarm alarm = alarms.begin()->second;
+                    alarms.erase(alarms.begin());
+                    const uint32_t next = callFunction(alarm.handler, alarm.argument, 0u, 0u, 0u, alarm.gp, 100000u);
+                    if (next != 0u)
