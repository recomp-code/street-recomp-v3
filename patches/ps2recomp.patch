new file mode 100644
index 0000000..39b8baa
--- /dev/null
+++ b/ps2xRuntime/include/ps2_interpreter.h
@@ -0,0 +1,36 @@
+#pragma once
+
+#include <cstdint>
+#include <utility>
+#include <vector>
+
+struct R5900Context;
+class PS2Runtime;
+
+// COP0 Count (register 9) runs at the EE clock, 294.912 MHz, and games time themselves with it
+// (mfc0 $9). Recompiled code reads ctx->cop0_count directly, so the runtime refreshes it from
+// the host clock at every guest dispatch and scheduler resume (defined in ps2_runtime.cpp).
+void ps2UpdateCop0Count(R5900Context *ctx);
+
+// Recent guest dispatch targets, oldest first (diagnostics; defined in ps2_runtime.cpp).
+const char *ps2DispatchHistoryText();
+
+// Fallback R5900 interpreter for guest code that has no recompiled function: gaps the static
+// analysis missed and code the game builds or relocates in RAM at run time (overlays, plugins).
+// It runs from ctx->pc until control reaches an address with a recompiled function, a
+// scheduler checkpoint is due, or the step budget runs out, always leaving ctx->pc at the next
+// guest instruction so the EE scheduler can resume it like any generated function.
+namespace ps2_interpreter
+{
+    bool canInterpret(uint32_t pc);
+    void interpretGuest(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime);
+    uint64_t interpretedInstructionCount();
+
+    // Differential verification: interprets a call from `entry` until control returns to
+    // `returnPc`, against a copy-on-write view of RAM (the machine is left untouched). Returns
+    // false if the call had side effects it cannot model (syscalls, I/O, COP0, VU0 micro mode,
+    // unimplemented instructions) or did not return; otherwise fills the final registers and
+    // every byte the call wrote.
+    bool verifyCall(uint8_t *rdram, const R5900Context &entry, PS2Runtime *runtime, uint32_t returnPc,
+                    R5900Context &outContext, std::vector<std::pair<uint32_t, uint8_t>> &outWrites);
+}
