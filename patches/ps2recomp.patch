+                if (header && header->consumerQuit)
+                    return true;
+                return hostProcess && WaitForSingleObject(hostProcess, 0) == WAIT_OBJECT_0;
+            }
+
+            // Blocks while the ring is full (the host draws slower than the game produces).
+            bool write(const uint8_t *src, size_t size)
+            {
+                while (size != 0u)
+                {
+                    const int64_t w = header->writePos;
+                    const int64_t r = header->readPos;
+                    const uint64_t used = static_cast<uint64_t>(w - r);
+                    const uint64_t freeBytes = capacity - used;
+                    if (freeBytes == 0u)
+                    {
+                        if (hostGone())
+                            return false;
+                        SetEvent(dataEvent);
+                        const uint64_t waitStart = __rdtsc();
+                        header->producerWaiting = 1u;
+                        MemoryBarrier();
+                        if (header->readPos == r) // still full after announcing the wait
+                            WaitForSingleObject(spaceEvent, 20);
+                        header->producerWaiting = 0u;
+                        g_ps2StatRingWaitTicks += __rdtsc() - waitStart;
+                        continue;
+                    }
+                    const uint64_t offset = static_cast<uint64_t>(w) % capacity;
+                    const size_t chunk = static_cast<size_t>(std::min<uint64_t>({size, freeBytes, capacity - offset}));
+                    std::memcpy(data + offset, src, chunk);
+                    MemoryBarrier();
+                    header->writePos = w + static_cast<int64_t>(chunk);
+                    src += chunk;
+                    size -= chunk;
+                }
+                return true;
+            }
+
+            // Called after every packet: a kernel call each time is a measurable part of the game
+            // thread's frame, so only wake the host when it is actually blocked on the event.
+            void signal()
+            {
+                MemoryBarrier(); // writePos store before the consumerWaiting load (pairs with the host)
+                if (!header->consumerFlags || header->consumerWaiting)
+                    SetEvent(dataEvent);
+            }
+        };
+#endif
+
+        struct Writer
+        {
+            std::mutex mutex;
+            FILE *file = nullptr;
+#if defined(_WIN32)
+            LiveRing live;
+            bool liveActive = false;
+#endif
+            bool headerWritten = false;
+            bool finished = false;
+            uint64_t bytes = 0;
+            uint64_t maxBytes = 0;
+            uint32_t frames = 0;
+            uint32_t maxFrames = 0;
+            std::vector<uint8_t> regs = std::vector<uint8_t>(kPrivRegsSize, 0u);
+
+            // Remote VU: PATH3 arrives in DMA slices, but the host's GIF unit interleaves
+            // PATH1/PATH2 with it, so PATH3 is only sent as whole GIF packets (up to EOP), the
+            // granularity of real GIF arbitration.
+            std::vector<uint8_t> path3Pending;
+            size_t path3Parsed = 0;      // bytes of path3Pending already walked
+            uint64_t path3TagQwLeft = 0; // payload qwords left in the current tag
+            bool path3TagEop = false;
+
+            bool enabled() const
+            {
+#if defined(_WIN32)
+                if (liveActive)
+                    return true;
+#endif
+                return file != nullptr;
+            }
+
+            void write(const void *data, size_t size)
+            {
+                if (size == 0)
+                    return;
+#if defined(_WIN32)
+                if (liveActive)
+                {
+                    if (!live.write(static_cast<const uint8_t *>(data), size))
+                    {
+                        DWORD exitCode = 0;
+                        const bool exited = live.hostProcess && GetExitCodeProcess(live.hostProcess, &exitCode) && exitCode != STILL_ACTIVE;
+                        std::fprintf(stderr, "[gslive] GS host closed (%s, exit code 0x%lX), exiting\n",
+                                     exited ? "process ended" : "window closed", exited ? exitCode : 0ul);
+                        std::fflush(stderr);
+                        ExitProcess(0);
+                    }
+                    bytes += size;
+                    return;
+                }
+#endif
+                if (!file)
+                    return;
+                std::fwrite(data, 1, size, file);
+                bytes += size;
+            }
+            void writeByte(uint8_t value) { write(&value, 1); }
+            void writeWord(uint32_t value) { write(&value, 4); }
+
+            void endPacket()
+            {
+#if defined(_WIN32)
+                if (liveActive)
+                    live.signal();
+#endif
+            }
+
+            void close()
+            {
+                if (file)
+                {
+                    std::fclose(file);
+                    file = nullptr;
+                }
+                finished = true;
+            }
+
+            // The header goes out with the first packet, carrying the privileged registers
+            // as they are at that moment. There is no saved GS state: the dump starts with
+            // the console's GS fresh (PCSX2's replayer is patched to accept that).
+            void ensureHeader()
+            {
+                if (headerWritten || !enabled())
+                    return;
+                headerWritten = true;
+                static const char kSerial[] = "SLUS-21126";
+                const uint32_t serialSize = static_cast<uint32_t>(sizeof(kSerial) - 1u);
+                writeWord(0xFFFFFFFFu);
+                writeWord(static_cast<uint32_t>(sizeof(DumpHeader)) + serialSize);
+                DumpHeader header{};
+                header.state_version = kGsStateVersion;
+                header.state_size = 0u;
+                header.serial_offset = sizeof(DumpHeader);
+                header.serial_size = serialSize;
+                header.crc = 0u;
+                header.screenshot_offset = header.serial_offset + serialSize;
+                write(&header, sizeof(header));
+                write(kSerial, serialSize);
+                write(regs.data(), regs.size());
+            }
+
+            bool usable()
+            {
+                if (finished || !enabled())
+                    return false;
+                if (file && maxBytes != 0u && bytes >= maxBytes)
+                {
+                    std::fprintf(stderr, "[gsdump] size limit reached, closing dump\n");
+                    close();
+                    return false;
+                }
+                ensureHeader();
+                return true;
+            }
+        };
+
+        Writer &writer()
+        {
+            static Writer w;
+            static const bool s_initialized = []
+            {
+                Writer &init = w;
+#if defined(_WIN32)
+                const char *liveEnv = std::getenv("PS2X_GS_LIVE");
+                if (liveEnv && *liveEnv == '1')
+                {
+                    if (init.live.open() && init.live.launchHost())
+                    {
+                        init.liveActive = true;
+                        std::fprintf(stderr, "[gslive] GS host started (PCSX2 renderer)\n");
+                    }
+                    else
+                    {
+                        std::fprintf(stderr, "[gslive] live GS host unavailable, using the built-in renderer\n");
+                    }
+                }
+#endif
+                const char *path = std::getenv("PS2X_GS_DUMP");
+                if (path && *path)
+                {
+                    init.file = std::fopen(path, "wb");
+                    if (init.file)
+                    {
+                        std::setvbuf(init.file, nullptr, _IOFBF, 8u << 20);
+                        std::fprintf(stderr, "[gsdump] writing %s\n", path);
+                    }
+                    else
+                    {
+                        std::fprintf(stderr, "[gsdump] cannot open %s\n", path);
+                    }
+                }
+                if (const char *frames = std::getenv("PS2X_GS_DUMP_FRAMES"))
+                    init.maxFrames = static_cast<uint32_t>(std::strtoul(frames, nullptr, 10));
+                const char *maxMb = std::getenv("PS2X_GS_DUMP_MAX_MB");
+                init.maxBytes = static_cast<uint64_t>(maxMb ? std::strtoull(maxMb, nullptr, 10) : 8192u) << 20u;
+                return true;
+            }();
+            (void)s_initialized;
+            return w;
+        }
+
+        void snapshotRegisters(Writer &w, const GSRegisters &r)
+        {
+            auto put = [&](uint32_t offset, uint64_t value) { std::memcpy(w.regs.data() + offset, &value, sizeof(value)); };
+            put(0x0000u, r.pmode);
+            put(0x0010u, r.smode1);
+            put(0x0020u, r.smode2);
+            put(0x0030u, r.srfsh);
+            put(0x0040u, r.synch1);
+            put(0x0050u, r.synch2);
+            put(0x0060u, r.syncv);
+            put(0x0070u, r.dispfb1);
+            put(0x0080u, r.display1);
+            put(0x0090u, r.dispfb2);
+            put(0x00A0u, r.display2);
+            put(0x00B0u, r.extbuf);
+            put(0x00C0u, r.extdata);
+            put(0x00D0u, r.extwrite);
+            put(0x00E0u, r.bgcolor);
+            put(0x1000u, r.csr.load(std::memory_order_relaxed));
+            put(0x1010u, r.imr);
+            put(0x1040u, r.busdir);
+            put(0x1080u, r.siglblid);
+        }
+    }
+
+    bool active()
+    {
+        Writer &w = writer();
+        return w.enabled() && !w.finished;
+    }
+
+    bool liveActive()
+    {
+#if defined(_WIN32)
+        return writer().liveActive;
+#else
+        return false;
+#endif
+    }
+
+    bool hostMenuOpen()
+    {
+#if defined(_WIN32)
+        Writer &w = writer();
+        return w.liveActive && w.live.header && w.live.header->hostMenuOpen != 0u;
+#else
+        return false;
+#endif
+    }
+
+    bool inputFocused()
+    {
+#if defined(_WIN32)
+        // PS2X_BACKGROUND_INPUT=1: the controller also drives this instance when it is not in front.
+        static const bool s_background = []
+        {
+            const char *value = std::getenv("PS2X_BACKGROUND_INPUT");
+            return value && *value && *value != '0';
+        }();
+        Writer &w = writer();
+        if (s_background || !w.liveActive || !w.live.hostProcess)
+            return true;
+        // Throttled: called for every pad read.
+        static ULONGLONG s_lastCheck = 0;
+        static bool s_focused = true;
+        const ULONGLONG now = GetTickCount64();
+        if (now - s_lastCheck >= 50)
+        {
+            s_lastCheck = now;
+            DWORD pid = 0;
+            if (HWND foreground = GetForegroundWindow())
+                GetWindowThreadProcessId(foreground, &pid);
+            s_focused = pid == GetProcessId(w.live.hostProcess) || pid == GetCurrentProcessId();
+        }
+        return s_focused;
+#else
+        return true;
+#endif
+    }
+
+    bool remotePad(uint32_t &buttons, uint32_t &axes)
+    {
+#if defined(_WIN32)
+        Writer &w = writer();
+        if (!w.liveActive || !w.live.header)
+            return false;
+        buttons = w.live.header->padButtons;
+        axes = w.live.header->padAxes;
+        return true;
+#else
+        (void)buttons;
+        (void)axes;
+        return false;
+#endif
+    }
+
+    namespace
+    {
+        void writeTransferLocked(Writer &w, int path, const uint8_t *data, uint32_t size)
+        {
+            w.writeByte(kTypeTransfer);
+            w.writeByte(path == 1 ? kPath1New : (path == 2 ? kPath2 : kPath3));
+            w.writeWord(size);
+            w.write(data, size);
+            w.endPacket();
+        }
+
+        // Appends PATH3 data and sends every GIF packet completed so far (see Writer::path3Pending).
+        // True when data is a run of whole GIF packets ending with an EOP tag's last qword.
+        bool endsWithCompletePacket(const uint8_t *data, size_t size)
+        {
+            size_t pos = 0;
+            bool lastEop = false;
+            while (pos + 16u <= size)
+            {
+                uint64_t tagLo = 0;
+                std::memcpy(&tagLo, data + pos, sizeof(tagLo));
+                const uint64_t nloop = tagLo & 0x7FFFu;
+                const uint32_t flg = static_cast<uint32_t>((tagLo >> 58) & 3u);
+                uint64_t nreg = (tagLo >> 60) & 0xFu;
+                if (nreg == 0)
+                    nreg = 16;
+                lastEop = ((tagLo >> 15) & 1u) != 0u;
+                pos += 16u + static_cast<size_t>(16u * (flg == 0u ? nloop * nreg : (flg == 1u ? (nloop * nreg + 1u) / 2u : nloop)));
+            }
+            return pos == size && lastEop;
+        }
+
+        void queuePath3Locked(Writer &w, const uint8_t *data, uint32_t size)
+        {
+            // Common case: nothing pending and the slice is made of whole packets -> send it
+            // straight from the caller's buffer instead of copying it through path3Pending.
+            if (w.path3Pending.empty() && w.path3TagQwLeft == 0 && endsWithCompletePacket(data, size))
+            {
+                writeTransferLocked(w, 3, data, size);
+                return;
+            }
+            w.path3Pending.insert(w.path3Pending.end(), data, data + size);
+            std::vector<uint8_t> &buf = w.path3Pending;
+            size_t sendUpTo = 0;
+            size_t lastTagBoundary = 0;
+            while (w.path3Parsed + 16u <= buf.size())
+            {
+                if (w.path3TagQwLeft == 0)
+                {
+                    lastTagBoundary = w.path3Parsed;
+                    uint64_t tagLo = 0;
+                    std::memcpy(&tagLo, buf.data() + w.path3Parsed, sizeof(tagLo));
+                    const uint64_t nloop = tagLo & 0x7FFFu;
+                    const bool eop = ((tagLo >> 15) & 1u) != 0u;
+                    const uint32_t flg = static_cast<uint32_t>((tagLo >> 58) & 3u);
+                    uint64_t nreg = (tagLo >> 60) & 0xFu;
+                    if (nreg == 0)
+                        nreg = 16;
+                    w.path3Parsed += 16u;
+                    w.path3TagQwLeft = flg == 0u ? nloop * nreg : (flg == 1u ? (nloop * nreg + 1u) / 2u : nloop);
+                    w.path3TagEop = eop;
+                }
+                else
+                {
+                    const uint64_t availQw = (buf.size() - w.path3Parsed) / 16u;
+                    const uint64_t takeQw = std::min(availQw, w.path3TagQwLeft);
+                    w.path3Parsed += static_cast<size_t>(takeQw * 16u);
+                    w.path3TagQwLeft -= takeQw;
+                }
+                if (w.path3TagQwLeft == 0 && w.path3TagEop)
+                {
+                    sendUpTo = w.path3Parsed;
+                    w.path3TagEop = false;
+                }
+            }
+            if (w.path3TagQwLeft == 0)
+                lastTagBoundary = w.path3Parsed;
+            // A long packet (a texture chain with one EOP at the end) is sent at its last complete
+            // tag once it gets large: the host's GIF path buffers are 9 MB.
+            constexpr size_t kMaxPending = 6u * 1024u * 1024u;
+            if (sendUpTo == 0 && buf.size() >= kMaxPending && lastTagBoundary > 0)
+                sendUpTo = lastTagBoundary;
+            if (sendUpTo == 0)
+                return;
+            writeTransferLocked(w, 3, buf.data(), static_cast<uint32_t>(sendUpTo));
+            buf.erase(buf.begin(), buf.begin() + static_cast<std::ptrdiff_t>(sendUpTo));
+            w.path3Parsed -= sendUpTo;
+        }
+    }
+
+    void transfer(int path, const uint8_t *data, uint32_t sizeBytes)
+    {
+        if (!data || sizeBytes < 16u)
+            return;
+        Writer &w = writer();
+        std::lock_guard<std::mutex> lock(w.mutex);
+        if (!w.usable())
+            return;
+        const uint32_t size = sizeBytes & ~15u;
+        static const bool assemblePath3 = []
+        {
+            const char *env = std::getenv("PS2X_PATH3_ASSEMBLE");
+            return !(env && env[0] == '0');
+        }();
+        if (path == 3 && assemblePath3 && remoteVu())
+        {
+            queuePath3Locked(w, data, size);
+            return;
+        }
+        writeTransferLocked(w, path, data, size);
+    }
+
+    void writeRegister(uint8_t reg, uint64_t value)
+    {
+        // GIFtag: NLOOP=1, EOP=1, FLG=PACKED, NREG=1, REGS=A+D (0xE).
+        uint8_t packet[32] = {};
+        const uint64_t tagLo = 1ull | (1ull << 15) | (1ull << 60);
+        const uint64_t tagHi = 0xEull;
+        const uint64_t adHi = reg;
+        std::memcpy(packet + 0, &tagLo, 8);
+        std::memcpy(packet + 8, &tagHi, 8);
+        std::memcpy(packet + 16, &value, 8);
+        std::memcpy(packet + 24, &adHi, 8);
+        // A complete packet of its own: never merged into a PATH3 packet still being assembled.
+        Writer &w = writer();
+        std::lock_guard<std::mutex> lock(w.mutex);
+        if (!w.usable())
+            return;
+        writeTransferLocked(w, 3, packet, sizeof(packet));
+    }
+
+    void readFifo(uint32_t qwc)
+    {
+        if (qwc == 0u)
+            return;
+        Writer &w = writer();
+        std::lock_guard<std::mutex> lock(w.mutex);
+        if (!w.usable())
+            return;
+        w.writeByte(kTypeReadFifo2);
+        w.writeWord(qwc);
+        w.endPacket();
+    }
+
+    bool remoteVu()
+    {
+#if defined(_WIN32)
+        static const bool enabled = []
+        {
+            const char *env = std::getenv("PS2X_REMOTE_VU");
+            return !(env && env[0] == '0');
+        }();
+        return enabled && writer().liveActive;
+#else
+        return false;
+#endif
+    }
+
+    void vif1(const uint8_t *data, uint32_t sizeBytes)
+    {
+        sizeBytes &= ~3u;
+        if (!data || sizeBytes == 0u || !remoteVu())
+            return;
+        Writer &w = writer();
+        std::lock_guard<std::mutex> lock(w.mutex);
+        if (!w.usable())
+            return;
+        w.writeByte(kTypeLiveVif1);
+        w.writeWord(sizeBytes);
+        w.write(data, sizeBytes);
+        w.endPacket();
+    }
+
+    void vif1Register(uint32_t address, uint32_t value)
+    {
+        if (!remoteVu())
+            return;
+        Writer &w = writer();
+        std::lock_guard<std::mutex> lock(w.mutex);
+        if (!w.usable())
+            return;
+        w.writeByte(kTypeLiveVif1Reg);
+        w.writeWord(address);
+        w.writeWord(value);
+        w.endPacket();
+    }
+
+    void vsync(const GSRegisters &regs, int field)
+    {
+        Writer &w = writer();
+        std::lock_guard<std::mutex> lock(w.mutex);
+        snapshotRegisters(w, regs);
+        if (!w.usable())
+            return;
+        w.writeByte(kTypeRegisters);
+        w.write(w.regs.data(), w.regs.size());
+        w.writeByte(kTypeVSync);
+        w.writeByte(static_cast<uint8_t>(field & 1));
+        w.endPacket();
+        if (w.file && w.frames % 600u == 0u)
+            std::fflush(w.file);
+        ++w.frames;
+        if (w.file && w.maxFrames != 0u && w.frames >= w.maxFrames)
+        {
+            std::fprintf(stderr, "[gsdump] %u frames written, closing dump (%.1f MB)\n", w.frames,
+                         static_cast<double>(w.bytes) / (1024.0 * 1024.0));
+            w.close();
+        }
+    }
+}
diff --git a/ps2xRuntime/src/lib/gs/gs_dump_writer.h b/ps2xRuntime/src/lib/gs/gs_dump_writer.h
new file mode 100644
index 0000000..b82f22e
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_dump_writer.h
@@ -0,0 +1,42 @@
+#pragma once
+
+#include <cstdint>
+
+struct GSRegisters;
+
+// Records everything the game sends to the GS as a PCSX2 GS dump (.gs, uncompressed): GIF
+// transfers per path, privileged register snapshots and vsyncs. The PCSX2 GS (hardware
+// renderers: Vulkan/D3D12/D3D11/OpenGL, upscaling) replays it, which lets that renderer draw
+// the recompiled game. Enabled with PS2X_GS_DUMP=<file>; PS2X_GS_DUMP_FRAMES=<n> stops after n
+// vsyncs and PS2X_GS_DUMP_MAX_MB caps the size (default 8192).
+// PS2X_GS_LIVE=1 instead streams the same data, live, to the PCSX2 GS host window
+// ("pcsx2-gsrunner -live", started automatically; PS2X_GSHOST / PS2X_GSHOST_ARGS override
+// its path and arguments, default "-renderer vulkan -ini nba_street.ini": 4K, see gshost\nba_street.ini;
+// add "-fullscreen" to start in fullscreen).
+namespace ps2_gsdump
+{
+    bool active();
+    bool liveActive();
+    // Pad state of the live GS host window (it has the keyboard focus): active-high libpad
+    // buttons and lx|ly<<8|rx<<16|ry<<24. False when not running live.
+    bool remotePad(uint32_t &buttons, uint32_t &axes);
+    // The GS host's options menu is open (it owns keyboard and gamepad): give the game no input.
+    bool hostMenuOpen();
+    // The physical controller belongs to this instance: its GS host window (or no host) is in front.
+    // Two instances on one PC must not both follow the same gamepad.
+    bool inputFocused();
+    // path: 1, 2 or 3 (GIF PATH1 = VU1 XGKICK, PATH2 = VIF1 DIRECT, PATH3 = GIF DMA).
+    void transfer(int path, const uint8_t *data, uint32_t sizeBytes);
+    // A register written outside a GIF packet (HLE'd library code): recorded as an A+D packet.
+    void writeRegister(uint8_t reg, uint64_t value);
+    // GS -> EE (local -> host) transfer of qwc quadwords.
+    void readFifo(uint32_t qwc);
+    // Live only: the GS host also runs VIF1 + VU1 (PCSX2's microVU recompiler). The game's
+    // VIF1 stream is forwarded with vif1() and local VU1 execution / PATH1 / PATH2 output are
+    // skipped. Default on in live mode; PS2X_REMOTE_VU=0 keeps VU1 local.
+    bool remoteVu();
+    void vif1(const uint8_t *data, uint32_t sizeBytes);
+    // A game write to a VIF1 register the host's VIF1 must see (FBRST, ERR, MARK).
+    void vif1Register(uint32_t address, uint32_t value);
+    void vsync(const GSRegisters &regs, int field);
+}
