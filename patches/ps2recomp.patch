diff --git a/ps2xRuntime/src/lib/ps2_interpreter.cpp b/ps2xRuntime/src/lib/ps2_interpreter.cpp
new file mode 100644
index 0000000..0acb31b
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_interpreter.cpp
@@ -0,0 +1,1370 @@
+#include "ps2_interpreter.h"
+
+#include "ps2_runtime.h"
+#include "ps2_runtime_macros.h"
+
+#include <atomic>
+#include <cmath>
+#include <cstring>
+#include <iostream>
+#include <mutex>
+#include <unordered_map>
+
+namespace ps2_interpreter
+{
+    namespace
+    {
+        constexpr uint32_t kStepBudget = 1u << 20;
+
+        std::atomic<uint64_t> g_interpretedInstructions{0u};
+        std::atomic<uint32_t> g_unimplementedReports{0u};
+        std::atomic<uint32_t> g_entryReports{0u};
+
+        inline uint32_t physical(uint32_t address)
+        {
+            return address & 0x1FFFFFFFu;
+        }
+
+        inline uint32_t fetch(const uint8_t *rdram, uint32_t pc)
+        {
+            uint32_t word = 0u;
+            std::memcpy(&word, rdram + (physical(pc) & PS2_RAM_MASK), sizeof(word));
+            return word;
+        }
+
+        inline int32_t simm(uint32_t insn) { return static_cast<int16_t>(insn & 0xFFFFu); }
+        inline uint32_t uimm(uint32_t insn) { return insn & 0xFFFFu; }
+        inline uint32_t rsOf(uint32_t insn) { return (insn >> 21) & 0x1Fu; }
+        inline uint32_t rtOf(uint32_t insn) { return (insn >> 16) & 0x1Fu; }
+        inline uint32_t rdOf(uint32_t insn) { return (insn >> 11) & 0x1Fu; }
+        inline uint32_t saOf(uint32_t insn) { return (insn >> 6) & 0x1Fu; }
+
+        inline __m128i hiLoVec(uint64_t low, uint64_t high)
+        {
+            return _mm_set_epi64x(static_cast<int64_t>(high), static_cast<int64_t>(low));
+        }
+
+        inline uint32_t vecWord(__m128i v, int i)
+        {
+            alignas(16) uint32_t w[4];
+            _mm_store_si128(reinterpret_cast<__m128i *>(w), v);
+            return w[i];
+        }
+
+        inline __m128i vecFromWords(uint32_t w0, uint32_t w1, uint32_t w2, uint32_t w3)
+        {
+            return _mm_set_epi32(static_cast<int>(w3), static_cast<int>(w2), static_cast<int>(w1), static_cast<int>(w0));
+        }
+
+        void reportUnimplemented(const R5900Context *ctx, uint32_t pc, uint32_t insn, const char *what)
+        {
+            if (g_unimplementedReports.fetch_add(1u, std::memory_order_relaxed) < 64u)
+            {
+                std::cerr << "[interp] unimplemented " << what << " insn=0x" << std::hex << insn
+                          << " pc=0x" << pc << " ra=0x" << GPR_U32(ctx, 31) << std::dec << std::endl;
+            }
+        }
+
+        // Guest memory as seen by the interpreter: the live machine (normal fallback mode) or an
+        // isolated copy-on-write overlay (verification mode, see verifyCall()).
+        struct MemoryAccess
+        {
+            virtual ~MemoryAccess() = default;
+            virtual uint8_t read8(uint32_t address) = 0;
+            virtual uint16_t read16(uint32_t address) = 0;
+            virtual uint32_t read32(uint32_t address) = 0;
+            virtual uint64_t read64(uint32_t address) = 0;
+            virtual __m128i read128(uint32_t address) = 0;
+            virtual void write8(uint32_t address, uint8_t value) = 0;
+            virtual void write16(uint32_t address, uint16_t value) = 0;
+            virtual void write32(uint32_t address, uint32_t value) = 0;
+            virtual void write64(uint32_t address, uint64_t value) = 0;
+            virtual void write128(uint32_t address, __m128i value) = 0;
+        };
+
+        struct LiveMemory final : MemoryAccess
+        {
+            uint8_t *rdram;
+            R5900Context *ctx;
+            PS2Runtime *runtime;
+            LiveMemory(uint8_t *r, R5900Context *c, PS2Runtime *rt) : rdram(r), ctx(c), runtime(rt) {}
+            uint8_t read8(uint32_t a) override { return READ8(a); }
+            uint16_t read16(uint32_t a) override { return READ16(a); }
+            uint32_t read32(uint32_t a) override { return READ32(a); }
+            uint64_t read64(uint32_t a) override { return READ64(a); }
+            __m128i read128(uint32_t a) override { return READ128(a); }
+            void write8(uint32_t a, uint8_t v) override { WRITE8(a, v); }
+            void write16(uint32_t a, uint16_t v) override { WRITE16(a, v); }
+            void write32(uint32_t a, uint32_t v) override { WRITE32(a, v); }
+            void write64(uint32_t a, uint64_t v) override { WRITE64(a, v); }
+            void write128(uint32_t a, __m128i v) override { WRITE128(a, v); }
+        };
+
+        // Copy-on-write view of RDRAM: reads see earlier overlay writes, then the real memory.
+        // Any I/O (special address) access aborts the verification run.
+        struct OverlayMemory final : MemoryAccess
+        {
+            const uint8_t *rdram;
+            bool *aborted;
+            std::unordered_map<uint32_t, uint8_t> bytes;
+            OverlayMemory(const uint8_t *r, bool *abortFlag) : rdram(r), aborted(abortFlag) {}
+
+            bool special(uint32_t a)
+            {
+                if (PS2Runtime::isSpecialAddress(a))
+                {
+                    *aborted = true;
+                    return true;
+                }
+                return false;
+            }
+            uint8_t byteAt(uint32_t a)
+            {
+                const uint32_t p = a & PS2_RAM_MASK;
+                const auto it = bytes.find(p);
+                return it != bytes.end() ? it->second : rdram[p];
+            }
+            void setByte(uint32_t a, uint8_t v) { bytes[a & PS2_RAM_MASK] = v; }
+            template <typename T> T readT(uint32_t a)
+            {
+                if (special(a))
+                    return T{};
+                T value{};
+                uint8_t raw[sizeof(T)];
+                for (size_t i = 0; i < sizeof(T); ++i)
+                    raw[i] = byteAt(a + static_cast<uint32_t>(i));
+                std::memcpy(&value, raw, sizeof(T));
+                return value;
+            }
+            template <typename T> void writeT(uint32_t a, T value)
+            {
+                if (special(a))
+                    return;
+                uint8_t raw[sizeof(T)];
+                std::memcpy(raw, &value, sizeof(T));
+                for (size_t i = 0; i < sizeof(T); ++i)
+                    setByte(a + static_cast<uint32_t>(i), raw[i]);
+            }
+            uint8_t read8(uint32_t a) override { return readT<uint8_t>(a); }
+            uint16_t read16(uint32_t a) override { return readT<uint16_t>(a); }
+            uint32_t read32(uint32_t a) override { return readT<uint32_t>(a); }
+            uint64_t read64(uint32_t a) override { return readT<uint64_t>(a); }
+            __m128i read128(uint32_t a) override { return readT<__m128i>(a & ~0xFu); }
+            void write8(uint32_t a, uint8_t v) override { writeT(a, v); }
+            void write16(uint32_t a, uint16_t v) override { writeT(a, v); }
+            void write32(uint32_t a, uint32_t v) override { writeT(a, v); }
+            void write64(uint32_t a, uint64_t v) override { writeT(a, v); }
+            void write128(uint32_t a, __m128i v) override { writeT(a & ~0xFu, v); }
+        };
+
+        struct Interpreter
+        {
+            uint8_t *rdram;
+            R5900Context *ctx;
+            PS2Runtime *runtime;
+            MemoryAccess *mem;
+            // Verification mode: anything with side effects outside registers/RAM stops the run.
+            bool verify = false;
+            bool aborted = false;
+
+            bool abortIfVerifying()
+            {
+                if (!verify)
+                    return false;
+                aborted = true;
+                return true;
+            }
+
+            void setFpuCondition(bool value)
+            {
+                if (value)
+                    ctx->fcr31 |= 0x00800000u;
+                else
+                    ctx->fcr31 &= ~0x00800000u;
+            }
+
+            bool fpuCondition() const { return (ctx->fcr31 & 0x00800000u) != 0u; }
+
+            // Executes one non-control-transfer instruction. Returns false if the instruction
+            // is a branch/jump (handled by the caller) or unknown.
+            void executeSimple(uint32_t pc, uint32_t insn);
+            void executeSpecial(uint32_t pc, uint32_t insn);
+            void executeMmi(uint32_t pc, uint32_t insn);
+            void executeCop0(uint32_t pc, uint32_t insn);
+            void executeCop1(uint32_t pc, uint32_t insn);
+            void executeCop2(uint32_t pc, uint32_t insn);
+        };
+
+        void Interpreter::executeSpecial(uint32_t pc, uint32_t insn)
+        {
+            const uint32_t rs = rsOf(insn), rt = rtOf(insn), rd = rdOf(insn), sa = saOf(insn);
+            switch (insn & 0x3Fu)
+            {
+            case 0x00: SET_GPR_S32(ctx, rd, (int32_t)(GPR_U32(ctx, rt) << sa)); break;                       // SLL
+            case 0x02: SET_GPR_S32(ctx, rd, (int32_t)(GPR_U32(ctx, rt) >> sa)); break;                       // SRL
+            case 0x03: SET_GPR_S32(ctx, rd, GPR_S32(ctx, rt) >> sa); break;                                  // SRA
