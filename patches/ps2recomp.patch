+        case 4: // open(name, flags, mode)
+        {
+            const std::string name = m_memory.readString(a0, 256u);
+            const int32_t result = open(executor, name, a1, a2);
+            char flagText[32];
+            std::snprintf(flagText, sizeof(flagText), " (flags 0x%x)", a1);
