+        };
+        const auto findFile = [&](uint32_t fd) -> OpenFile *
+        {
+            const auto it = m_files.find(static_cast<int>(fd));
+            return it == m_files.end() ? nullptr : &it->second;
+        };
+        const auto trace = [&](const char *op, const std::string &what, int32_t result)
+        {
+            if (logEnabled())
+                std::fprintf(stderr, "[IOP ioman] %s %s -> %d\n", op, what.c_str(), result);
+        };
 
         switch (ordinal)
