+// PS2X_PEEK="5accf4:53f4:4;5af2a8": every ~2 s prints the u32 at each pointer chain. A chain
+// "a:b:c" means read32(read32(a)+b)+c, i.e. each further offset dereferences the value so far.
+static void printPeekChains(const uint8_t *ram)
+{
+    static const std::vector<std::vector<uint32_t>> chains = []
+    {
+        std::vector<std::vector<uint32_t>> parsed;
+        const char *env = std::getenv("PS2X_PEEK");
+        if (!env)
+            return parsed;
+        std::stringstream all(env);
+        std::string chainText;
+        while (std::getline(all, chainText, ';'))
+        {
+            std::vector<uint32_t> chain;
+            std::stringstream parts(chainText);
+            std::string part;
+            while (std::getline(parts, part, ':'))
+                chain.push_back(static_cast<uint32_t>(std::strtoul(part.c_str(), nullptr, 16)));
+            if (!chain.empty())
+                parsed.push_back(std::move(chain));
+        }
+        return parsed;
+    }();
+    if (chains.empty())
+        return;
+    auto read32 = [&](uint32_t address) -> uint32_t
+    {
+        address &= 0x1FFFFFFFu;
+        if (address + 4u > PS2_RAM_SIZE)
+            return 0xDEADBEEFu;
+        uint32_t value;
+        std::memcpy(&value, ram + address, 4);
+        return value;
+    };
+    std::ostringstream line;
+    line << "[peek]" << std::hex;
+    for (const auto &chain : chains)
+    {
+        uint32_t address = chain[0];
+        for (size_t i = 1; i < chain.size(); ++i)
+            address = read32(address) + chain[i];
+        line << " " << chain[0];
+        for (size_t i = 1; i < chain.size(); ++i)
+            line << ":" << chain[i];
+        line << "=@" << address << "=" << read32(address);
+    }
+    std::fprintf(stderr, "%s\n", line.str().c_str());
+}
