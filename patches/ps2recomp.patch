+
+		case SMAP_R_BD_MODE:
+			return dev9.bd_swap;
+
+		default:
+			DevCon.WriteLn("DEV9: SMAP : Unknown 8 bit read @ %X,v=%X", addr, dev9Ru8(addr));
+			return dev9Ru8(addr);
+	}
+
+	DevCon.WriteLn("DEV9: SMAP : error , 8 bit read @ %X,v=%X", addr, dev9Ru8(addr));
+	return dev9Ru8(addr);
+}
