+// Live mode keyboard -> PS2 pad (same keys as the PS2Recomp runtime window): arrows = D-pad,
+// Z/X/C/V = square/cross/circle/triangle, Q/E = L1/R1, 1/3 = L2/R2, Enter = START,
+// Right Shift/Backspace = SELECT, Ctrl = L3, WASD = left stick. Alt+Enter / F11 = fullscreen.
+static u32 s_live_keys = 0;
+static u32 s_live_stick = 0; // bit0 left, bit1 right, bit2 up, bit3 down
+static bool s_fullscreen = false;
+static RECT s_windowed_rect = {};
+
+static void LivePublishPad()
+{
+	const u32 lx = (s_live_stick & 1) ? 0x00 : ((s_live_stick & 2) ? 0xFF : 0x80);
+	const u32 ly = (s_live_stick & 4) ? 0x00 : ((s_live_stick & 8) ? 0xFF : 0x80);
+	GSDumpReplayer::SetLivePad(s_live_keys, lx | (ly << 8) | (0x80u << 16) | (0x80u << 24));
+}
+
+static void LiveKey(WPARAM vk, LPARAM lParam, bool down)
+{
+	u32 bit = 0;
+	u32 stick = 0;
+	switch (vk)
+	{
+		case VK_UP: bit = 1u << 4; break;
+		case VK_RIGHT: bit = 1u << 5; break;
+		case VK_DOWN: bit = 1u << 6; break;
+		case VK_LEFT: bit = 1u << 7; break;
+		case 'Z': bit = 1u << 15; break;
+		case 'X': bit = 1u << 14; break;
+		case 'C': bit = 1u << 13; break;
+		case 'V': bit = 1u << 12; break;
+		case 'Q': bit = 1u << 10; break;
+		case 'E': bit = 1u << 11; break;
+		case '1': bit = 1u << 8; break;
+		case '3': bit = 1u << 9; break;
+		case VK_RETURN: bit = 1u << 3; break;
+		case VK_BACK: bit = 1u << 0; break;
+		case VK_SHIFT:
+			if (MapVirtualKeyW((lParam >> 16) & 0xFF, MAPVK_VSC_TO_VK_EX) == VK_RSHIFT)
+				bit = 1u << 0;
+			break;
+		case VK_CONTROL: bit = 1u << 1; break;
+		case 'A': stick = 1; break;
+		case 'D': stick = 2; break;
+		case 'W': stick = 4; break;
+		case 'S': stick = 8; break;
+		default: return;
+	}
+	if (down)
+	{
+		s_live_keys |= bit;
+		s_live_stick |= stick;
+	}
+	else
+	{
+		s_live_keys &= ~bit;
+		s_live_stick &= ~stick;
+	}
+	LivePublishPad();
+}
