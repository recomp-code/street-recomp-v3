+static void LiveMenuApply(int item)
+{
+	const int index = s_menu[item].index;
+	switch (item)
+	{
+		case MENU_RENDERER:
+			s_menu_pending_renderer = static_cast<int>(kMenuRenderer[index]);
+			LiveMenuSave();
+			return;
+		case MENU_TEXTURES:
+			s_settings_interface.SetBoolValue("EmuCore/GS", "LoadTextureReplacements", index >= 1);
+			s_settings_interface.SetBoolValue("EmuCore/GS", "LoadTextureReplacementsAsync", true);
+			s_settings_interface.SetBoolValue("EmuCore/GS", "DumpReplaceableTextures", index == 2);
+			break;
+		case MENU_RES:
+			s_settings_interface.SetFloatValue("EmuCore/GS", "upscale_multiplier", kMenuUpscale[index]);
+			break;
+		case MENU_ANISO:
+			s_settings_interface.SetIntValue("EmuCore/GS", "MaxAnisotropy", kMenuAniso[index]);
+			break;
+		case MENU_FILTER:
+			s_settings_interface.SetIntValue("EmuCore/GS", "filter", index);
+			break;
+		case MENU_FXAA:
+			s_settings_interface.SetBoolValue("EmuCore/GS", "fxaa", index == 1);
+			break;
+		case MENU_CAS:
+			s_settings_interface.SetIntValue("EmuCore/GS", "CASMode", index == 0 ? 0 : 1);
+			s_settings_interface.SetIntValue("EmuCore/GS", "CASSharpness", kMenuCasSharpness[index]);
+			break;
+		case MENU_ASPECT:
+			s_settings_interface.SetStringValue("EmuCore/GS", "AspectRatio", kMenuAspect[index]);
+			break;
+		case MENU_FULLSCREEN:
+			if ((index == 1) != s_fullscreen)
+				ToggleFullscreen(s_hwnd);
+			return;
+		case MENU_FPS:
+			s_settings_interface.SetBoolValue("EmuCore/GS", "OsdShowFPS", index == 1);
+			break;
+		default:
+			return;
+	}
+	VMManager::ApplySettings();
+	LiveMenuSave();
+}
+
+static void LiveMenuDo(LiveMenuAction action)
+{
+	LiveMenuInit();
+	const bool open = s_menu_open.load();
+	if (action == LiveMenuAction::Toggle || (open && action == LiveMenuAction::Close))
+	{
+		s_menu_open.store(action == LiveMenuAction::Toggle ? !open : false);
+		s_menu[MENU_FULLSCREEN].index = s_fullscreen ? 1 : 0;
+		GSDumpReplayer::SetLiveMenuOpen(s_menu_open.load());
+		LiveMenuPublish();
+		return;
+	}
+	if (!open)
+		return;
+	const int count = static_cast<int>(s_menu.size());
+	LiveMenuOption& opt = s_menu[s_menu_selected];
+	switch (action)
+	{
+		case LiveMenuAction::Up:
+			s_menu_selected = (s_menu_selected + count - 1) % count;
+			break;
+		case LiveMenuAction::Down:
+			s_menu_selected = (s_menu_selected + 1) % count;
+			break;
+		case LiveMenuAction::Left:
+		case LiveMenuAction::Right:
+			if (!opt.names.empty())
+			{
+				const int n = static_cast<int>(opt.names.size());
+				opt.index = (opt.index + (action == LiveMenuAction::Right ? 1 : n - 1)) % n;
+				LiveMenuApply(s_menu_selected);
+			}
+			break;
+		case LiveMenuAction::Accept:
+			if (opt.names.empty())
+			{
+				LiveMenuDo(LiveMenuAction::Close);
+				return;
+			}
+			opt.index = (opt.index + 1) % static_cast<int>(opt.names.size());
+			LiveMenuApply(s_menu_selected);
+			break;
+		default:
+			break;
+	}
+	LiveMenuPublish();
+}
