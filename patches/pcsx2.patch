+// SPDX-FileCopyrightText: 2002-2026 PCSX2 Dev Team
+// SPDX-License-Identifier: GPL-3.0+
+
+#pragma once
+
+// PS2Recomp live mode: platform-neutral keys and gamepad buttons shared by Main.cpp (pad mapping,
+// options menu) and the platform window code (Win32 WndProc, LiveMac.mm).
+
+#include <cstdint>
+
+enum class LiveKey : uint8_t
+{
+	Other,
+	Up,
+	Down,
+	Left,
+	Right,
+	Z,
+	X,
+	C,
+	V,
+	Q,
+	E,
+	Num1,
+	Num3,
+	Return,
+	Backspace,
+	RightShift,
+	Control,
+	A,
+	D,
+	W,
+	S,
+	F1,
+	Escape,
+	Space,
+};
+
+// Gamepad buttons in the XInput bit layout (the Windows host reads XInput directly).
+namespace LivePad
+{
+	constexpr uint16_t DpadUp = 0x0001;
+	constexpr uint16_t DpadDown = 0x0002;
+	constexpr uint16_t DpadLeft = 0x0004;
+	constexpr uint16_t DpadRight = 0x0008;
+	constexpr uint16_t Start = 0x0010;
+	constexpr uint16_t Back = 0x0020;
+	constexpr uint16_t A = 0x1000;
+	constexpr uint16_t B = 0x2000;
+} // namespace LivePad
+
+#ifdef __APPLE__
+namespace LiveMac
+{
+	struct Callbacks
+	{
+		void (*key)(LiveKey key, bool down, bool repeat);
+		void (*toggle_fullscreen)();
+		void (*close)();
+		void (*resize)(); // the content view changed size (window resize, fullscreen)
+		void (*focus_lost)();
+		void (*fullscreen_changed)(bool fullscreen);
+	};
+
+	// Brings the app to the front and routes the window's keyboard / close / resize events to cb.
+	void Install(void* window, const Callbacks& cb);
+	void ToggleFullscreen(void* window);
+	// Thread-safe (tracked from the key window notifications).
+	bool IsFocused();
+	// First connected controller (GameController.framework), XInput layout; false if none.
+	bool ReadGamepad(uint16_t* buttons);
+	// The same controller as a PS2 pad for the game: buttons active high in the libpad bit order
+	// (bit 0 = SELECT ... bit 15 = SQUARE) and axes lx | ly << 8 | rx << 16 | ry << 24 (0x80 =
+	// centre). macOS hands a controller only to the frontmost app using GameController (this
+	// window), so the game process can not read it itself. False if no controller.
+	bool ReadGamepadPs2(uint32_t* buttons, uint32_t* axes);
+} // namespace LiveMac
+#endif
diff --git a/pcsx2-gsrunner/LiveMac.mm b/pcsx2-gsrunner/LiveMac.mm
new file mode 100644
index 000000000..48863205a
--- /dev/null
+++ b/pcsx2-gsrunner/LiveMac.mm
@@ -0,0 +1,300 @@
+// SPDX-FileCopyrightText: 2002-2026 PCSX2 Dev Team
+// SPDX-License-Identifier: GPL-3.0+
+
+// PS2Recomp live mode on macOS: keyboard, close/resize/focus/fullscreen events of the GS runner
+// window and the first game controller (GameController.framework), for Main.cpp's live code.
+// All AppKit work happens on the main thread (the runner's event loop); the CPU thread only reads
+// the atomics below.
+
+#include "LiveInput.h"
+
+#import <AppKit/AppKit.h>
+#import <Carbon/Carbon.h> // kVK_* key codes
+#import <GameController/GameController.h>
+
+#include <atomic>
+#include <cstdlib>
+
+#if !__has_feature(objc_arc)
+#error ARC is required (PCSX2 builds its Objective-C++ with -fobjc-arc).
+#endif
+
+namespace
+{
+	LiveMac::Callbacks s_callbacks = {};
+	std::atomic<bool> s_focused{false};
+	std::atomic<uint16_t> s_pad_buttons{0};
+	std::atomic<bool> s_pad_connected{false};
+	std::atomic<uint32_t> s_pad_ps2_buttons{0};
+	std::atomic<uint32_t> s_pad_ps2_axes{0x80808080u};
+
+	// Device-dependent modifier bits (IOKit NX_DEVICE*KEYMASK): tell left from right.
+	constexpr NSUInteger kLeftControl = 0x0001;
+	constexpr NSUInteger kRightShift = 0x0004;
+	constexpr NSUInteger kRightControl = 0x2000;
+
+	LiveKey KeyFromCode(unsigned short code)
+	{
+		switch (code)
+		{
+			case kVK_UpArrow: return LiveKey::Up;
+			case kVK_DownArrow: return LiveKey::Down;
+			case kVK_LeftArrow: return LiveKey::Left;
+			case kVK_RightArrow: return LiveKey::Right;
+			case kVK_ANSI_Z: return LiveKey::Z;
+			case kVK_ANSI_X: return LiveKey::X;
+			case kVK_ANSI_C: return LiveKey::C;
+			case kVK_ANSI_V: return LiveKey::V;
+			case kVK_ANSI_Q: return LiveKey::Q;
+			case kVK_ANSI_E: return LiveKey::E;
+			case kVK_ANSI_1: return LiveKey::Num1;
+			case kVK_ANSI_3: return LiveKey::Num3;
+			case kVK_Return:
+			case kVK_ANSI_KeypadEnter: return LiveKey::Return;
+			case kVK_Delete: return LiveKey::Backspace;
+			case kVK_ANSI_A: return LiveKey::A;
+			case kVK_ANSI_D: return LiveKey::D;
+			case kVK_ANSI_W: return LiveKey::W;
+			case kVK_ANSI_S: return LiveKey::S;
+			case kVK_F1: return LiveKey::F1;
+			case kVK_Escape: return LiveKey::Escape;
+			case kVK_Space: return LiveKey::Space;
+			default: return LiveKey::Other;
+		}
+	}
+
+	uint16_t ButtonsFromGamepad(GCExtendedGamepad* pad)
+	{
+		uint16_t buttons = 0;
+		if (pad.dpad.up.isPressed)
+			buttons |= LivePad::DpadUp;
+		if (pad.dpad.down.isPressed)
+			buttons |= LivePad::DpadDown;
+		if (pad.dpad.left.isPressed)
+			buttons |= LivePad::DpadLeft;
+		if (pad.dpad.right.isPressed)
+			buttons |= LivePad::DpadRight;
+		if (pad.buttonMenu.isPressed)
+			buttons |= LivePad::Start;
+		if (pad.buttonOptions.isPressed)
+			buttons |= LivePad::Back;
+		if (pad.buttonA.isPressed)
+			buttons |= LivePad::A;
+		if (pad.buttonB.isPressed)
+			buttons |= LivePad::B;
+		return buttons;
+	}
+
+	uint32_t AxisByte(float value, bool invert)
+	{
+		// GameController: -1..1, up = +1. PS2: 0..255, up = 0, centre 0x80.
+		const float v = invert ? -value : value;
+		const int byte = static_cast<int>(128.0f + v * 127.5f);
+		return static_cast<uint32_t>(byte < 0 ? 0 : (byte > 255 ? 255 : byte));
+	}
+
+	void UpdatePs2(GCExtendedGamepad* pad)
+	{
+		uint32_t b = 0;
+		if (pad.buttonOptions.isPressed) b |= 1u << 0; // SELECT
+		if (pad.leftThumbstickButton.isPressed) b |= 1u << 1; // L3
+		if (pad.rightThumbstickButton.isPressed) b |= 1u << 2; // R3
+		if (pad.buttonMenu.isPressed) b |= 1u << 3; // START
+		if (pad.dpad.up.isPressed) b |= 1u << 4;
+		if (pad.dpad.right.isPressed) b |= 1u << 5;
+		if (pad.dpad.down.isPressed) b |= 1u << 6;
+		if (pad.dpad.left.isPressed) b |= 1u << 7;
+		if (pad.leftTrigger.isPressed) b |= 1u << 8; // L2
+		if (pad.rightTrigger.isPressed) b |= 1u << 9; // R2
+		if (pad.leftShoulder.isPressed) b |= 1u << 10; // L1
+		if (pad.rightShoulder.isPressed) b |= 1u << 11; // R1
+		if (pad.buttonY.isPressed) b |= 1u << 12; // TRIANGLE
+		if (pad.buttonB.isPressed) b |= 1u << 13; // CIRCLE
+		if (pad.buttonA.isPressed) b |= 1u << 14; // CROSS
+		if (pad.buttonX.isPressed) b |= 1u << 15; // SQUARE
+		s_pad_ps2_buttons.store(b);
+		s_pad_ps2_axes.store(AxisByte(pad.leftThumbstick.xAxis.value, false) |
+							 (AxisByte(pad.leftThumbstick.yAxis.value, true) << 8) |
+							 (AxisByte(pad.rightThumbstick.xAxis.value, false) << 16) |
+							 (AxisByte(pad.rightThumbstick.yAxis.value, true) << 24));
+	}
+
+	// The first controller with an extended gamepad profile drives the menu and the game.
+	void RefreshControllers()
+	{
+		GCExtendedGamepad* first = nil;
+		for (GCController* controller in [GCController controllers])
+		{
+			GCExtendedGamepad* pad = controller.extendedGamepad;
+			if (!pad)
+				continue;
+			pad.valueChangedHandler = ^(GCExtendedGamepad* gamepad, GCControllerElement*) {
+				if (gamepad == [[GCController controllers] firstObject].extendedGamepad)
+				{
+					s_pad_buttons.store(ButtonsFromGamepad(gamepad));
+					UpdatePs2(gamepad);
+				}
+			};
+			if (!first)
+				first = pad;
+		}
+		s_pad_connected.store(first != nil);
+		s_pad_buttons.store(first ? ButtonsFromGamepad(first) : 0);
+		if (first)
+			UpdatePs2(first);
+		else
+		{
+			s_pad_ps2_buttons.store(0);
+			s_pad_ps2_axes.store(0x80808080u);
+		}
+	}
+} // namespace
+
+@interface PS2RecompLiveWindowDelegate : NSObject <NSWindowDelegate>
+@end
+
+@implementation PS2RecompLiveWindowDelegate
+- (BOOL)windowShouldClose:(NSWindow*)sender
+{
+	// Like WM_CLOSE on Windows: ask the VM to stop; the window goes away with it.
+	if (s_callbacks.close)
+		s_callbacks.close();
+	return NO;
+}
+- (void)windowDidResize:(NSNotification*)notification
+{
+	if (s_callbacks.resize)
+		s_callbacks.resize();
+}
+- (void)windowDidChangeBackingProperties:(NSNotification*)notification
+{
+	if (s_callbacks.resize)
+		s_callbacks.resize();
+}
+- (void)windowDidBecomeKey:(NSNotification*)notification
+{
+	s_focused.store(true);
+}
+- (void)windowDidResignKey:(NSNotification*)notification
+{
+	s_focused.store(false);
+	if (s_callbacks.focus_lost)
+		s_callbacks.focus_lost();
+}
+- (void)windowDidEnterFullScreen:(NSNotification*)notification
+{
+	if (s_callbacks.fullscreen_changed)
+		s_callbacks.fullscreen_changed(true);
+}
+- (void)windowDidExitFullScreen:(NSNotification*)notification
+{
+	if (s_callbacks.fullscreen_changed)
+		s_callbacks.fullscreen_changed(false);
+}
+@end
+
+void LiveMac::Install(void* window_handle, const Callbacks& cb)
+{
+	static PS2RecompLiveWindowDelegate* s_delegate = nil;
+	static id s_key_monitor = nil;
+
+	s_callbacks = cb;
+	NSWindow* window = (__bridge NSWindow*)window_handle;
+	s_delegate = [[PS2RecompLiveWindowDelegate alloc] init];
+	window.delegate = s_delegate;
+	window.collectionBehavior |= NSWindowCollectionBehaviorFullScreenPrimary;
+
+	// Started from the game (a terminal process): come to the front with the keyboard focus.
+	// PS2X_HOST_NOACTIVATE=1 (automated tests): show the window without taking the focus.
+	const char* no_activate = std::getenv("PS2X_HOST_NOACTIVATE");
+	if (no_activate && *no_activate == '1')
+	{
+		[window orderFront:nil];
+	}
+	else
+	{
+		[NSApp activateIgnoringOtherApps:YES];
+		[window makeKeyAndOrderFront:nil];
+	}
+	s_focused.store(window.isKeyWindow);
+
+	if (s_key_monitor)
+		[NSEvent removeMonitor:s_key_monitor];
+	s_key_monitor = [NSEvent addLocalMonitorForEventsMatchingMask:NSEventMaskKeyDown | NSEventMaskKeyUp | NSEventMaskFlagsChanged
+														  handler:^NSEvent*(NSEvent* event) {
+		if (event.window != window)
+			return event;
+		const NSEventModifierFlags flags = event.modifierFlags;
+		const unsigned short code = event.keyCode;
+		if (event.type == NSEventTypeFlagsChanged)
+		{
+			// Modifiers have no key up/down: compare the device bits.
+			if (code == kVK_RightShift)
+				s_callbacks.key(LiveKey::RightShift, (flags & kRightShift) != 0, false);
+			else if (code == kVK_Control)
+				s_callbacks.key(LiveKey::Control, (flags & kLeftControl) != 0, false);
+			else if (code == kVK_RightControl)
+				s_callbacks.key(LiveKey::Control, (flags & kRightControl) != 0, false);
+			return event;
+		}
+		const bool down = event.type == NSEventTypeKeyDown;
+		const bool command = (flags & NSEventModifierFlagCommand) != 0;
+		if (down && command && (code == kVK_ANSI_Q || code == kVK_ANSI_W))
+		{
+			if (s_callbacks.close)
+				s_callbacks.close();
+			return nil;
+		}
+		// Option+Return (Alt+Enter on Windows), F11 or Ctrl+Cmd+F: fullscreen.
+		const bool fullscreen_key = (code == kVK_Return && (flags & NSEventModifierFlagOption)) || code == kVK_F11 ||
+									(code == kVK_ANSI_F && command && (flags & NSEventModifierFlagControl));
+		if (fullscreen_key)
+		{
+			if (down && !event.isARepeat && s_callbacks.toggle_fullscreen)
+				s_callbacks.toggle_fullscreen();
+			return nil;
+		}
+		if (command)
+			return event; // other Cmd shortcuts: AppKit
+		s_callbacks.key(KeyFromCode(code), down, down && event.isARepeat);
+		return nil; // handled: no beep from the plain content view
+	}];
+
+	NSNotificationCenter* center = [NSNotificationCenter defaultCenter];
+	[center addObserverForName:GCControllerDidConnectNotification object:nil queue:[NSOperationQueue mainQueue]
+					usingBlock:^(NSNotification*) { RefreshControllers(); }];
+	[center addObserverForName:GCControllerDidDisconnectNotification object:nil queue:[NSOperationQueue mainQueue]
+					usingBlock:^(NSNotification*) { RefreshControllers(); }];
+	RefreshControllers();
+}
+
+void LiveMac::ToggleFullscreen(void* window_handle)
+{
+	NSWindow* window = (__bridge NSWindow*)window_handle;
+	// The options menu applies settings on the CPU thread: AppKit only on the main thread.
+	dispatch_async(dispatch_get_main_queue(), ^{
+		[window toggleFullScreen:nil];
+	});
+}
+
+bool LiveMac::IsFocused()
+{
+	return s_focused.load();
+}
+
+bool LiveMac::ReadGamepad(uint16_t* buttons)
+{
+	if (!s_pad_connected.load())
+		return false;
+	*buttons = s_pad_buttons.load();
+	return true;
+}
+
+bool LiveMac::ReadGamepadPs2(uint32_t* buttons, uint32_t* axes)
+{
+	if (!s_pad_connected.load())
+		return false;
+	*buttons = s_pad_ps2_buttons.load();
+	*axes = s_pad_ps2_axes.load();
+	return true;
+}
