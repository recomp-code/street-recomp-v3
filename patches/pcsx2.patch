+static void RenderLiveMenu()
+{
+	std::lock_guard lock(s_menu_mutex);
+	if (s_menu_lines.empty())
+		return;
+
+	const float scale = ImGuiManager::GetGlobalScale();
+	ImFont* const font = ImGuiManager::GetStandardFont();
+	const float font_size = ImGuiManager::GetFontSizeStandard() * 1.15f;
+	const float pad = std::ceil(18.0f * scale);
+	const float line_h = font_size + std::ceil(8.0f * scale);
+
+	// "label\tvalue" lines: values start in a common column.
+	float label_w = 0.0f, value_w = 0.0f;
+	for (const std::string& line : s_menu_lines)
+	{
+		const size_t tab = line.find('\t');
+		const std::string label = line.substr(0, tab);
+		label_w = std::max(label_w, font->CalcTextSizeA(font_size, FLT_MAX, -1.0f, label.c_str()).x);
+		if (tab != std::string::npos)
+			value_w = std::max(value_w, font->CalcTextSizeA(font_size, FLT_MAX, -1.0f, line.c_str() + tab + 1).x);
+	}
+	const float column_gap = std::ceil(28.0f * scale);
+	float width = label_w + column_gap + value_w;
+	width = std::max(width, font->CalcTextSizeA(font_size * 1.2f, FLT_MAX, -1.0f, s_menu_title.c_str()).x);
+	width = std::max(width, font->CalcTextSizeA(font_size * 0.85f, FLT_MAX, -1.0f, s_menu_footer.c_str()).x);
+	width += pad * 2.0f;
+	const float height = pad * 2.0f + line_h * (static_cast<float>(s_menu_lines.size()) + 2.5f);
+
+	const ImVec2 display = ImGui::GetIO().DisplaySize;
+	const ImVec2 p0((display.x - width) * 0.5f, (display.y - height) * 0.5f);
+	const ImVec2 p1(p0.x + width, p0.y + height);
+	ImDrawList* dl = ImGui::GetForegroundDrawList();
+	dl->AddRectFilled(p0, p1, IM_COL32(10, 10, 20, 225), 10.0f * scale);
+	dl->AddRect(p0, p1, IM_COL32(255, 160, 40, 255), 10.0f * scale, 2.0f * scale);
+
+	float y = p0.y + pad;
+	dl->AddText(font, font_size * 1.2f, ImVec2(p0.x + pad, y), IM_COL32(255, 180, 60, 255), s_menu_title.c_str());
+	y += line_h * 1.5f;
+	for (size_t i = 0; i < s_menu_lines.size(); i++)
+	{
+		const bool selected = static_cast<int>(i) == s_menu_selected;
+		if (selected)
+			dl->AddRectFilled(ImVec2(p0.x + pad * 0.5f, y - 2.0f * scale), ImVec2(p1.x - pad * 0.5f, y + font_size + 4.0f * scale),
+				IM_COL32(40, 90, 200, 220), 6.0f * scale);
+		const ImU32 color = selected ? IM_COL32(255, 255, 255, 255) : IM_COL32(200, 200, 210, 255);
+		const std::string& line = s_menu_lines[i];
+		const size_t tab = line.find('\t');
+		dl->AddText(font, font_size, ImVec2(p0.x + pad, y), color, line.c_str(), tab == std::string::npos ? nullptr : line.c_str() + tab);
+		if (tab != std::string::npos)
+			dl->AddText(font, font_size, ImVec2(p0.x + pad + label_w + column_gap, y),
+				selected ? IM_COL32(255, 200, 90, 255) : IM_COL32(230, 230, 240, 255), line.c_str() + tab + 1);
+		y += line_h;
+	}
+	dl->AddText(font, font_size * 0.85f, ImVec2(p0.x + pad, y + line_h * 0.25f), IM_COL32(160, 160, 170, 255), s_menu_footer.c_str());
+}
