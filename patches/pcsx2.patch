+// lane, doubleword or rotate distance it takes.
+struct ArmLaneGatherBase
+{
+	u8 lane[4];
+	u8 kind;
+	u8 arg;
+};
+static constexpr ArmLaneGatherBase armLaneGatherBases[] = {
+	{{0, 1, 2, 3}, 0, 0},
+	{{0, 0, 0, 0}, 1, 0},
+	{{1, 1, 1, 1}, 1, 1},
+	{{2, 2, 2, 2}, 1, 2},
+	{{3, 3, 3, 3}, 1, 3},
+	{{0, 1, 0, 1}, 2, 0},
+	{{2, 3, 2, 3}, 2, 1},
