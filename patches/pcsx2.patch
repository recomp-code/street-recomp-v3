+void GSDevice::Upscale(GSTexture*& tex, GSVector4i& src_rect, GSVector4& src_uv, const GSVector4& draw_rect, int mode, GSTexture* depth)
+{
+	m_upscaler_depth = depth;
+	const int dst_width = static_cast<int>(std::ceil(draw_rect.z - draw_rect.x));
+	const int dst_height = static_cast<int>(std::ceil(draw_rect.w - draw_rect.y));
+	// Only an upscaler: when the internal resolution already covers the window, present as is.
+	if (dst_width <= src_rect.width() || dst_height <= src_rect.height() || dst_width <= 0 || dst_height <= 0)
+		return;
+
+	if (!m_upscaled || m_upscaled->GetWidth() != dst_width || m_upscaled->GetHeight() != dst_height)
+	{
+		delete m_upscaled;
+		m_upscaled = CreateSurface(GSTexture::ShaderWriteTexture, dst_width, dst_height, 1, GSTexture::Format::Color);
+		if (!m_upscaled)
+		{
+			Console.Error("Failed to allocate upscaler output texture.");
+			return;
+		}
+	}
+
+	const int used = DoUpscale(tex, src_rect, m_upscaled, mode, static_cast<float>(GSConfig.NbaUpscalerSharpness) * 0.01f);
+	static int s_last_used = -1;
+	if (used != s_last_used)
+	{
+		s_last_used = used;
+		Console.WriteLn("(PS2Recomp) upscaler: %s (%dx%d -> %dx%d)", used == 2 ? "NVIDIA DLSS" : (used == 1 ? "AMD FSR 1" : "unavailable"),
+			src_rect.width(), src_rect.height(), dst_width, dst_height);
+	}
+	if (!used)
+		return;
+
+	tex = m_upscaled;
+	src_rect = GSVector4i(0, 0, dst_width, dst_height);
+	src_uv = GSVector4(0.0f, 0.0f, 1.0f, 1.0f);
+}
