+			armAsm->Ldr(RQSCRATCH, mVUglobMem(&mVUglob.absclip[0]));
+			armAsm->And(Fs.V16B(), Fs.V16B(), RQSCRATCH.V16B());
+			armAsm->Fsqrt(a64::SRegister(Fs.GetCode()), a64::SRegister(Fs.GetCode()));
+			mVUwritePQresult(Fs, mVUinfo.writeP);
