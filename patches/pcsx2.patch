+
+static void LivePadKey(LiveKey key, bool down)
+{
+	u32 bit = 0;
+	u32 stick = 0;
+	switch (key)
+	{
+		case LiveKey::Up: bit = 1u << 4; break;
+		case LiveKey::Right: bit = 1u << 5; break;
+		case LiveKey::Down: bit = 1u << 6; break;
+		case LiveKey::Left: bit = 1u << 7; break;
+		case LiveKey::Z: bit = 1u << 15; break;
+		case LiveKey::X: bit = 1u << 14; break;
+		case LiveKey::C: bit = 1u << 13; break;
+		case LiveKey::V: bit = 1u << 12; break;
+		case LiveKey::Q: bit = 1u << 10; break;
+		case LiveKey::E: bit = 1u << 11; break;
+		case LiveKey::Num1: bit = 1u << 8; break;
+		case LiveKey::Num3: bit = 1u << 9; break;
+		case LiveKey::Return: bit = 1u << 3; break;
+		case LiveKey::Backspace: bit = 1u << 0; break;
+		case LiveKey::RightShift: bit = 1u << 0; break;
+		case LiveKey::Control: bit = 1u << 1; break;
+		case LiveKey::A: stick = 1; break;
+		case LiveKey::D: stick = 2; break;
+		case LiveKey::W: stick = 4; break;
+		case LiveKey::S: stick = 8; break;
+		default: return;
+	}
+	if (down)
+	{
+		s_live_keys |= bit;
+		s_live_stick |= stick;
+	}
+	else
+	{
+		s_live_keys &= ~bit;
+		s_live_stick &= ~stick;
+	}
+	LivePublishPad();
+}
