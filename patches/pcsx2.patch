+// PS2Recomp scripted capture (deterministic with PS2X_LIVE_PLAYBACK), counted in vsyncs:
+//   PS2X_CAPTURE=<file.mp4> PS2X_CAPTURE_FROM=<n> PS2X_CAPTURE_FRAMES=<n> [PS2X_CAPTURE_SIZE=WxH]
+//   PS2X_SHOT_FRAMES=<n,n,...> (+ PS2X_SHOT_DIR) screenshots, PS2X_EXIT_FRAME=<n> closes the host.
+static void NbaScriptedCapture(GSRenderer& renderer)
+{
+	static u64 s_vsync = 0;
+	static const char* s_capture = std::getenv("PS2X_CAPTURE");
+	static const u64 s_capture_from = [] { const char* v = std::getenv("PS2X_CAPTURE_FROM"); return v ? std::strtoull(v, nullptr, 10) : 0ull; }();
+	static const u64 s_capture_frames = [] { const char* v = std::getenv("PS2X_CAPTURE_FRAMES"); return v ? std::strtoull(v, nullptr, 10) : 600ull; }();
+	static const u64 s_exit_frame = [] { const char* v = std::getenv("PS2X_EXIT_FRAME"); return v ? std::strtoull(v, nullptr, 10) : 0ull; }();
+	static const std::vector<u64> s_shots = [] {
+		std::vector<u64> frames;
+		if (const char* v = std::getenv("PS2X_SHOT_FRAMES"))
+			for (const std::string_view item : StringUtil::SplitString(v, ','))
+				if (const std::optional<u64> n = StringUtil::FromChars<u64>(item))
+					frames.push_back(*n);
+		return frames;
+	}();
+
+	const u64 n = s_vsync++;
+	if (s_capture && *s_capture)
+	{
+		if (n == s_capture_from)
+		{
+			GSVector2i size(0, 0);
+			if (const char* v = std::getenv("PS2X_CAPTURE_SIZE"))
+				std::sscanf(v, "%dx%d", &size.x, &size.y);
+			if (size.x == 0 || size.y == 0)
+				size = GSVector2i(1920, 1080);
+			// NTSC rate and the window's aspect: the replayer's video mode is not reliable here.
+			const bool ok = GSCapture::BeginCapture(59.94f, size, static_cast<float>(size.x) / static_cast<float>(size.y), s_capture);
+			Console.WriteLn("(PS2Recomp) capture to '%s' at vsync %llu: %s", s_capture, n, ok ? "started" : "FAILED");
+		}
+		else if (n == s_capture_from + s_capture_frames)
+		{
+			renderer.EndCapture();
+			Console.WriteLn("(PS2Recomp) capture finished at vsync %llu.", n);
+		}
+	}
+	for (const u64 shot : s_shots)
+	{
+		if (shot == n)
+		{
+			const char* dir = std::getenv("PS2X_SHOT_DIR");
+			renderer.QueueSnapshot(Path::Combine(dir ? dir : EmuFolders::Snapshots, fmt::format("frame_{}.png", n)), 0);
+		}
+	}
+	if (s_exit_frame != 0 && n == s_exit_frame)
+		Host::RequestVMShutdown(false, false, false);
+}
