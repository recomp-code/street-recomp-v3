+					(s_live.producer_process && WaitForSingleObject(s_live.producer_process, 0) == WAIT_OBJECT_0))
+				{
+					Host::RequestVMShutdown(false, false, false);
+					return false;
+				}
+				LARGE_INTEGER waitStart, waitEnd;
+				QueryPerformanceCounter(&waitStart);
+				// Announce the wait so the game signals the event (it skips SetEvent otherwise),
+				// then re-check: data written before the announcement was seen would not wake us.
+				s_live.header->consumerWaiting = 1;
+				MemoryBarrier();
+				if (s_live.header->writePos == w)
+					WaitForSingleObject(s_live.data_event, 10);
+				s_live.header->consumerWaiting = 0;
+				QueryPerformanceCounter(&waitEnd);
+				s_live_wait_ticks += static_cast<u64>(waitEnd.QuadPart - waitStart.QuadPart);
+				continue;
+			}
+			MemoryBarrier();
+			const u64 offset = static_cast<u64>(r) % s_live.capacity;
+			const size_t chunk = static_cast<size_t>(std::min<u64>({static_cast<u64>(size), avail, s_live.capacity - offset}));
+			std::memcpy(out, s_live.data + offset, chunk);
+			MemoryBarrier();
+			s_live.header->readPos = r + static_cast<s64>(chunk);
+			MemoryBarrier(); // readPos store before the producerWaiting load
+			if (!s_live.header->producerFlags || s_live.header->producerWaiting)
+				SetEvent(s_live.space_event);
+			out += chunk;
+			size -= chunk;
+		}
+		return true;
+	}
+
+	template <typename T>
+	bool LiveReadValue(T* value)
+	{
+		return LiveRead(value, sizeof(T));
+	}
+
+	bool LiveSkip(size_t size)
+	{
+		u8 scratch[4096];
+		while (size > 0)
+		{
+			const size_t chunk = std::min(size, sizeof(scratch));
+			if (!LiveRead(scratch, chunk))
+				return false;
+			size -= chunk;
+		}
+		return true;
