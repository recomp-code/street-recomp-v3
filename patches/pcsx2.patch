+static void GSDumpReplayerLiveStep()
+{
+	if (!s_live.stream_header_done)
+	{
+		// Same layout as a .gs file: crc, header size, header (+serial), state, registers.
+		u32 crc = 0, header_size = 0;
+		if (!LiveReadValue(&crc) || !LiveReadValue(&header_size))
+			return;
+		u32 state_size = header_size;
+		if (crc == 0xFFFFFFFFu)
+		{
+			std::vector<u8> header(header_size);
+			if (!LiveRead(header.data(), header.size()))
+				return;
+			GSDumpHeader dump_header = {};
+			std::memcpy(&dump_header, header.data(), std::min<size_t>(sizeof(dump_header), header.size()));
+			state_size = dump_header.state_size;
+		}
+		if (!LiveSkip(state_size))
+			return;
+		if (!LiveRead(PS2MEM_GS, Ps2MemSize::GSregs))
+			return;
+		s_live.stream_header_done = true;
+		Console.WriteLn("(GSDumpReplayer) Live GS stream connected.");
+	}
+
+	u8 id = 0;
+	if (!LiveReadValue(&id))
+		return;
+
+	if (id == kLivePacketVif1)
+	{
+		u32 length = 0;
+		if (!LiveReadValue(&length))
+			return;
+		s_live.buffer.resize((length + 15) & ~15u);
+		if (!LiveRead(s_live.buffer.data(), length))
+			return;
+		if (length >= 4)
