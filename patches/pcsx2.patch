+// PS2Recomp: the game draws frame N+1 with the same Z buffer while frame N is on screen, so the
+// depth of a finished frame only exists until the next frame starts. Whenever a depth-using draw
+// moves to another colour target, the previous target's depth is complete: keep a copy of it,
+// tagged with that frame's address. GetUpscalerDepth() hands DLSS the copy of the shown frame.
+void GSRendererHW::NbaTrackDepth(GSTextureCache::Target* rt, GSTextureCache::Target* ds)
+{
+	const bool uses_depth = !m_cached_ctx.ZBUF.ZMSK || (m_cached_ctx.TEST.ZTE && m_cached_ctx.TEST.ZTST > ZTST_ALWAYS);
+	if (!uses_depth || m_using_temp_z || !ds->m_texture)
+		return;
+
+	const u32 frame_bp = rt->m_TEX0.TBP0;
+	const u32 depth_bp = ds->m_TEX0.TBP0;
+	m_nba_last_depth_bp = depth_bp;
+	m_nba_last_depth_psm = ds->m_TEX0.PSM;
+
+	// Last colour target per Z buffer (render-to-texture passes use their own Z buffers).
+	NbaDepthUse* use = nullptr;
+	for (NbaDepthUse& u : m_nba_depth_uses)
+	{
+		if (u.depth_bp == depth_bp)
+		{
+			use = &u;
+			break;
+		}
+	}
+	if (!use)
+	{
+		use = &m_nba_depth_uses[m_nba_depth_use_next++ % std::size(m_nba_depth_uses)];
+		*use = {depth_bp, frame_bp};
+		return;
+	}
+
+	const u32 done_bp = use->frame_bp;
+	use->frame_bp = frame_bp;
+	// Only frames that are (or recently were) on screen matter; skips render-to-texture targets.
+	if (frame_bp != done_bp && (done_bp == m_nba_display_bp || done_bp == m_nba_prev_display_bp))
+	{
+		GSTexture* const src = ds->m_texture;
+		if (!m_nba_saved_depth || m_nba_saved_depth->GetSize() != src->GetSize())
+		{
+			delete m_nba_saved_depth;
+			m_nba_saved_depth = g_gs_device->CreateDepthStencil(src->GetSize(), false, false);
+		}
+		if (m_nba_saved_depth)
+		{
+			g_gs_device->CopyRect(src, m_nba_saved_depth, GSVector4i(0, 0, src->GetWidth(), src->GetHeight()), 0, 0);
+			m_nba_saved_depth_bp = done_bp;
+		}
+	}
+}
+
+void GSRendererHW::NbaFreeDepth()
+{
+	delete m_nba_saved_depth;
+	m_nba_saved_depth = nullptr;
+	m_nba_saved_depth_bp = ~0u;
+	m_nba_last_depth_bp = ~0u;
+	for (NbaDepthUse& u : m_nba_depth_uses)
+		u = {~0u, ~0u};
+}
+
+GSTexture* GSRendererHW::GetUpscalerDepth()
+{
+	static const bool s_log = std::getenv("PS2X_DLSS_DEPTH_LOG") != nullptr;
+	static u32 s_n = 0;
+	if (s_log && (s_n++ % 120) == 0)
+	{
+		Console.WriteLn("(PS2Recomp) depth: display %x prev %x saved %x(%p) uses %x>%x %x>%x %x>%x %x>%x", m_nba_display_bp,
+			m_nba_prev_display_bp, m_nba_saved_depth_bp, m_nba_saved_depth, m_nba_depth_uses[0].depth_bp, m_nba_depth_uses[0].frame_bp,
+			m_nba_depth_uses[1].depth_bp, m_nba_depth_uses[1].frame_bp, m_nba_depth_uses[2].depth_bp, m_nba_depth_uses[2].frame_bp,
+			m_nba_depth_uses[3].depth_bp, m_nba_depth_uses[3].frame_bp);
+	}
+	// Page flipping games: the copy taken when the shown frame was finished.
+	if (m_nba_saved_depth && m_nba_saved_depth_bp == m_nba_display_bp)
+		return m_nba_saved_depth;
+	// Games that render into one back buffer and copy it to the display buffer: the frame is
+	// finished when the vsync arrives (the GS stream is processed in order), so the live Z buffer
+	// of the last 3D draw is exactly the shown frame's depth.
+	if (m_nba_last_depth_bp != ~0u && m_nba_saved_depth_bp == ~0u)
+	{
+		if (GSTextureCache::Target* ds = g_texture_cache->GetTargetWithSharedBits(m_nba_last_depth_bp, m_nba_last_depth_psm))
+			return ds->m_texture;
+	}
+	return nullptr;
+}
