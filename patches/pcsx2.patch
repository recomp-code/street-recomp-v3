+void mVUGenerateModelStubs(mV)
+{
+	for (int i = 0; i < mVUModelStubCount; i++)
+	{
+		mVU.modelStubs[i] = armStartBlock();
+		armDynGenEeFpuModelStub(mVUModelStubTarget(i, mVU.index));
+		armEndBlock();
+	}
+}
