+static LiveKey LiveKeyFromVK(WPARAM vk, LPARAM lParam)
+{
+	switch (vk)
+	{
+		case VK_UP: return LiveKey::Up;
+		case VK_RIGHT: return LiveKey::Right;
+		case VK_DOWN: return LiveKey::Down;
+		case VK_LEFT: return LiveKey::Left;
+		case 'Z': return LiveKey::Z;
+		case 'X': return LiveKey::X;
+		case 'C': return LiveKey::C;
+		case 'V': return LiveKey::V;
+		case 'Q': return LiveKey::Q;
+		case 'E': return LiveKey::E;
+		case '1': return LiveKey::Num1;
+		case '3': return LiveKey::Num3;
+		case VK_RETURN: return LiveKey::Return;
+		case VK_BACK: return LiveKey::Backspace;
+		case VK_SHIFT:
+			return MapVirtualKeyW((lParam >> 16) & 0xFF, MAPVK_VSC_TO_VK_EX) == VK_RSHIFT ? LiveKey::RightShift : LiveKey::Other;
+		case VK_CONTROL: return LiveKey::Control;
+		case 'A': return LiveKey::A;
+		case 'D': return LiveKey::D;
+		case 'W': return LiveKey::W;
+		case 'S': return LiveKey::S;
+		case VK_F1: return LiveKey::F1;
+		case VK_ESCAPE: return LiveKey::Escape;
+		case VK_SPACE: return LiveKey::Space;
+		default: return LiveKey::Other;
+	}
