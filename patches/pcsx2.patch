+// Gamepad (polled at every vsync on the CPU thread): Back+Start or a long START toggles the menu.
+static void LiveMenuPollGamepad()
+{
+#ifdef __APPLE__
+	LivePublishPad(); // the controller's state for the game, every vsync
+#endif
+	static u16 s_prev = 0;
+	u16 buttons = 0;
+	if (!LivePlatformReadGamepad(&buttons))
+	{
+		s_prev = 0;
+		return;
+	}
+	const u16 pressed = buttons & ~s_prev;
+	s_prev = buttons;
+	constexpr u16 combo = LivePad::Back | LivePad::Start;
+	if ((buttons & combo) == combo && (pressed & combo))
+	{
+		LiveMenuDo(LiveMenuAction::Toggle);
+		return;
+	}
+	// Holding START alone for 1.5 s also toggles it (pads without a handy Back button). Fires once
+	// per hold; the short press still reaches the game as its normal pause.
+	using Clock = std::chrono::steady_clock;
+	static Clock::time_point s_start_since{};
+	static bool s_start_fired = false;
+	if (buttons == LivePad::Start)
+	{
+		const Clock::time_point now = Clock::now();
+		if (pressed & LivePad::Start)
+		{
+			s_start_since = now;
+			s_start_fired = false;
+		}
+		else if (!s_start_fired && s_start_since != Clock::time_point{} && now - s_start_since >= std::chrono::milliseconds(1500))
+		{
+			s_start_fired = true;
+			LiveMenuDo(LiveMenuAction::Toggle);
+			return;
+		}
+	}
+	else
+	{
+		s_start_since = {};
+	}
+	if (!s_menu_open.load())
+		return;
+	if (pressed & LivePad::DpadUp)
+		LiveMenuDo(LiveMenuAction::Up);
+	if (pressed & LivePad::DpadDown)
+		LiveMenuDo(LiveMenuAction::Down);
+	if (pressed & LivePad::DpadLeft)
+		LiveMenuDo(LiveMenuAction::Left);
+	if (pressed & LivePad::DpadRight)
+		LiveMenuDo(LiveMenuAction::Right);
+	if (pressed & LivePad::A)
+		LiveMenuDo(LiveMenuAction::Accept);
+	if (pressed & LivePad::B)
+		LiveMenuDo(LiveMenuAction::Close);
+}
+
+// Keyboard from the window thread: queued to the CPU thread. True when the key was the menu's.
+static bool LiveMenuKey(LiveKey key)
+{
+	LiveMenuAction action;
+	if (key == LiveKey::F1)
+		action = LiveMenuAction::Toggle;
+	else if (!s_menu_open.load())
+		return false;
+	else if (key == LiveKey::Up)
+		action = LiveMenuAction::Up;
+	else if (key == LiveKey::Down)
+		action = LiveMenuAction::Down;
+	else if (key == LiveKey::Left)
+		action = LiveMenuAction::Left;
+	else if (key == LiveKey::Right)
+		action = LiveMenuAction::Right;
+	else if (key == LiveKey::Return || key == LiveKey::Space)
+		action = LiveMenuAction::Accept;
+	else if (key == LiveKey::Escape || key == LiveKey::Backspace)
+		action = LiveMenuAction::Close;
+	else
+		return true; // the menu owns the keyboard while open
+	Host::RunOnCPUThread([action]() { LiveMenuDo(action); });
+	return true;
+}
