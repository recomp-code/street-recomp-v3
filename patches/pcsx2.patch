+	const u32 left = s_live_stick ? (lx | (ly << 8)) : (pad_axes & 0xFFFFu);
+	GSDumpReplayer::SetLivePad(s_live_keys | pad_buttons, left | (pad_axes & 0xFFFF0000u));
+#else
+	GSDumpReplayer::SetLivePad(s_live_keys, lx | (ly << 8) | (0x80u << 16) | (0x80u << 24));
+#endif
