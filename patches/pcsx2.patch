+
+bool GSDumpReplayer::AttachLiveRing(Error* error)
+{
+#ifdef _WIN32
+	HANDLE mapping = nullptr;
+	const std::wstring mapping_name = ps2live::objectName(ps2live::kMappingName, s_live_ring_suffix);
+	// The game creates the ring before starting us; give it a moment anyway.
+	for (int attempt = 0; attempt < 100 && !mapping; attempt++)
+	{
+		mapping = OpenFileMappingW(FILE_MAP_ALL_ACCESS, FALSE, mapping_name.c_str());
+		if (!mapping)
+			Sleep(50);
+	}
+	if (!mapping)
+	{
+		Error::SetString(error, "PS2Recomp live GS ring not found (start the game, not this program).");
+		return false;
+	}
+	void* view = MapViewOfFile(mapping, FILE_MAP_ALL_ACCESS, 0, 0, 0);
+	if (!view)
+	{
+		CloseHandle(mapping);
+		Error::SetString(error, "Failed to map the live GS ring.");
+		return false;
+	}
+	ps2live::RingHeader* header = static_cast<ps2live::RingHeader*>(view);
+	if (header->magic != ps2live::kMagic || header->version != ps2live::kVersion)
+	{
+		Error::SetString(error, "Live GS ring version mismatch.");
+		return false;
+	}
+	s_live.mapping = mapping;
+	s_live.header = header;
+	s_live.data = ps2live::ringData(header);
+	s_live.capacity = header->capacity;
+	s_live.data_event = OpenEventW(SYNCHRONIZE | EVENT_MODIFY_STATE, FALSE,
+		ps2live::objectName(ps2live::kDataEventName, s_live_ring_suffix).c_str());
+	s_live.space_event = OpenEventW(SYNCHRONIZE | EVENT_MODIFY_STATE, FALSE,
+		ps2live::objectName(ps2live::kSpaceEventName, s_live_ring_suffix).c_str());
+	if (!s_live_ring_suffix.empty())
+	{
+		const DWORD pid = static_cast<DWORD>(std::wcstoul(s_live_ring_suffix.c_str(), nullptr, 10));
+		if (pid != 0)
+			s_live.producer_process = OpenProcess(SYNCHRONIZE, FALSE, pid);
+	}
+	header->consumerAlive = 1;
+	header->consumerFlags = 1;
+	s_live_mode = true;
+	s_live_mode_early = true;
+	return true;
+#else
+	Error::SetString(error, "Live mode is only implemented on Windows.");
+	return false;
+#endif
+}
+
+void GSDumpReplayer::SetLivePad(u32 buttons, u32 axes)
+{
+#ifdef _WIN32
+	if (!s_live.header)
+		return;
+	s_live.header->padButtons = buttons;
+	s_live.header->padAxes = axes;
+	s_live.header->padSequence = s_live.header->padSequence + 1;
+#endif
+}
+
+void GSDumpReplayer::SetLiveMenuOpen(bool open)
+{
+#ifdef _WIN32
+	if (s_live.header)
+		s_live.header->hostMenuOpen = open ? 1u : 0u;
+#endif
+}
+
+void GSDumpReplayer::SetLiveQuit()
+{
+#ifdef _WIN32
+	if (s_live.header)
+		s_live.header->consumerQuit = 1;
+#endif
+}
+
+bool GSDumpReplayer::WriteLiveBootDump(const std::string& path, Error* error)
+{
+	auto fp = FileSystem::OpenManagedCFile(path.c_str(), "wb", error);
+	if (!fp)
+		return false;
+	static constexpr char serial[] = "SLUS-21126";
+	const u32 crc = 0xFFFFFFFFu;
+	const u32 header_size = static_cast<u32>(sizeof(GSDumpHeader) + sizeof(serial) - 1);
+	GSDumpHeader header = {};
+	header.state_version = 9;
+	header.state_size = 0;
+	header.serial_offset = sizeof(GSDumpHeader);
+	header.serial_size = sizeof(serial) - 1;
+	header.screenshot_offset = header.serial_offset + header.serial_size;
+	std::vector<u8> regs(8192, 0);
+	bool ok = std::fwrite(&crc, 4, 1, fp.get()) == 1;
+	ok = ok && std::fwrite(&header_size, 4, 1, fp.get()) == 1;
+	ok = ok && std::fwrite(&header, sizeof(header), 1, fp.get()) == 1;
+	ok = ok && std::fwrite(serial, sizeof(serial) - 1, 1, fp.get()) == 1;
+	ok = ok && std::fwrite(regs.data(), regs.size(), 1, fp.get()) == 1;
+	if (!ok)
+		Error::SetString(error, "Failed to write the live boot dump.");
+	return ok;
+}
