+static void LiveMenuPublish()
+{
+	if (!s_menu_open.load())
+	{
+		GSDumpReplayer::SetLiveMenu({}, {}, -1, {});
+		return;
+	}
+	std::vector<std::string> lines;
+	for (const LiveMenuOption& opt : s_menu)
+	{
+		if (opt.names.empty())
+			lines.emplace_back(opt.label);
+		else
+			lines.push_back(fmt::format("{}\t<  {}  >", opt.label, opt.names[opt.index])); // tab = value column
+	}
+	GSDumpReplayer::SetLiveMenu("Opciones graficas", std::move(lines), s_menu_selected,
+		"Flechas/cruceta: elegir y cambiar   Enter/A: aceptar   Esc/B o F1: cerrar");
+}
