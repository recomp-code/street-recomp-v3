+#if defined(PS2X_LIVE_RING) && !defined(_WIN32)
+// POSIX side of AttachLiveRing: map the game's shm_open ring.
+static bool AttachLiveRingMapping(Error* error)
+{
+	const std::string mapping_name = ps2live::objectName(ps2live::kPosixMappingName, s_live_ring_suffix);
+	// The game creates the ring before starting us; give it a moment anyway.
+	int fd = -1;
+	for (int attempt = 0; attempt < 100 && fd < 0; attempt++)
+	{
+		fd = shm_open(mapping_name.c_str(), O_RDWR, 0);
+		if (fd < 0)
+			Threading::Sleep(50);
+	}
+	if (fd < 0)
+	{
+		Error::SetString(error, "PS2Recomp live GS ring not found (start the game, not this program).");
+		return false;
+	}
+	struct stat st = {};
+	void* view = MAP_FAILED;
+	if (fstat(fd, &st) == 0 && static_cast<u64>(st.st_size) > sizeof(ps2live::RingHeader))
+		view = mmap(nullptr, static_cast<size_t>(st.st_size), PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+	if (view == MAP_FAILED)
+	{
+		close(fd);
+		Error::SetString(error, "Failed to map the live GS ring.");
+		return false;
+	}
+	ps2live::RingHeader* header = static_cast<ps2live::RingHeader*>(view);
+	if (header->magic != ps2live::kMagic || header->version != ps2live::kVersion ||
+		static_cast<u64>(st.st_size) < ps2live::mappingSize(header->capacity))
+	{
+		Error::SetString(error, "Live GS ring version mismatch.");
+		return false;
+	}
+	s_live.mapping_fd = fd;
+	s_live.header = header;
+	s_live.data = ps2live::ringData(header);
+	s_live.capacity = header->capacity;
+	s_live.events = ps2live::ringEvents(header);
+	if (!s_live_ring_suffix.empty())
+		s_live.producer_pid = static_cast<pid_t>(std::strtoul(s_live_ring_suffix.c_str(), nullptr, 10));
+	return true;
+}
+#endif
+
+bool GSDumpReplayer::AttachLiveRing(Error* error)
+{
+#ifdef PS2X_LIVE_RING
+	if (const char* playback = std::getenv("PS2X_LIVE_PLAYBACK"); playback && *playback)
+	{
+		s_live_playback = std::fopen(playback, "rb");
+		if (!s_live_playback)
+		{
+			Error::SetStringFmt(error, "Cannot open live playback file '{}'.", playback);
+			return false;
+		}
+		std::setvbuf(s_live_playback, nullptr, _IOFBF, 4 << 20);
+		s_live_playback_header.magic = ps2live::kMagic;
+		s_live_playback_header.version = ps2live::kVersion;
+		s_live.header = &s_live_playback_header;
+		s_live_mode = true;
+		s_live_mode_early = true;
+		Console.WriteLn("(GSDumpReplayer) Live playback from '%s'.", playback);
+		return true;
+	}
+	if (const char* record = std::getenv("PS2X_LIVE_RECORD"); record && *record)
+	{
+		s_live_record = std::fopen(record, "wb");
+		if (s_live_record)
+			std::setvbuf(s_live_record, nullptr, _IOFBF, 4 << 20);
+		Console.WriteLn("(GSDumpReplayer) Recording the live stream to '%s'%s.", record, s_live_record ? "" : " FAILED");
+	}
+#ifdef _WIN32
+	HANDLE mapping = nullptr;
+	const std::wstring mapping_name = ps2live::objectName(ps2live::kMappingName, s_live_ring_suffix);
+	// The game creates the ring before starting us; give it a moment anyway.
+	for (int attempt = 0; attempt < 100 && !mapping; attempt++)
+	{
+		mapping = OpenFileMappingW(FILE_MAP_ALL_ACCESS, FALSE, mapping_name.c_str());
+		if (!mapping)
+			Sleep(50);
+	}
+	if (!mapping)
+	{
+		Error::SetString(error, "PS2Recomp live GS ring not found (start the game, not this program).");
+		return false;
+	}
+	void* view = MapViewOfFile(mapping, FILE_MAP_ALL_ACCESS, 0, 0, 0);
+	if (!view)
+	{
+		CloseHandle(mapping);
+		Error::SetString(error, "Failed to map the live GS ring.");
+		return false;
+	}
+	ps2live::RingHeader* header = static_cast<ps2live::RingHeader*>(view);
+	if (header->magic != ps2live::kMagic || header->version != ps2live::kVersion)
+	{
+		Error::SetString(error, "Live GS ring version mismatch.");
+		return false;
+	}
+	s_live.mapping = mapping;
+	s_live.header = header;
+	s_live.data = ps2live::ringData(header);
+	s_live.capacity = header->capacity;
+	s_live.data_event = OpenEventW(SYNCHRONIZE | EVENT_MODIFY_STATE, FALSE,
+		ps2live::objectName(ps2live::kDataEventName, s_live_ring_suffix).c_str());
+	s_live.space_event = OpenEventW(SYNCHRONIZE | EVENT_MODIFY_STATE, FALSE,
+		ps2live::objectName(ps2live::kSpaceEventName, s_live_ring_suffix).c_str());
+	if (!s_live_ring_suffix.empty())
+	{
+		const DWORD pid = static_cast<DWORD>(std::wcstoul(s_live_ring_suffix.c_str(), nullptr, 10));
+		if (pid != 0)
+			s_live.producer_process = OpenProcess(SYNCHRONIZE, FALSE, pid);
+	}
+#else
+	if (!AttachLiveRingMapping(error))
+		return false;
+	ps2live::RingHeader* header = s_live.header;
+#endif
+	header->consumerAlive = 1;
+	header->consumerFlags = 1;
+	s_live_mode = true;
+	s_live_mode_early = true;
+	return true;
+#else
+	Error::SetString(error, "Live mode is not implemented on this platform.");
+	return false;
+#endif
+}
