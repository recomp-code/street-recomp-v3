+// EEXP polynomial helper: pq[0] += (Fs^n) * E_n.
+// Matches the x86 eexpHelper macro.
+#define eexpHelper_arm(addr) \
+	do { \
+		NEON_MULSS_Series(mVU, t2, Fs); \
+		mVUmovAPSReg(t1, t2); \
+		mVUmulSSConst(t1, (addr)); \
+		NEON_ADDSS(mVU, pq, t1); \
+	} while (0)
