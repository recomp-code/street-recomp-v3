+bool GSDevice12::InitDLSS()
+{
+	if (m_dlss_tried)
+		return m_dlss_ok;
+	m_dlss_tried = true;
+
+	// NGX writes its logs/cache next to the executable (where nvngx_dlss.dll also lives).
+	wchar_t exe_path[MAX_PATH] = {};
+	GetModuleFileNameW(nullptr, exe_path, MAX_PATH);
+	std::wstring data_path(exe_path);
+	data_path = data_path.substr(0, data_path.find_last_of(L"\\/"));
+
+	NVSDK_NGX_Result res = NVSDK_NGX_D3D12_Init_with_ProjectID("6c1a4b5e-3f2d-4e8b-9a71-5d0c2e9f8b34",
+		NVSDK_NGX_ENGINE_TYPE_CUSTOM, "1.0", data_path.c_str(), m_device.get());
+	if (NVSDK_NGX_FAILED(res))
+	{
+		Console.Error("(PS2Recomp) DLSS (D3D12): NGX init failed (0x%08X).", static_cast<u32>(res));
+		return false;
+	}
+
+	NVSDK_NGX_Parameter* params = nullptr;
+	res = NVSDK_NGX_D3D12_GetCapabilityParameters(&params);
+	if (NVSDK_NGX_FAILED(res) || !params)
+	{
+		Console.Error("(PS2Recomp) DLSS (D3D12): no NGX capability parameters (0x%08X).", static_cast<u32>(res));
+		NVSDK_NGX_D3D12_Shutdown1(m_device.get());
+		return false;
+	}
+	int available = 0;
+	NVSDK_NGX_Parameter_GetI(params, NVSDK_NGX_Parameter_SuperSampling_Available, &available);
+	if (!available)
+	{
+		int needs_driver = 0;
+		NVSDK_NGX_Parameter_GetI(params, NVSDK_NGX_Parameter_SuperSampling_NeedsUpdatedDriver, &needs_driver);
+		Console.Error("(PS2Recomp) DLSS (D3D12) not available on this GPU/driver%s.", needs_driver ? " (driver update needed)" : "");
+		NVSDK_NGX_D3D12_DestroyParameters(params);
+		NVSDK_NGX_D3D12_Shutdown1(m_device.get());
+		return false;
+	}
+	m_ngx_params = params;
+	m_dlss_ok = true;
+	Console.WriteLn("(PS2Recomp) DLSS ready (NGX initialised, Direct3D 12).");
+	return true;
+}
