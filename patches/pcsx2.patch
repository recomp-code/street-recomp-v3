+bool GSDevice12::DoDLSS(GSTexture12* sTex, const GSVector4i& src_rect, GSTexture12* dTex)
+{
+	NVSDK_NGX_Parameter* params = static_cast<NVSDK_NGX_Parameter*>(m_ngx_params);
+	const int in_w = src_rect.width(), in_h = src_rect.height();
+	const int out_w = dTex->GetWidth(), out_h = dTex->GetHeight();
+
+	EndRenderPass();
+
+	// (Re)create the feature and the zero depth / motion vector inputs when the sizes change.
+	if (!m_dlss_feature || in_w != m_dlss_in_w || in_h != m_dlss_in_h || out_w != m_dlss_out_w || out_h != m_dlss_out_h)
+	{
+		if (m_dlss_feature)
+		{
+			ExecuteCommandList(true); // the old feature may still be in use by the GPU
+			NVSDK_NGX_D3D12_ReleaseFeature(static_cast<NVSDK_NGX_Handle*>(m_dlss_feature));
+			m_dlss_feature = nullptr;
+		}
+		delete m_dlss_depth;
+		delete m_dlss_mv;
+		m_dlss_depth = CreateSurface(GSTexture::RenderTarget, in_w, in_h, 1, GSTexture::Format::DepthColor);
+		m_dlss_mv = CreateSurface(GSTexture::RenderTarget, in_w, in_h, 1, GSTexture::Format::ColorHDR);
+		if (!m_dlss_depth || !m_dlss_mv)
+			return false;
+		ClearRenderTarget(m_dlss_depth, 0);
+		ClearRenderTarget(m_dlss_mv, 0);
+
+		NVSDK_NGX_DLSS_Create_Params create = {};
+		create.Feature.InWidth = in_w;
+		create.Feature.InHeight = in_h;
+		create.Feature.InTargetWidth = out_w;
+		create.Feature.InTargetHeight = out_h;
+		create.Feature.InPerfQualityValue = NVSDK_NGX_PerfQuality_Value_MaxQuality;
+		// LDR input, motion vectors at render resolution, no exposure texture; PS2 Z grows towards
+		// the camera ("inverted" depth in DLSS terms).
+		create.InFeatureCreateFlags = NVSDK_NGX_DLSS_Feature_Flags_MVLowRes | NVSDK_NGX_DLSS_Feature_Flags_AutoExposure |
+		                              NVSDK_NGX_DLSS_Feature_Flags_DepthInverted;
+		NVSDK_NGX_Handle* handle = nullptr;
+		const NVSDK_NGX_Result res = NGX_D3D12_CREATE_DLSS_EXT(GetCommandList().list4.get(), 1, 1, &handle, params, &create);
+		m_dlss_in_w = in_w, m_dlss_in_h = in_h, m_dlss_out_w = out_w, m_dlss_out_h = out_h;
+		if (NVSDK_NGX_FAILED(res) || !handle)
+		{
+			static int s_fail_logs = 0;
+			if (s_fail_logs++ < 4)
+				Console.Error("(PS2Recomp) DLSS (D3D12) feature %dx%d -> %dx%d failed (0x%08X).", in_w, in_h, out_w, out_h,
+					static_cast<u32>(res));
+			return false;
+		}
+		m_dlss_feature = handle;
+		InvalidateCachedState();
+	}
+	if (!m_dlss_feature)
+		return false;
+
+	const D3D12CommandList& cmdlist = GetCommandList();
+	// The game's real depth buffer of the shown frame when the renderer has one that covers the
+	// input (see GSRendererHW::NbaTrackDepth), otherwise the cleared stand-in (all far).
+	GSTexture12* const game_depth = static_cast<GSTexture12*>(m_upscaler_depth);
+	const bool real_depth = game_depth && game_depth->IsDepthStencil() &&
+	                        game_depth->GetWidth() >= src_rect.z && game_depth->GetHeight() >= src_rect.w;
+	static int s_real_depth = -1;
+	if (s_real_depth != static_cast<int>(real_depth))
+	{
+		s_real_depth = static_cast<int>(real_depth);
+		Console.WriteLn("(PS2Recomp) DLSS depth: %s", real_depth ? "game depth buffer" : "none");
+	}
+	GSTexture12* const depth = real_depth ? game_depth : static_cast<GSTexture12*>(m_dlss_depth);
+	GSTexture12* const mv = static_cast<GSTexture12*>(m_dlss_mv);
+	for (GSTexture12* t : {sTex, depth, mv, dTex})
+	{
+		if (t->GetState() == GSTexture::State::Cleared)
+			t->CommitClear(cmdlist);
+		t->SetUseFenceCounter(GetCurrentFenceValue());
+	}
+	sTex->TransitionToState(cmdlist, GSTexture12::ResourceState::ComputeShaderResource);
+	depth->TransitionToState(cmdlist, GSTexture12::ResourceState::ComputeShaderResource);
+	mv->TransitionToState(cmdlist, GSTexture12::ResourceState::ComputeShaderResource);
+	dTex->TransitionToState(cmdlist, GSTexture12::ResourceState::CASShaderUAV);
+
+	NVSDK_NGX_D3D12_DLSS_Eval_Params eval = {};
+	eval.Feature.pInColor = sTex->GetResource();
+	eval.Feature.pInOutput = dTex->GetResource();
+	eval.pInDepth = depth->GetResource();
+	eval.pInMotionVectors = mv->GetResource();
+	eval.InRenderSubrectDimensions.Width = in_w;
+	eval.InRenderSubrectDimensions.Height = in_h;
+	eval.InColorSubrectBase.X = src_rect.x;
+	eval.InColorSubrectBase.Y = src_rect.y;
+	if (real_depth)
+	{
+		eval.InDepthSubrectBase.X = src_rect.x;
+		eval.InDepthSubrectBase.Y = src_rect.y;
+	}
+	// No real motion vectors exist for a PS2 frame: drop the history every frame so moving
+	// objects never ghost (DLSS then works as a per-frame AI upscaler).
+	eval.InReset = 1;
+	eval.InMVScaleX = 1.0f;
+	eval.InMVScaleY = 1.0f;
+	const NVSDK_NGX_Result res = NGX_D3D12_EVALUATE_DLSS_EXT(cmdlist.list4.get(), static_cast<NVSDK_NGX_Handle*>(m_dlss_feature), params, &eval);
+
+	// NGX recorded its own pipelines, root signatures and descriptor heaps into our command list.
+	CommandListResources& clr = m_command_lists[m_current_command_list];
+	ID3D12DescriptorHeap* heaps[2] = {clr.descriptor_allocator.GetDescriptorHeap(), clr.sampler_allocator.GetDescriptorHeap()};
+	cmdlist.list4->SetDescriptorHeaps(std::size(heaps), heaps);
+	InvalidateCachedState();
+	if (NVSDK_NGX_FAILED(res))
+	{
+		static int s_eval_logs = 0;
+		if (s_eval_logs++ < 4)
+			Console.Error("(PS2Recomp) DLSS (D3D12) evaluate failed (0x%08X).", static_cast<u32>(res));
+		return false;
+	}
+	dTex->TransitionToState(cmdlist, GSTexture12::ResourceState::PixelShaderResource);
+	return true;
+}
