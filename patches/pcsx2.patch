+//------------------------------------------------------------------
+// Micro VU - Globals
+//------------------------------------------------------------------
+
+alignas(16) microVU microVU0;
+alignas(16) microVU microVU1;
+
+// See iR5900-arm64.h. Written on the EE thread only: every VU0 path that arms
+// or disarms it runs there.
+u32 mVU0ParkedSpin = 0;
