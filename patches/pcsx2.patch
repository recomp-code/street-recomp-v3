+		return;
+	}
+	if (id == kLivePacketVif1Reg)
+	{
+		u32 address = 0, value = 0;
+		if (!LiveReadValue(&address) || !LiveReadValue(&value))
+			return;
+		vifWrite32<1>(address, value);
+		vif1.vifstalled.enabled = false;
+		return;
+	}
+
+	switch (static_cast<GSDumpTypes::GSType>(id))
+	{
+		case GSDumpTypes::GSType::Transfer:
+		{
+			u8 path = 0;
+			u32 length = 0;
+			if (!LiveReadValue(&path) || !LiveReadValue(&length))
+				return;
+			s_live.buffer.resize(length);
+			if (!LiveRead(s_live.buffer.data(), length))
+				return;
+			if (path >= static_cast<u8>(GSDumpTypes::GSTransferPath::Path2) &&
+				path <= static_cast<u8>(GSDumpTypes::GSTransferPath::Path1New) && length > 0)
+			{
+				// Dump files use path - 1 as the buffer index (Path2 -> GIF_PATH_1 ...). Live mode
+				// shares the GIF unit with the host's VIF1/VU1 (PATH1/PATH2), so each path must use
+				// its own buffer.
+				const GIF_PATH gif_path =
+					path == static_cast<u8>(GSDumpTypes::GSTransferPath::Path1New) ? GIF_PATH_1 :
+					path == static_cast<u8>(GSDumpTypes::GSTransferPath::Path2)    ? GIF_PATH_2 :
+					                                                                 GIF_PATH_3;
+				GSDumpReplayerSendPacketToMTGS(gif_path, s_live.buffer.data(), length);
+			}
+		}
+		break;
+
+		case GSDumpTypes::GSType::VSync:
+		{
+			u8 field = 0;
+			if (!LiveReadValue(&field))
+				return;
+			s_dump_frame_number++;
+			{
+				// Game frame rate = how often the displayed framebuffer changes (PS2X_FPS_LOG=1).
+				static const bool s_fps_log = [] { const char* e = std::getenv("PS2X_FPS_LOG"); return e && e[0] == '1'; }();
+				static u64 s_last_dispfb = 0;
+				static u32 s_flips = 0, s_vsyncs = 0;
+				const u64 dispfb = *reinterpret_cast<const u64*>(PS2MEM_GS + 0x70) ^ *reinterpret_cast<const u64*>(PS2MEM_GS + 0x90);
+				if (dispfb != s_last_dispfb)
+				{
+					s_last_dispfb = dispfb;
+					s_flips++;
+				}
+				if (s_fps_log)
+				{
+					// Hitches: wall time between vsync packets and how much of it the host spent
+					// waiting for the game (high wait = the game/EE is late; low wait = the host
+					// itself was busy: GPU, shader compilation, texture loads).
+					static LARGE_INTEGER s_freq{}, s_last{};
+					static double s_max_ms = 0, s_max_wait_ms = 0, s_busy_ms = 0;
+					static u32 s_hitches = 0;
+					LARGE_INTEGER now;
+					QueryPerformanceCounter(&now);
+					if (!s_freq.QuadPart)
+						QueryPerformanceFrequency(&s_freq);
+					if (s_last.QuadPart)
+					{
+						const double ms = 1000.0 * static_cast<double>(now.QuadPart - s_last.QuadPart) / static_cast<double>(s_freq.QuadPart);
+						const double wait_ms = 1000.0 * static_cast<double>(s_live_wait_ticks) / static_cast<double>(s_freq.QuadPart);
+						s_busy_ms += ms - wait_ms;
+						if (ms > s_max_ms)
+						{
+							s_max_ms = ms;
+							s_max_wait_ms = wait_ms;
+						}
+						if (ms > 25.0)
+						{
+							s_hitches++;
+							static u32 s_hitch_logs = 0;
+							if (s_hitch_logs++ < 200)
+								Console.WriteLn("(PS2Recomp) hitch %.1f ms (host waited for the game %.1f ms, host busy %.1f ms)", ms, wait_ms, ms - wait_ms);
+						}
+					}
+					s_last = now;
+					s_live_wait_ticks = 0;
+					if (++s_vsyncs >= 60)
+					{
+						Console.WriteLn("(PS2Recomp) internal fps %.1f, vsync fps %.1f, flips %u/%u, hitches>25ms %u, worst %.1f ms (wait %.1f), host busy %.0f%%",
+							PerformanceMetrics::GetInternalFPS(), PerformanceMetrics::GetFPS(), s_flips, s_vsyncs, s_hitches,
+							s_max_ms, s_max_wait_ms, 100.0 * s_busy_ms / (1000.0 * s_vsyncs / 60.0));
+						s_flips = s_vsyncs = s_hitches = 0;
+						s_max_ms = s_max_wait_ms = s_busy_ms = 0;
+					}
+				}
+			}
+			// The game paces itself; no frame limiter here.
+			MTGS::PostVsyncStart(false);
+			VMManager::Internal::VSyncOnCPUThread();
+			if (VMManager::Internal::IsExecutionInterrupted())
+				GSDumpReplayerExitExecution();
+			Host::PumpMessagesOnCPUThread();
+		}
+		break;
+
+		case GSDumpTypes::GSType::ReadFIFO2:
+		{
+			u32 size = 0;
+			if (!LiveReadValue(&size))
+				return;
+			std::unique_ptr<u8[]> arr(new u8[(size + 1) * 16]);
+			MTGS::InitAndReadFIFO(arr.get(), size);
+		}
+		break;
+
+		case GSDumpTypes::GSType::Registers:
