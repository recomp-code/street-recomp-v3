+// ---------------------------------------------------------------------------------------------
+// PS2Recomp final upscaler: AMD FidelityFX Super Resolution 1 and NVIDIA DLSS.
+
+bool GSDeviceVK::CompileFSRPipelines()
+{
+	VkDevice dev = m_device;
+	Vulkan::DescriptorSetLayoutBuilder dslb;
+	Vulkan::PipelineLayoutBuilder plb;
+
+	dslb.SetPushFlag();
+	dslb.AddBinding(0, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 1, VK_SHADER_STAGE_COMPUTE_BIT);
+	dslb.AddBinding(1, VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, 1, VK_SHADER_STAGE_COMPUTE_BIT);
+	if ((m_fsr_ds_layout = dslb.Create(dev)) == VK_NULL_HANDLE)
+		return false;
+	Vulkan::SetObjectName(dev, m_fsr_ds_layout, "FSR descriptor layout");
+
+	plb.AddPushConstants(VK_SHADER_STAGE_COMPUTE_BIT, 0, 16 * sizeof(u32));
+	plb.AddDescriptorSet(m_fsr_ds_layout);
+	if ((m_fsr_pipeline_layout = plb.Create(dev)) == VK_NULL_HANDLE)
+		return false;
+	Vulkan::SetObjectName(dev, m_fsr_pipeline_layout, "FSR pipeline layout");
+
+	std::optional<std::string> source = ReadShaderSource("shaders/vulkan/fsr1.glsl");
+	std::optional<std::string> ffx_a = ReadShaderSource("shaders/common/ffx_a_fsr.h");
+	std::optional<std::string> ffx_fsr = ReadShaderSource("shaders/common/ffx_fsr1.h");
+	if (!source.has_value() || !ffx_a.has_value() || !ffx_fsr.has_value())
+		return false;
+	StringUtil::ReplaceAll(&source.value(), "#include \"ffx_a_fsr.h\"", ffx_a.value());
+	StringUtil::ReplaceAll(&source.value(), "#include \"ffx_fsr1.h\"", ffx_fsr.value());
+
+	VkShaderModule mod = g_vulkan_shader_cache->GetComputeShader(source->c_str());
+	ScopedGuard mod_guard = [this, &mod]() { vkDestroyShaderModule(m_device, mod, nullptr); };
+	if (mod == VK_NULL_HANDLE)
+		return false;
+
+	for (int pass = 0; pass < 2; pass++)
+	{
+		Vulkan::ComputePipelineBuilder cpb;
+		cpb.SetPipelineLayout(m_fsr_pipeline_layout);
+		cpb.SetShader(mod, "main");
+		cpb.SetSpecializationBool(0, pass != 0);
+		m_fsr_pipelines[pass] = cpb.Create(dev, g_vulkan_shader_cache->GetPipelineCache(true), false);
+		if (!m_fsr_pipelines[pass])
+			return false;
+	}
+	return true;
+}
+
+namespace
+{
+	u32 FsrBits(float f)
+	{
+		u32 u;
+		std::memcpy(&u, &f, sizeof(u));
+		return u;
+	}
+} // namespace
+
+int GSDeviceVK::DoUpscale(GSTexture* sTex, const GSVector4i& src_rect, GSTexture* dTex, int mode, float sharpness)
+{
+	GSTextureVK* const sTexVK = static_cast<GSTextureVK*>(sTex);
+	GSTextureVK* const dTexVK = static_cast<GSTextureVK*>(dTex);
+
+	if (mode == 2 && InitDLSS() && DoDLSS(sTexVK, src_rect, dTexVK))
+		return 2;
+	if (!m_fsr_pipelines[0] || !m_fsr_pipelines[1])
+		return 0;
+
+	g_perfmon.Put(GSPerfMon::TextureCopies, 1);
+	EndRenderPass();
+	const int out_w = dTex->GetWidth();
+	const int out_h = dTex->GetHeight();
+	if (!m_fsr_easu || m_fsr_easu->GetWidth() != out_w || m_fsr_easu->GetHeight() != out_h)
+	{
+		delete m_fsr_easu;
+		m_fsr_easu = CreateSurface(GSTexture::ShaderWriteTexture, out_w, out_h, 1, GSTexture::Format::Color);
+		if (!m_fsr_easu)
+			return 0;
+	}
+	// PS2X_FSR_DEBUG=1: EASU straight into the output (no RCAS), to inspect each pass.
+	static const bool s_easu_only = [] { const char* e = std::getenv("PS2X_FSR_DEBUG"); return e && e[0] == '1'; }();
+	GSTextureVK* const easuVK = s_easu_only ? dTexVK : static_cast<GSTextureVK*>(m_fsr_easu);
+	VkCommandBuffer cmdbuf = GetCurrentCommandBuffer();
+	const int groups_x = (out_w + 15) / 16;
+	const int groups_y = (out_h + 15) / 16;
+
+	// EASU: FsrEasuConOffset(viewport = src_rect, input size = texture, output, offset = src_rect.xy).
+	{
+		const float vw = static_cast<float>(src_rect.width()), vh = static_cast<float>(src_rect.height());
+		const float iw = static_cast<float>(sTex->GetWidth()), ih = static_cast<float>(sTex->GetHeight());
+		const float ow = static_cast<float>(out_w), oh = static_cast<float>(out_h);
+		const u32 con[16] = {
+			FsrBits(vw / ow), FsrBits(vh / oh),
+			FsrBits(0.5f * vw / ow - 0.5f + static_cast<float>(src_rect.x)), FsrBits(0.5f * vh / oh - 0.5f + static_cast<float>(src_rect.y)),
+			FsrBits(1.0f / iw), FsrBits(1.0f / ih), FsrBits(1.0f / iw), FsrBits(-1.0f / ih),
+			FsrBits(-1.0f / iw), FsrBits(2.0f / ih), FsrBits(1.0f / iw), FsrBits(2.0f / ih),
+			FsrBits(0.0f), FsrBits(4.0f / ih), 0u, 0u};
+
+		sTexVK->TransitionToLayout(cmdbuf, GSTextureVK::Layout::ShaderReadOnly);
+		easuVK->TransitionToLayout(cmdbuf, GSTextureVK::Layout::ComputeReadWriteImage);
+		Vulkan::DescriptorSetUpdateBuilder dsub;
+		dsub.AddCombinedImageSamplerDescriptorWrite(VK_NULL_HANDLE, 0, sTexVK->GetView(), m_linear_sampler, sTexVK->GetVkLayout());
+		dsub.AddStorageImageDescriptorWrite(VK_NULL_HANDLE, 1, easuVK->GetView(), easuVK->GetVkLayout());
+		dsub.PushUpdate(cmdbuf, VK_PIPELINE_BIND_POINT_COMPUTE, m_fsr_pipeline_layout, 0, false);
+		vkCmdPushConstants(cmdbuf, m_fsr_pipeline_layout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(con), con);
+		vkCmdBindPipeline(cmdbuf, VK_PIPELINE_BIND_POINT_COMPUTE, m_fsr_pipelines[0]);
+		vkCmdDispatch(cmdbuf, groups_x, groups_y, 1);
+		static bool s_logged = false;
+		if (!s_logged)
+		{
+			s_logged = true;
+			Console.WriteLn("(PS2Recomp) FSR EASU in %dx%d (tex %dx%d, at %d,%d) out %dx%d con0 %08X %08X %08X %08X con1 %08X %08X",
+				src_rect.width(), src_rect.height(), sTex->GetWidth(), sTex->GetHeight(), src_rect.x, src_rect.y, out_w, out_h,
+				con[0], con[1], con[2], con[3], con[4], con[5]);
+		}
+	}
+	if (s_easu_only)
+	{
+		dTexVK->TransitionToLayout(GSTextureVK::Layout::ShaderReadOnly);
+		return 1;
+	}
+
+	// RCAS: sharpness 0..1 -> 2..0 stops of reduction (FsrRcasCon); only con.x is read in fp32.
+	{
+		const float stops = (1.0f - std::clamp(sharpness, 0.0f, 1.0f)) * 2.0f;
+		const u32 con[16] = {FsrBits(std::exp2(-stops)), 0u, 0u, 0u};
+
+		easuVK->TransitionToLayout(cmdbuf, GSTextureVK::Layout::ShaderReadOnly);
+		dTexVK->TransitionToLayout(cmdbuf, GSTextureVK::Layout::ComputeReadWriteImage);
+		Vulkan::DescriptorSetUpdateBuilder dsub;
+		dsub.AddCombinedImageSamplerDescriptorWrite(VK_NULL_HANDLE, 0, easuVK->GetView(), m_point_sampler, easuVK->GetVkLayout());
+		dsub.AddStorageImageDescriptorWrite(VK_NULL_HANDLE, 1, dTexVK->GetView(), dTexVK->GetVkLayout());
+		dsub.PushUpdate(cmdbuf, VK_PIPELINE_BIND_POINT_COMPUTE, m_fsr_pipeline_layout, 0, false);
+		vkCmdPushConstants(cmdbuf, m_fsr_pipeline_layout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(con), con);
+		vkCmdBindPipeline(cmdbuf, VK_PIPELINE_BIND_POINT_COMPUTE, m_fsr_pipelines[1]);
+		vkCmdDispatch(cmdbuf, groups_x, groups_y, 1);
+	}
+
+	dTexVK->TransitionToLayout(GSTextureVK::Layout::ShaderReadOnly);
+	return 1;
+}
+
+#if defined(PCSX2_NBA_DLSS)
+
+bool GSDeviceVK::InitDLSS()
+{
+	if (m_dlss_tried)
+		return m_dlss_ok;
+	m_dlss_tried = true;
+
+	// NGX writes its logs/cache next to the executable (where nvngx_dlss.dll also lives).
+	wchar_t exe_path[MAX_PATH] = {};
+	GetModuleFileNameW(nullptr, exe_path, MAX_PATH);
+	std::wstring data_path(exe_path);
+	data_path = data_path.substr(0, data_path.find_last_of(L"\\/"));
+
+	NVSDK_NGX_Result res = NVSDK_NGX_VULKAN_Init_with_ProjectID("6c1a4b5e-3f2d-4e8b-9a71-5d0c2e9f8b34",
+		NVSDK_NGX_ENGINE_TYPE_CUSTOM, "1.0", data_path.c_str(), m_instance, m_physical_device, m_device,
+		vkGetInstanceProcAddr, vkGetDeviceProcAddr);
+	if (NVSDK_NGX_FAILED(res))
+	{
+		Console.Error("(PS2Recomp) DLSS: NGX init failed (0x%08X). Using FSR instead.", static_cast<u32>(res));
+		return false;
+	}
+
+	NVSDK_NGX_Parameter* params = nullptr;
+	res = NVSDK_NGX_VULKAN_GetCapabilityParameters(&params);
+	if (NVSDK_NGX_FAILED(res) || !params)
+	{
+		Console.Error("(PS2Recomp) DLSS: no NGX capability parameters (0x%08X).", static_cast<u32>(res));
+		NVSDK_NGX_VULKAN_Shutdown1(m_device);
+		return false;
+	}
+	int available = 0;
+	NVSDK_NGX_Parameter_GetI(params, NVSDK_NGX_Parameter_SuperSampling_Available, &available);
+	if (!available)
+	{
+		int needs_driver = 0;
+		NVSDK_NGX_Parameter_GetI(params, NVSDK_NGX_Parameter_SuperSampling_NeedsUpdatedDriver, &needs_driver);
+		Console.Error("(PS2Recomp) DLSS not available on this GPU/driver%s. Using FSR instead.",
+			needs_driver ? " (driver update needed)" : "");
+		NVSDK_NGX_VULKAN_DestroyParameters(params);
+		NVSDK_NGX_VULKAN_Shutdown1(m_device);
+		return false;
+	}
+	m_ngx_params = params;
+	m_dlss_ok = true;
+	Console.WriteLn("(PS2Recomp) DLSS ready (NGX initialised).");
+	return true;
+}
+
+bool GSDeviceVK::DoDLSS(GSTextureVK* sTex, const GSVector4i& src_rect, GSTextureVK* dTex)
+{
+	NVSDK_NGX_Parameter* params = static_cast<NVSDK_NGX_Parameter*>(m_ngx_params);
+	const int in_w = src_rect.width(), in_h = src_rect.height();
+	const int out_w = dTex->GetWidth(), out_h = dTex->GetHeight();
+
+	EndRenderPass();
+	VkCommandBuffer cmdbuf = GetCurrentCommandBuffer();
+
+	// (Re)create the feature and the zero depth / motion vector inputs when the sizes change.
+	if (!m_dlss_feature || in_w != m_dlss_in_w || in_h != m_dlss_in_h || out_w != m_dlss_out_w || out_h != m_dlss_out_h)
+	{
+		if (m_dlss_feature)
+		{
+			ExecuteCommandBuffer(true); // the old feature may still be in use by the GPU
+			cmdbuf = GetCurrentCommandBuffer();
+			NVSDK_NGX_VULKAN_ReleaseFeature(static_cast<NVSDK_NGX_Handle*>(m_dlss_feature));
+			m_dlss_feature = nullptr;
+		}
+		delete m_dlss_depth;
+		delete m_dlss_mv;
+		m_dlss_depth = CreateSurface(GSTexture::RenderTarget, in_w, in_h, 1, GSTexture::Format::DepthColor);
+		m_dlss_mv = CreateSurface(GSTexture::RenderTarget, in_w, in_h, 1, GSTexture::Format::ColorHDR);
+		if (!m_dlss_depth || !m_dlss_mv)
+			return false;
+		static_cast<GSTextureVK*>(m_dlss_depth)->TransitionToLayout(cmdbuf, GSTextureVK::Layout::TransferDst);
+		static_cast<GSTextureVK*>(m_dlss_mv)->TransitionToLayout(cmdbuf, GSTextureVK::Layout::TransferDst);
+		const VkClearColorValue zero = {};
+		const VkImageSubresourceRange range = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+		vkCmdClearColorImage(cmdbuf, static_cast<GSTextureVK*>(m_dlss_depth)->GetImage(), VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, &zero, 1, &range);
+		vkCmdClearColorImage(cmdbuf, static_cast<GSTextureVK*>(m_dlss_mv)->GetImage(), VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, &zero, 1, &range);
+
+		NVSDK_NGX_DLSS_Create_Params create = {};
+		create.Feature.InWidth = in_w;
+		create.Feature.InHeight = in_h;
+		create.Feature.InTargetWidth = out_w;
+		create.Feature.InTargetHeight = out_h;
+		create.Feature.InPerfQualityValue = NVSDK_NGX_PerfQuality_Value_MaxQuality;
+		// LDR input, motion vectors at render resolution, no exposure texture. PS2 Z grows towards
+		// the camera, so the depth buffer is "inverted" (1 = near) in DLSS terms.
+		create.InFeatureCreateFlags = NVSDK_NGX_DLSS_Feature_Flags_MVLowRes | NVSDK_NGX_DLSS_Feature_Flags_AutoExposure |
+		                              NVSDK_NGX_DLSS_Feature_Flags_DepthInverted;
+		NVSDK_NGX_Handle* handle = nullptr;
+		const NVSDK_NGX_Result res = NGX_VULKAN_CREATE_DLSS_EXT(cmdbuf, 1, 1, &handle, params, &create);
+		if (NVSDK_NGX_FAILED(res) || !handle)
+		{
+			static int s_fail_logs = 0;
+			if (s_fail_logs++ < 4)
+				Console.Error("(PS2Recomp) DLSS feature %dx%d -> %dx%d failed (0x%08X); DLSS needs an output 1-3x the "
+							  "internal resolution. Using FSR instead.", in_w, in_h, out_w, out_h, static_cast<u32>(res));
+			m_dlss_in_w = in_w, m_dlss_in_h = in_h, m_dlss_out_w = out_w, m_dlss_out_h = out_h;
+			return false;
+		}
+		m_dlss_feature = handle;
+		m_dlss_in_w = in_w, m_dlss_in_h = in_h, m_dlss_out_w = out_w, m_dlss_out_h = out_h;
+		InvalidateCachedState();
+	}
+	if (!m_dlss_feature)
+		return false;
+
+	// The game's real depth buffer of the shown frame when the renderer has one that covers the
+	// input (see GSRendererHW::NbaTrackDepth), otherwise the cleared stand-in (all far).
+	GSTextureVK* const game_depth = static_cast<GSTextureVK*>(m_upscaler_depth);
+	const bool real_depth = game_depth && game_depth->IsDepthStencil() &&
+	                        game_depth->GetWidth() >= src_rect.z && game_depth->GetHeight() >= src_rect.w;
+	static int s_real_depth = -1;
+	if (s_real_depth != static_cast<int>(real_depth))
+	{
+		s_real_depth = static_cast<int>(real_depth);
+		Console.WriteLn("(PS2Recomp) DLSS depth: %s", real_depth ? "game depth buffer" : "none");
+	}
+	GSTextureVK* const depth = real_depth ? game_depth : static_cast<GSTextureVK*>(m_dlss_depth);
+	GSTextureVK* const mv = static_cast<GSTextureVK*>(m_dlss_mv);
+	if (real_depth && depth->GetState() == GSTexture::State::Cleared)
+		depth->CommitClear(cmdbuf);
+	depth->SetUseFenceCounter(GetCurrentFenceCounter());
+	sTex->TransitionToLayout(cmdbuf, GSTextureVK::Layout::ShaderReadOnly);
+	depth->TransitionToLayout(cmdbuf, GSTextureVK::Layout::ShaderReadOnly);
+	mv->TransitionToLayout(cmdbuf, GSTextureVK::Layout::ShaderReadOnly);
+	dTex->TransitionToLayout(cmdbuf, GSTextureVK::Layout::ComputeReadWriteImage);
+
+	const VkImageSubresourceRange range = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+	NVSDK_NGX_Resource_VK color_res = NVSDK_NGX_Create_ImageView_Resource_VK(sTex->GetView(), sTex->GetImage(), range,
+		sTex->GetVkFormat(), sTex->GetWidth(), sTex->GetHeight(), false);
+	NVSDK_NGX_Resource_VK out_res = NVSDK_NGX_Create_ImageView_Resource_VK(dTex->GetView(), dTex->GetImage(), range,
+		dTex->GetVkFormat(), out_w, out_h, true);
+	const VkImageSubresourceRange depth_range = {
+		static_cast<VkImageAspectFlags>(real_depth ? VK_IMAGE_ASPECT_DEPTH_BIT : VK_IMAGE_ASPECT_COLOR_BIT), 0, 1, 0, 1};
+	NVSDK_NGX_Resource_VK depth_res = NVSDK_NGX_Create_ImageView_Resource_VK(depth->GetView(), depth->GetImage(), depth_range,
+		depth->GetVkFormat(), depth->GetWidth(), depth->GetHeight(), false);
+	NVSDK_NGX_Resource_VK mv_res = NVSDK_NGX_Create_ImageView_Resource_VK(mv->GetView(), mv->GetImage(), range,
+		mv->GetVkFormat(), in_w, in_h, false);
+
+	NVSDK_NGX_VK_DLSS_Eval_Params eval = {};
+	eval.Feature.pInColor = &color_res;
+	eval.Feature.pInOutput = &out_res;
+	eval.pInDepth = &depth_res;
+	eval.pInMotionVectors = &mv_res;
+	eval.InRenderSubrectDimensions.Width = in_w;
+	eval.InRenderSubrectDimensions.Height = in_h;
+	eval.InColorSubrectBase.X = src_rect.x;
+	eval.InColorSubrectBase.Y = src_rect.y;
+	if (real_depth)
+	{
+		eval.InDepthSubrectBase.X = src_rect.x;
+		eval.InDepthSubrectBase.Y = src_rect.y;
+	}
+	// No real motion vectors exist for a PS2 frame: drop the history every frame so moving
+	// objects never ghost (DLSS then works as a per-frame AI upscaler).
+	eval.InReset = 1;
+	eval.InMVScaleX = 1.0f;
+	eval.InMVScaleY = 1.0f;
+	const NVSDK_NGX_Result res = NGX_VULKAN_EVALUATE_DLSS_EXT(cmdbuf, static_cast<NVSDK_NGX_Handle*>(m_dlss_feature), params, &eval);
+	InvalidateCachedState(); // NGX recorded its own pipelines/descriptors into our command buffer
+	if (NVSDK_NGX_FAILED(res))
+	{
+		static int s_eval_logs = 0;
+		if (s_eval_logs++ < 4)
+			Console.Error("(PS2Recomp) DLSS evaluate failed (0x%08X). Using FSR instead.", static_cast<u32>(res));
+		return false;
+	}
+	dTex->TransitionToLayout(GSTextureVK::Layout::ShaderReadOnly);
+	return true;
+}
+
+#else
+
+bool GSDeviceVK::InitDLSS()
+{
+	if (!m_dlss_tried)
+	{
+		m_dlss_tried = true;
+		Console.Warning("(PS2Recomp) This renderer was built without the NVIDIA DLSS SDK. Using FSR instead.");
+	}
+	return false;
+}
+
+bool GSDeviceVK::DoDLSS(GSTextureVK*, const GSVector4i&, GSTextureVK*)
+{
+	return false;
+}
