+// Gamepad (XInput, polled at every vsync on the CPU thread): Back+Start or a long START toggles the menu.
+static void LiveMenuPollGamepad()
+{
+	using XInputGetStateFn = DWORD(WINAPI*)(DWORD, XINPUT_STATE*);
+	static XInputGetStateFn get_state = [] {
+		HMODULE mod = LoadLibraryW(L"xinput1_4.dll");
+		if (!mod)
+			mod = LoadLibraryW(L"xinput9_1_0.dll");
+		return mod ? reinterpret_cast<XInputGetStateFn>(GetProcAddress(mod, "XInputGetState")) : nullptr;
+	}();
+	static WORD s_prev = 0;
+	if (!get_state)
+		return;
+	// Only the focused window reacts: XInput is global, and several instances (or a test run next
+	// to the player's game) must not open/drive each other's menus.
+	static const bool s_no_gamepad = [] {
+		const char* value = std::getenv("PS2X_NO_GAMEPAD"); // automated test runs
+		return value && *value && *value != '0';
+	}();
+	if (s_no_gamepad || GetForegroundWindow() != s_hwnd)
+	{
+		s_prev = 0;
+		return;
+	}
+	WORD buttons = 0;
+	for (DWORD pad = 0; pad < 4; pad++)
+	{
+		XINPUT_STATE state = {};
+		if (get_state(pad, &state) == ERROR_SUCCESS)
+		{
+			buttons = state.Gamepad.wButtons;
+			break;
+		}
+	}
+	const WORD pressed = buttons & ~s_prev;
+	s_prev = buttons;
+	constexpr WORD combo = XINPUT_GAMEPAD_BACK | XINPUT_GAMEPAD_START;
+	if ((buttons & combo) == combo && (pressed & combo))
+	{
+		LiveMenuDo(LiveMenuAction::Toggle);
+		return;
+	}
+	// Holding START alone for 1.5 s also toggles it (pads without a handy Back button). Fires once
+	// per hold; the short press still reaches the game as its normal pause.
+	static ULONGLONG s_start_since = 0;
+	static bool s_start_fired = false;
+	if (buttons == XINPUT_GAMEPAD_START)
+	{
+		const ULONGLONG now = GetTickCount64();
+		if (pressed & XINPUT_GAMEPAD_START)
+		{
+			s_start_since = now;
+			s_start_fired = false;
+		}
+		else if (!s_start_fired && s_start_since && now - s_start_since >= 1500)
+		{
+			s_start_fired = true;
+			LiveMenuDo(LiveMenuAction::Toggle);
+			return;
+		}
+	}
+	else
+	{
+		s_start_since = 0;
+	}
+	if (!s_menu_open.load())
+		return;
+	if (pressed & XINPUT_GAMEPAD_DPAD_UP)
+		LiveMenuDo(LiveMenuAction::Up);
+	if (pressed & XINPUT_GAMEPAD_DPAD_DOWN)
+		LiveMenuDo(LiveMenuAction::Down);
+	if (pressed & XINPUT_GAMEPAD_DPAD_LEFT)
+		LiveMenuDo(LiveMenuAction::Left);
+	if (pressed & XINPUT_GAMEPAD_DPAD_RIGHT)
+		LiveMenuDo(LiveMenuAction::Right);
+	if (pressed & XINPUT_GAMEPAD_A)
+		LiveMenuDo(LiveMenuAction::Accept);
+	if (pressed & XINPUT_GAMEPAD_B)
+		LiveMenuDo(LiveMenuAction::Close);
+}
+
+// Keyboard from the window thread: queued to the CPU thread. True when the key was the menu's.
+static bool LiveMenuKey(WPARAM vk)
+{
+	LiveMenuAction action;
+	if (vk == VK_F1)
+		action = LiveMenuAction::Toggle;
+	else if (!s_menu_open.load())
+		return false;
+	else if (vk == VK_UP)
+		action = LiveMenuAction::Up;
+	else if (vk == VK_DOWN)
+		action = LiveMenuAction::Down;
+	else if (vk == VK_LEFT)
+		action = LiveMenuAction::Left;
+	else if (vk == VK_RIGHT)
+		action = LiveMenuAction::Right;
+	else if (vk == VK_RETURN || vk == VK_SPACE)
+		action = LiveMenuAction::Accept;
+	else if (vk == VK_ESCAPE || vk == VK_BACK)
+		action = LiveMenuAction::Close;
+	else
+		return true; // the menu owns the keyboard while open
+	Host::RunOnCPUThread([action]() { LiveMenuDo(action); });
+	return true;
+}
+
 LRESULT CALLBACK WndProc(HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam)
 {
+	if (s_live)
+	{
+		switch (msg)
+		{
+			case WM_KEYDOWN:
+			case WM_SYSKEYDOWN:
+				if ((wParam == VK_RETURN && (lParam & (1 << 29))) || wParam == VK_F11)
+				{
+					if (!(lParam & (1 << 30)))
+						ToggleFullscreen(hwnd);
+					return 0;
+				}
+				if (!(lParam & (1 << 30)) && LiveMenuKey(wParam))
+				{
+					// Opening the menu releases whatever the pad was holding.
+					s_live_keys = 0;
+					s_live_stick = 0;
+					LivePublishPad();
+					return 0;
+				}
+				if (s_menu_open.load())
+					return 0;
+				LiveKey(wParam, lParam, true);
+				return 0;
+			case WM_KEYUP:
+			case WM_SYSKEYUP:
+				LiveKey(wParam, lParam, false);
+				return 0;
+			case WM_KILLFOCUS:
+				s_live_keys = 0;
+				s_live_stick = 0;
+				LivePublishPad();
+				break;
+			case WM_SIZE:
+				if (VMManager::HasValidVM() && wParam != SIZE_MINIMIZED)
+				{
+					const u32 width = LOWORD(lParam), height = HIWORD(lParam);
+					if (MTGS::IsOpen())
+						MTGS::ResizeDisplayWindow(width, height, 1.0f);
+				}
+				break;
+			case WM_CLOSE:
+				GSDumpReplayer::SetLiveQuit();
+				Host::RequestVMShutdown(false, false, false);
+				return 0;
+		}
+	}
 	return DefWindowProcW(hwnd, msg, wParam, lParam);
 }
 
