+	{
+		std::fprintf(fp, "; Opciones graficas de NBA Street V3 (menu F1 / Back+Start / mantener START). Se reescribe al cambiar.\n[EmuCore/GS]\n");
+		std::fprintf(fp, "Renderer = %d\n", s_menu_pending_renderer >= 0 ? s_menu_pending_renderer :
+			s_settings_interface.GetIntValue("EmuCore/GS", "Renderer", static_cast<int>(GSRendererType::VK)));
+		std::fprintf(fp, "upscale_multiplier = %g\n", s_settings_interface.GetFloatValue("EmuCore/GS", "upscale_multiplier", 1.0f));
+		std::fprintf(fp, "MaxAnisotropy = %d\n", s_settings_interface.GetIntValue("EmuCore/GS", "MaxAnisotropy", 0));
+		std::fprintf(fp, "filter = %d\n", s_settings_interface.GetIntValue("EmuCore/GS", "filter", 2));
+		std::fprintf(fp, "fxaa = %s\n", s_settings_interface.GetBoolValue("EmuCore/GS", "fxaa", false) ? "true" : "false");
+		std::fprintf(fp, "CASMode = %d\n", s_settings_interface.GetIntValue("EmuCore/GS", "CASMode", 0));
+		std::fprintf(fp, "CASSharpness = %d\n", s_settings_interface.GetIntValue("EmuCore/GS", "CASSharpness", 40));
+		std::fprintf(fp, "AspectRatio = %s\n", s_settings_interface.GetStringValue("EmuCore/GS", "AspectRatio", "Auto 4:3/3:2").c_str());
+		std::fprintf(fp, "OsdShowFPS = %s\n", s_settings_interface.GetBoolValue("EmuCore/GS", "OsdShowFPS", false) ? "true" : "false");
+		// Texture packs: Documents\PCSX2\textures\SLUS-21126\replacements (same layout as PCSX2).
+		std::fprintf(fp, "LoadTextureReplacements = %s\n", s_settings_interface.GetBoolValue("EmuCore/GS", "LoadTextureReplacements", false) ? "true" : "false");
+		std::fprintf(fp, "LoadTextureReplacementsAsync = true\n");
+		std::fprintf(fp, "DumpReplaceableTextures = %s\n", s_settings_interface.GetBoolValue("EmuCore/GS", "DumpReplaceableTextures", false) ? "true" : "false");
