+// Live packet carrying the game's VIF1 stream (DMA payload, VIFcodes + data, in order).
+static constexpr u8 kLivePacketVif1 = 0x10;
+// Live packet: the game wrote a VIF1 register (u32 address, u32 value): FBRST, ERR, MARK.
+static constexpr u8 kLivePacketVif1Reg = 0x11;
+
+// Runs a chunk of the game's VIF1 stream through PCSX2's VIF1: UNPACK/MPG fill VU1 memory,
+// MSCAL runs microVU1, XGKICK and DIRECT reach the GS through the GIF unit. Interrupts and
+// i-bit stalls belong to the game (handled on its side), so they are acknowledged here and
+// the stream continues; a waiting VU/GIF is drained before retrying.
+static void GSDumpReplayerLiveVif1(u8* data, u32 size)
+{
+	// The game boots without the BIOS, which leaves VIF1 CYCLE configured; with CL=WL=0 an
+	// UNPACK would consume no data and its payload would be parsed as VIFcodes.
+	static bool s_cycle_initialized = false;
+	if (!s_cycle_initialized)
+	{
+		s_cycle_initialized = true;
+		if (vif1Regs.cycle.cl == 0 && vif1Regs.cycle.wl == 0)
+		{
+			vif1Regs.cycle.cl = 1;
+			vif1Regs.cycle.wl = 1;
+		}
+	}
+
+	u32* words = reinterpret_cast<u32*>(data);
+	int remaining = static_cast<int>(size / 4);
+	int noProgress = 0;
+	while (remaining > 0)
+	{
+		vif1ch.chcr.STR = true; // let VIF stall instead of spinning on a busy GIF/VU
+		vif1.vifstalled.enabled = false;
+		vif1.irq = 0;
+		VIF1transfer(words, remaining, true);
+		const int consumed = remaining - static_cast<int>(vif1.vifpacketsize);
+		words += consumed;
+		remaining -= consumed;
+		if (vif1.vifstalled.enabled)
+		{
+			vu1Finish(false);
+			if (vif1Regs.stat.VGW)
+				gifUnit.Execute(false, true);
+			vifExecQueue(1);
+		}
+		if (consumed > 0)
+			noProgress = 0;
+		else if (++noProgress > 64)
+		{
+			Console.WarningFmt("(GSDumpReplayer) VIF1 stuck (cmd {:02x}), dropping {} words", vif1.cmd, remaining);
+			vif1.cmd = 0;
+			vif1.pass = 0;
+			break;
+		}
+	}
+	vif1ch.chcr.STR = false;
+	vif1.vifstalled.enabled = false;
+	vif1.irq = 0;
+	// INSTANT_VU1: queued programs run at the end of the transfer; make sure nothing is left.
+	vifExecQueue(1);
+}
