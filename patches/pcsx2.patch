+#endif // PCSX2_NBA_DLSS
+
+void GSDeviceVK::DestroyUpscalers()
+{
+	// Called with the GPU idle; the textures were already released in Destroy().
+#if defined(PCSX2_NBA_DLSS)
+	if (m_dlss_feature)
+		NVSDK_NGX_VULKAN_ReleaseFeature(static_cast<NVSDK_NGX_Handle*>(m_dlss_feature));
+	if (m_ngx_params)
+		NVSDK_NGX_VULKAN_DestroyParameters(static_cast<NVSDK_NGX_Parameter*>(m_ngx_params));
+	if (m_dlss_ok)
+		NVSDK_NGX_VULKAN_Shutdown1(m_device);
+#endif
+	m_dlss_feature = nullptr;
+	m_ngx_params = nullptr;
+	m_dlss_ok = false;
+	m_dlss_tried = false;
+	for (VkPipeline& it : m_fsr_pipelines)
+	{
+		if (it != VK_NULL_HANDLE)
+			vkDestroyPipeline(m_device, it, nullptr);
+		it = VK_NULL_HANDLE;
+	}
+	if (m_fsr_pipeline_layout != VK_NULL_HANDLE)
+		vkDestroyPipelineLayout(m_device, m_fsr_pipeline_layout, nullptr);
+	if (m_fsr_ds_layout != VK_NULL_HANDLE)
+		vkDestroyDescriptorSetLayout(m_device, m_fsr_ds_layout, nullptr);
+	m_fsr_pipeline_layout = VK_NULL_HANDLE;
+	m_fsr_ds_layout = VK_NULL_HANDLE;
+}
