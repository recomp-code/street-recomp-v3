+// PS2X_SHOT_TIMES="98,104.5,110" (seconds since the host started) + PS2X_SHOT_DIR=<dir>: the host
+// saves its own rendered frame as <dir>\shot_<n>.png at those times. Used by automated tests
+// instead of desktop captures (no window focus, nothing else on screen gets captured).
+static void LiveTimedSnapshots()
+{
+	// PS2X_TEST_T0 (Unix ms) shares the time base with the game's PS2X_PAD_SCRIPT.
+	static const double t0 = [] {
+		const char* value = std::getenv("PS2X_TEST_T0");
+		if (value && *value)
+			return std::atof(value) / 1000.0;
+		return std::chrono::duration<double>(std::chrono::system_clock::now().time_since_epoch()).count();
+	}();
+	static std::vector<double> times = [] {
+		std::vector<double> result;
+		if (const char* value = std::getenv("PS2X_SHOT_TIMES"))
+		{
+			for (const std::string_view item : StringUtil::SplitString(value, ',', true))
+				result.push_back(StringUtil::FromChars<double>(item).value_or(-1.0));
+		}
+		return result;
+	}();
+	static size_t next = 0;
+	if (next >= times.size())
+		return;
+	const double now = std::chrono::duration<double>(std::chrono::system_clock::now().time_since_epoch()).count() - t0;
+	if (now < times[next])
+		return;
+	const char* dir = std::getenv("PS2X_SHOT_DIR");
+	const std::string path = Path::Combine(dir && *dir ? dir : EmuFolders::DataRoot.c_str(), fmt::format("shot_{}.png", next + 1));
+	GSQueueSnapshot(path);
+	next++;
+}
