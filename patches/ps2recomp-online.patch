+            if (!(relay && token && std::strlen(token) == 32) && !direct && !listen)
+                return;
+            if (const char *d = env("PS2X_NET_DELAY"))
+            {
+                if (std::strcmp(d, "auto") == 0)
+                    g.autoDelay = true;
+                else
+                    g.delay = static_cast<uint32_t>(std::clamp(std::atoi(d), 1, 10));
+            }
+            if (const char *v = env("PS2X_NET_WAIT_MS"))
+                g.waitMs = static_cast<uint32_t>(std::max(1000, std::atoi(v)));
+            if (const char *v = env("PS2X_NET_TIMEOUT"))
+                g.timeoutMs = static_cast<uint32_t>(std::max(1000, std::atoi(v)));
+            if (const char *v = env("PS2X_NET_CHECKEVERY"))
+                g.checkEvery = static_cast<uint32_t>(std::max(1, std::atoi(v)));
+            if (const char *v = env("PS2X_NET_STATUS_FILE"))
+                g.statusPath = v;
+            if (const char *v = env("PS2X_DETERMINISTIC"); !v || v[0] != '1')
+                std::fprintf(stderr, "[net] warning: PS2X_DETERMINISTIC=1 is not set, the two games will not stay the same\n");
+
+#if defined(_WIN32)
+            WSADATA wsa;
+            if (WSAStartup(MAKEWORD(2, 2), &wsa) != 0)
+                return;
+#endif
+            g.sock = ::socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+            if (g.sock == INVALID_SOCKET)
+                return;
+#if defined(_WIN32)
+            u_long nb = 1;
+            ioctlsocket(g.sock, FIONBIO, &nb);
+#else
+            fcntl(g.sock, F_SETFL, fcntl(g.sock, F_GETFL, 0) | O_NONBLOCK);
+#endif
+            if (relay && token && std::strlen(token) == 32)
+            {
+                g.relay = true;
+                std::memcpy(g.token, token, 32);
+                g.peerKnown = resolve(relay, g.peer);
+            }
+            else if (listen)
+            {
+                sockaddr_in a{};
+                a.sin_family = AF_INET;
+                a.sin_addr.s_addr = htonl(INADDR_ANY);
+                a.sin_port = htons(static_cast<uint16_t>(std::atoi(listen)));
+                if (::bind(g.sock, reinterpret_cast<sockaddr *>(&a), sizeof a) != 0)
+                {
+                    std::fprintf(stderr, "[net] cannot listen on UDP %s\n", listen);
+                    return;
+                }
+                g.listen = true;
+            }
+            else
+            {
+                g.peerKnown = resolve(direct, g.peer);
+            }
+            if (!g.relay && !g.listen && !g.peerKnown)
+            {
+                std::fprintf(stderr, "[net] cannot resolve the peer\n");
+                return;
+            }
+            g.configured = true;
+            std::fprintf(stderr, "[net] player %d via %s, delay %s\n", g.player, g.relay ? "relay" : (g.listen ? "listen" : "direct"),
+                         g.autoDelay ? "auto" : std::to_string(g.delay).c_str());
+        }
+
+        void sendRaw(const void *data, size_t n)
+        {
+            if (!g.peerKnown)
+                return;
+            ::sendto(g.sock, static_cast<const char *>(data), static_cast<int>(n), 0, reinterpret_cast<const sockaddr *>(&g.peer),
+                     sizeof g.peer);
+            ++g.tx;
+        }
+
+        void sendRelayRegistration()
+        {
+            char reg[37];
+            std::memcpy(reg, "RLY1", 4);
+            std::memcpy(reg + 4, g.token, 32);
+            reg[36] = static_cast<char>('0' + g.player);
+            sendRaw(reg, sizeof reg);
+        }
+
+        Packet header(uint8_t kind)
+        {
+            Packet p{};
+            p.magic = kMagic;
+            p.version = kVersion;
+            p.kind = kind;
+            p.player = static_cast<uint8_t>(g.player);
+            p.checkFrame = g.ourCheckFrame;
+            p.checksum = g.ourChecksum;
+            return p;
+        }
+
+        void sendControl(uint8_t kind, uint64_t value)
+        {
+            Packet p = header(kind);
+            p.value = value;
+            sendRaw(&p, sizeof p);
+        }
+
+        // Our inputs up to frame `last` (the newest is the one for frame + delay).
+        void sendInputs(uint32_t last)
+        {
+            Packet p = header(kInputs);
+            const uint32_t first = std::max(g.firstFrame, last >= kRedundancy - 1 ? last - (kRedundancy - 1) : 0u);
+            uint32_t n = 0;
+            for (uint32_t f = first; f <= last && n < kRedundancy; ++f)
+            {
+                const Slot &s = g.local[f % kRing];
+                if (s.frame != f)
+                    continue;
+                if (n == 0)
+                    p.base = f;
+                p.inputs[n++] = WireInput{s.pad.buttons, s.pad.lx, s.pad.ly, s.pad.rx, s.pad.ry};
+            }
+            p.count = static_cast<uint8_t>(n);
+            sendRaw(&p, sizeof p);
+        }
+
+        void compareChecks()
+        {
+            if (g.peerCheckFrame == 0 || g.peerCheckFrame == g.lastCompared)
+                return;
+            for (const auto &[f, h] : g.ourHash)
+            {
+                if (f != g.peerCheckFrame)
+                    continue;
+                g.lastCompared = f;
+                if (h != g.peerChecksum)
+                {
+                    ++g.desyncs;
+                    std::fprintf(stderr, "[net] *** DESYNC at frame %u: ours %016llx, theirs %016llx\n", f,
+                                 static_cast<unsigned long long>(h), static_cast<unsigned long long>(g.peerChecksum));
+                }
+                return;
+            }
+        }
+
+        void handle(const Packet &p, size_t n, std::vector<uint64_t> *rtts)
+        {
+            if (n < offsetof(Packet, inputs) || p.magic != kMagic || p.version != kVersion || p.player != 3 - g.player)
+                return;
+            g.lastRx = Clock::now();
+            ++g.rx;
+            if (p.checkFrame != 0 && p.checkFrame > g.peerCheckFrame)
+            {
+                g.peerCheckFrame = p.checkFrame;
+                g.peerChecksum = p.checksum;
+            }
+            switch (p.kind)
+            {
+            case kInputs:
+                for (uint32_t i = 0; i < p.count && i < kRedundancy; ++i)
+                {
+                    const uint32_t f = p.base + i;
+                    Slot &s = g.remote[f % kRing];
+                    s.frame = f;
+                    s.pad = PadSample{p.inputs[i].buttons, p.inputs[i].lx, p.inputs[i].ly, p.inputs[i].rx, p.inputs[i].ry};
+                }
+                break;
+            case kPing:
+                sendControl(kPong, p.value);
+                break;
+            case kPong:
+                if (rtts && p.value != 0)
+                    rtts->push_back(nowUs() - p.value);
+                break;
+            case kDelay:
+                if (g.player == 2 && p.value >= 1 && p.value <= 10)
+                {
+                    g.peerDelay = static_cast<uint32_t>(p.value);
+                    sendControl(kDelayAck, p.value);
+                }
+                break;
+            case kDelayAck:
+                if (g.player == 1 && p.value == g.delay)
+                    g.delayAcked = true;
+                break;
+            case kBye:
+                if (g.online && !g.ended)
+                {
+                    g.ended = true;
+                    std::fprintf(stderr, "[net] the other player left\n");
+                    writeStatus("offline the other player left");
+                    showBanner(6, 300);
+                }
+                break;
+            default:
+                break;
+            }
+            compareChecks();
+        }
+
+        // Reads every datagram waiting. In listen mode the first valid sender becomes the peer.
+        void pump(std::vector<uint64_t> *rtts = nullptr)
+        {
+            for (;;)
+            {
+                char buf[512];
+                sockaddr_in from{};
+                socklen_t len = sizeof from;
+                const int n = ::recvfrom(g.sock, buf, sizeof buf, 0, reinterpret_cast<sockaddr *>(&from), &len);
+                if (n <= 0)
+                    return;
+                if (g.relay && n == 6 && std::memcmp(buf, "RLYA", 4) == 0)
+                    continue; // the relay's answer to the registration
+                if (static_cast<size_t>(n) < offsetof(Packet, inputs))
+                    continue;
+                Packet p{};
+                std::memcpy(&p, buf, std::min(static_cast<size_t>(n), sizeof p));
+                if (g.listen && !g.peerKnown && p.magic == kMagic && p.player == 3 - g.player)
+                {
+                    g.peer = from;
+                    g.peerKnown = true;
+                }
+                handle(p, static_cast<size_t>(n), rtts);
+            }
+        }
+
+        void sleepMs(int ms) { std::this_thread::sleep_for(std::chrono::milliseconds(ms)); }
+
+        void goOffline(const char *why)
+        {
+            if (g.ended)
+                return;
+            g.ended = true;
+            std::fprintf(stderr, "[net] match over: %s (frame %u, stalls %llu, %.1f s waited, desyncs %llu)\n", why, g.frame,
+                         static_cast<unsigned long long>(g.stalls), g.stallUs / 1e6, static_cast<unsigned long long>(g.desyncs));
+            const std::string line = std::string("offline ") + why;
+            writeStatus(line.c_str());
+            showBanner(6, 300);
+            for (int i = 0; i < 3; ++i)
+                sendControl(kBye, 0);
+        }
+
+        void sendByeAtExit()
+        {
+            if (g.online && !g.ended)
+                for (int i = 0; i < 3; ++i)
+                    sendControl(kBye, 0);
+        }
+
+        // The start: both games wait here (their first vblank) for each other, then agree on the delay.
+        void meet(uint32_t vsync)
+        {
+            g.started = true;
+            std::fprintf(stderr, "[net] waiting for the other player (up to %u s)\n", g.waitMs / 1000u);
+            writeStatus("waiting");
+            const auto t0 = Clock::now();
+            auto lastSend = Clock::time_point{};
+            auto lastReg = Clock::time_point{};
+            std::vector<uint64_t> rtts;
+            bool heard = false;
+            for (;;)
+            {
+                const auto now = Clock::now();
+                if (now - t0 > std::chrono::milliseconds(g.waitMs))
+                {
+                    std::fprintf(stderr, "[net] the other player never came\n");
+                    g.ended = true;
+                    writeStatus("offline the other player never came");
+                    showBanner(4, 300);
+                    return;
+                }
+                if (g.relay && now - lastReg > std::chrono::milliseconds(500))
+                {
+                    sendRelayRegistration();
+                    lastReg = now;
+                }
+                if (now - lastSend > std::chrono::milliseconds(heard ? 20 : 100))
+                {
+                    sendControl(kPing, nowUs());
+                    if (g.player == 1 && g.autoDelay && rtts.size() >= 8)
+                        sendControl(kDelay, g.delay);
+                    lastSend = now;
+                }
+                pump(&rtts);
+                heard = g.rx > 0;
+                ps2_gsdump::setNetStatus(2); // every pass: the GS host's ring may open while we wait
+                if (heard)
+                {
+                    if (g.player == 1 && g.autoDelay && rtts.size() >= 8 && !g.delayAcked)
+                    {
+                        std::vector<uint64_t> s(rtts.begin(), rtts.begin() + 8);
+                        std::sort(s.begin(), s.end());
+                        const double oneWayMs = s[4] / 2000.0;
+                        g.delay = static_cast<uint32_t>(std::clamp(static_cast<int>(std::ceil((oneWayMs + 8.0) / 16.667)), 1, 8));
+                    }
+                    const bool delayAgreed = !g.autoDelay || (g.player == 1 ? g.delayAcked : g.peerDelay != 0);
+                    if (delayAgreed)
+                        break;
+                }
+                sleepMs(2);
+            }
+            if (g.autoDelay && g.player == 2)
+                g.delay = g.peerDelay;
+            g.firstFrame = vsync;
+            g.online = true;
+            g.lastRx = Clock::now();
+            std::atexit(sendByeAtExit);
+            showBanner(3, 180);
+            std::fprintf(stderr, "[net] online from frame %u, delay %u frames, waited %.1f s\n", vsync, g.delay,
+                         std::chrono::duration<double>(Clock::now() - t0).count());
+            writeStatus("online");
+        }
+
+        // FNV-1a over 64-bit words in 8 independent lanes (word i goes to lane i % 8), folded at the end. One chain of 4M
+        // dependent multiplies took ~4.5 ms at the vblank once a second; the lanes run side by side, so the 32 MB read
+        // is the limit. Integers only: the same value on every machine. Protocol version 2 (version 1 was one lane).
+        uint64_t hashRam(const uint8_t *p, size_t n)
+        {
+            constexpr uint64_t kBasis = 1469598103934665603ull, kPrime = 1099511628211ull;
+            uint64_t h[8];
+            for (uint64_t &x : h)
+                x = kBasis;
+            const uint64_t *w = reinterpret_cast<const uint64_t *>(p);
+            const size_t words = n / 8u;
+            size_t i = 0;
+            for (; i + 8u <= words; i += 8u)
+                for (size_t l = 0; l < 8u; ++l)
+                    h[l] = (h[l] ^ w[i + l]) * kPrime;
+            for (; i < words; ++i)
+                h[0] = (h[0] ^ w[i]) * kPrime;
+            uint64_t r = kBasis;
+            for (uint64_t x : h)
+                r = (r ^ x) * kPrime;
+            return r;
+        }
+    }
+
+    bool enabled()
+    {
+        configure();
+        return g.configured;
+    }
+
+    void onVsync(uint64_t vsync64, const uint8_t *rdram, PS2Runtime *runtime)
+    {
+        if (!enabled())
+            return;
+        const uint32_t vsync = static_cast<uint32_t>(vsync64);
+        g.lastVsync = vsync;
+        if (!g.started)
+            meet(vsync);
+        if (g.banner != 0 && vsync >= g.bannerUntil)
+            g.banner = 0;
+        ps2_gsdump::setNetStatus(g.banner);
+        const PadSample mine = sampleLocalPad(runtime);
+        const int myPort = g.player - 1;
+        if (!g.online || g.ended)
+        {
+            // offline (the other player never came or left): the local pad plays its own port, the other one idles
+            g.current[myPort] = mine;
+            g.current[1 - myPort] = PadSample{};
+            return;
+        }
+        g.frame = vsync;
+
+        // the hash first: it is the state both games reached with the same inputs
+        if (rdram && ((vsync - g.firstFrame) % g.checkEvery) == 0u && vsync != g.firstFrame)
+        {
+            const uint64_t h = hashRam(rdram, kEeRamSize);
+            g.ourHash[(vsync / g.checkEvery) % g.ourHash.size()] = {vsync, h};
+            g.ourCheckFrame = vsync;
+            g.ourChecksum = h;
+            compareChecks();
+        }
+
+        const uint32_t target = vsync + g.delay;
+        g.local[target % kRing] = Slot{target, mine};
+        sendInputs(target);
+
+        PadSample theirs{};
+        if (vsync >= g.firstFrame + g.delay)
+        {
+            const auto t0 = Clock::now();
+            auto lastSend = t0;
+            bool stalled = false;
+            for (;;)
+            {
+                pump();
+                if (g.ended)
+                    break;
+                const Slot &s = g.remote[vsync % kRing];
+                if (s.frame == vsync)
+                {
+                    theirs = s.pad;
+                    break;
+                }
+                const auto now = Clock::now();
+                if (!stalled)
+                {
+                    stalled = true;
+                    ++g.stalls;
+                }
+                if (now - g.lastRx > std::chrono::milliseconds(g.timeoutMs))
+                {
+                    goOffline("the other player stopped answering");
+                    break;
+                }
+                if (now - lastSend > std::chrono::milliseconds(15))
+                {
+                    sendInputs(target); // the other side may have lost ours
+                    lastSend = now;
+                }
+                std::this_thread::sleep_for(std::chrono::microseconds(500));
+            }
+            if (stalled)
+                g.stallUs += static_cast<uint64_t>(
+                    std::chrono::duration_cast<std::chrono::microseconds>(Clock::now() - t0).count());
+        }
+        else
+        {
+            pump();
+        }
+        if (g.ended)
+        {
+            g.current[myPort] = mine;
+            g.current[1 - myPort] = PadSample{};
+            return;
+        }
+
+        const Slot &own = g.local[vsync % kRing];
+        g.current[myPort] = own.frame == vsync ? own.pad : PadSample{};
+        g.current[1 - myPort] = theirs;
+
+        if (((vsync - g.firstFrame) % 600u) == 0u && vsync != g.firstFrame)
+            std::fprintf(stderr, "[net] frame %u: stalls %llu (%.1f s), rx %llu tx %llu, desyncs %llu\n", vsync,
+                         static_cast<unsigned long long>(g.stalls), g.stallUs / 1e6, static_cast<unsigned long long>(g.rx),
+                         static_cast<unsigned long long>(g.tx), static_cast<unsigned long long>(g.desyncs));
+    }
+
+    bool padFor(int port, PadSample &out)
+    {
+        if (!g.configured || port < 0 || port > 1)
+            return false;
+        out = g.current[port];
+        return true;
+    }
+}
diff --git a/C:/NBAOnline/PS2Recomp/ps2xRuntime/src/lib/Kernel/Net/NetPlay.h b/ps2xRuntime/src/lib/Kernel/Net/NetPlay.h
new file mode 100644
index 0000000..653d0f6
--- /dev/null
+++ b/ps2xRuntime/src/lib/Kernel/Net/NetPlay.h
@@ -0,0 +1,32 @@
+#pragma once
+
+// [netplay] Two-player online play by input lockstep (PS2X_DETERMINISTIC=1 makes both games the same function of
+// their inputs; see NetPlay.cpp).
+
+#include <cstdint>
+
+class PS2Runtime;
+
+namespace ps2_net
+{
+    // One pad's input for one frame: what crosses the network.
+    struct PadSample
+    {
+        uint16_t buttons = 0xFFFFu; // active-low, as the pad reports it
+        uint8_t lx = 0x80u, ly = 0x80u, rx = 0x80u, ry = 0x80u;
+    };
+
+    // PS2X_NET_PLAYER=1|2 and a transport (PS2X_NET_RELAY + PS2X_NET_TOKEN, PS2X_NET=<host:port> or
+    // PS2X_NET_LISTEN=<port>). Read once.
+    bool enabled();
+
+    // The local player's pad right now (host controller, keyboard, GS host window, PS2X_PAD_SCRIPT). In Pad.cpp.
+    PadSample sampleLocalPad(PS2Runtime *runtime);
+
+    // At every VBlankStart, on the EE executor thread: sends this frame's local input and waits for the other
+    // player's. Blocks the game while the other one is behind.
+    void onVsync(uint64_t vsync, const uint8_t *rdram, PS2Runtime *runtime);
+
+    // The input a pad port reads this frame while netplay runs (port 0 = player 1, port 1 = player 2).
+    bool padFor(int port, PadSample &out);
+}
