+    {
+        info = {};
+        uint32_t sdPtr = 0u;
+        {
+            std::lock_guard<std::mutex> lock(g_rpc_mutex);
+            const auto it = g_rpc_servers.find(sid);
+            if (it == g_rpc_servers.end())
+                return false;
+            sdPtr = it->second.sd_ptr;
+        }
+
+        // SifBindRpc publishes func-less descriptors for IOP-side SIDs: only a registered
+        // EE server has a function.
+        const auto *sd = sdPtr != 0u ? reinterpret_cast<const t_SifRpcServerData *>(getConstMemPtr(rdram, sdPtr)) : nullptr;
+        if (!sd || sd->func == 0u)
+            return false;
