+    uint32_t IopKernel::allocateFromPool(VariablePool &pool, uint32_t size)
+    {
+        const uint32_t wanted = alignUp(std::max<uint32_t>(size, 1u), 16u);
+        for (auto block = pool.freeBlocks.begin(); block != pool.freeBlocks.end(); ++block)
+        {
+            if (block->second < wanted)
+                continue;
+            const uint32_t address = block->first;
+            const uint32_t remaining = block->second - wanted;
+            pool.freeBlocks.erase(block);
+            if (remaining != 0u)
+                pool.freeBlocks.emplace(address + wanted, remaining);
+            pool.usedBlocks.emplace(address, wanted);
+            return address;
+        }
+        return 0u;
+    }
+
+    bool IopKernel::freeToPool(VariablePool &pool, uint32_t address)
+    {
+        const auto used = pool.usedBlocks.find(address);
+        if (used == pool.usedBlocks.end())
+            return false;
+        uint32_t start = used->first;
+        uint32_t size = used->second;
+        pool.usedBlocks.erase(used);
+
+        // Merge with the free neighbours on both sides.
+        auto next = pool.freeBlocks.lower_bound(start);
+        if (next != pool.freeBlocks.end() && next->first == start + size)
+        {
+            size += next->second;
+            next = pool.freeBlocks.erase(next);
+        }
+        if (next != pool.freeBlocks.begin())
+        {
+            auto previous = std::prev(next);
+            if (previous->first + previous->second == start)
+            {
+                start = previous->first;
+                size += previous->second;
+                pool.freeBlocks.erase(previous);
+            }
+        }
+        pool.freeBlocks.emplace(start, size);
+        return true;
+    }
+
+    // thvpool: CreateVpl(4) DeleteVpl(5) AllocateVpl(6) pAllocateVpl(7) ipAllocateVpl(8)
+    // FreeVpl(9) ReferVplStatus(11) iReferVplStatus(12). The pool is one allocation from the
+    // IOP heap; blocks are tracked host-side (16-byte granules), so the guest sees no headers.
+    bool IopKernel::dispatchVplImport(uint16_t ordinal, IopCpuState &cpu)
+    {
+        constexpr int32_t kErrorNoMemory = -400;    // KE_NO_MEMORY
+        constexpr int32_t kErrorIllegalSize = -404; // KE_ILLEGAL_SIZE
+        constexpr int32_t kErrorUnknownVpl = -411;  // KE_UNKNOWN_VPLID
+        constexpr int32_t kErrorIllegalBlock = -412;
+        const auto setV0 = [&](int32_t value)
+        {
+            cpu.gpr[2] = static_cast<uint32_t>(value);
+        };
+
+        switch (ordinal)
+        {
+        case 4: // CreateVpl(iop_vpl_param_t {attr, option, size})
+        {
+            const uint32_t descriptor = cpu.gpr[4];
+            VariablePool pool;
+            if (descriptor != 0u)
+            {
+                pool.attr = m_memory.read32(descriptor + 0u);
+                pool.option = m_memory.read32(descriptor + 4u);
+                pool.size = alignUp(m_memory.read32(descriptor + 8u), 16u);
+            }
+            if (pool.size == 0u)
+            {
+                setV0(kErrorIllegalSize);
+                return true;
+            }
+            pool.base = m_memory.allocate(pool.size, 16u);
+            if (pool.base == 0u)
+            {
+                setV0(kErrorNoMemory);
+                return true;
+            }
+            pool.id = static_cast<int>(m_nextVariablePoolId++);
+            pool.freeBlocks.emplace(pool.base, pool.size);
+            const int id = pool.id;
+            m_variablePools.emplace(id, std::move(pool));
+            setV0(id);
+            return true;
+        }
+        case 5: // DeleteVpl(id)
+        {
+            const auto it = m_variablePools.find(static_cast<int>(cpu.gpr[4]));
+            if (it == m_variablePools.end())
+            {
+                setV0(kErrorUnknownVpl);
+                return true;
+            }
+            (void)m_memory.freeAllocation(it->second.base);
+            m_variablePools.erase(it);
+            setV0(0);
+            return true;
+        }
+        case 6: // AllocateVpl(id, size)
+        case 7: // pAllocateVpl(id, size)
+        case 8: // ipAllocateVpl(id, size)
+        {
+            const auto it = m_variablePools.find(static_cast<int>(cpu.gpr[4]));
+            if (it == m_variablePools.end())
+            {
+                setV0(kErrorUnknownVpl);
+                return true;
+            }
+            const uint32_t address = allocateFromPool(it->second, cpu.gpr[5]);
+            if (address == 0u)
+            {
+                // AllocateVpl would wait for a FreeVpl; nothing here frees for it, so fail.
+                static uint32_t s_exhaustedLogs = 0;
+                if (s_exhaustedLogs < 8u)
+                {
+                    ++s_exhaustedLogs;
+                    std::fprintf(stderr, "[IOP] vpl %d exhausted: ordinal=%u size=0x%x pool=0x%x\n",
+                                 it->second.id, static_cast<unsigned>(ordinal), cpu.gpr[5], it->second.size);
+                }
+                setV0(kErrorNoMemory);
+                return true;
+            }
+            cpu.gpr[2] = address;
+            return true;
+        }
+        case 9: // FreeVpl(id, block)
+        {
+            const auto it = m_variablePools.find(static_cast<int>(cpu.gpr[4]));
+            if (it == m_variablePools.end())
+            {
+                setV0(kErrorUnknownVpl);
+                return true;
+            }
+            setV0(freeToPool(it->second, cpu.gpr[5]) ? 0 : kErrorIllegalBlock);
+            return true;
+        }
+        case 11: // ReferVplStatus(id, iop_vpl_info_t *)
+        case 12: // iReferVplStatus
+        {
+            const auto it = m_variablePools.find(static_cast<int>(cpu.gpr[4]));
+            if (it == m_variablePools.end())
+            {
+                setV0(kErrorUnknownVpl);
+                return true;
+            }
+            const uint32_t info = cpu.gpr[5];
+            if (info != 0u)
+            {
+                uint32_t freeSize = 0u;
+                for (const auto &[address, size] : it->second.freeBlocks)
+                    freeSize += size;
+                (void)m_memory.zeroRam(info, 32u);
+                m_memory.write32(info + 0u, it->second.attr);
+                m_memory.write32(info + 4u, it->second.option);
+                m_memory.write32(info + 8u, it->second.size);
+                m_memory.write32(info + 12u, freeSize);
+            }
+            setV0(0);
+            return true;
+        }
+        default:
+            return false;
+        }
+    }
