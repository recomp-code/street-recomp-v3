+    bool callEeRpcServer(uint8_t *rdram,
+                         PS2Runtime *runtime,
+                         uint32_t sid,
+                         uint32_t function,
+                         const void *sendData,
+                         size_t sendSize,
+                         std::function<void(uint32_t)> onComplete)
+    {
+        ps2x::iop::EeRpcServerInfo server{};
+        if (!rdram || !runtime || !findEeRpcServer(rdram, sid, server))
+            return false;
+        uint32_t gp = 0u;
+        {
+            std::lock_guard<std::mutex> lock(g_rpc_mutex);
+            gp = g_rpc_servers[sid].gp;
+        }
+
+        if (sendData && sendSize != 0u && server.buffer != 0u)
+        {
+            uint8_t *const first = getMemPtr(rdram, server.buffer);
+            uint8_t *const last = getMemPtr(rdram, server.buffer + static_cast<uint32_t>(sendSize - 1u));
+            if (!first || !last || last < first || static_cast<size_t>(last - first) != sendSize - 1u)
+                return false;
+            ps2TraceGuestRangeWrite(rdram, server.buffer, static_cast<uint32_t>(sendSize), "IOP->EE RPC send", nullptr);
+            std::memcpy(first, sendData, sendSize);
+        }
+
+        try
+        {
+            // Queued like an IOP -> EE SIF command: the server's own thread (sceSifRpcLoop)
+            // does not exist here, so the function runs as an invocation on the EE.
+            GuestInvocation invocation{};
+            invocation.kind = GuestInvocationKind::SifCommand;
+            invocation.tag = sid;
+            invocation.context = runtime->cpu();
+            invocation.context.pc = server.function;
+            SET_GPR_U32(&invocation.context, 4, function);
+            SET_GPR_U32(&invocation.context, 5, server.buffer);
+            SET_GPR_U32(&invocation.context, 6, static_cast<uint32_t>(sendSize));
+            SET_GPR_U32(&invocation.context, 7, 0u);
+            SET_GPR_U32(&invocation.context, 28, gp);
+            SET_GPR_U32(&invocation.context, 29, 0u);
+            SET_GPR_U32(&invocation.context, 31, 0u);
+            invocation.onComplete = [onComplete = std::move(onComplete)](const R5900Context &completed, R5900Context &)
+            {
+                if (onComplete)
+                    onComplete(getRegU32(&completed, 2));
+            };
+            runtime->eeScheduler().queueInvocation(std::move(invocation));
+            return true;
+        }
+        catch (...)
+        {
+            return false;
+        }
