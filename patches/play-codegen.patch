+//Pushes the next block's table value: table[(ctx->pc & mask) >> shift]
+void CCodeGen_Wasm::EmitChainIndex(const WASM_BLOCK_CHAIN& chain)
+{
+	PushContext();
+	m_functionStream.Write8(Wasm::INST_I32_LOAD);
+	m_functionStream.Write8(0x02);
+	CWasmModuleBuilder::WriteULeb128(m_functionStream, chain.pcOffset);
+	m_functionStream.Write8(Wasm::INST_I32_CONST);
+	CWasmModuleBuilder::WriteSLeb128(m_functionStream, static_cast<int32>(chain.pcMask));
+	m_functionStream.Write8(Wasm::INST_I32_AND);
+	m_functionStream.Write8(Wasm::INST_I32_CONST);
+	CWasmModuleBuilder::WriteSLeb128(m_functionStream, static_cast<int32>(chain.pcShift));
+	m_functionStream.Write8(Wasm::INST_I32_SHR_U);
+	m_functionStream.Write8(Wasm::INST_I32_CONST);
+	CWasmModuleBuilder::WriteSLeb128(m_functionStream, 2);
+	m_functionStream.Write8(Wasm::INST_I32_SHL);
+	m_functionStream.Write8(Wasm::INST_I32_LOAD);
+	m_functionStream.Write8(0x02);
+	CWasmModuleBuilder::WriteULeb128(m_functionStream, chain.functionTable);
+}
+
+void CCodeGen_Wasm::Emit_ExternJmpDyn(const STATEMENT& statement)
+{
+	auto src1 = statement.src1->GetSymbol().get();
+	assert(src1->m_type == SYM_CONSTANTPTR);
+	const auto& chain = *reinterpret_cast<const WASM_BLOCK_CHAIN*>(src1->m_valueLow);
+
+	//if(ctx->exception == 0)
+	PushContext();
+	m_functionStream.Write8(Wasm::INST_I32_LOAD);
+	m_functionStream.Write8(0x02);
+	CWasmModuleBuilder::WriteULeb128(m_functionStream, chain.exceptionOffset);
+	m_functionStream.Write8(Wasm::INST_I32_EQZ);
+	m_functionStream.Write8(Wasm::INST_IF);
+	m_functionStream.Write8(0x40);
+	if(chain.tailCalls)
+	{
+		//if(next != 0) return_call_indirect(next)(ctx)
+		EmitChainIndex(chain);
+		m_functionStream.Write8(Wasm::INST_IF);
+		m_functionStream.Write8(0x40);
+		PushContext();
+		EmitChainIndex(chain);
+		auto sigIdxIterator = m_signatures.find("vi");
+		assert(sigIdxIterator != std::end(m_signatures));
+		m_functionStream.Write8(Wasm::INST_RETURN_CALL_INDIRECT);
+		CWasmModuleBuilder::WriteULeb128(m_functionStream, sigIdxIterator->second);
+		m_functionStream.Write8(0x00); //Table index
+		m_functionStream.Write8(Wasm::INST_END);
+	}
+	else
+	{
+		//ctx->nextFunction = next (the dispatcher calls it without looking the block up)
+		PushContext();
+		EmitChainIndex(chain);
+		m_functionStream.Write8(Wasm::INST_I32_STORE);
+		m_functionStream.Write8(0x02);
+		CWasmModuleBuilder::WriteULeb128(m_functionStream, chain.nextFunctionOffset);
+	}
+	m_functionStream.Write8(Wasm::INST_END);
+}
