+namespace
+{
+	bool ReadULeb128(const std::vector<uint8>& data, size_t& pos, uint32& value)
+	{
+		value = 0;
+		for(uint32 shift = 0; shift < 35; shift += 7)
+		{
+			if(pos >= data.size()) return false;
+			uint8 byte = data[pos++];
+			value |= static_cast<uint32>(byte & 0x7F) << shift;
+			if((byte & 0x80) == 0) return true;
+		}
+		return false;
+	}
+
+	struct MODULE_PARTS
+	{
+		std::vector<uint8> typeSection;   //section content (without id and size)
+		std::vector<uint8> importSection;
+		std::vector<uint8> body;          //the function body (locals + code), without its size
+	};
+
+	bool SplitModule(const std::vector<uint8>& data, MODULE_PARTS& parts)
+	{
+		if(data.size() < 8) return false;
+		uint32 magic = 0, version = 0;
+		memcpy(&magic, data.data(), 4);
+		memcpy(&version, data.data() + 4, 4);
+		if((magic != Wasm::BINARY_MAGIC) || (version != Wasm::BINARY_VERSION)) return false;
+		size_t pos = 8;
+		bool hasCode = false;
+		while(pos < data.size())
+		{
+			uint8 id = data[pos++];
+			uint32 size = 0;
+			if(!ReadULeb128(data, pos, size) || (pos + size > data.size())) return false;
+			const auto begin = data.begin() + pos;
+			switch(id)
+			{
+			case Wasm::SECTION_ID_TYPE:
+				parts.typeSection.assign(begin, begin + size);
+				break;
+			case Wasm::SECTION_ID_IMPORT:
+				parts.importSection.assign(begin, begin + size);
+				break;
+			case Wasm::SECTION_ID_FUNCTION:
+				//One function of type 0
+				if((size != 2) || (data[pos] != 1) || (data[pos + 1] != 0)) return false;
+				break;
+			case Wasm::SECTION_ID_EXPORT:
+				break;
+			case Wasm::SECTION_ID_CODE:
+			{
+				size_t codePos = pos;
+				uint32 count = 0, bodySize = 0;
+				if(!ReadULeb128(data, codePos, count) || (count != 1)) return false;
+				if(!ReadULeb128(data, codePos, bodySize) || (codePos + bodySize != pos + size)) return false;
+				parts.body.assign(data.begin() + codePos, data.begin() + codePos + bodySize);
+				hasCode = true;
+			}
+			break;
+			default:
+				return false;
+			}
+			pos += size;
+		}
+		return hasCode && !parts.typeSection.empty() && !parts.importSection.empty();
+	}
+
+	void WriteULeb128Vector(std::vector<uint8>& out, uint32 value)
+	{
+		do
+		{
+			uint8 byte = value & 0x7F;
+			value >>= 7;
+			if(value != 0) byte |= 0x80;
+			out.push_back(byte);
+		} while(value != 0);
+	}
+
+	void WriteSection(std::vector<uint8>& out, uint8 id, const std::vector<uint8>& content)
+	{
+		out.push_back(id);
+		WriteULeb128Vector(out, static_cast<uint32>(content.size()));
+		out.insert(out.end(), content.begin(), content.end());
+	}
+}
+
+bool CWasmModuleBuilder::MergeModules(const std::vector<const std::vector<uint8>*>& modules, std::vector<uint8>& merged)
+{
+	if(modules.empty()) return false;
+	std::vector<MODULE_PARTS> parts(modules.size());
+	for(size_t i = 0; i < modules.size(); i++)
+	{
+		if(!SplitModule(*modules[i], parts[i])) return false;
+		if(i != 0)
+		{
+			if(parts[i].typeSection != parts[0].typeSection) return false;
+			if(parts[i].importSection != parts[0].importSection) return false;
+		}
+	}
+	uint32 count = static_cast<uint32>(modules.size());
+
+	std::vector<uint8> out;
+	uint32 header[2] = {Wasm::BINARY_MAGIC, Wasm::BINARY_VERSION};
+	out.insert(out.end(), reinterpret_cast<const uint8*>(header), reinterpret_cast<const uint8*>(header) + sizeof(header));
+	WriteSection(out, Wasm::SECTION_ID_TYPE, parts[0].typeSection);
+	WriteSection(out, Wasm::SECTION_ID_IMPORT, parts[0].importSection);
+	{
+		std::vector<uint8> functions;
+		WriteULeb128Vector(functions, count);
+		for(uint32 i = 0; i < count; i++)
+			functions.push_back(0); //Type 0 ("vi")
+		WriteSection(out, Wasm::SECTION_ID_FUNCTION, functions);
+	}
+	{
+		std::vector<uint8> exports;
+		WriteULeb128Vector(exports, count);
+		for(uint32 i = 0; i < count; i++)
+		{
+			std::string name = "f" + std::to_string(i);
+			WriteULeb128Vector(exports, static_cast<uint32>(name.size()));
+			exports.insert(exports.end(), name.begin(), name.end());
+			exports.push_back(Wasm::IMPORT_EXPORT_TYPE_FUNCTION);
+			WriteULeb128Vector(exports, i);
+		}
+		WriteSection(out, Wasm::SECTION_ID_EXPORT, exports);
+	}
+	{
+		std::vector<uint8> code;
+		WriteULeb128Vector(code, count);
+		for(const auto& part : parts)
+		{
+			WriteULeb128Vector(code, static_cast<uint32>(part.body.size()));
+			code.insert(code.end(), part.body.begin(), part.body.end());
+		}
+		WriteSection(out, Wasm::SECTION_ID_CODE, code);
+	}
+	merged = std::move(out);
+	return true;
+}
