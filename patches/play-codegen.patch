+	for(uint32 i = 0; i < count; i++)
+	{
+		auto& function = result[i];
+		function.m_wasmModule = module;
+		function.m_size = size / count;
+		function.m_exportIndex = static_cast<int32>(i);
+		function.m_code = reinterpret_cast<void*>(static_cast<uintptr_t>(ids[i]));
+	}
+	return result;
+}
+#endif
