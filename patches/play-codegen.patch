+//Registers are turned into temporaries, which already live in locals; they get stack locations
+//past any real temporary so each register is its own local.
+StatementList CCodeGen_Wasm::MapRegistersToLocals(const StatementList& statements)
+{
+	static constexpr uint32 REGISTER_LOCATION_BASE = 0x40000000;
+	m_registerLocals.clear();
+	std::map<std::pair<SYM_TYPE, uint32>, SymbolPtr> locals;
+	StatementList result = statements;
+	for(auto& statement : result)
+	{
+		statement.VisitOperands(
+		    [&](SymbolRefPtr& symbolRef, bool) {
+			    auto symbol = symbolRef->GetSymbol();
+			    SYM_TYPE localType;
+			    switch(symbol->m_type)
+			    {
+			    case SYM_REGISTER:
+				    localType = SYM_TEMPORARY;
+				    break;
+			    case SYM_REG_REFERENCE:
+				    localType = SYM_TMP_REFERENCE;
+				    break;
+			    case SYM_FP_REGISTER32:
+				    localType = SYM_FP_TEMPORARY32;
+				    break;
+			    case SYM_REGISTER128:
+				    localType = SYM_TEMPORARY128;
+				    break;
+			    default:
+				    return;
+			    }
+			    auto key = std::make_pair(localType, symbol->m_valueLow);
+			    auto& local = locals[key];
+			    if(!local)
+			    {
+				    local = std::make_shared<CSymbol>(localType, REGISTER_LOCATION_BASE + symbol->m_valueLow, 0);
+				    local->m_stackLocation = REGISTER_LOCATION_BASE + symbol->m_valueLow;
+				    m_registerLocals.push_back(local);
+			    }
+			    symbolRef = std::make_shared<CSymbolRef>(local);
+		    });
+	}
+	return result;
+}
+
+bool CCodeGen_Wasm::s_cacheContextInLocals = true;
+
+//The register allocator works per basic block: every context field a block uses is loaded from
+//the context at the block's start and stored back at its end (and around calls). In wasm, locals
+//are function-wide and structured control flow keeps them intact, so here each context field
+//(relative symbol) that doesn't overlap another one gets its own local for the whole function:
+//loaded once at the entry, stored back before the function can be left (calls, external jumps,
+//its end) or the context can be accessed some other way (through a reference that may point into
+//it), and reloaded after anything that may have changed the context (calls, such stores). The
+//register allocator's per-block loads and stores become local-to-local copies.
+//Invariant: at any point, a cached local holds the field's current value (written back to the
+//context at the sync points above), on every path.
+StatementList CCodeGen_Wasm::CacheContextInLocals(const StatementList& statements)
+{
+	if(!s_cacheContextInLocals) return statements;
+
+	static constexpr uint32 CACHE_LOCATION_BASE = 0x50000000;
+
+	struct CACHED
+	{
+		SymbolPtr relative;
+		SymbolPtr local;
+		uint32 begin = 0;
+		uint32 end = 0;
+		bool written = false;
+		bool excluded = false;
+	};
+
+	auto getCacheInfo =
+	    [](SYM_TYPE type, SYM_TYPE& localType, uint32& size) {
+		    switch(type)
+		    {
+		    case SYM_RELATIVE:
+			    localType = SYM_TEMPORARY;
+			    size = 4;
+			    return true;
+		    case SYM_REL_REFERENCE:
+			    localType = SYM_TMP_REFERENCE;
+			    size = 4;
+			    return true;
+		    case SYM_FP_RELATIVE32:
+			    localType = SYM_FP_TEMPORARY32;
+			    size = 4;
+			    return true;
+		    case SYM_RELATIVE64:
+			    localType = SYM_TEMPORARY64;
+			    size = 8;
+			    return true;
+		    case SYM_RELATIVE128:
+			    localType = SYM_TEMPORARY128;
+			    size = 16;
+			    return true;
+		    default:
+			    return false;
+		    }
+	    };
+
+	//Gather the context fields the function uses
+	std::map<std::pair<SYM_TYPE, uint32>, CACHED> cached;
+	for(const auto& statement : statements)
+	{
+		statement.VisitOperands(
+		    [&](const SymbolRefPtr& symbolRef, bool isDef) {
+			    auto symbol = symbolRef->GetSymbol();
+			    SYM_TYPE localType = SYM_CONSTANT;
+			    uint32 size = 0;
+			    if(!getCacheInfo(symbol->m_type, localType, size)) return;
+			    auto& entry = cached[std::make_pair(symbol->m_type, symbol->m_valueLow)];
+			    if(!entry.relative)
+			    {
+				    entry.relative = symbol;
+				    entry.begin = symbol->m_valueLow;
+				    entry.end = symbol->m_valueLow + size;
+			    }
+			    entry.written |= isDef;
+		    });
+	}
+	if(cached.empty()) return statements;
+
+	//Fields seen through overlapping symbols (e.g. a vector and one of its elements) stay in memory
+	for(auto it1 = cached.begin(); it1 != cached.end(); it1++)
+	{
+		for(auto it2 = std::next(it1); it2 != cached.end(); it2++)
+		{
+			if((it1->second.begin < it2->second.end) && (it2->second.begin < it1->second.end))
+			{
+				it1->second.excluded = true;
+				it2->second.excluded = true;
+			}
+		}
+	}
+
+	uint32 nextLocation = CACHE_LOCATION_BASE;
+	for(auto& [key, entry] : cached)
+	{
+		if(entry.excluded) continue;
+		SYM_TYPE localType = SYM_CONSTANT;
+		uint32 size = 0;
+		getCacheInfo(entry.relative->m_type, localType, size);
+		entry.local = std::make_shared<CSymbol>(localType, nextLocation, 0);
+		entry.local->m_stackLocation = nextLocation;
+		m_registerLocals.push_back(entry.local);
+		nextLocation++;
+	}
+
+	auto makeMove =
+	    [](const SymbolPtr& dst, const SymbolPtr& src) {
+		    STATEMENT move;
+		    move.op = OP_MOV;
+		    move.dst = std::make_shared<CSymbolRef>(dst);
+		    move.src1 = std::make_shared<CSymbolRef>(src);
+		    return move;
+	    };
+
+	StatementList result;
+
+	//Writes back the cached fields that end past 'lowerBound' (only the ones the function writes)
+	auto flush =
+	    [&](uint32 lowerBound) {
+		    for(const auto& [key, entry] : cached)
+		    {
+			    if(!entry.local || !entry.written || (entry.end <= lowerBound)) continue;
+			    result.push_back(makeMove(entry.relative, entry.local));
+		    }
+	    };
+	//Reloads the cached fields that end past 'lowerBound'
+	auto reload =
+	    [&](uint32 lowerBound) {
+		    for(const auto& [key, entry] : cached)
+		    {
+			    if(!entry.local || (entry.end <= lowerBound)) continue;
+			    result.push_back(makeMove(entry.local, entry.relative));
+		    }
+	    };
+
+	//Where references point: into the context (from OP_RELTOREF: from that offset upwards, as array
+	//indexing goes) or somewhere else (pointers kept in the context, loaded pointers).
+	struct ORIGIN
+	{
+		bool external = false;
+		uint32 lowerBound = 0;
+	};
+	static const ORIGIN unknownOrigin = {false, 0};
+	std::map<std::pair<SYM_TYPE, uint32>, ORIGIN> origins;
+	auto refKey =
+	    [](const SymbolPtr& symbol) {
+		    uint32 id = symbol->IsTemporary() ? symbol->m_stackLocation : symbol->m_valueLow;
+		    return std::make_pair(symbol->m_type, id);
+	    };
+	auto originOf =
+	    [&](const SymbolPtr& symbol) -> ORIGIN {
+		    auto it = origins.find(refKey(symbol));
+		    if(it != origins.end()) return it->second;
+		    //A pointer stored in the context, never written here from a context address
+		    if(symbol->m_type == SYM_REL_REFERENCE) return {true, 0};
+		    return unknownOrigin;
+	    };
+
+	//Entry: every cached field in its local
+	reload(0);
+
+	for(const auto& original : statements)
+	{
+		bool refLoad = false;
+		bool refStore = false;
+		switch(original.op)
+		{
+		case OP_LOADFROMREF:
+		case OP_LOAD8FROMREF:
+		case OP_LOAD16FROMREF:
+		case OP_MD_LOADFROMREF_MASKED:
+			refLoad = true;
+			break;
+		case OP_STOREATREF:
+		case OP_STORE8ATREF:
+		case OP_STORE16ATREF:
+		case OP_MD_STOREATREF_MASKED:
+			refStore = true;
+			break;
+		default:
+			break;
+		}
+
+		ORIGIN accessOrigin = {true, 0};
+		if(refLoad || refStore)
+		{
+			accessOrigin = originOf(original.src1->GetSymbol());
+		}
+		bool contextAccess = (refLoad || refStore) && !accessOrigin.external;
+
+		bool isCall = (original.op == OP_CALL);
+		bool isExit = (original.op == OP_EXTERNJMP) || (original.op == OP_EXTERNJMP_DYN);
+
+		if(isCall || isExit)
+		{
+			flush(0);
+		}
+		else if(contextAccess)
+		{
+			flush(accessOrigin.lowerBound);
+		}
+
+		//Track reference origins (on the original symbols)
+		if(original.dst)
+		{
+			auto dst = original.dst->GetSymbol();
+			bool dstIsRef = (dst->m_type == SYM_TMP_REFERENCE) || (dst->m_type == SYM_REG_REFERENCE) || (dst->m_type == SYM_REL_REFERENCE);
+			if(dstIsRef)
+			{
+				ORIGIN origin = unknownOrigin;
+				switch(original.op)
+				{
+				case OP_RELTOREF:
+				{
+					auto src1 = original.src1->GetSymbol();
+					origin = {false, (src1->m_type == SYM_CONSTANT) ? src1->m_valueLow : 0};
+				}
+				break;
+				case OP_ADDREF:
+				case OP_MOV:
+					origin = originOf(original.src1->GetSymbol());
+					break;
+				case OP_LOADFROMREF:
+					origin = {true, 0};
+					break;
+				default:
+					break;
+				}
+				if(dst->m_type == SYM_REL_REFERENCE)
+				{
+					//A pointer stored into the context: only keep "external" if it is one
