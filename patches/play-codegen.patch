+//Registers are turned into temporaries, which already live in locals; they get stack locations
+//past any real temporary so each register is its own local.
+StatementList CCodeGen_Wasm::MapRegistersToLocals(const StatementList& statements)
+{
+	static constexpr uint32 REGISTER_LOCATION_BASE = 0x40000000;
+	m_registerLocals.clear();
+	std::map<std::pair<SYM_TYPE, uint32>, SymbolPtr> locals;
+	StatementList result = statements;
+	for(auto& statement : result)
+	{
+		statement.VisitOperands(
+		    [&](SymbolRefPtr& symbolRef, bool) {
+			    auto symbol = symbolRef->GetSymbol();
+			    SYM_TYPE localType;
+			    switch(symbol->m_type)
+			    {
+			    case SYM_REGISTER:
+				    localType = SYM_TEMPORARY;
+				    break;
+			    case SYM_REG_REFERENCE:
+				    localType = SYM_TMP_REFERENCE;
+				    break;
+			    case SYM_FP_REGISTER32:
+				    localType = SYM_FP_TEMPORARY32;
+				    break;
+			    case SYM_REGISTER128:
+				    localType = SYM_TEMPORARY128;
+				    break;
+			    default:
+				    return;
+			    }
+			    auto key = std::make_pair(localType, symbol->m_valueLow);
+			    auto& local = locals[key];
+			    if(!local)
+			    {
+				    local = std::make_shared<CSymbol>(localType, REGISTER_LOCATION_BASE + symbol->m_valueLow, 0);
+				    local->m_stackLocation = REGISTER_LOCATION_BASE + symbol->m_valueLow;
+				    m_registerLocals.push_back(local);
+			    }
+			    symbolRef = std::make_shared<CSymbolRef>(local);
+		    });
+	}
+	return result;
+}
