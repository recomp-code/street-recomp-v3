index 0000000..190f160
--- /dev/null
+++ b/ps2xRuntime/web/library_fetch_stream.js
@@ -0,0 +1,289 @@
+/**
+ * WasmFS fetch backend for the game disc, replacing Emscripten's (src/lib/libwasmfs_fetch.js):
+ * the same on-demand HTTP Range reads, plus
+ *  - read-ahead: sequential reads (streamed music, videos, loading) fetch the next chunks in
+ *    the background, several requests at once, so the game rarely waits for the network;
+ *  - one request per chunk: a read waits for a chunk already on its way instead of asking again;
+ *  - a bounded cache (least recently used chunks go), instead of keeping every chunk ever read;
+ *  - a persistent copy in the browser's Cache Storage: what was played once is read locally the
+ *    next time (keyed by the server's ETag, so a changed file is fetched again).
+ */
+
+addToLibrary({
+  $wasmFS$JSMemoryRanges: {},
+
+  _wasmfs_create_fetch_backend_js__deps: [
+    '$wasmFS$backends',
+    '$wasmFS$JSMemoryRanges',
+    '_wasmfs_fetch_get_file_url',
+    '_wasmfs_fetch_get_chunk_size',
+  ],
+  _wasmfs_create_fetch_backend_js: async function(backend) {
+    const READ_AHEAD_CHUNKS = 8;     // chunks fetched ahead of a sequential read
+    const STREAMS = 4;               // interleaved sequential readers followed at once (video, audio...)
+    const MAX_CACHED_CHUNKS = 384;   // per file (x chunk size, 1 MB here)
+
+    // Persistent chunk store (absent in some private modes: then memory only).
+    var diskCache = (typeof caches !== 'undefined') ? caches.open('ps2x-disc-v1').catch(() => null) : Promise.resolve(null);
+
+    // fetch() with a deadline and retries: on phones a request can stall for good (a dead
+    // connection after a network change), and with no timeout the game waited on it forever
+    // ("starting the game..." that never ends). A 404 is final; anything else is retried.
+    // The deadline is on progress, not on the whole request: a phone's connection can stall
+    // mid-transfer, and a whole-request deadline (19 s for a 1 MB chunk) let one stalled read
+    // hold the game's music for close to two minutes over its retries.
+    const STALL_MS = 6000;
+    async function fetchRetry(url, init, expectBytes) {
+      for (var attempt = 1; ; attempt++) {
+        var abort = new AbortController();
+        var timer = 0;
+        var stalled = () => { clearTimeout(timer); timer = setTimeout(() => abort.abort(), STALL_MS); };
+        stalled();
+        try {
+          // cache: 'no-store': the chunks are kept in Cache Storage already, and Chrome's HTTP
+          // cache makes requests for one URL queue behind a single writer (up to 20 s each):
+          // on a cold start the disc reads stalled behind each other until they timed out.
+          var response = await fetch(url, Object.assign({cache: 'no-store'}, init, {signal: abort.signal}));
+          if (response.status === 404) throw response;
+          if (!response.ok) throw new Error(`HTTP ${response.status}`);
+          if (init.method === 'HEAD') return response;
+          var bytes;
+          if (response.body && expectBytes) {
+            // Read as it arrives: every piece pushes the stall deadline back
+            bytes = new Uint8Array(expectBytes);
+            var got = 0, reader = response.body.getReader();
+            for (;;) {
+              stalled();
+              var part = await reader.read();
+              if (part.done) break;
+              if (got + part.value.byteLength > expectBytes) throw new Error(`long read`);
+              bytes.set(part.value, got);
+              got += part.value.byteLength;
+            }
+            if (got !== expectBytes) throw new Error(`short read ${got}/${expectBytes}`);
+          } else {
+            bytes = new Uint8Array(await response.arrayBuffer());
+            if (expectBytes && bytes.byteLength !== expectBytes) throw new Error(`short read ${bytes.byteLength}/${expectBytes}`);
+          }
+          return bytes;
+        } catch (e) {
+          if (e && e.status === 404) throw e;
+          if (attempt >= 6) throw {status: 0};
+          err(`[disc] ${url.split('/').pop()}: ${e && e.name === 'AbortError' ? 'stalled' : e}; retrying (${attempt})`);
+          await new Promise((r) => setTimeout(r, 300 * attempt));
+        } finally {
+          clearTimeout(timer);
+        }
+      }
+    }
+
+    function chunkKey(info, i) {
+      return `${info.url}?ps2x-chunk=${i}&size=${info.chunkSize}&v=${encodeURIComponent(info.version)}`;
+    }
+
+    function fileUrl(file) {
+      var name = UTF8ToString(__wasmfs_fetch_get_file_url(file));
+      if (name.indexOf('://') !== -1) return name;
+      try {
+        return new URL(name, self.location.origin).toString();
+      } catch (_e) {
+        throw {status: 404};
+      }
+    }
+
+    // First access: size and range support (HEAD), or the whole file when it is small or the
+    // server can't do ranges.
+    async function openFile(file) {
+      var info = wasmFS$JSMemoryRanges[file];
+      if (info) return info.ready ? info : await info.opening;
+      var url = fileUrl(file);
+      var chunkSize = __wasmfs_fetch_get_chunk_size(file);
+      info = wasmFS$JSMemoryRanges[file] = {url, chunkSize, size: 0, chunks: new Map(), pending: new Map(),
+                                            ready: false, streams: []};
+      info.opening = (async () => {
+        var head = await fetchRetry(url, {method: 'HEAD', headers: {'Range': 'bytes=0-'}});
+        var length = head.ok && head.headers.has('Content-Length') ? parseInt(head.headers.get('Content-Length'), 10) : 0;
+        if (head.ok && head.headers.get('Accept-Ranges') == 'bytes' && length > chunkSize * 2) {
+          info.size = length;
+          info.version = head.headers.get('ETag') || head.headers.get('Last-Modified') || String(length);
+        } else {
+          var data = await fetchRetry(url, {});
+          info.size = data.byteLength;
+          info.chunkSize = Math.max(1, data.byteLength);
+          info.chunks.set(0, data);
+        }
+        info.ready = true;
+        return info;
+      })();
+      try {
+        return await info.opening;
+      } catch (e) {
+        wasmFS$JSMemoryRanges[file] = undefined;
+        throw e;
+      }
+    }
+
+    function chunkCount(info) {
+      return Math.ceil(info.size / info.chunkSize);
+    }
+
+    // Fetches chunks [first, last] that are neither cached nor on their way, as one request.
+    function requestChunks(info, first, last) {
+      last = Math.min(last, chunkCount(info) - 1);
+      while (first <= last && (info.chunks.has(first) || info.pending.has(first))) first++;
+      while (last >= first && (info.chunks.has(last) || info.pending.has(last))) last--;
+      if (first > last) return;
+      // One promise per chunk, settled as soon as that chunk is in: a read never waits for its
+      // neighbours in the same request.
+      var settle = new Map();
+      for (var i = first; i <= last; i++) {
+        let resolve, reject;
+        var promise = new Promise((ok, fail) => { resolve = ok; reject = fail; });
+        promise.catch(() => {});
+        settle.set(i, {resolve, reject});
+        info.pending.set(i, promise);
+      }
+      var arrived = (i, chunk) => {
+        if (!info.chunks.has(i)) info.chunks.set(i, chunk);
+        info.pending.delete(i);
+        settle.get(i).resolve();
+        settle.delete(i);
+      };
+      (async () => {
+        // Chunks already in the browser's store come from there; the rest from the network.
+        var cache = await diskCache;
+        var missing = [];
+        for (var i = first; i <= last; i++) {
+          var hit = cache ? await cache.match(chunkKey(info, i)).catch(() => null) : null;
+          if (hit) arrived(i, new Uint8Array(await hit.arrayBuffer()));
+          else missing.push(i);
+        }
+        while (missing.length) {
+          var a = missing[0], b = a;
+          while (missing.length > b - a + 1 && missing[b - a + 1] === b + 1) b++;
+          missing.splice(0, b - a + 1);
+          var start = a * info.chunkSize;
+          var end = Math.min((b + 1) * info.chunkSize, info.size);
+          var bytes = await fetchRetry(info.url, {headers: {'Range': `bytes=${start}-${end - 1}`}}, end - start);
+          for (var j = a; j <= b; j++) {
+            var chunk = bytes.slice(j * info.chunkSize - start, (j + 1) * info.chunkSize - start);
+            arrived(j, chunk);
+            if (cache) cache.put(chunkKey(info, j), new Response(chunk)).catch(() => {});
+          }
+        }
+      })().catch((error) => {
+        for (var [i, s] of settle) { info.pending.delete(i); s.reject(error); }
+      });
+    }
+
+    function evict(info, keepFrom, keepTo) {
+      // Maps keep insertion order and touch() re-inserts on use: the first ones are the oldest.
+      for (var key of info.chunks.keys()) {
+        if (info.chunks.size <= MAX_CACHED_CHUNKS) break;
+        if (key >= keepFrom && key <= keepTo) continue;
+        info.chunks.delete(key);
+      }
+    }
+
+    function touch(info, i) {
+      var chunk = info.chunks.get(i);
+      info.chunks.delete(i);
+      info.chunks.set(i, chunk);
+      return chunk;
+    }
+
+    async function getFileRange(info, offset, len) {
+      if (info.chunks.size === 1 && info.chunkSize >= info.size) return; // whole file
+      var first = (offset / info.chunkSize) | 0;
+      var last = ((offset + len - 1) / info.chunkSize) | 0;
+      // Sequential reading? The game may interleave several streams (a video, its sound, music):
+      // a read continues one of them when it starts where that one ended (or in the same chunk).
+      var stream = info.streams.find((st) => first === st.chunk || first === st.chunk + 1);
+      if (stream) {
+        info.streams.splice(info.streams.indexOf(stream), 1);
+        // Only moving on to a new chunk counts: many small reads inside one chunk are not a stream
+        if (last > stream.chunk) stream.streak++;
+      } else {
+        stream = {chunk: last, streak: 0};
+        if (info.streams.length >= STREAMS) info.streams.shift();
+      }
+      stream.chunk = last;
+      info.streams.push(stream);
+      requestChunks(info, first, last);
+      // Ahead of the reader, as far as it has proven to go: 1 chunk, then 2, then the full
+      // read-ahead for long streams (videos). The next chunk goes in its own request, first.
+      var ahead = stream.streak >= 4 ? READ_AHEAD_CHUNKS : Math.min(stream.streak, 2);
+      if (ahead >= 1) requestChunks(info, last + 1, last + 1);
+      if (ahead >= 2) requestChunks(info, last + 2, last + ahead);
+      var waitStart = 0;
+      for (var i = first; i <= last; i++) {
+        var hedge = null, failure = null;
+        while (!info.chunks.has(i)) {
+          waitStart ||= performance.now();
+          if (!info.pending.has(i)) requestChunks(info, i, i);
+          // The game is waiting on it: if it is slow (often inside a read-ahead request of
+          // several chunks, or on a connection that stalled), ask for this chunk alone as well,
+          // and take whichever answer comes first.
+          await Promise.race([info.pending.get(i).catch((e) => { failure = e; }), hedge || new Promise(() => {}),
+                              new Promise((r) => setTimeout(r, 1500))]);
+          if (failure && failure.status === 404) throw failure;
+          if (!info.chunks.has(i) && !hedge && performance.now() - waitStart >= 1500) {
+            let index = i;
+            var start = index * info.chunkSize, end = Math.min(start + info.chunkSize, info.size);
+            hedge = fetchRetry(info.url, {headers: {'Range': `bytes=${start}-${end - 1}`}}, end - start)
+              .then((chunk) => { if (!info.chunks.has(index)) info.chunks.set(index, chunk); })
+              .catch(() => {});
+          }
+        }
+      }
+      if (waitStart) {
+        // The game had to wait for the network: count it (and show long waits with ?debug)
+        var waited = performance.now() - waitStart;
+        info.waits = (info.waits || 0) + 1;
+        info.waitedMs = (info.waitedMs || 0) + waited;
+        if (waited > 20) err(`[disc] waited ${waited.toFixed(0)} ms for chunk ${first}-${last} (stream streak ${stream.streak}, ${info.waits} waits, ${info.waitedMs.toFixed(0)} ms total)`);
+      }
+      evict(info, first, last + READ_AHEAD_CHUNKS);
+    }
+
+    wasmFS$backends[backend] = {
+      allocFile: async (file) => { /* nop */ },
+      freeFile: async (file) => {
+        wasmFS$JSMemoryRanges[file] = undefined;
+      },
+      write: async (file, buffer, length, offset) => {
+        console.error('fetch backend: files are read-only');
+      },
+      read: async (file, buffer, length, offset) => {
+        if (offset < 0 || length <= 0) return 0;
+        var info;
+        try {
+          info = await openFile(file);
+          length = Math.min(length, info.size - offset);
+          if (length <= 0) return 0;
+          await getFileRange(info, offset, length);
+        } catch (failedResponse) {
+          return failedResponse.status === 404 ? -{{{ cDefs.ENOENT }}} : -{{{ cDefs.EBADF }}};
+        }
+        var chunkSize = info.chunkSize;
+        var first = (offset / chunkSize) | 0;
+        var last = ((offset + length - 1) / chunkSize) | 0;
+        for (var i = first; i <= last; i++) {
+          var chunk = touch(info, i);
+          var chunkStart = i * chunkSize;
+          var start = Math.max(chunkStart, offset);
+          var end = Math.min(chunkStart + chunkSize, offset + length);
+          HEAPU8.set(chunk.subarray(start - chunkStart, end - chunkStart), buffer + (start - offset));
+        }
+        return length;
+      },
+      getSize: async (file) => {
+        try {
+          return (await openFile(file)).size;
+        } catch (failedResponse) {
+          return 0;
+        }
+      },
+    };
+  },
+});
