+		std::printf("[webgs] 2s: vif %llu (vu %.0f ms, %llu slices) vifreg %llu xfer %llu vsync %llu regs %llu fifo %llu gs %.0f ms, ring pending %lld KB, vu running %d\n",
+		            (unsigned long long)h.nVif, h.vuMs, (unsigned long long)h.vuSlices, (unsigned long long)h.nVifReg,
+		            (unsigned long long)h.nXfer, (unsigned long long)h.nVsync, (unsigned long long)h.nRegs,
+		            (unsigned long long)h.nFifo, h.gsMs, (long long)(Available(h) / 1024), h.vpu1->IsVuRunning() ? 1 : 0);
+		std::printf("[webgs] 2s: worker waited %.0f ms at vblanks, %.0f ms for data\n", h.vblankWaitMs, h.idleMs);
+		h.vblankWaitMs = h.idleMs = 0.0;
+		h.nVif = h.nVifReg = h.nXfer = h.nVsync = h.nRegs = h.nFifo = h.vuSlices = 0;
+		h.vuMs = h.gsMs = 0.0;
+		h.debugStart = now;
+	}
