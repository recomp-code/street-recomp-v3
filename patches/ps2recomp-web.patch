+			return;
+		uint64_t pmode = 0, dispfb1 = 0, display1 = 0;
+		std::memcpy(&pmode, h.privRegs.data() + 0x00, 8);
+		std::memcpy(&dispfb1, h.privRegs.data() + 0x70, 8);
+		std::memcpy(&display1, h.privRegs.data() + 0x80, 8);
