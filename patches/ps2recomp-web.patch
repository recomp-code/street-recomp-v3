diff --git a/ps2xIOP/src/emulator/spu2/SPU2/spu2_glue.cpp b/ps2xIOP/src/emulator/spu2/SPU2/spu2_glue.cpp
new file mode 100644
index 0000000..7c11cc7
--- /dev/null
+++ b/ps2xIOP/src/emulator/spu2/SPU2/spu2_glue.cpp
@@ -0,0 +1,390 @@
+// SPDX-FileCopyrightText: 2002-2026 PCSX2 Dev Team
+// SPDX-License-Identifier: GPL-3.0+
+
+// ps2recomp: stands in for PCSX2's SPU2/spu2.cpp: register and DMA entry points, reset, and the
+// output stage (DC filter), feeding ps2x::spu2::output() instead of a host audio stream. The IOP side
+// (interrupt lines, DMA registers, IOP memory) is reached through spu2_bridge.h.
+
+#include "SPU2/spu2.h"
+#include "SPU2/defs.h"
+#include "SPU2/Debug.h"
+#include "SPU2/Dma.h"
+#include "R3000A.h"
+#include "IopHw.h"
+#include "IopDma.h"
+#include "IopCounters.h"
+
+#include "spu2_bridge.h"
+
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+#else
+#define EMSCRIPTEN_KEEPALIVE
+#endif
+
+#include <cmath>
+#include <cstdio>
+#include <string>
+
+const StereoOut32 StereoOut32::Empty(0, 0);
+
+u64 lClocks = 0;
+psxRegisters psxRegs{};
+psxCounter psxCounters[8]{};
+s32 psxNextDeltaCounter = 0;
+u32 psxNextStartCounter = 0;
+
+u32 g_spu2StaleHalves = 0; // ReadInput.cpp
+u32 g_spu2RepeatedHalves = 0; // ReadInput.cpp
+u32 HW_DMA4_MADR = 0;
+u32 HW_DMA4_TADR = 0;
+u32 HW_DMA7_MADR = 0;
+u32 HW_DMA7_TADR = 0;
+
+namespace
+{
+	u8* s_iopRam = nullptr;
+	// AutoDMA timing (core 0): IRQ -> next transfer start, in samples; halves replayed because no data had come
+	u32 s_admaIrqCycles[2] = {0, 0};
+	bool s_admaIrqPending[2] = {false, false};
+	u32 s_admaLatencyHist[8] = {};
+	u32 s_admaLatencyMax = 0;
+	bool s_irq = false;
+	bool s_dmaDone[2] = {false, false};
+	std::vector<int16_t> s_output;
+	float s_dcIn[2] = {0.0f, 0.0f};
+	float s_dcOut[2] = {0.0f, 0.0f};
+	float s_limiterGain = 1.0f;
+} // namespace
+
+u8* iopPhysMem(u32 addr)
+{
+	return s_iopRam + (addr & 0x1FFFFF);
+}
+
+bool SPU2::IsRunningPSXMode()
+{
+	return false;
+}
+
+u32 SPU2::GetConsoleSampleRate()
+{
+	return SAMPLE_RATE;
+}
+
+// IOP interrupt line 9.
+void spu2Irq()
+{
+	s_irq = true;
+}
+
+// PCSX2's IopDma.cpp: the SPU2 finished the transfer of core 0 / core 1.
+void spu2DMA4Irq()
+{
+	SPU2interruptDMA4();
+	s_dmaDone[0] = true;
+	s_admaIrqCycles[0] = psxRegs.cycle;
+	s_admaIrqPending[0] = Cores[0].AutoDMACtrl & 1;
+}
+
+void spu2DMA7Irq()
+{
+	SPU2interruptDMA7();
+	s_dmaDone[1] = true;
+}
+
+void SPU2readDMA4Mem(u16* pMem, u32 size) // size in 16-bit units
+{
+	TimeUpdate(psxRegs.cycle);
+	Cores[0].DoDMAread(pMem, size);
+}
+
+void SPU2writeDMA4Mem(u16* pMem, u32 size)
+{
+	TimeUpdate(psxRegs.cycle);
+	Cores[0].DoDMAwrite(pMem, size);
+}
+
+void SPU2interruptDMA4()
+{
+	if (Cores[0].DmaMode)
+		Cores[0].Regs.STATX |= 0x80;
+	Cores[0].Regs.STATX &= ~0x400;
+	Cores[0].TSA = Cores[0].ActiveTSA;
+}
+
+void SPU2interruptDMA7()
+{
+	if (Cores[1].DmaMode)
+		Cores[1].Regs.STATX |= 0x80;
+	Cores[1].Regs.STATX &= ~0x400;
+	Cores[1].TSA = Cores[1].ActiveTSA;
+}
+
+void SPU2readDMA7Mem(u16* pMem, u32 size)
+{
+	TimeUpdate(psxRegs.cycle);
+	Cores[1].DoDMAread(pMem, size);
+}
+
+void SPU2writeDMA7Mem(u16* pMem, u32 size)
+{
+	TimeUpdate(psxRegs.cycle);
+	Cores[1].DoDMAwrite(pMem, size);
+}
+
+void SPU2async()
+{
+	TimeUpdate(psxRegs.cycle);
+}
+
+u16 SPU2read(u32 rmem)
+{
+	u16 ret = 0xDEAD;
+	u32 core = 0;
+	const u32 mem = rmem & 0xFFFF;
+	u32 omem = mem;
+
+	if (mem & 0x400)
+	{
+		omem ^= 0x400;
+		core = 1;
+	}
+
+	if (omem == 0x1f9001AC)
+	{
+		Cores[core].ActiveTSA = Cores[core].TSA;
+		for (int i = 0; i < 2; i++)
+		{
+			if (Cores[i].IRQEnable && (Cores[i].IRQA == Cores[core].ActiveTSA))
+			{
+				SetIrqCall(i);
+			}
+		}
+		ret = Cores[core].DmaRead();
+	}
+	else
+	{
+		TimeUpdate(psxRegs.cycle);
+
+		if (rmem >> 16 == 0x1f80)
+			ret = Cores[0].ReadRegPS1(rmem);
+		else if (mem >= 0x800)
+			ret = spu2Ru16(mem);
+		else
+			ret = *(regtable[(mem >> 1)]);
+	}
+
+	return ret;
+}
+
+void SPU2write(u32 rmem, u16 value)
+{
+	// Reverb/effects are sensitive to precise update timings: catch up to the IOP first.
+	TimeUpdate(psxRegs.cycle);
+
+	if (rmem >> 16 == 0x1f80)
+		Cores[0].WriteRegPS1(rmem, value);
+	else
+		SPU2_FastWrite(rmem, value);
+}
+
+// Debug capture of the last 8 s: per sample core 0 input, core 1 input and the final output (L, R each),
+// plus per-sample core 0 AutoDMA state; Module._ps2xSpu2Dump() returns them oldest first.
+namespace
+{
+	constexpr u32 kDumpFrames = 48000 * 8;
+	constexpr u32 kDumpWords = 8;
+	s16 s_dump[kDumpFrames * kDumpWords];
+	s16 s_dumpOut[kDumpFrames * kDumpWords];
+	u32 s_dumpPos = 0;
+} // namespace
+
+void ps2xSpu2DebugInput(const StereoOut32& core0, const StereoOut32& core1)
+{
+	s16* d = &s_dump[(s_dumpPos % kDumpFrames) * kDumpWords];
+	d[0] = static_cast<s16>(clamp_mix(core0.Left));
+	d[1] = static_cast<s16>(clamp_mix(core0.Right));
+	d[2] = static_cast<s16>(clamp_mix(core1.Left));
+	d[3] = static_cast<s16>(clamp_mix(core1.Right));
+	d[6] = static_cast<s16>(OutPos);
+	d[7] = static_cast<s16>((Cores[0].InputDataLeft & 0x7FFF) | (Cores[0].AdmaInProgress ? 0x8000 : 0));
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE s16* ps2xSpu2Dump()
+{
+	for (u32 i = 0; i < kDumpFrames; i++)
+		std::memcpy(&s_dumpOut[i * kDumpWords], &s_dump[((s_dumpPos + i) % kDumpFrames) * kDumpWords], kDumpWords * sizeof(s16));
+	return s_dumpOut;
+}
+
+// A simple DC blocking high-pass filter (some games leave paused voices with their volume up).
+// From http://peabody.sapp.org/class/dmp2/lab/dcblock/, as in PCSX2.
+__forceinline void spu2Output(StereoOut32 out)
+{
+	float in[2] = {
+		static_cast<float>(clamp_mix(out.Left)) / INT16_MAX,
+		static_cast<float>(clamp_mix(out.Right)) / INT16_MAX,
+	};
+	float filtered[2];
+	for (int c = 0; c < 2; c++)
+	{
+		filtered[c] = in[c] - s_dcIn[c] + 0.995f * s_dcOut[c];
+		s_dcIn[c] = in[c];
+		s_dcOut[c] = filtered[c];
+	}
+	// ps2recomp: peak limiter instead of hard clipping (loud crowd + music mixes reach full scale and
+	// clipped samples sound like clicks): instant attack, ~0.5 s release, transparent below -0.5 dBFS.
+	constexpr float kCeiling = 0.95f;
+	const float peak = std::max(std::fabs(filtered[0]), std::fabs(filtered[1]));
+	if (peak * s_limiterGain > kCeiling)
+		s_limiterGain = kCeiling / peak;
+	else if (s_limiterGain < 1.0f)
+		s_limiterGain = std::min(1.0f, s_limiterGain + (1.0f - s_limiterGain) * 0.0001f + 0.000001f);
+	s16* d = &s_dump[(s_dumpPos % kDumpFrames) * kDumpWords];
+	for (int c = 0; c < 2; c++)
+	{
+		const float scaled = filtered[c] * s_limiterGain * INT16_MAX;
+		s_output.push_back(static_cast<int16_t>(std::clamp(scaled, -32768.0f, 32767.0f)));
+		d[4 + c] = s_output.back();
+	}
+	s_dumpPos++;
+}
+
+namespace ps2x::spu2
+{
+	void reset(uint8_t* iopRam)
+	{
+		s_iopRam = iopRam;
+		s_irq = false;
+		s_dmaDone[0] = s_dmaDone[1] = false;
+		s_output.clear();
+		s_dcIn[0] = s_dcIn[1] = s_dcOut[0] = s_dcOut[1] = 0.0f;
+		s_limiterGain = 1.0f;
+
+		spu2Mix = MULTI_ISA_SELECT(spu2Mix);
+		ReverbDownsample = MULTI_ISA_SELECT(ReverbDownsample);
+		ReverbUpsample = MULTI_ISA_SELECT(ReverbUpsample);
+
+		memset(spu2regs, 0, 0x010000);
+		memset(_spu2mem, 0, 0x200000);
+		memset(_spu2mem + 0x2800, 7, 0x10); // from BIOS reversal. Locks the voices so they don't run free.
+		memset(_spu2mem + 0xe870, 7, 0x10); // Loop which gets left over by the BIOS, Megaman X7 relies on it being there.
+		for (PcmCacheEntry& entry : pcm_cache_data)
+			entry.Validated = false;
+
+		Spdif.Info = 0;
+		Cores[0].Init(0);
+		Cores[1].Init(1);
+
+		HW_DMA4_MADR = HW_DMA4_TADR = HW_DMA7_MADR = HW_DMA7_TADR = 0;
+		psxRegs.cycle = 0;
+		lClocks = 0;
+	}
+
+	uint16_t read(uint32_t cycle, uint32_t address)
+	{
+		psxRegs.cycle = cycle;
+		return SPU2read(address);
+	}
+
+	void write(uint32_t cycle, uint32_t address, uint16_t value)
+	{
+		psxRegs.cycle = cycle;
+		SPU2write(address, value);
+	}
+
+	void dmaWrite(uint32_t cycle, int core, uint32_t madr, uint32_t halfwords)
+	{
+		psxRegs.cycle = cycle;
+		if (core == 0 && s_admaIrqPending[0])
+		{
+			s_admaIrqPending[0] = false;
+			const u32 samples = (cycle - s_admaIrqCycles[0]) / 768;
+			s_admaLatencyMax = std::max(s_admaLatencyMax, samples);
+			s_admaLatencyHist[std::min<u32>(7, samples / 32)]++;
+		}
+		setDmaMadr(core, madr);
+		u16* data = reinterpret_cast<u16*>(iopPhysMem(madr));
+		if (core == 0)
+			SPU2writeDMA4Mem(data, halfwords);
+		else
+			SPU2writeDMA7Mem(data, halfwords);
+	}
+
+	void dmaRead(uint32_t cycle, int core, uint32_t madr, uint32_t halfwords)
+	{
+		psxRegs.cycle = cycle;
+		setDmaMadr(core, madr);
+		u16* data = reinterpret_cast<u16*>(iopPhysMem(madr));
+		if (core == 0)
+			SPU2readDMA4Mem(data, halfwords);
+		else
+			SPU2readDMA7Mem(data, halfwords);
+	}
+
+	uint32_t dmaMadr(int core)
+	{
+		return core == 0 ? HW_DMA4_MADR : HW_DMA7_MADR;
+	}
+
+	void setDmaMadr(int core, uint32_t madr)
+	{
+		(core == 0 ? HW_DMA4_MADR : HW_DMA7_MADR) = madr;
+	}
+
+	void advance(uint32_t cycle)
+	{
+		psxRegs.cycle = cycle;
+		TimeUpdate(cycle);
+	}
+
+	std::vector<int16_t>& output()
+	{
+		return s_output;
+	}
+
+	bool takeIrq()
+	{
+		const bool irq = s_irq;
+		s_irq = false;
+		return irq;
+	}
+
+	std::string describe()
+	{
+		std::string text;
+		char line[256];
+		for (int c = 0; c < 2; c++)
+		{
+			const V_Core& core = Cores[c];
+			int active = 0;
+			for (const V_Voice& voice : core.Voices)
+				active += voice.ADSR.Phase != V_ADSR::PHASE_STOPPED ? 1 : 0;
+			std::snprintf(line, sizeof(line),
+				" c%d[attr=%04x adma=%x left=%x xfer=%x posw=%x inprog=%d dmac=%d rsz=%x mvol=%d/%d inp=%d voices=%d irqe=%d irqa=%x tsa=%x statx=%x]",
+				c, core.Regs.ATTR, core.AutoDMACtrl, core.InputDataLeft, core.InputDataTransferred, core.InputPosWrite,
+				core.AdmaInProgress ? 1 : 0, core.DMAICounter, core.ReadSize, core.MasterVol.Left.Value, core.MasterVol.Right.Value,
+				core.InpVol.Left, active, core.IRQEnable ? 1 : 0, core.IRQA, core.TSA, core.Regs.STATX);
+			text += line;
+		}
+		std::snprintf(line, sizeof(line), " playmode=%x outpos=%x madr=%x/%x", PlayMode, OutPos, HW_DMA4_MADR, HW_DMA7_MADR);
+		text += line;
+		std::snprintf(line, sizeof(line), " adma irq->next start (samples, /32): %u %u %u %u %u %u %u %u max %u stale halves %u repeated halves %u",
+			s_admaLatencyHist[0], s_admaLatencyHist[1], s_admaLatencyHist[2], s_admaLatencyHist[3], s_admaLatencyHist[4],
+			s_admaLatencyHist[5], s_admaLatencyHist[6], s_admaLatencyHist[7], s_admaLatencyMax, g_spu2StaleHalves, g_spu2RepeatedHalves);
+		text += line;
+		std::fill(std::begin(s_admaLatencyHist), std::end(s_admaLatencyHist), 0u);
+		s_admaLatencyMax = 0;
+		g_spu2StaleHalves = 0;
+		g_spu2RepeatedHalves = 0;
+		return text;
+	}
+
+	bool takeDmaDone(int core)
+	{
+		const bool done = s_dmaDone[core];
+		s_dmaDone[core] = false;
+		return done;
+	}
+} // namespace ps2x::spu2
diff --git a/ps2xIOP/src/emulator/spu2/SPU2/spu2sys.cpp b/ps2xIOP/src/emulator/spu2/SPU2/spu2sys.cpp
