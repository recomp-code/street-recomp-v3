diff --git a/ps2xIOP/include/ps2x/host_intrin.h b/ps2xIOP/include/ps2x/host_intrin.h
index 43bc85f..ea93884 100644
--- a/ps2xIOP/include/ps2x/host_intrin.h
+++ b/ps2xIOP/include/ps2x/host_intrin.h
@@ -9,6 +9,21 @@
 // sse2neon spells the cycle counter _rdtsc (CNTVCT_EL0); callers use the MSVC/GCC name. The rate
 // differs from an x86 TSC, but every user either calibrates it or only compares ticks.
 static inline uint64_t __rdtsc() { return _rdtsc(); }
+#elif defined(__EMSCRIPTEN__)
+// WebAssembly: Emscripten maps the SSE intrinsics onto wasm SIMD; there is no cycle counter, so
+// __rdtsc counts nanoseconds of the monotonic clock (every user calibrates it or subtracts).
+#include <immintrin.h>
+#include <emscripten.h>
+static inline uint64_t __rdtsc() { return static_cast<uint64_t>(emscripten_get_now() * 1000000.0); }
 #else
 #include <x86intrin.h>
 #endif
+
+// Ticks for the frame-budget statistics only. Free where the CPU has a cycle counter; in the
+// browser every clock read is a call into JavaScript (thousands per frame on the game thread),
+// so the statistics stay at zero there.
+#if defined(__EMSCRIPTEN__)
+static inline uint64_t ps2xStatTicks() { return 0; }
+#else
+static inline uint64_t ps2xStatTicks() { return __rdtsc(); }
+#endif
