@@ -0,0 +1,55 @@
+// Browser build: the sockets DEV9's network sessions use (TCP, UDP, name lookups), carried over a
+// single WebSocket to the relay on the page's server (/net), which makes the real connections.
+// They behave like non-blocking BSD sockets with no network round trip per call: received data
+// waits in local queues, so recv/select/ioctl(FIONREAD) answer at once and send/connect only
+// queue a message.
+//
+// DEV9 sources include this after their system headers; the macros send their socket calls
+// here. web_sockets.cpp defines PS2X_WEB_SOCKETS_IMPL to see the real names.
+#pragma once
+#if defined(__EMSCRIPTEN__)
+
+#include <netdb.h>
+#include <sys/select.h>
+#include <sys/socket.h>
+#include <sys/types.h>
+
+int ps2x_ws_socket(int domain, int type, int protocol);
+int ps2x_ws_close(int fd);
+int ps2x_ws_bind(int fd, const struct sockaddr* address, socklen_t length);
+int ps2x_ws_connect(int fd, const struct sockaddr* address, socklen_t length);
+ssize_t ps2x_ws_send(int fd, const void* data, size_t length, int flags);
+ssize_t ps2x_ws_recv(int fd, void* data, size_t length, int flags);
+ssize_t ps2x_ws_sendto(int fd, const void* data, size_t length, int flags, const struct sockaddr* address, socklen_t addressLength);
+ssize_t ps2x_ws_recvfrom(int fd, void* data, size_t length, int flags, struct sockaddr* address, socklen_t* addressLength);
+int ps2x_ws_select(int count, fd_set* read, fd_set* write, fd_set* except, struct timeval* timeout);
+int ps2x_ws_ioctl(int fd, int request, ...);
+int ps2x_ws_fcntl(int fd, int command, ...);
+int ps2x_ws_setsockopt(int fd, int level, int option, const void* value, socklen_t length);
+int ps2x_ws_getsockopt(int fd, int level, int option, void* value, socklen_t* length);
+int ps2x_ws_getsockname(int fd, struct sockaddr* address, socklen_t* length);
+int ps2x_ws_shutdown(int fd, int how);
+int ps2x_ws_getaddrinfo(const char* node, const char* service, const struct addrinfo* hints, struct addrinfo** result);
+void ps2x_ws_freeaddrinfo(struct addrinfo* info);
+
+#if !defined(PS2X_WEB_SOCKETS_IMPL)
+#define socket ps2x_ws_socket
+#define close ps2x_ws_close
+#define bind ps2x_ws_bind
+#define connect ps2x_ws_connect
+#define send ps2x_ws_send
+#define recv ps2x_ws_recv
+#define sendto ps2x_ws_sendto
+#define recvfrom ps2x_ws_recvfrom
+#define select ps2x_ws_select
+#define ioctl ps2x_ws_ioctl
+#define fcntl ps2x_ws_fcntl
+#define setsockopt ps2x_ws_setsockopt
+#define getsockopt ps2x_ws_getsockopt
+#define getsockname ps2x_ws_getsockname
+#define shutdown ps2x_ws_shutdown
+#define getaddrinfo ps2x_ws_getaddrinfo
+#define freeaddrinfo ps2x_ws_freeaddrinfo
+#endif
+
+#endif
