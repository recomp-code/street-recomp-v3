+            r[7] = c.lo;
+            r[2] = r[2] + r[7] + r[4];
+            bus.io16(r[2], static_cast<uint16_t>(r[5]), base + 22u);
+            return 23u;
+        case LibsdRoutine::GetParam:
+            r[5] = a0 & 1u;
+            stride(r[5]);
+            r[2] = (a0 >> 6) & 0x3FCu;
+            r[4] = (a0 & 0x3Eu) << 3;
+            r[1] = high + r[2];
+            r[2] = bus.lw(table + r[2]);
+            r[6] = c.lo;
