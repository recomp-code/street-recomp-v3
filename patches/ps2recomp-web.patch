+                    const double k = 0.5 + n;
+                    const double s = std::sin(pi * k * 2.048 / 1024.0);
+                    const double t = (std::cos(pi * k * 2.000 / 1023.0) - 1.0) * 0.50;
+                    const double u = (std::cos(pi * k * 4.000 / 1023.0) - 1.0) * 0.08;
