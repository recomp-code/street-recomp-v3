+        // Volume sweep (VOLL/VOLR bit 15): the volume moves one step at a time, linearly or
+        // exponentially, up or down (bits 14/13), at the rate in bits 0-6, like an envelope.
+        void sweepVolume(uint16_t reg, int32_t &value, uint32_t &counter)
+        {
+            if ((reg & 0x8000u) == 0u)
+                return;
+            const int step = reg & 3;
+            const int shift = (reg >> 2) & 0x1F;
+            const bool negative = (reg & 0x1000u) != 0u;
+            const bool decrease = (reg & 0x2000u) != 0u;
+            const bool exponential = (reg & 0x4000u) != 0u;
