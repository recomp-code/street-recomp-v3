+++ b/ps2xIOP/src/emulator/dev9/web_sockets.cpp
@@ -0,0 +1,681 @@
+// Browser sockets for DEV9 over one WebSocket (see web_sockets.h). Messages, little endian:
+//   page -> relay   1 TCP_OPEN id ip4 port16 | 2 TCP_SEND id data | 3 CLOSE id | 4 UDP_OPEN id
+//                   5 UDP_SEND id ip4 port16 data | 6 RESOLVE id name | 7 SHUTDOWN id
+//   relay -> page   10 CONNECTED id ok8 | 11 DATA id data | 12 CLOSED id
+//                   13 UDP_DATA id ip4 port16 data | 14 RESOLVED id ok8 ip4
+// ip4 is in network order (as in sin_addr), the rest little endian.
+#if defined(__EMSCRIPTEN__)
+#define PS2X_WEB_SOCKETS_IMPL
+#include "web_sockets.h"
+
+#include <emscripten.h>
+#include <emscripten/threading.h>
+
+#include <arpa/inet.h>
+#include <netinet/in.h>
+#include <sys/ioctl.h>
+
+#include <algorithm>
+#include <cerrno>
+#include <chrono>
+#include <condition_variable>
+#include <cstdarg>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <fcntl.h>
+#include <map>
+#include <mutex>
+#include <pthread.h>
+#include <unistd.h>
+#include <vector>
+
+namespace
+{
+	// Our descriptors sit below FD_SETSIZE (select) and above the few real files the runtime opens.
+	constexpr int kFirstFd = 600;
+	constexpr int kLastFd = 1000;
+
+	enum class Kind
+	{
+		Tcp,
+		Udp,
+	};
+	enum class TcpState
+	{
+		Idle,
+		Connecting,
+		Connected,
+		Failed,
+	};
+
+	struct Datagram
+	{
+		uint32_t ip;   // network order
+		uint16_t port; // host order
+		std::vector<uint8_t> data;
+	};
+
+	struct Sock
+	{
+		Kind kind = Kind::Tcp;
+		bool nonblock = false;
+		TcpState state = TcpState::Idle;
+		std::deque<uint8_t> stream;
+		std::deque<Datagram> datagrams;
+		bool peerClosed = false;
+		bool udpOpened = false;
+		uint16_t localPort = 0;
+		int error = 0;
+		uint32_t defaultIp = 0;
+		uint16_t defaultPort = 0;
+	};
+
+	struct Resolution
+	{
+		bool done = false;
+		bool ok = false;
+		uint32_t ip = 0;
+	};
+
+	std::mutex g_mutex;
+	std::condition_variable g_cv;
+	std::map<int, Sock> g_sockets;
+	std::map<uint32_t, Resolution> g_resolutions;
+	std::deque<std::vector<uint8_t>> g_outgoing;
+	uint32_t g_nextResolution = 1;
+	uint16_t g_nextPort = 40000;
+	std::vector<uint8_t> g_inbox; // the message the net thread is handing over
+	std::once_flag g_threadOnce;
+
+	void put8(std::vector<uint8_t>& out, uint8_t value) { out.push_back(value); }
+	void put16(std::vector<uint8_t>& out, uint16_t value)
+	{
+		out.push_back(static_cast<uint8_t>(value));
+		out.push_back(static_cast<uint8_t>(value >> 8));
+	}
+	void put32(std::vector<uint8_t>& out, uint32_t value)
+	{
+		for (int i = 0; i < 4; i++)
+			out.push_back(static_cast<uint8_t>(value >> (8 * i)));
+	}
+	void putIp(std::vector<uint8_t>& out, uint32_t ip)
+	{
+		const uint8_t* bytes = reinterpret_cast<const uint8_t*>(&ip);
+		out.insert(out.end(), bytes, bytes + 4);
+	}
+	uint16_t get16(const uint8_t* p) { return static_cast<uint16_t>(p[0] | (p[1] << 8)); }
+	uint32_t get32(const uint8_t* p) { return p[0] | (p[1] << 8) | (p[2] << 16) | (static_cast<uint32_t>(p[3]) << 24); }
+	uint32_t getIp(const uint8_t* p)
+	{
+		uint32_t ip;
+		std::memcpy(&ip, p, 4);
+		return ip;
+	}
+
+	std::vector<uint8_t> message(uint8_t type, uint32_t id)
+	{
+		std::vector<uint8_t> out;
+		put8(out, type);
+		put32(out, id);
+		return out;
+	}
+
+	void* netThread(void*)
+	{
+		// The WebSocket lives in this worker; its events need the worker's event loop, so the
+		// thread hands back to it. Outgoing messages are picked up every 2 ms.
+		EM_ASM({
+			const url = (self.location.protocol === 'https:' ? 'wss:' : 'ws:') + '//' + self.location.host + '/net';
+			function open() {
+				const ws = new WebSocket(url);
+				ws.binaryType = 'arraybuffer';
+				ws.onopen = () => { self.ps2xNet = ws; _ps2x_ws_link(1); };
+				ws.onmessage = (event) => {
+					const data = new Uint8Array(event.data);
+					const ptr = _ps2x_ws_inbox(data.length);
+					new Uint8Array(wasmMemory.buffer).set(data, ptr);
+					_ps2x_ws_receive(data.length);
+				};
+				ws.onclose = () => {
+					if (self.ps2xNet === ws) self.ps2xNet = null;
+					_ps2x_ws_link(0);
+					setTimeout(open, 2000);
+				};
+			}
+			open();
+			setInterval(() => { if (self.ps2xNet && self.ps2xNet.readyState === 1) _ps2x_ws_pump(); }, 2);
+		});
+		emscripten_exit_with_live_runtime();
+		return nullptr;
+	}
+
+	void startNetThread()
+	{
+		std::call_once(g_threadOnce, [] {
+			pthread_t thread;
+			pthread_create(&thread, nullptr, &netThread, nullptr);
+			pthread_detach(thread);
+		});
+	}
+
+	Sock* find(int fd)
+	{
+		auto it = g_sockets.find(fd);
+		return it == g_sockets.end() ? nullptr : &it->second;
+	}
+
+	bool readable(const Sock& s)
+	{
+		if (s.kind == Kind::Udp)
+			return !s.datagrams.empty();
+		return !s.stream.empty() || s.peerClosed || s.state == TcpState::Failed;
+	}
+	bool writable(const Sock& s) { return s.kind == Kind::Udp || s.state == TcpState::Connected; }
+	bool failed(const Sock& s) { return s.kind == Kind::Tcp && s.state == TcpState::Failed; }
+
+	template <typename Pred>
+	bool waitFor(std::unique_lock<std::mutex>& lock, Pred pred, int timeoutMs)
+	{
+		if (timeoutMs < 0)
+		{
+			g_cv.wait(lock, pred);
+			return true;
+		}
+		return g_cv.wait_for(lock, std::chrono::milliseconds(timeoutMs), pred);
+	}
+} // namespace
+
+extern "C" {
+EMSCRIPTEN_KEEPALIVE uint8_t* ps2x_ws_inbox(int length)
+{
+	g_inbox.resize(static_cast<size_t>(length));
+	return g_inbox.data();
+}
+
+EMSCRIPTEN_KEEPALIVE void ps2x_ws_link(int up)
+{
+	if (up)
+		return;
+	// Relay connection lost: every TCP connection is gone with it.
+	std::lock_guard lock(g_mutex);
+	for (auto& [fd, s] : g_sockets)
+	{
+		if (s.kind != Kind::Tcp)
+			continue;
+		if (s.state == TcpState::Connecting)
+		{
+			s.state = TcpState::Failed;
+			s.error = ECONNREFUSED;
+		}
+		else if (s.state == TcpState::Connected)
+			s.peerClosed = true;
+	}
+	g_cv.notify_all();
+}
+
+EMSCRIPTEN_KEEPALIVE void ps2x_ws_receive(int length)
+{
+	const uint8_t* p = g_inbox.data();
+	if (length < 5)
+		return;
+	const uint8_t type = p[0];
+	const uint32_t id = get32(p + 1);
+	std::lock_guard lock(g_mutex);
+	Sock* s = find(static_cast<int>(id));
+	switch (type)
+	{
+		case 10: // CONNECTED
+			if (s && length >= 6)
+			{
+				s->state = p[5] ? TcpState::Connected : TcpState::Failed;
+				s->error = p[5] ? 0 : ECONNREFUSED;
+			}
+			break;
+		case 11: // DATA
+			if (s)
+				s->stream.insert(s->stream.end(), p + 5, p + length);
+			break;
+		case 12: // CLOSED
+			if (s)
+			{
+				if (s->state == TcpState::Connecting)
+				{
+					s->state = TcpState::Failed;
+					s->error = ECONNREFUSED;
+				}
+				s->peerClosed = true;
+			}
+			break;
+		case 13: // UDP_DATA
+			if (s && length >= 11 && s->datagrams.size() < 512)
+				s->datagrams.push_back(Datagram{getIp(p + 5), get16(p + 9), std::vector<uint8_t>(p + 11, p + length)});
+			break;
+		case 14: // RESOLVED
+			if (length >= 10)
+			{
+				auto it = g_resolutions.find(id);
+				if (it != g_resolutions.end())
+				{
+					it->second.done = true;
+					it->second.ok = p[5] != 0;
+					it->second.ip = getIp(p + 6);
+				}
+			}
+			break;
+	}
+	g_cv.notify_all();
+}
+
+EMSCRIPTEN_KEEPALIVE void ps2x_ws_pump()
+{
+	std::deque<std::vector<uint8_t>> outgoing;
+	{
+		std::lock_guard lock(g_mutex);
+		outgoing.swap(g_outgoing);
+	}
+	for (const auto& m : outgoing)
+	{
+		EM_ASM({ self.ps2xNet.send(new Uint8Array(wasmMemory.buffer).slice($0, $0 + $1)); }, m.data(), m.size());
+	}
+}
+}
+
+int ps2x_ws_socket(int domain, int type, int)
+{
+	const int base = type & ~(SOCK_NONBLOCK | SOCK_CLOEXEC);
+	if (domain != AF_INET || (base != SOCK_STREAM && base != SOCK_DGRAM))
+	{
+		errno = base == SOCK_RAW ? EACCES : EAFNOSUPPORT; // no ICMP in a browser
+		return -1;
+	}
+	startNetThread();
+	std::lock_guard lock(g_mutex);
+	for (int fd = kFirstFd; fd < kLastFd; fd++)
+	{
+		if (g_sockets.count(fd))
+			continue;
+		Sock& s = g_sockets[fd];
+		s.kind = base == SOCK_STREAM ? Kind::Tcp : Kind::Udp;
+		s.nonblock = (type & SOCK_NONBLOCK) != 0;
+		return fd;
+	}
+	errno = EMFILE;
+	return -1;
+}
+
+int ps2x_ws_close(int fd)
+{
+	{
+		std::lock_guard lock(g_mutex);
+		if (Sock* s = find(fd))
+		{
+			if ((s->kind == Kind::Tcp && s->state != TcpState::Idle) || (s->kind == Kind::Udp && s->udpOpened))
+				g_outgoing.push_back(message(3, static_cast<uint32_t>(fd)));
+			g_sockets.erase(fd);
+			return 0;
+		}
+	}
+	return ::close(fd);
+}
+
+int ps2x_ws_bind(int fd, const sockaddr* address, socklen_t)
+{
+	std::lock_guard lock(g_mutex);
+	Sock* s = find(fd);
+	if (!s)
+	{
+		errno = EBADF;
+		return -1;
+	}
+	const uint16_t port = ntohs(reinterpret_cast<const sockaddr_in*>(address)->sin_port);
+	s->localPort = port ? port : g_nextPort++;
+	return 0;
+}
+
+int ps2x_ws_connect(int fd, const sockaddr* address, socklen_t)
+{
+	const sockaddr_in* in = reinterpret_cast<const sockaddr_in*>(address);
+	std::unique_lock lock(g_mutex);
+	Sock* s = find(fd);
+	if (!s)
+	{
+		errno = EBADF;
+		return -1;
+	}
+	if (s->kind == Kind::Udp)
+	{
+		s->defaultIp = in->sin_addr.s_addr;
+		s->defaultPort = ntohs(in->sin_port);
+		return 0;
+	}
+	s->state = TcpState::Connecting;
+	auto m = message(1, static_cast<uint32_t>(fd));
+	putIp(m, in->sin_addr.s_addr);
+	put16(m, ntohs(in->sin_port));
+	g_outgoing.push_back(std::move(m));
+	if (s->nonblock)
+	{
+		errno = EINPROGRESS;
+		return -1;
+	}
+	waitFor(lock, [fd] { Sock* t = find(fd); return !t || t->state != TcpState::Connecting; }, 15000);
+	s = find(fd);
+	if (!s || s->state != TcpState::Connected)
+	{
+		errno = ECONNREFUSED;
+		return -1;
+	}
+	return 0;
+}
+
+ssize_t ps2x_ws_sendto(int fd, const void* data, size_t length, int, const sockaddr* address, socklen_t)
+{
+	std::lock_guard lock(g_mutex);
+	Sock* s = find(fd);
+	if (!s)
+	{
+		errno = EBADF;
+		return -1;
+	}
+	if (s->kind == Kind::Tcp)
+	{
+		if (s->state != TcpState::Connected)
+		{
+			errno = s->state == TcpState::Failed ? ECONNRESET : EWOULDBLOCK;
+			return -1;
+		}
+		auto m = message(2, static_cast<uint32_t>(fd));
+		m.insert(m.end(), static_cast<const uint8_t*>(data), static_cast<const uint8_t*>(data) + length);
+		g_outgoing.push_back(std::move(m));
+		return static_cast<ssize_t>(length);
+	}
+	uint32_t ip = s->defaultIp;
+	uint16_t port = s->defaultPort;
+	if (address)
+	{
+		const sockaddr_in* in = reinterpret_cast<const sockaddr_in*>(address);
+		ip = in->sin_addr.s_addr;
+		port = ntohs(in->sin_port);
+	}
+	if (!s->udpOpened)
+	{
+		g_outgoing.push_back(message(4, static_cast<uint32_t>(fd)));
+		s->udpOpened = true;
+		if (!s->localPort)
+			s->localPort = g_nextPort++;
+	}
+	auto m = message(5, static_cast<uint32_t>(fd));
+	putIp(m, ip);
+	put16(m, port);
+	m.insert(m.end(), static_cast<const uint8_t*>(data), static_cast<const uint8_t*>(data) + length);
+	g_outgoing.push_back(std::move(m));
+	return static_cast<ssize_t>(length);
+}
+
+ssize_t ps2x_ws_send(int fd, const void* data, size_t length, int flags)
+{
+	return ps2x_ws_sendto(fd, data, length, flags, nullptr, 0);
+}
+
+ssize_t ps2x_ws_recvfrom(int fd, void* data, size_t length, int flags, sockaddr* address, socklen_t* addressLength)
+{
+	std::unique_lock lock(g_mutex);
+	Sock* s = find(fd);
+	if (!s)
+	{
+		errno = EBADF;
+		return -1;
+	}
+	const bool dontWait = s->nonblock || (flags & MSG_DONTWAIT);
+	if (!readable(*s))
+	{
+		if (dontWait)
+		{
+			errno = EWOULDBLOCK;
+			return -1;
+		}
+		waitFor(lock, [fd] { Sock* t = find(fd); return !t || readable(*t); }, -1);
+		s = find(fd);
+		if (!s)
+		{
+			errno = EBADF;
+			return -1;
+		}
+	}
+	if (s->kind == Kind::Udp)
+	{
+		Datagram d = std::move(s->datagrams.front());
+		s->datagrams.pop_front();
+		const size_t n = std::min(length, d.data.size());
+		std::memcpy(data, d.data.data(), n);
+		if (address && addressLength)
+		{
+			sockaddr_in from{};
+			from.sin_family = AF_INET;
+			from.sin_addr.s_addr = d.ip;
+			from.sin_port = htons(d.port);
+			std::memcpy(address, &from, std::min<size_t>(*addressLength, sizeof(from)));
+			*addressLength = sizeof(from);
+		}
+		return static_cast<ssize_t>(n);
+	}
+	if (s->stream.empty())
+	{
+		if (s->state == TcpState::Failed)
+		{
+			errno = ECONNRESET;
+			return -1;
+		}
+		return 0; // the server closed its side
+	}
+	const size_t n = std::min(length, s->stream.size());
+	std::copy(s->stream.begin(), s->stream.begin() + static_cast<std::ptrdiff_t>(n), static_cast<uint8_t*>(data));
+	if (!(flags & MSG_PEEK))
+		s->stream.erase(s->stream.begin(), s->stream.begin() + static_cast<std::ptrdiff_t>(n));
+	return static_cast<ssize_t>(n);
+}
+
+ssize_t ps2x_ws_recv(int fd, void* data, size_t length, int flags)
+{
+	return ps2x_ws_recvfrom(fd, data, length, flags, nullptr, nullptr);
+}
+
+int ps2x_ws_select(int count, fd_set* read, fd_set* write, fd_set* except, timeval* timeout)
+{
+	const fd_set inRead = read ? *read : fd_set{};
+	const fd_set inWrite = write ? *write : fd_set{};
+	const fd_set inExcept = except ? *except : fd_set{};
+	auto evaluate = [&](bool apply) {
+		int ready = 0;
+		fd_set outRead, outWrite, outExcept;
+		FD_ZERO(&outRead);
+		FD_ZERO(&outWrite);
+		FD_ZERO(&outExcept);
+		for (int fd = 0; fd < count && fd < FD_SETSIZE; fd++)
+		{
+			const Sock* s = find(fd);
+			if (!s)
+				continue;
+			if (read && FD_ISSET(fd, &inRead) && readable(*s))
+				FD_SET(fd, &outRead), ready++;
+			if (write && FD_ISSET(fd, &inWrite) && writable(*s))
+				FD_SET(fd, &outWrite), ready++;
+			if (except && FD_ISSET(fd, &inExcept) && failed(*s))
+				FD_SET(fd, &outExcept), ready++;
+		}
+		if (apply)
+		{
+			if (read)
+				*read = outRead;
+			if (write)
+				*write = outWrite;
+			if (except)
+				*except = outExcept;
+		}
+		return ready;
+	};
+	std::unique_lock lock(g_mutex);
+	const int timeoutMs = timeout ? static_cast<int>(timeout->tv_sec * 1000 + timeout->tv_usec / 1000) : -1;
+	if (evaluate(false) == 0 && timeoutMs != 0)
+		waitFor(lock, [&] { return evaluate(false) > 0; }, timeoutMs);
+	return evaluate(true);
+}
+
+int ps2x_ws_ioctl(int fd, int request, ...)
+{
+	va_list args;
+	va_start(args, request);
+	void* argument = va_arg(args, void*);
+	va_end(args);
+	std::lock_guard lock(g_mutex);
+	Sock* s = find(fd);
+	if (!s)
+	{
+		errno = ENOTTY;
+		return -1;
+	}
+	if (request == FIONBIO)
+	{
+		s->nonblock = *static_cast<int*>(argument) != 0;
+		return 0;
+	}
+	if (request == FIONREAD)
+	{
+		const size_t available = s->kind == Kind::Tcp ? s->stream.size() : (s->datagrams.empty() ? 0 : s->datagrams.front().data.size());
+		*static_cast<int*>(argument) = static_cast<int>(available);
+		return 0;
+	}
+	errno = EINVAL;
+	return -1;
+}
+
+int ps2x_ws_fcntl(int fd, int command, ...)
+{
+	va_list args;
+	va_start(args, command);
+	const int argument = va_arg(args, int);
+	va_end(args);
+	{
+		std::lock_guard lock(g_mutex);
+		if (Sock* s = find(fd))
+		{
+			if (command == F_GETFL)
+				return O_RDWR | (s->nonblock ? O_NONBLOCK : 0);
+			if (command == F_SETFL)
+				s->nonblock = (argument & O_NONBLOCK) != 0;
+			return 0;
+		}
+	}
+	return ::fcntl(fd, command, argument);
+}
+
+int ps2x_ws_setsockopt(int fd, int, int, const void*, socklen_t)
+{
+	std::lock_guard lock(g_mutex);
+	if (!find(fd))
+	{
+		errno = EBADF;
+		return -1;
+	}
+	return 0; // TCP_NODELAY, SO_BROADCAST...: the relay has its own sockets
+}
+
+int ps2x_ws_getsockopt(int fd, int level, int option, void* value, socklen_t* length)
+{
+	std::lock_guard lock(g_mutex);
+	Sock* s = find(fd);
+	if (!s)
+	{
+		errno = EBADF;
+		return -1;
+	}
+	if (value && length && *length >= sizeof(int))
+	{
+		int result = 0;
+		if (level == SOL_SOCKET && option == SO_ERROR)
+		{
+			result = s->error;
+			s->error = 0;
+		}
+		std::memcpy(value, &result, sizeof(result));
+		*length = sizeof(int);
+	}
+	return 0;
+}
+
+int ps2x_ws_getsockname(int fd, sockaddr* address, socklen_t* length)
+{
+	std::lock_guard lock(g_mutex);
+	Sock* s = find(fd);
+	if (!s)
+	{
+		errno = EBADF;
+		return -1;
+	}
+	sockaddr_in local{};
+	local.sin_family = AF_INET;
+	local.sin_port = htons(s->localPort);
+	std::memcpy(address, &local, std::min<size_t>(*length, sizeof(local)));
+	*length = sizeof(local);
+	return 0;
+}
+
+int ps2x_ws_shutdown(int fd, int how)
+{
+	std::lock_guard lock(g_mutex);
+	Sock* s = find(fd);
+	if (!s)
+	{
+		errno = EBADF;
+		return -1;
+	}
+	if (s->kind == Kind::Tcp && s->state == TcpState::Connected && (how == SHUT_WR || how == SHUT_RDWR))
+		g_outgoing.push_back(message(7, static_cast<uint32_t>(fd)));
+	return 0;
+}
+
+int ps2x_ws_getaddrinfo(const char* node, const char* service, const addrinfo* hints, addrinfo** result)
+{
+	if (!node || !result)
+		return EAI_NONAME;
+	uint32_t ip = 0;
+	if (inet_pton(AF_INET, node, &ip) != 1)
+	{
+		// A name: the relay looks it up.
+		startNetThread();
+		std::unique_lock lock(g_mutex);
+		const uint32_t id = g_nextResolution++;
+		g_resolutions[id] = Resolution{};
+		auto m = message(6, id);
+		m.insert(m.end(), node, node + std::strlen(node));
+		g_outgoing.push_back(std::move(m));
+		waitFor(lock, [id] { return g_resolutions[id].done; }, 10000);
+		const Resolution r = g_resolutions[id];
+		g_resolutions.erase(id);
+		if (!r.done || !r.ok)
+			return EAI_NONAME;
+		ip = r.ip;
+	}
+	// One block: the addrinfo followed by its address (freed by ps2x_ws_freeaddrinfo).
+	auto* block = static_cast<uint8_t*>(std::calloc(1, sizeof(addrinfo) + sizeof(sockaddr_in)));
+	auto* info = reinterpret_cast<addrinfo*>(block);
+	auto* address = reinterpret_cast<sockaddr_in*>(block + sizeof(addrinfo));
+	address->sin_family = AF_INET;
+	address->sin_addr.s_addr = ip;
+	address->sin_port = htons(static_cast<uint16_t>(service ? std::atoi(service) : 0));
+	info->ai_family = AF_INET;
+	info->ai_socktype = hints ? hints->ai_socktype : SOCK_STREAM;
+	info->ai_protocol = hints ? hints->ai_protocol : 0;
+	info->ai_addrlen = sizeof(sockaddr_in);
+	info->ai_addr = reinterpret_cast<sockaddr*>(address);
+	*result = info;
+	return 0;
+}
+
+void ps2x_ws_freeaddrinfo(addrinfo* info)
+{
+	std::free(info);
+}
+
+#endif
