+		}
+	public:
+		bool debug = false;
+		uint64_t regCounts[0x80] = {};
+		bool traceOn = false;
+		uint32_t traceVertexRun = 0, traceLines = 0, traceWb = 0;
+		std::map<uint64, uint64_t> regValues[0x80];
+
+	protected:
+		void WriteRegisterImpl(uint8 reg, uint64 value) override
+		{
+			if(!debug)
+			{
+				CGSH_OpenGL::WriteRegisterImpl(reg, value);
+				return;
+			}
+			regCounts[reg & 0x7F]++;
+			if(traceOn)
+			{
+				const bool vertex = reg == 0x01 || reg == 0x02 || reg == 0x03 || reg == 0x04 || reg == 0x05 || reg == 0x0C || reg == 0x0D;
+				if(vertex && traceVertexRun > 8)
+					traceVertexRun++;
+				else
+				{
+					if(!vertex && traceVertexRun > 8)
+						std::printf("[trace]   ... %u vertex writes\n", traceVertexRun - 8);
+					traceVertexRun = vertex ? traceVertexRun + 1 : 0;
+					if(traceLines++ < 4000)
+						std::printf("[trace] %02x %016llx%s\n", reg, (unsigned long long)value, m_framebufferWriteBacks != traceWb ? " (after write-back)" : "");
+					traceWb = m_framebufferWriteBacks;
+				}
+			}
+			if(reg == 0x06 || reg == 0x07 || reg == 0x4C || reg == 0x4D || reg == 0x4E || reg == 0x4F || reg == 0x00 || reg == 0x50 || reg == 0x52)
+				regValues[reg][value]++;
+			CGSH_OpenGL::WriteRegisterImpl(reg, value);
+		}
+		void PresentBackbuffer() override
