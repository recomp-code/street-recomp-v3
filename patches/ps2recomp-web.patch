+	// Feeds whole quadwords of the game's VIF1 stream; a VIF waiting for the VU gets it run.
+	void FeedVif1(Host& h, const uint8_t* bytes, uint32_t size)
+	{
+		static int s_dumped = 0;
+		if(s_dumped < 12 && size >= 16)
+		{
+			s_dumped++;
+			uint32_t w[8] = {};
+			std::memcpy(w, bytes, std::min<uint32_t>(size, sizeof(w)));
+			std::printf("[webgs] vif1 #%d size %u carry %zu: %08x %08x %08x %08x %08x %08x %08x %08x\n", s_dumped, size,
+			            h.vifCarry.size(), w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7]);
+		}
+		h.vifCarry.insert(h.vifCarry.end(), bytes, bytes + size);
+		const uint32_t whole = static_cast<uint32_t>(h.vifCarry.size()) & ~15u;
+		CVif& vif = h.vpu1->GetVif();
+		uint32_t done = 0;
+		while(done < whole)
+		{
+			const uint32_t chunk = std::min(whole - done, kVifStageSize);
+			std::memcpy(h.ram + kVifStageAddr, h.vifCarry.data() + done, chunk);
+			const uint32_t qwc = chunk / 16;
+			uint32_t consumed = 0;
+			int stalls = 0;
+			while(consumed < qwc)
+			{
+				const uint32_t n = vif.ReceiveDMA(kVifStageAddr + consumed * 16, qwc - consumed, Dmac::CChannel::CHCR_DIR_FROM, false);
+				static int s_logged = 0;
+				if(s_logged < 12)
+				{
+					s_logged++;
+					std::printf("[webgs] ReceiveDMA qwc %u -> %u, VIF STAT %08x, vu running %d\n", qwc - consumed, n,
+					            vif.GetRegister(0x10003C00), h.vpu1->IsVuRunning() ? 1 : 0);
+				}
+				consumed += n;
+				if(n == 0)
+				{
+					if(!h.vpu1->IsVuRunning() || ++stalls > 64)
+					{
+						std::printf("[webgs] VIF1 stuck, dropping %u qwords\n", qwc - consumed);
+						consumed = qwc;
+						break;
+					}
+					RunVu1(h);
+				}
+			}
+			done += chunk;
+		}
+		h.vifCarry.erase(h.vifCarry.begin(), h.vifCarry.begin() + whole);
+		RunVu1(h); // MSCAL at the end of the chunk
+	}
+
+	void Transfer(Host& h, uint8_t path, const uint8_t* data, uint32_t size)
+	{
+		const unsigned pathIndex = path == kPath1New ? 1 : path == kPath2 ? 2 : path == kPath3 ? 3 : 0;
+		if(!pathIndex || !size)
+			return;
+		h.pathBytes[pathIndex] += size;
+		uint32_t done = 0;
+		int stalls = 0;
+		while(done < size)
+		{
+			const uint32_t n = h.gif->ProcessMultiplePackets(data, size, done, size, CGsPacketMetadata(pathIndex));
+			if(n == 0)
+			{
+				// Another path has the GIF: let the VU finish its XGKICK first.
+				RunVu1(h);
+				if(++stalls > 64)
+				{
+					std::printf("[webgs] GIF path %u busy, dropping %u bytes\n", pathIndex, size - done);
+					break;
+				}
+				continue;
+			}
+			done += n;
+		}
+	}
+
+	// Processes whole packets until a vsync (drawn) or the data runs out. True if a frame was drawn.
+	bool ProcessPackets(Host& h)
+	{
+		if(!h.headerDone)
+		{
+			if(Available(h) < 8)
+				return false;
+			const uint32_t crc = PeekValue<uint32_t>(h, 0);
+			const uint32_t headerSize = PeekValue<uint32_t>(h, 4);
+			uint64_t stateSize = headerSize;
+			uint64_t headerBytes = 0;
+			if(crc == 0xFFFFFFFFu)
+			{
+				headerBytes = headerSize;
+				if(Available(h) < 8 + headerBytes)
+					return false;
+				std::vector<uint8_t> header(headerBytes);
+				Peek(h, 8, header.data(), headerBytes);
+				uint32_t dumpStateSize = 0;
+				std::memcpy(&dumpStateSize, header.data() + 4, sizeof(dumpStateSize)); // GSDumpHeader.state_size
+				stateSize = dumpStateSize;
+			}
+			const uint64_t total = 8 + headerBytes + stateSize + kPrivRegsSize;
+			if(Available(h) < total)
+				return false;
+			Peek(h, 8 + headerBytes + stateSize, h.privRegs.data(), kPrivRegsSize);
+			Consume(h, total);
+			ApplyPrivRegisters(h);
+			h.headerDone = true;
+			std::printf("[webgs] live GS stream connected\n");
+		}
+
+		for(;;)
+		{
+			const uint64_t avail = Available(h);
+			if(avail < 1)
+				return false;
+			const uint8_t id = PeekValue<uint8_t>(h, 0);
+			switch(id)
+			{
+			case kTypeLiveVif1:
+			{
+				if(avail < 5)
+					return false;
+				const uint32_t length = PeekValue<uint32_t>(h, 1);
+				if(avail < 5ull + length)
+					return false;
+				h.packet.resize(length);
+				Peek(h, 5, h.packet.data(), length);
+				Consume(h, 5ull + length);
+				h.nVif++;
+				FeedVif1(h, h.packet.data(), length & ~3u);
+				break;
+			}
+			case kTypeLiveVif1Reg:
+			{
+				if(avail < 9)
+					return false;
+				const uint32_t address = PeekValue<uint32_t>(h, 1);
+				const uint32_t value = PeekValue<uint32_t>(h, 5);
+				Consume(h, 9);
+				h.nVifReg++;
+				h.vifRegWrites[address]++;
+				h.vifRegLast[address] = value;
+				h.vpu1->GetVif().SetRegister(address, value);
+				break;
+			}
+			case kTypeTransfer:
+			{
+				if(avail < 6)
+					return false;
+				const uint8_t path = PeekValue<uint8_t>(h, 1);
+				const uint32_t length = PeekValue<uint32_t>(h, 2);
+				if(avail < 6ull + length)
+					return false;
+				h.packet.resize(length);
+				Peek(h, 6, h.packet.data(), length);
+				Consume(h, 6ull + length);
+				h.nXfer++;
+				Transfer(h, path, h.packet.data(), length);
+				break;
+			}
+			case kTypeVSync:
+			{
+				if(avail < 2)
+					return false;
+				Consume(h, 2);
+				h.nVsync++;
+				h.totalVsyncs++;
+				if(g_traceState == 2)
+				{
+					h.gsWeb->traceOn = false;
+					g_traceState = 0;
+					std::printf("[trace] end\n");
+				}
+				else if(g_traceState == 1)
+				{
+					g_traceState = 2;
+					h.gsWeb->traceOn = true;
+					h.gsWeb->traceLines = 0;
+					std::printf("[trace] begin\n");
+				}
+				// Queues the frame's end and the flip for the page thread. With two frames already
+				// queued (Play!'s MAX_INFLIGHT_FRAMES) this waits: the picture never lags far behind.
+				const double waitStart = emscripten_get_now();
+				h.gs->SetVBlank();
+				h.gs->ResetVBlank();
+				h.vblankWaitMs += emscripten_get_now() - waitStart;
+				return true;
+			}
+			case kTypeReadFifo2:
+			{
+				if(avail < 5)
+					return false;
+				const uint32_t qwc = PeekValue<uint32_t>(h, 1);
+				Consume(h, 5);
+				h.nFifo++;
+				std::vector<uint8_t> discard((static_cast<size_t>(qwc) + 1) * 16);
+				h.gs->ReadImageData(discard.data(), qwc * 16);
+				h.gs->SendGSCall([]() {}, true, true); // the page thread has read it: the buffer can go
+				break;
+			}
+			case kTypeRegisters:
+			{
+				if(avail < 1 + kPrivRegsSize)
+					return false;
+				Peek(h, 1, h.privRegs.data(), kPrivRegsSize);
+				Consume(h, 1 + kPrivRegsSize);
+				h.nRegs++;
+				ApplyPrivRegisters(h);
+				break;
+			}
+			default:
+				std::printf("[webgs] unknown packet 0x%02X, stopping\n", id);
+				h.ring->consumerQuit = 1;
+				return false;
+			}
+		}
+	}
+
+	// Follows the canvas' size on the page (window resize, fullscreen): drawing buffer and GS
+	// presentation in device pixels.
+	void UpdatePresentation(Host& h)
+	{
+		double cssWidth = 0.0, cssHeight = 0.0;
+		emscripten_get_element_css_size("#canvas", &cssWidth, &cssHeight);
+		const double ratio = emscripten_get_device_pixel_ratio();
+		const uint32 width = static_cast<uint32>(cssWidth * ratio + 0.5);
+		const uint32 height = static_cast<uint32>(cssHeight * ratio + 0.5);
+		if(width == 0 || height == 0 || (width == h.presentWidth && height == h.presentHeight))
+			return;
+		h.presentWidth = width;
+		h.presentHeight = height;
+		emscripten_set_canvas_element_size("#canvas", static_cast<int>(width), static_cast<int>(height));
+		CGSHandler::PRESENTATION_PARAMS presentation;
+		presentation.mode = CGSHandler::PRESENTATION_MODE_FIT;
+		presentation.windowWidth = width;
+		presentation.windowHeight = height;
+		h.gs->SetPresentationParams(presentation);
+	}
+
+	EM_BOOL OnAnimationFrame(double time, void*)
+	{
+		Host& h = *g_host;
+		UpdatePresentation(h);
+		PublishPad(h.ring);
+		// The GS calls the worker thread queued (draws, transfers, flips) run here, where the WebGL
+		// context lives; the last flip is what the page shows.
+		const double gsStart = emscripten_get_now();
+		h.gsWeb->Pump();
+		h.gsMs += emscripten_get_now() - gsStart;
+		if(g_debug)
+			DebugStats(h);
+		if(h.statsStart == 0.0)
+			h.statsStart = time; // rAF time is page-relative; emscripten_get_now() is absolute with pthreads
+		if(time - h.statsStart >= 5000.0)
+		{
+			std::printf("[webgs] %.1f game fps on screen\n", h.frames * 1000.0 / (time - h.statsStart));
+			h.frames = 0;
+			h.statsStart = time;
+		}
+		return h.ring->producerAlive ? EM_TRUE : EM_FALSE;
+	}
+
+	void RegisterJitFunctions();
+
+	// DMAC/GIF/VIF1/VU1 for the worker thread: built there, because the VU1 JIT adds its code to
+	// the function table of the thread that compiles it (each WebAssembly thread has its own).
+	void SetupEmulation(Host* h)
+	{
+		h->dmac = std::make_unique<CDMAC>(h->ram, h->spr, h->vuMem0, h->vuMem1, h->ee);
+		h->gif = std::make_unique<CGIF>(h->gs, *h->dmac, h->ram, h->spr);
+		h->vpu1 = std::make_shared<CVpu>(1, CVpu::VPUINIT(h->microMem1, h->vuMem1, &h->vu1), *h->gif, h->intc, h->ram, h->spr);
+
+		// VU1 context, as Play!'s EE subsystem sets it up.
+		CMIPS& vu1 = h->vu1;
+		vu1.m_executor = std::make_unique<CVuExecutor>(vu1, PS2::MICROMEM1SIZE);
+		vu1.m_pMemoryMap->InsertReadMap(0x00000000, 0x00003FFF, h->vuMem1, 0x00);
+		vu1.m_pMemoryMap->InsertReadMap(0x00008000, 0x00008FFF, [h](uint32 address, uint32) -> uint32 {
+			if(address == CVpu::VU_ADDR_ITOP)
+				return h->vpu1->GetVif().GetITOP();
+			if(address == CVpu::VU_ADDR_TOP)
+				return h->vpu1->GetVif().GetTOP();
+			return 0xCCCCCCCC;
+		}, 0x01);
+		vu1.m_pMemoryMap->InsertWriteMap(0x00000000, 0x00003FFF, h->vuMem1, 0x00);
+		vu1.m_pMemoryMap->InsertWriteMap(0x00008000, 0x00008FFF, [h](uint32 address, uint32 value) -> uint32 {
+			if(address == CVpu::VU_ADDR_XGKICK)
+			{
+				h->xgkicks++;
+				h->vpu1->ProcessXgKick(value);
+			}
+			return 0;
+		}, 0x01);
+		vu1.m_pMemoryMap->InsertInstructionMap(0x00000000, 0x00003FFF, h->microMem1, 0x01);
+		vu1.m_pArch = &h->maVu1;
+		vu1.m_pAddrTranslator = CMIPS::TranslateAddress64;
+		vu1.m_vuMem = h->vuMem1;
+		h->vuStateConnection = h->vpu1->VuStateChanged.Connect([h](CVpu::VU_STATE state) {
+			if(state == CVpu::VU_STATE_RUNNING)
+				h->vuStarts++;
+		});
+		h->vpu1->Reset();
+	}
+
+	// Worker thread: the live stream, VIF1, VU1 (its JIT code lives in this thread's function
+	// table) and the GIF; everything for the GS goes to the page thread through Play!'s mailbox.
+	void* HostThread(void* arg)
+	{
+		Host& h = *static_cast<Host*>(arg);
+		RegisterJitFunctions();
+		SetupEmulation(&h);
+		for(;;)
+		{
+			bool drew = false;
+			for(int i = 0; i < 4 && ProcessPackets(h); i++)
+				drew = true;
+			if(!drew)
+			{
+				if(!h.ring->producerAlive && h.headerDone)
+					break;
+				const double sleepStart = emscripten_get_now();
+				usleep(300); // the game writes a frame every ~16 ms
+				h.idleMs += emscripten_get_now() - sleepStart;
+			}
+		}
+		return nullptr;
+	}
+
+	void RegisterJitFunctions()
+	{
+		using Jitter::CWasmFunctionRegistry;
+		CWasmFunctionRegistry::RegisterFunction(reinterpret_cast<uintptr_t>(&EmptyBlockHandler), "_EmptyBlockHandler", "vi");
+		CWasmFunctionRegistry::RegisterFunction(reinterpret_cast<uintptr_t>(&MemoryUtils_GetByteProxy), "_MemoryUtils_GetByteProxy", "iii");
+		CWasmFunctionRegistry::RegisterFunction(reinterpret_cast<uintptr_t>(&MemoryUtils_GetHalfProxy), "_MemoryUtils_GetHalfProxy", "iii");
+		CWasmFunctionRegistry::RegisterFunction(reinterpret_cast<uintptr_t>(&MemoryUtils_GetWordProxy), "_MemoryUtils_GetWordProxy", "iii");
+		CWasmFunctionRegistry::RegisterFunction(reinterpret_cast<uintptr_t>(&MemoryUtils_GetDoubleProxy), "_MemoryUtils_GetDoubleProxy", "jii");
+		CWasmFunctionRegistry::RegisterFunction(reinterpret_cast<uintptr_t>(&MemoryUtils_SetByteProxy), "_MemoryUtils_SetByteProxy", "viii");
+		CWasmFunctionRegistry::RegisterFunction(reinterpret_cast<uintptr_t>(&MemoryUtils_SetHalfProxy), "_MemoryUtils_SetHalfProxy", "viii");
+		CWasmFunctionRegistry::RegisterFunction(reinterpret_cast<uintptr_t>(&MemoryUtils_SetWordProxy), "_MemoryUtils_SetWordProxy", "viii");
+		CWasmFunctionRegistry::RegisterFunction(reinterpret_cast<uintptr_t>(&MemoryUtils_SetDoubleProxy), "_MemoryUtils_SetDoubleProxy", "viji");
+		CWasmFunctionRegistry::RegisterFunction(reinterpret_cast<uintptr_t>(&LWL_Proxy), "_LWL_Proxy", "iiii");
+		CWasmFunctionRegistry::RegisterFunction(reinterpret_cast<uintptr_t>(&LWR_Proxy), "_LWR_Proxy", "iiii");
+		CWasmFunctionRegistry::RegisterFunction(reinterpret_cast<uintptr_t>(&LDL_Proxy), "_LDL_Proxy", "jiji");
+		CWasmFunctionRegistry::RegisterFunction(reinterpret_cast<uintptr_t>(&LDR_Proxy), "_LDR_Proxy", "jiji");
+		CWasmFunctionRegistry::RegisterFunction(reinterpret_cast<uintptr_t>(&SWL_Proxy), "_SWL_Proxy", "viii");
+		CWasmFunctionRegistry::RegisterFunction(reinterpret_cast<uintptr_t>(&SWR_Proxy), "_SWR_Proxy", "viii");
+		CWasmFunctionRegistry::RegisterFunction(reinterpret_cast<uintptr_t>(&SDL_Proxy), "_SDL_Proxy", "viji");
+		CWasmFunctionRegistry::RegisterFunction(reinterpret_cast<uintptr_t>(&SDR_Proxy), "_SDR_Proxy", "viji");
+	}
+
+	// Main thread: builds the GS/VIF1/VU1/GIF and starts the frame loop.
+	void StartOnMainThread(void* arg)
+	{
+		auto* ring = static_cast<ps2live::RingHeader*>(arg);
+
+		EmscriptenWebGLContextAttributes attr;
+		emscripten_webgl_init_context_attributes(&attr);
+		attr.majorVersion = 2;
+		attr.minorVersion = 0;
+		attr.alpha = EM_FALSE;
+		attr.antialias = EM_FALSE;
+		attr.preserveDrawingBuffer = EM_TRUE; // a vsync without changes keeps the last picture
+		attr.powerPreference = EM_WEBGL_POWER_PREFERENCE_HIGH_PERFORMANCE;
+		g_context = emscripten_webgl_create_context("#canvas", &attr);
+		if(g_context <= 0)
+		{
+			std::printf("[webgs] WebGL2 is not available (%d)\n", static_cast<int>(g_context));
+			ring->consumerQuit = 1;
+			return;
+		}
+
+		Host* h = new Host();
+		h->ring = ring;
+		h->ringData = ps2live::ringData(ring);
+		h->ringCapacity = ring->capacity;
+		h->ram = static_cast<uint8*>(std::aligned_alloc(16, PS2::EE_RAM_SIZE));
+		h->spr = static_cast<uint8*>(std::aligned_alloc(16, PS2::EE_SPR_SIZE));
+		h->vuMem0 = static_cast<uint8*>(std::aligned_alloc(16, PS2::VUMEM0SIZE));
+		h->vuMem1 = static_cast<uint8*>(std::aligned_alloc(16, PS2::VUMEM1SIZE));
+		h->microMem1 = new uint8[PS2::MICROMEM1SIZE];
+		std::memset(h->ram, 0, PS2::EE_RAM_SIZE);
+		std::memset(h->vuMem1, 0, PS2::VUMEM1SIZE);
+		std::memset(h->microMem1, 0, PS2::MICROMEM1SIZE);
+
+		// Internal resolution: <page>?scale=N (1 = native PS2, default 2)
+		const int scale = EM_ASM_INT({
+			const value = parseInt(new URLSearchParams(location.search).get('scale') || '2', 10);
+			return value >= 1 && value <= 4 ? value : 2;
+		});
+		g_debug = EM_ASM_INT({ return new URLSearchParams(location.search).has('debug') ? 1 : 0; }) != 0;
+		CGSH_OpenGL::RegisterPreferences();
+		CAppConfig::GetInstance().SetPreferenceInteger(PREF_CGSH_OPENGL_RESOLUTION_FACTOR, scale);
+		std::printf("[webgs] internal resolution x%d\n", scale);
+
+		h->gsWeb = new CGSH_Web(g_context);
+		h->gsWeb->debug = g_debug;
+		h->gs = h->gsWeb;
+		h->gs->SetIntc(&h->intc);
+
+		h->newFrameConnection = h->gs->OnNewFrame.Connect([h](uint32 drawCalls) {
+			h->drawCalls += drawCalls;
+			h->frames++; // a game frame finished on screen (runs on the page thread)
+		});
+		h->flipConnection = h->gs->OnFlipComplete.Connect([h]() { h->flips++; });
+		h->gs->Initialize();
+		h->gsWeb->Pump();
+		CGSHandler::PRESENTATION_PARAMS presentation;
+		presentation.mode = CGSHandler::PRESENTATION_MODE_FIT;
+		double cssWidth = 1280.0, cssHeight = 960.0;
+		emscripten_get_element_css_size("#canvas", &cssWidth, &cssHeight);
+		const double ratio = emscripten_get_device_pixel_ratio();
+		presentation.windowWidth = static_cast<uint32>(cssWidth * ratio);
+		presentation.windowHeight = static_cast<uint32>(cssHeight * ratio);
+		emscripten_set_canvas_element_size("#canvas", static_cast<int>(presentation.windowWidth), static_cast<int>(presentation.windowHeight));
+		h->gs->SetPresentationParams(presentation);
+		h->gs->Reset();
+		h->gsWeb->Pump();
+
+		emscripten_set_keydown_callback(EMSCRIPTEN_EVENT_TARGET_WINDOW, nullptr, EM_TRUE, &OnKey);
+		emscripten_set_keyup_callback(EMSCRIPTEN_EVENT_TARGET_WINDOW, nullptr, EM_TRUE, &OnKey);
+		emscripten_set_blur_callback(EMSCRIPTEN_EVENT_TARGET_WINDOW, nullptr, EM_TRUE, &OnBlur);
+
+		ring->consumerAlive = 1;
+		ring->consumerFlags = 1; // never waits on the data event: no wake-ups needed
+		g_host = h;
+		h->statsStart = 0.0;
+		pthread_t thread;
+		pthread_create(&thread, nullptr, &HostThread, h);
+		pthread_detach(thread);
+		std::printf("[webgs] GS host started (Play! GS on WebGL2 in the page, VIF1/VU1/GIF in a worker)\n");
+		emscripten_request_animation_frame_loop(&OnAnimationFrame, nullptr);
+	}
+} // namespace
+
+// Called by gs_dump_writer.cpp on the game's thread when PS2X_GS_LIVE=1.
+bool ps2xWebStartGsHost(ps2live::RingHeader* header)
+{
+	emscripten_async_run_in_main_runtime_thread(EM_FUNC_SIG_VI, &StartOnMainThread, header);
+	return true;
+}
diff --git a/ps2xRuntime/web/raylib_headless.cpp b/ps2xRuntime/web/raylib_headless.cpp
new file mode 100644
index 0000000..ac06b4b
--- /dev/null
+++ b/ps2xRuntime/web/raylib_headless.cpp
@@ -0,0 +1,122 @@
+// Headless raylib for the WebAssembly build: the subset of raylib the runtime uses, with no
+// window or input (the page reads those), and audio handed to the platform. The main loop still runs at the target FPS
+// (EndDrawing paces it) and PS2X_WASM_SECONDS makes WindowShouldClose() end the run.
+
+#include "raylib.h"
+
+#include <chrono>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <thread>
+
+namespace
+{
+    using Clock = std::chrono::steady_clock;
+    int s_targetFps = 60;
+    Clock::time_point s_start = Clock::now();
+    Clock::time_point s_nextFrame = Clock::now();
+    double s_runSeconds = []
+    {
+        const char* value = std::getenv("PS2X_WASM_SECONDS");
+        return value && *value ? std::atof(value) : 0.0;
+    }();
+} // namespace
+
+void InitWindow(int, int, const char*) { s_start = s_nextFrame = Clock::now(); }
+void CloseWindow(void) {}
+void SetConfigFlags(unsigned int) {}
+bool IsWindowReady(void) { return false; } // no input backend: the pad code skips raylib
+bool WindowShouldClose(void)
+{
+    return s_runSeconds > 0.0 && std::chrono::duration<double>(Clock::now() - s_start).count() >= s_runSeconds;
+}
+void SetTargetFPS(int fps) { s_targetFps = fps > 0 ? fps : 60; }
+int GetScreenWidth(void) { return 640; }
+int GetScreenHeight(void) { return 448; }
+
+void BeginDrawing(void) {}
+void EndDrawing(void)
+{
+    s_nextFrame += std::chrono::microseconds(1000000 / s_targetFps);
+    const Clock::time_point now = Clock::now();
+    if (s_nextFrame < now)
+        s_nextFrame = now;
+    std::this_thread::sleep_until(s_nextFrame);
+}
+void ClearBackground(Color) {}
+void DrawTexturePro(Texture2D, Rectangle, Rectangle, Vector2, float, Color) {}
+
+Image GenImageColor(int width, int height, Color)
+{
+    Image image{};
+    image.width = width;
+    image.height = height;
+    image.mipmaps = 1;
+    image.format = PIXELFORMAT_UNCOMPRESSED_R8G8B8A8;
+    return image; // no pixel data: textures are never drawn
+}
+void UnloadImage(Image) {}
+Texture2D LoadTextureFromImage(Image image)
+{
+    Texture2D texture{};
+    texture.width = image.width;
+    texture.height = image.height;
+    texture.mipmaps = 1;
+    texture.format = image.format;
+    return texture;
+}
+void UpdateTexture(Texture2D, const void*) {}
+void UnloadTexture(Texture2D) {}
+
+bool IsKeyDown(int) { return false; }
+bool IsKeyPressed(int) { return false; }
+bool IsGamepadAvailable(int) { return false; }
+bool IsGamepadButtonDown(int, int) { return false; }
+float GetGamepadAxisMovement(int, int) { return 0.0f; }
+
+// Audio goes to the platform (web_platform.cpp: a ring buffer read by an AudioWorklet;
+// node_platform.cpp: none). Only the runtime's 48 kHz 16-bit stereo stream is supported.
+bool ps2xHostAudioInit();
+bool ps2xHostAudioWantsFrames(int frames);
+void ps2xHostAudioWrite(const int16_t* samples, int frames);
+
+namespace
+{
+    bool s_audioReady = false;
+}
+
+void InitAudioDevice(void) { s_audioReady = ps2xHostAudioInit(); }
+void CloseAudioDevice(void) { s_audioReady = false; }
+bool IsAudioDeviceReady(void) { return s_audioReady; }
+void SetAudioStreamBufferSizeDefault(int) {}
+AudioStream LoadAudioStream(unsigned int sampleRate, unsigned int sampleSize, unsigned int channels)
+{
+    AudioStream stream{};
+    stream.sampleRate = sampleRate;
+    stream.sampleSize = sampleSize;
+    stream.channels = channels;
+    return stream;
+}
+void UnloadAudioStream(AudioStream) {}
+void UpdateAudioStream(AudioStream, const void* data, int frames)
+{
+    ps2xHostAudioWrite(static_cast<const int16_t*>(data), frames);
+}
+void PlayAudioStream(AudioStream) {}
+bool IsAudioStreamProcessed(AudioStream) { return s_audioReady && ps2xHostAudioWantsFrames(1024); }
+bool IsAudioStreamValid(AudioStream stream)
+{
+    return s_audioReady && stream.sampleRate == 48000 && stream.sampleSize == 16 && stream.channels == 2;
+}
+void StopAudioStream(AudioStream) {}
+
+Wave LoadWaveFromMemory(const char*, const unsigned char*, int) { return Wave{}; }
+void UnloadWave(Wave) {}
+Sound LoadSoundFromWave(Wave) { return Sound{}; }
+void UnloadSound(Sound) {}
+void PlaySound(Sound) {}
+void StopSound(Sound) {}
+bool IsSoundPlaying(Sound) { return false; }
+void SetSoundVolume(Sound, float) {}
+void SetSoundPitch(Sound, float) {}
diff --git a/ps2xRuntime/web/site/index.html b/ps2xRuntime/web/site/index.html
new file mode 100644
index 0000000..54446f7
--- /dev/null
+++ b/ps2xRuntime/web/site/index.html
@@ -0,0 +1,184 @@
+<!doctype html>
+<html lang="es">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>NBA Street V3</title>
+<style>
+  :root { color-scheme: dark; --bg: #0b0b0d; --fg: #e8e6e3; --dim: #8b8a88; --accent: #e8792b; }
+  * { box-sizing: border-box; }
+  html, body { margin: 0; height: 100%; background: var(--bg); color: var(--fg); font: 14px/1.4 system-ui, sans-serif; }
+  main { height: 100%; display: grid; grid-template-rows: 1fr auto; }
+  #stage { position: relative; display: grid; place-items: center; overflow: hidden; }
+  #canvas { width: min(100vw, calc((100vh - 40px) * 4 / 3)); aspect-ratio: 4 / 3; background: #000; outline: none; }
+  /* Fullscreen: the whole screen; the game keeps 4:3 inside (black bars) */
+  #stage:fullscreen { background: #000; }
+  #stage:fullscreen #canvas { width: 100vw; height: 100vh; aspect-ratio: auto; }
+  #status { position: absolute; inset: 0; display: grid; place-items: center; pointer-events: none; text-align: center; }
+  #status[hidden] { display: none; }
+  #status b { display: block; font-size: 18px; margin-bottom: 6px; }
+  #play { pointer-events: auto; margin-top: 18px; font: 600 16px system-ui, sans-serif; color: #111; background: var(--accent);
+          border: 0; border-radius: 6px; padding: 10px 28px; cursor: pointer; }
+  #bar { width: 260px; height: 4px; background: #222; border-radius: 2px; overflow: hidden; margin: 10px auto 0; }
+  #bar i { display: block; height: 100%; width: 0; background: var(--accent); transition: width .2s; }
+  footer { display: flex; gap: 16px; align-items: center; padding: 8px 16px; color: var(--dim); font-size: 12px; }
+  footer button { background: none; border: 1px solid #333; color: var(--fg); border-radius: 4px; padding: 3px 8px; cursor: pointer; }
+  #log { display: none; position: fixed; right: 0; bottom: 36px; width: min(640px, 100vw); height: 40vh; overflow: auto;
+         background: rgba(0,0,0,.85); color: #bdbdbd; font: 11px/1.35 ui-monospace, monospace; padding: 8px; white-space: pre-wrap; }
+  #log.open { display: block; }
+</style>
+</head>
+<body>
+<main>
+  <div id="stage">
+    <canvas id="canvas" tabindex="0" oncontextmenu="event.preventDefault()"></canvas>
+    <div id="status"><div><b id="statusTitle">Cargando…</b><span id="statusText">Descargando el juego (solo la primera vez)</span><div id="bar"><i></i></div>
+      <button id="play">▶ Jugar</button></div></div>
+  </div>
+  <footer>
+    <span>Flechas/WASD · Z X C V · Q E 1 3 · Enter = START · mando compatible</span>
+    <span id="fps"></span>
+    <button id="sound" hidden>Activar sonido</button>
+    <span style="flex:1"></span>
+    <button id="full">Pantalla completa</button>
+    <button id="logBtn">Log</button>
+  </footer>
+</main>
+<pre id="log"></pre>
+<script>
+  const log = document.getElementById('log');
+  const statusBox = document.getElementById('status');
+  const statusTitle = document.getElementById('statusTitle');
+  const statusText = document.getElementById('statusText');
+  const bar = document.querySelector('#bar i');
+  const fps = document.getElementById('fps');
+  const lines = [];
+  const maxLines = new URLSearchParams(location.search).has('debug') ? 400000 : 2000;
+  function append(text) {
+    text = text.replace(/\[MC\][^\[]*/g, ''); // memory card chatter (several lines per frame)
+    if (!text.trim()) return;
+    lines.push(text);
+    if (lines.length > maxLines) lines.splice(0, maxLines / 4);
+    if (log.classList.contains('open')) { log.textContent = lines.join('\n'); log.scrollTop = log.scrollHeight; }
+    const m = /\[webgs\] ([\d.]+) game fps/.exec(text);
+    if (m) fps.textContent = m[1] + ' fps';
+    if (text.includes('[webgs] live GS stream connected')) statusBox.hidden = true;
+  }
+  document.getElementById('logBtn').onclick = () => { log.classList.toggle('open'); log.textContent = lines.join('\n'); };
+  document.getElementById('full').onclick = () => document.getElementById('stage').requestFullscreen?.();
+  if (!crossOriginIsolated) {
+    statusTitle.textContent = 'El navegador no permite hilos aquí';
+    statusText.textContent = 'La página necesita las cabeceras COOP/COEP del servidor.';
+  }
+  let audioContext = null;
+  var Module = {
+    canvas: document.getElementById('canvas'),
+    print: append,
+    printErr: append,
+    setStatus: (text) => {
+      const m = /\((\d+(\.\d+)?)\/(\d+)\)/.exec(text);
+      if (m) bar.style.width = (100 * m[1] / m[3]).toFixed(1) + '%';
+    },
+    onAbort: (what) => { statusBox.hidden = false; statusTitle.textContent = 'Se detuvo'; statusText.textContent = String(what); },
+    monitorRunDependencies: (left) => { if (!left) { statusText.textContent = 'Arrancando el juego…'; bar.style.width = '100%'; } },
+    // The game starts on the "Jugar" click: browsers only allow sound after one, and this way the
+    // sound is there from the first video. The download goes on meanwhile.
+    preRun: [() => Module.addRunDependency('play-click')],
+  };
+  const playButton = document.getElementById('play');
+  playButton.onclick = () => {
+    playButton.remove();
+    audioContext = new AudioContext({ sampleRate: 48000, latencyHint: 'interactive' });
+    audioContext.resume();
+    document.getElementById('canvas').focus();
+    Module.removeRunDependency('play-click');
+  };
+  document.getElementById('canvas').focus();
+
+  // Sound: the game writes 48 kHz stereo into a ring buffer in its (shared) memory and this
+  // worklet plays it from there. Browsers only start audio after a click or a key press.
+  const audioWorklet = `
+    class Ps2xOutput extends AudioWorkletProcessor {
+      constructor(options) {
+        super();
+        const o = options.processorOptions;
+        this.ring = new Int16Array(o.buffer, o.ring, o.frames * 2);
+        this.index = new Uint32Array(o.buffer, o.index, 2);
+        this.frames = o.frames;
+        this.waiting = true;
+        this.lastL = this.lastR = 0;
+        this.underruns = this.skips = this.blocks = 0;
+        this.frac = 0;
+        this.level = 2400;
+        this.capture = null;
+        this.port.onmessage = (e) => { if (e.data === 'capture') this.capture = []; };
+      }
+      sample(pos) {
+        const k = (pos % this.frames) * 2;
+        return [this.ring[k] / 32768, this.ring[k + 1] / 32768];
+      }
+      process(inputs, outputs) {
+        const left = outputs[0][0], right = outputs[0][1];
+        const written = Atomics.load(this.index, 0);
+        let read = Atomics.load(this.index, 1);
+        let queued = (written - read) >>> 0;
+        if (queued > 14000) { read = (written - 2400) >>> 0; queued = 2400; this.frac = 0; this.skips++; }
+        if (this.waiting && queued >= 1600) this.waiting = false;
+        if (!this.waiting && queued < left.length + 2) { this.waiting = true; this.underruns++; }
+        // The game's clock and the sound card's differ (the game makes ~49 kHz): play slightly
+        // faster or slower (up to 4%) to keep ~60 ms queued, instead of dropping samples (clicks)
+        this.level += (queued - this.level) * 0.01;
+        const step = 1 + Math.max(-0.04, Math.min(0.04, (this.level - 2400) / 2400 * 0.06));
+        for (let i = 0; i < left.length; i++) {
+          if (!this.waiting && ((written - read) >>> 0) > 1) {
+            const [l0, r0] = this.sample(read), [l1, r1] = this.sample((read + 1) >>> 0);
+            this.lastL = l0 + (l1 - l0) * this.frac;
+            this.lastR = r0 + (r1 - r0) * this.frac;
+            this.frac += step;
+            const whole = Math.floor(this.frac);
+            this.frac -= whole;
+            read = (read + whole) >>> 0;
+          } else {
+            this.lastL *= 0.995; this.lastR *= 0.995;
+          }
+          left[i] = this.lastL;
+          right[i] = this.lastR;
+          if (this.capture && !this.waiting) { this.capture.push(this.lastL); if (this.capture.length >= 48000 * 8) { this.port.postMessage({ capture: this.capture }); this.capture = null; } }
+        }
+        Atomics.store(this.index, 1, read);
+        if (++this.blocks % 1500 === 0) {
+          const produced = ((written - (this.lastWritten ?? written)) >>> 0) / (currentTime - (this.lastTime ?? currentTime) || 1);
+          this.lastWritten = written; this.lastTime = currentTime;
+          this.port.postMessage({ underruns: this.underruns, skips: this.skips, queued, step, produced });
+        }
+        return true;
+      }
+    }
+    registerProcessor('ps2x-output', Ps2xOutput);`;
+  async function ps2xStartAudio(buffer, ring, frames, index) {
+    audioContext ??= new AudioContext({ sampleRate: 48000, latencyHint: 'interactive' });
+    const url = URL.createObjectURL(new Blob([audioWorklet], { type: 'text/javascript' }));
+    await audioContext.audioWorklet.addModule(url);
+    const node = new AudioWorkletNode(audioContext, 'ps2x-output', {
+      numberOfInputs: 0, outputChannelCount: [2],
+      processorOptions: { buffer, ring, frames, index },
+    });
+    node.connect(audioContext.destination);
+    node.port.onmessage = (e) => {
+      if (e.data.capture) { window.ps2xAudioCapture = e.data.capture; return; }
+      append(`[audio] underruns ${e.data.underruns}, skips ${e.data.skips}, queued ${e.data.queued}, rate ${e.data.step.toFixed(4)}, game makes ${e.data.produced.toFixed(0)} Hz`);
+    };
+    window.ps2xAudioNode = node;
+    if (audioContext.state !== 'running') sound.hidden = false;
+  }
+  const sound = document.getElementById('sound');
+  function resumeAudio() {
+    if (audioContext && audioContext.state !== 'running') audioContext.resume().then(() => { sound.hidden = true; });
+  }
+  for (const type of ['pointerdown', 'keydown']) window.addEventListener(type, resumeAudio, { capture: true });
+  window.addEventListener('gamepadconnected', resumeAudio);
+  sound.onclick = resumeAudio;
+</script>
+<script src="ps2EntryRunner.js"></script>
+</body>
+</html>
diff --git a/ps2xRuntime/web/web_platform.cpp b/ps2xRuntime/web/web_platform.cpp
new file mode 100644
index 0000000..ec5e29c
--- /dev/null
+++ b/ps2xRuntime/web/web_platform.cpp
@@ -0,0 +1,133 @@
+// Browser platform for the WebAssembly build, run at the start of main() (on a worker: the build
+// uses PROXY_TO_PTHREAD, so the page's main thread stays free for the GS host).
+//
+// Files (WasmFS):
+//   /game        fetch backend on <page>/data/: read on demand in 1 MB HTTP Range requests,
+//                so the 4.7 GB ISO is never downloaded whole, only the sectors the game reads
+//   /saves/mc0   OPFS (the browser's private file system): the memory card survives reloads
+// Environment: the GS host is the page (PS2X_GS_LIVE=1), no network yet.
+// Audio: the runtime's 48 kHz stereo stream goes into a ring buffer in the wasm memory, which an
+// AudioWorklet on the page reads directly (the memory is a SharedArrayBuffer).
+
+#include <emscripten.h>
+#include <emscripten/wasmfs.h>
+
+#include <atomic>
+#include <cerrno>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+// Opens a file the way the runtime will and reports what WasmFS answers (size, first bytes).
+static void ProbeFile(const char* path)
+{
+	const int fd = open(path, O_RDONLY);
+	if(fd < 0)
+	{
+		std::printf("[web] %s: open failed (%s)\n", path, std::strerror(errno));
+		return;
+	}
+	const off_t size = lseek(fd, 0, SEEK_END);
+	lseek(fd, 0, SEEK_SET);
+	unsigned char head[4] = {};
+	const ssize_t got = read(fd, head, sizeof(head));
+	std::printf("[web] %s: size %lld, read %d -> %02x %02x %02x %02x\n", path, static_cast<long long>(size),
+	            static_cast<int>(got), head[0], head[1], head[2], head[3]);
+	close(fd);
+}
