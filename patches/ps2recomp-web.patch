+// GS host for the browser build: the consumer side of the live ring (gs_dump_writer.cpp) running
+// on the page's main thread, drawing with the GS, VIF1/VU1 and GIF of the Play! emulator
+// (https://github.com/jpd002/Play-, BSD-2-Clause): GSH_OpenGL on WebGL2, VU1 on Play!'s
+// WebAssembly JIT.
+//
+// It does what pcsx2-gsrunner -live does with the same stream (GSDumpReplayer.cpp):
+//   header + privileged GS registers, then packets
+//   Transfer(path, data) -> GIF path 1/2/3      VSync(field) -> vblank, flip
+//   Registers(8 KB)      -> privileged regs     ReadFIFO2    -> local->host transfer
+//   0x10 VIF1 stream     -> VIF1 (UNPACK/MPG fill VU1, MSCAL runs it, XGKICK/DIRECT reach the GIF)
+//   0x11 VIF1 register   -> FBRST / ERR / MARK
+// It runs once per browser frame (requestAnimationFrame) and never blocks: whole packets only,
+// the rest waits for the next frame. The game side runs on workers and blocks on a full ring.
+// Keyboard and gamepad are read here and published through the ring header, like the Mac host.
+
+#include "../src/lib/gs/ps2_live_ring.h"
+
+#include <emscripten.h>
+#include <emscripten/html5.h>
+
+#include "BasicBlock.h"
+#include "FrameDump.h"
+#include "Jitter_CodeGen_Wasm.h"
+#include "MIPS.h"
+#include "MemoryUtils.h"
+#include "Ps2Const.h"
+#include "ee/DMAC.h"
+#include "ee/GIF.h"
+#include "ee/INTC.h"
+#include "ee/MA_VU.h"
+#include "ee/Vif.h"
+#include "ee/Vpu.h"
+#include "ee/VuExecutor.h"
+#include "gs/GSH_OpenGL/GSH_OpenGL.h"
+#include "gs/GsPixelFormats.h"
+#include "DefaultAppConfig.h" // CAppConfig::GetBasePath, defined once per Play! app
+
+#include <pthread.h>
+#include <unistd.h>
+
+#include <array>
+#include <map>
+#include <atomic>
+#include <cstdio>
+#include <cstring>
+#include <memory>
+#include <vector>
+
+extern "C" uint32 LWL_Proxy(uint32, uint32, CMIPS*);
+extern "C" uint32 LWR_Proxy(uint32, uint32, CMIPS*);
+extern "C" uint64 LDL_Proxy(uint32, uint64, CMIPS*);
+extern "C" uint64 LDR_Proxy(uint32, uint64, CMIPS*);
+extern "C" void SWL_Proxy(uint32, uint32, CMIPS*);
+extern "C" void SWR_Proxy(uint32, uint32, CMIPS*);
+extern "C" void SDL_Proxy(uint32, uint64, CMIPS*);
+extern "C" void SDR_Proxy(uint32, uint64, CMIPS*);
+
+namespace
+{
+	// PCSX2 GS dump packet types and the live extensions (gs_dump_writer.cpp).
+	constexpr uint8_t kTypeTransfer = 0;
+	constexpr uint8_t kTypeVSync = 1;
+	constexpr uint8_t kTypeReadFifo2 = 2;
+	constexpr uint8_t kTypeRegisters = 3;
+	constexpr uint8_t kTypeLiveVif1 = 0x10;
+	constexpr uint8_t kTypeLiveVif1Reg = 0x11;
+	constexpr uint8_t kPath2 = 1, kPath3 = 2, kPath1New = 3;
+	constexpr uint32_t kPrivRegsSize = 8192;
+
+	// Where VIF1 data is staged in the emulated EE RAM for CVif::ReceiveDMA (end of the 32 MB).
+	constexpr uint32_t kVifStageAddr = 0x01F00000;
+	constexpr uint32_t kVifStageSize = 0x00100000;
+
+	class CGSH_Web : public CGSH_OpenGL
+	{
+	public:
+		explicit CGSH_Web(EMSCRIPTEN_WEBGL_CONTEXT_HANDLE context)
+		    : CGSH_OpenGL(false) // not threaded: everything runs on the page's main thread
+		    , m_context(context)
+		{
+		}
+
+		// Runs the GS calls queued by the GIF / vblank (draws, flip) on this thread.
+		void Pump()
+		{
+			ProcessPendingCalls();
+		}
+
+	protected:
+		void InitializeImpl() override
+		{
+			emscripten_webgl_make_context_current(m_context);
+			CGSH_OpenGL::InitializeImpl();
+		}
+	public:
+		bool debug = false;
+		uint64_t regCounts[0x80] = {};
+		bool traceOn = false;
+		uint32_t traceVertexRun = 0, traceLines = 0, traceWb = 0;
+		std::map<uint64, uint64_t> regValues[0x80];
+
+	protected:
+		void WriteRegisterImpl(uint8 reg, uint64 value) override
+		{
+			if(!debug)
+			{
+				CGSH_OpenGL::WriteRegisterImpl(reg, value);
+				return;
+			}
+			regCounts[reg & 0x7F]++;
+			if(traceOn)
+			{
+				const bool vertex = reg == 0x01 || reg == 0x02 || reg == 0x03 || reg == 0x04 || reg == 0x05 || reg == 0x0C || reg == 0x0D;
+				if(vertex && traceVertexRun > 8)
+					traceVertexRun++;
+				else
+				{
+					if(!vertex && traceVertexRun > 8)
+						std::printf("[trace]   ... %u vertex writes\n", traceVertexRun - 8);
+					traceVertexRun = vertex ? traceVertexRun + 1 : 0;
+					if(traceLines++ < 4000)
+						std::printf("[trace] %02x %016llx%s\n", reg, (unsigned long long)value, m_framebufferWriteBacks != traceWb ? " (after write-back)" : "");
+					traceWb = m_framebufferWriteBacks;
+				}
+			}
+			if(reg == 0x06 || reg == 0x07 || reg == 0x4C || reg == 0x4D || reg == 0x4E || reg == 0x4F || reg == 0x00 || reg == 0x50 || reg == 0x52)
+				regValues[reg][value]++;
+			CGSH_OpenGL::WriteRegisterImpl(reg, value);
+		}
+		void PresentBackbuffer() override
+		{
+			// The browser presents the canvas when the animation frame returns.
+		}
+
+	private:
+		EMSCRIPTEN_WEBGL_CONTEXT_HANDLE m_context;
+	};
+
+	struct alignas(16) Host
+	{
+		ps2live::RingHeader* ring = nullptr;
+		uint8_t* ringData = nullptr;
+		uint64_t ringCapacity = 0;
+		bool headerDone = false;
+
+		uint8* ram = nullptr;
+		uint8* spr = nullptr;
+		uint8* vuMem0 = nullptr;
+		uint8* vuMem1 = nullptr;
+		uint8* microMem1 = nullptr;
+
+		CMIPS ee{MEMORYMAP_ENDIAN_LSBF, true};
+		CMIPS vu1{MEMORYMAP_ENDIAN_LSBF};
+		CMA_VU maVu1{PS2::VUMEM1SIZE - 1};
+		CINTC intc;
+		std::unique_ptr<CDMAC> dmac;
+		CGSHandler* gs = nullptr;
+		CGSH_Web* gsWeb = nullptr;
+		std::unique_ptr<CGIF> gif;
+		std::shared_ptr<CVpu> vpu1;
+
+		std::vector<uint8_t> packet;
+		std::vector<uint8_t> vifCarry; // VIF1 bytes not yet a whole quadword
+		std::vector<uint8_t> privRegs = std::vector<uint8_t>(kPrivRegsSize, 0);
+		uint64_t lastSmode2 = ~0ull;
+
+		uint32_t frames = 0;
+		double statsStart = 0.0;
+		// Debug counters (printed every 2 s from inside the packet loop).
+		uint64_t nVif = 0, nVifReg = 0, nXfer = 0, nVsync = 0, nRegs = 0, nFifo = 0;
+		double vuMs = 0.0, gsMs = 0.0, debugStart = 0.0;
+		uint64_t vuSlices = 0;
+		uint64_t drawCalls = 0;
+		uint64_t totalVsyncs = 0;
+		double vblankWaitMs = 0.0, idleMs = 0.0;
+		uint32 presentWidth = 0, presentHeight = 0;
+		uint64_t flips = 0;
+		Framework::CSignal<void()>::Connection flipConnection;
+		uint64_t pathBytes[4] = {};
+		uint64_t xgkicks = 0;
+		uint64_t vuStarts = 0;
+		std::map<uint32_t, uint64_t> vifRegWrites; // address -> count (last value in vifRegLast)
+		std::map<uint32_t, uint32_t> vifRegLast;
+		CVpu::VuStateChangedEvent::Connection vuStateConnection;
+		CGSHandler::NewFrameEvent::Connection newFrameConnection;
+	};
+
+	Host* g_host = nullptr;
+	EMSCRIPTEN_WEBGL_CONTEXT_HANDLE g_context = 0;
+
+	// --- input -----------------------------------------------------------------------------
+
+	// libpad bit order (active high in the ring): 0 SELECT 1 L3 2 R3 3 START 4 UP 5 RIGHT 6 DOWN
+	// 7 LEFT 8 L2 9 R2 10 L1 11 R1 12 TRIANGLE 13 CIRCLE 14 CROSS 15 SQUARE.
+	std::atomic<uint32_t> g_keyButtons{0};
+	std::atomic<uint32_t> g_keyStick{0}; // bit0 left, bit1 right, bit2 up, bit3 down
+
+	uint32_t KeyBit(const char* code, uint32_t* stick)
+	{
+		struct Map { const char* code; uint32_t bit; uint32_t stick; };
+		static const Map kMap[] = {
+			{"ArrowUp", 1u << 4, 0}, {"ArrowRight", 1u << 5, 0}, {"ArrowDown", 1u << 6, 0}, {"ArrowLeft", 1u << 7, 0},
+			{"KeyZ", 1u << 15, 0}, {"KeyX", 1u << 14, 0}, {"KeyC", 1u << 13, 0}, {"KeyV", 1u << 12, 0},
+			{"KeyQ", 1u << 10, 0}, {"KeyE", 1u << 11, 0}, {"Digit1", 1u << 8, 0}, {"Digit3", 1u << 9, 0},
+			{"Enter", 1u << 3, 0}, {"Backspace", 1u << 0, 0}, {"ShiftRight", 1u << 0, 0},
+			{"ControlLeft", 1u << 1, 0}, {"ControlRight", 1u << 1, 0},
+			{"KeyA", 0, 1}, {"KeyD", 0, 2}, {"KeyW", 0, 4}, {"KeyS", 0, 8},
+		};
+		for(const Map& m : kMap)
+		{
+			if(std::strcmp(code, m.code) == 0)
+			{
+				*stick = m.stick;
+				return m.bit;
+			}
+		}
+		*stick = 0;
+		return 0;
+	}
+
+	bool g_debug = false; // <page>?debug: GS statistics every 2 s, F8/F9 dumps
+	int g_traceState = 0; // F9: 1 = start at the next vsync, 2 = tracing this frame
+
+	EM_BOOL OnKey(int eventType, const EmscriptenKeyboardEvent* e, void*)
+	{
+		if(eventType == EMSCRIPTEN_EVENT_KEYDOWN && std::strcmp(e->code, "F9") == 0 && g_traceState == 0)
+			g_traceState = 1;
+		uint32_t stick = 0;
+		const uint32_t bit = KeyBit(e->code, &stick);
+		if(g_debug)
+			std::printf("[pad] %s %s -> bit %08x stick %x\n", eventType == EMSCRIPTEN_EVENT_KEYDOWN ? "down" : "up", e->code, bit, stick);
+		if(!bit && !stick)
+			return EM_FALSE;
+		if(eventType == EMSCRIPTEN_EVENT_KEYDOWN)
+		{
+			g_keyButtons |= bit;
+			g_keyStick |= stick;
+		}
+		else
+		{
+			g_keyButtons &= ~bit;
+			g_keyStick &= ~stick;
+		}
+		return EM_TRUE; // no page scrolling with the arrows
+	}
+
+	EM_BOOL OnBlur(int, const EmscriptenFocusEvent*, void*)
+	{
+		g_keyButtons = 0;
+		g_keyStick = 0;
+		return EM_FALSE;
+	}
+
+	uint32_t AxisByte(double value)
+	{
+		const int v = static_cast<int>(128.0 + value * 127.5);
+		return static_cast<uint32_t>(v < 0 ? 0 : (v > 255 ? 255 : v));
+	}
+
+	// Keyboard + first gamepad (W3C standard mapping) into the ring header.
+	void PublishPad(ps2live::RingHeader* ring)
+	{
+		uint32_t buttons = g_keyButtons.load();
+		const uint32_t stick = g_keyStick.load();
+		uint32_t lx = (stick & 1) ? 0x00 : ((stick & 2) ? 0xFF : 0x80);
+		uint32_t ly = (stick & 4) ? 0x00 : ((stick & 8) ? 0xFF : 0x80);
+		uint32_t rx = 0x80, ry = 0x80;
+
+		if(emscripten_sample_gamepad_data() == EMSCRIPTEN_RESULT_SUCCESS && emscripten_get_num_gamepads() > 0)
+		{
+			EmscriptenGamepadEvent pad;
+			for(int i = 0; i < emscripten_get_num_gamepads(); i++)
+			{
+				if(emscripten_get_gamepad_status(i, &pad) != EMSCRIPTEN_RESULT_SUCCESS || !pad.connected)
+					continue;
+				// "standard" mapping, and also controllers the browser couldn't map (Firefox on macOS,
+				// some third-party pads): they nearly always follow the same order.
+				if(pad.numButtons >= 4)
+				{
+					// Standard mapping: 0 A 1 B 2 X 3 Y 4 LB 5 RB 6 LT 7 RT 8 Back 9 Start
+					// 10 L3 11 R3 12 Up 13 Down 14 Left 15 Right.
+					static const int kBitForButton[16] = {14, 13, 15, 12, 10, 11, 8, 9, 0, 3, 1, 2, 4, 6, 7, 5};
+					for(int b = 0; b < 16 && b < pad.numButtons; b++)
+						if(pad.digitalButton[b])
+							buttons |= 1u << kBitForButton[b];
+					if(!stick && pad.numAxes >= 2)
+					{
+						lx = AxisByte(pad.axis[0]);
+						ly = AxisByte(pad.axis[1]);
+					}
+					if(pad.numAxes >= 4)
+					{
+						rx = AxisByte(pad.axis[2]);
+						ry = AxisByte(pad.axis[3]);
+					}
+				}
+				break;
+			}
+		}
+		ring->padButtons = buttons;
+		ring->padAxes = lx | (ly << 8) | (rx << 16) | (ry << 24);
+		ring->padSequence = ring->padSequence + 1;
+	}
+
+	// --- ring reading ------------------------------------------------------------------------
+
+	uint64_t Available(Host& h)
+	{
+		return static_cast<uint64_t>(h.ring->writePos - h.ring->readPos);
+	}
+
+	// Copies size bytes at offset `skip` past the read position, without consuming them.
+	void Peek(Host& h, uint64_t skip, void* dst, uint64_t size)
+	{
+		uint8_t* out = static_cast<uint8_t*>(dst);
+		uint64_t pos = static_cast<uint64_t>(h.ring->readPos) + skip;
+		while(size)
+		{
+			const uint64_t offset = pos % h.ringCapacity;
+			const uint64_t chunk = std::min(size, h.ringCapacity - offset);
+			std::memcpy(out, h.ringData + offset, chunk);
+			out += chunk;
+			pos += chunk;
+			size -= chunk;
+		}
+	}
+
+	void Consume(Host& h, uint64_t size)
+	{
+		__atomic_thread_fence(__ATOMIC_RELEASE);
+		h.ring->readPos = h.ring->readPos + static_cast<int64_t>(size);
+		__atomic_thread_fence(__ATOMIC_SEQ_CST); // readPos store before the producerWaiting load
+		if(h.ring->producerWaiting)
+			ps2live::eventSet(&ps2live::ringEvents(h.ring)->space);
+	}
+
+	template <typename T>
+	T PeekValue(Host& h, uint64_t skip)
+	{
+		T value;
+		Peek(h, skip, &value, sizeof(T));
+		return value;
+	}
+
+	// --- GS / VIF1 ---------------------------------------------------------------------------
+
+	// PS2MEM_GS layout (as PCSX2 dumps it) -> Play!'s privileged register writes (0x12000000 + offset).
+	void ApplyPrivRegisters(Host& h)
+	{
+		static const uint32_t kRegs[] = {0x00, 0x10, 0x20, 0x30, 0x40, 0x50, 0x60, 0x70, 0x80, 0x90, 0xA0, 0xB0, 0xC0, 0xD0, 0xE0, 0x1010};
+		for(uint32_t offset : kRegs)
+		{
+			uint64_t value;
+			std::memcpy(&value, h.privRegs.data() + offset, sizeof(value));
+			h.gs->WritePrivRegister(0x12000000 + offset, static_cast<uint32_t>(value));
+			h.gs->WritePrivRegister(0x12000000 + offset + 4, static_cast<uint32_t>(value >> 32));
+		}
+		{
+			// Display changes (PMODE, SMODE2, DISPFB1/2, DISPLAY1/2), for the "flashes" hunt
+			static uint64_t s_last[6] = {};
+			static int s_logged = 0;
+			static const uint32_t kShown[6] = {0x00, 0x20, 0x70, 0x80, 0x90, 0xA0};
+			for(int i = 0; i < 6; i++)
+			{
+				uint64_t value;
+				std::memcpy(&value, h.privRegs.data() + kShown[i], sizeof(value));
+				if(value != s_last[i] && s_logged < 400)
+				{
+					s_logged++;
+					std::printf("[display] vsync %llu reg %02x: %llx -> %llx\n", (unsigned long long)h.totalVsyncs, kShown[i],
+					            (unsigned long long)s_last[i], (unsigned long long)value);
+					s_last[i] = value;
+				}
+			}
+		}
+		uint64_t smode2;
+		std::memcpy(&smode2, h.privRegs.data() + 0x20, sizeof(smode2));
+		if(smode2 != h.lastSmode2)
+		{
+			h.lastSmode2 = smode2;
+			// NTSC (the game is SLUS); SMODE2: bit 0 INT (interlaced), bit 1 FFMD (frame mode).
+			h.gs->SetCrt((smode2 & 1) != 0, 2, (smode2 & 2) != 0);
+		}
+	}
+
+	void RunVu1(Host& h)
+	{
+		const double start = emscripten_get_now();
+		for(int i = 0; i < 100000 && h.vpu1->IsVuRunning(); i++)
+		{
+			h.vpu1->Execute(5000);
+			h.vuSlices++;
+		}
+		h.vuMs += emscripten_get_now() - start;
+	}
+
+	void DebugStats(Host& h)
+	{
+		const double now = emscripten_get_now();
+		if(now - h.debugStart < 2000.0)
+			return;
+		uint64_t pmode = 0, dispfb1 = 0, display1 = 0;
+		std::memcpy(&pmode, h.privRegs.data() + 0x00, 8);
+		std::memcpy(&dispfb1, h.privRegs.data() + 0x70, 8);
+		std::memcpy(&display1, h.privRegs.data() + 0x80, 8);
+		std::printf("[webgs] 2s: draws %llu, PMODE %llx DISPFB1 %llx DISPLAY1 %llx\n", (unsigned long long)h.drawCalls,
+		            (unsigned long long)pmode, (unsigned long long)dispfb1, (unsigned long long)display1);
+		h.drawCalls = 0;
+		{
+			// What is on screen: flips, GS RAM where DISPFB1 points, and the canvas centre.
+			const uint32_t fbp = static_cast<uint32_t>(dispfb1 & 0x1FF) * 8192u;
+			const uint8* gsRam = h.gs->GetRam();
+			uint64_t nonzero = 0, sum = 0;
+			for(uint32_t i = 0; i < 640u * 448u * 4u && fbp + i < 4u * 1024u * 1024u; i += 4)
+			{
+				const uint32_t v = gsRam[fbp + i] | (gsRam[fbp + i + 1] << 8) | (gsRam[fbp + i + 2] << 16);
+				nonzero += v != 0;
+				sum += v;
+			}
+			uint64_t ramNonzero = 0;
+			uint32_t firstNz = 0xFFFFFFFF, lastNz = 0;
+			for(uint32_t i = 0; i < 4u * 1024u * 1024u; i += 4)
+			{
+				if(*reinterpret_cast<const uint32_t*>(gsRam + i) != 0)
+				{
+					ramNonzero++;
+					if(firstNz == 0xFFFFFFFF)
+						firstNz = i;
+					lastNz = i;
+				}
+			}
+			const uint64* r = h.gs->GetRegisters();
+			std::printf("[webgs] 2s: gs ram nonzero words %llu [%x..%x], BITBLTBUF %llx TRXPOS %llx TRXREG %llx TRXDIR %llx\n",
+			            (unsigned long long)ramNonzero, firstNz, lastNz, (unsigned long long)r[0x50], (unsigned long long)r[0x51],
+			            (unsigned long long)r[0x52], (unsigned long long)r[0x53]);
+			uint8_t px[4] = {};
+			glBindFramebuffer(GL_FRAMEBUFFER, 0);
+			int cw = 0, ch = 0;
+			emscripten_get_canvas_element_size("#canvas", &cw, &ch);
+			glReadPixels(cw / 2, ch / 2, 1, 1, GL_RGBA, GL_UNSIGNED_BYTE, px);
+			std::printf("[webgs] 2s: flips %llu, gs ram @%x nonzero %llu sum %llx, canvas %dx%d centre %02x%02x%02x glerr %x\n",
+			            (unsigned long long)h.flips, fbp, (unsigned long long)nonzero, (unsigned long long)sum, cw, ch, px[0], px[1], px[2],
+			            glGetError());
+			h.flips = 0;
+		}
+		const uint64* gsRegs = h.gs->GetRegisters();
+		std::printf("[webgs] 2s: path1 %llu B (xgkick %llu) path2 %llu B path3 %llu B, GS PRIM %llx FRAME_1 %llx XYZ2 %llx\n",
+		            (unsigned long long)h.pathBytes[1], (unsigned long long)h.xgkicks, (unsigned long long)h.pathBytes[2],
+		            (unsigned long long)h.pathBytes[3], (unsigned long long)gsRegs[0x00], (unsigned long long)gsRegs[0x4C],
+		            (unsigned long long)gsRegs[0x05]);
+		h.pathBytes[1] = h.pathBytes[2] = h.pathBytes[3] = h.xgkicks = 0;
+		std::printf("[webgs] 2s: framebuffer write-backs %u, software sprites %u\n", h.gsWeb->m_framebufferWriteBacks, h.gsWeb->m_softwareSprites);
+		h.gsWeb->m_framebufferWriteBacks = 0;
+		h.gsWeb->m_softwareSprites = 0;
+		std::printf("[webgs] 2s: gs reg writes:");
+		for(int i = 0; i < 0x80; i++)
+		{
+			if(h.gsWeb->regCounts[i])
+				std::printf(" %02x:%llu", i, (unsigned long long)h.gsWeb->regCounts[i]);
+			h.gsWeb->regCounts[i] = 0;
+		}
+		std::printf("\n");
+		for(int reg : {0x00, 0x06, 0x07, 0x4C, 0x4D, 0x4E, 0x4F, 0x50, 0x52})
+		{
+			auto& values = h.gsWeb->regValues[reg];
+			std::printf("[webgs] 2s: reg %02x values (%zu):", reg, values.size());
+			int shown = 0;
+			for(const auto& [value, count] : values)
+				if(shown++ < 64)
+					std::printf(" %llx x%llu", (unsigned long long)value, (unsigned long long)count);
+			std::printf("\n");
+			values.clear();
+		}
+		std::printf("[webgs] 2s: vu starts %llu, VIF1 STAT %08x, reg writes:", (unsigned long long)h.vuStarts,
+		            h.vpu1->GetVif().GetRegister(0x10003C00));
+		for(const auto& [address, count] : h.vifRegWrites)
+			std::printf(" %08x x%llu (last %08x)", address, (unsigned long long)count, h.vifRegLast[address]);
+		std::printf("\n");
+		h.vuStarts = 0;
+		h.vifRegWrites.clear();
+		std::printf("[webgs] 2s: vif %llu (vu %.0f ms, %llu slices) vifreg %llu xfer %llu vsync %llu regs %llu fifo %llu gs %.0f ms, ring pending %lld KB, vu running %d\n",
+		            (unsigned long long)h.nVif, h.vuMs, (unsigned long long)h.vuSlices, (unsigned long long)h.nVifReg,
+		            (unsigned long long)h.nXfer, (unsigned long long)h.nVsync, (unsigned long long)h.nRegs,
+		            (unsigned long long)h.nFifo, h.gsMs, (long long)(Available(h) / 1024), h.vpu1->IsVuRunning() ? 1 : 0);
+		std::printf("[webgs] 2s: worker waited %.0f ms at vblanks, %.0f ms for data\n", h.vblankWaitMs, h.idleMs);
+		h.vblankWaitMs = h.idleMs = 0.0;
+		h.nVif = h.nVifReg = h.nXfer = h.nVsync = h.nRegs = h.nFifo = h.vuSlices = 0;
+		h.vuMs = h.gsMs = 0.0;
+		h.debugStart = now;
+	}
