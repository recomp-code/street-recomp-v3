+        r[v0] = sext8(bus.lbu(r[s1] + 7u));
+        r[a0] = r[s0];
+        r[v0] = bus.lbu(r[fp]);
+        n += 18u;
+        // 0x55814: start address / key state
+        r[a1] = bus.lw(r[s0]);
+        const bool same = r[a1] == bus.lw(r[s1]);
+        r[v0] = 0x007F0000u;
+        n += 5u;
+        if (!same)
+        {
+            r[v0] = r[a1] & 0x007FFFFFu;
+            bus.sw(r[sp] + 0x18u, r[v0]);
+            n += 4u;
+            if (r[v0] != 0u)
+            {
+                // 0x55838: ENVX
+                r[a0] = (r[s2] | 0x500u) & 0xFFFFu;
+                call(1, 0x00055844u, 4u);
+                const bool sounding = r[v0] != 0u;
+                r[a0] = r[s2] | 0x2040u;
+                n += 2u;
+                if (!sounding)
+                {
+                    // 0x5584C: new sample: SSA, LSA = 0x5000, ADSR 0x000F/0x0005, volumes; key on
+                    r[a1] = bus.lw(r[sp] + 0x18u);
+                    r[a0] &= 0xFFFFu;
+                    call(2, 0x00055858u, 4u);
+                    r[a0] = (r[s2] | 0x2140u) & 0xFFFFu;
+                    r[a1] = 0x5000u;
+                    call(2, 0x00055868u, 5u);
+                    r[a0] = (r[s2] | 0x300u) & 0xFFFFu;
+                    r[a1] = 0xFu;
+                    call(0, 0x00055878u, 5u);
