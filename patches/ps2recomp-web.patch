+struct V_VolumeSlide
+{
+	// Holds the "original" value of the volume for this voice, prior to slides.
+	// (ie, the volume as written to the register)
+
+	union
+	{
+		u16 Reg_VOL;
+		struct
+		{
+			u16 Step : 2;
+			u16 Shift : 5;
+			u16 : 5;
+			u16 Phase : 1;
+			u16 Decr : 1;
+			u16 Exp : 1;
+			u16 Enable : 1;
+		};
+	};
+
+	u32 Counter;
+	s32 Value;
+
+	// ps2recomp: Slide()'s values that depend only on the register (set with it: RegSet, constructor)
+	u32 RateCounterInc;
+	s32 RateLevelInc;
+	bool RateMinOne;
+
+public:
+	V_VolumeSlide() = default;
+	V_VolumeSlide(s16 regval, s32 fullvol)
+		: Reg_VOL(regval)
+		, Value(fullvol)
+	{
+		UpdateRate();
+	}
+
+	void UpdateRate();
+
+	// ps2recomp: the sweep is rare; testing Enable inline saves a call per voice and sample
+	__forceinline void Update()
+	{
+		if (Enable)
+			Slide();
+	}
+	void Slide();
+	void RegSet(u16 src); // used to set the volume from a register source
+
+#ifdef PCSX2_DEVBUILD
+	void DebugDump(FILE* dump, const char* title, const char* nameLR);
+#endif
+};
