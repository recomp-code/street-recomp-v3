+// web/disc_files.inc: the disc files the game opens through cdrom0: besides the raw ISO sectors
+// (found with PS2X_VFS_LOG=1), served under data/iso/.
+static const char* const kDiscFiles[] = {
+#include "disc_files.inc"
+};
+
+void ps2xWasmPlatformInit(int& argc, char**& argv)
+{
+	backend_t data = wasmfs_create_fetch_backend("data", 1u << 20);
+	int rc = wasmfs_create_directory("/game", 0777, data);
+	std::printf("[web] mkdir /game -> %d\n", rc);
+	rc = wasmfs_create_file("/game/NBAStreetV3.iso", 0444, data);
+	std::printf("[web] create /game/NBAStreetV3.iso -> %d\n", rc);
+	if(rc >= 0)
+		close(rc);
+	rc = mkdir("/game/iso", 0777); // a directory in the fetch backend: its files map to data/iso/
+	std::printf("[web] mkdir /game/iso -> %d\n", rc);
+	for(const char* name : kDiscFiles)
+	{
+		char path[256];
+		std::snprintf(path, sizeof(path), "/game/iso/%s", name);
+		rc = wasmfs_create_file(path, 0444, data);
+		std::printf("[web] create %s -> %d\n", path, rc);
+		if(rc >= 0)
+			close(rc);
+	}
+	ProbeFile("/game/iso/SLUS_211.26");
+	ProbeFile("/game/NBAStreetV3.iso");
+
+	backend_t opfs = wasmfs_create_opfs_backend();
+	wasmfs_create_directory("/saves", 0777, opfs);
+	mkdir("/saves/mc0", 0777);
+
+	setenv("PS2X_GS_LIVE", "1", 1);
+	// The page reads keyboard and gamepads and publishes them in the live ring; the raylib pad
+	// backend is headless here and would answer "no buttons" ahead of it.
+	setenv("PS2X_NO_GAMEPAD", "1", 1);
+	// <page>?debug: also what the game reads from the pad
+	if(MAIN_THREAD_EM_ASM_INT({ return new URLSearchParams(location.search).has('debug') ? 1 : 0; }))
+		setenv("PS2X_PAD_LOG", "1", 1);
+	setenv("PS2X_MC_ROOT", "/saves/mc0", 1);
+	setenv("PS2X_CD_IMAGE", "/game/NBAStreetV3.iso", 1);
+	chdir("/game/iso");
+
+	static char arg0[] = "ps2EntryRunner";
+	static char arg1[] = "/game/iso/SLUS_211.26";
+	static char* args[] = {arg0, arg1, nullptr};
+	argc = 2;
+	argv = args;
+	std::printf("[web] files: /game -> data/ (on demand), saves: OPFS\n");
+}
+
+namespace
+{
+	// Single producer (the game thread) and single consumer (the AudioWorklet), counted in frames.
+	constexpr uint32_t kAudioRingFrames = 16384; // ~340 ms
+	alignas(16) int16_t g_audioRing[kAudioRingFrames * 2];
+	alignas(8) std::atomic<uint32_t> g_audioIndex[2]; // [0] written, [1] read (by the worklet)
+}
+
+bool ps2xHostAudioInit()
+{
+	// The page owns the AudioContext (it may only start after a click or key press).
+	MAIN_THREAD_ASYNC_EM_ASM(
+	    {
+		    if(typeof ps2xStartAudio == 'function')
+			    ps2xStartAudio(HEAP16.buffer, $0, $1, $2);
+	    },
+	    g_audioRing, kAudioRingFrames, g_audioIndex);
+	return true;
+}
+
+bool ps2xHostAudioWantsFrames(int)
+{
+	return true; // ps2xHostAudioWrite drops what doesn't fit
+}
+
+void ps2xHostAudioWrite(const int16_t* samples, int frames)
+{
+	uint32_t write = g_audioIndex[0].load(std::memory_order_relaxed);
+	const uint32_t queued = write - g_audioIndex[1].load(std::memory_order_acquire);
+	if(queued + static_cast<uint32_t>(frames) > kAudioRingFrames - 256)
+		return; // the page isn't playing (no click yet) or fell far behind: drop
+	for(int i = 0; i < frames; i++, write++)
+	{
+		const uint32_t slot = (write % kAudioRingFrames) * 2;
+		g_audioRing[slot] = samples[i * 2];
+		g_audioRing[slot + 1] = samples[i * 2 + 1];
+	}
+	g_audioIndex[0].store(write, std::memory_order_release);
+}
