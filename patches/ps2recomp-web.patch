+	// Feeds whole quadwords of the game's VIF1 stream; a VIF waiting for the VU gets it run.
+	void FeedVif1(Host& h, const uint8_t* bytes, uint32_t size)
+	{
+		static int s_dumped = 0;
+		if(s_dumped < 12 && size >= 16)
+		{
+			s_dumped++;
+			uint32_t w[8] = {};
+			std::memcpy(w, bytes, std::min<uint32_t>(size, sizeof(w)));
+			std::printf("[webgs] vif1 #%d size %u carry %zu: %08x %08x %08x %08x %08x %08x %08x %08x\n", s_dumped, size,
+			            h.vifCarry.size(), w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7]);
+		}
+		h.vifCarry.insert(h.vifCarry.end(), bytes, bytes + size);
+		const uint32_t whole = static_cast<uint32_t>(h.vifCarry.size()) & ~15u;
+		CVif& vif = h.vpu1->GetVif();
+		uint32_t done = 0;
+		while(done < whole)
+		{
+			const uint32_t chunk = std::min(whole - done, kVifStageSize);
+			std::memcpy(h.ram + kVifStageAddr, h.vifCarry.data() + done, chunk);
+			const uint32_t qwc = chunk / 16;
+			uint32_t consumed = 0;
+			int stalls = 0;
+			while(consumed < qwc)
+			{
+				const uint32_t n = vif.ReceiveDMA(kVifStageAddr + consumed * 16, qwc - consumed, Dmac::CChannel::CHCR_DIR_FROM, false);
+				static int s_logged = 0;
+				if(s_logged < 12)
+				{
+					s_logged++;
+					std::printf("[webgs] ReceiveDMA qwc %u -> %u, VIF STAT %08x, vu running %d\n", qwc - consumed, n,
+					            vif.GetRegister(0x10003C00), h.vpu1->IsVuRunning() ? 1 : 0);
+				}
+				consumed += n;
+				if(n == 0)
+				{
+					if(!h.vpu1->IsVuRunning() || ++stalls > 64)
+					{
+						std::printf("[webgs] VIF1 stuck, dropping %u qwords\n", qwc - consumed);
+						consumed = qwc;
+						break;
+					}
+					RunVu1(h);
+				}
+			}
+			done += chunk;
+		}
+		h.vifCarry.erase(h.vifCarry.begin(), h.vifCarry.begin() + whole);
+		RunVu1(h); // MSCAL at the end of the chunk
+	}
+
+	void Transfer(Host& h, uint8_t path, const uint8_t* data, uint32_t size)
+	{
+		const unsigned pathIndex = path == kPath1New ? 1 : path == kPath2 ? 2 : path == kPath3 ? 3 : 0;
+		if(!pathIndex || !size)
+			return;
+		h.pathBytes[pathIndex] += size;
+		uint32_t done = 0;
+		int stalls = 0;
+		while(done < size)
+		{
+			const uint32_t n = h.gif->ProcessMultiplePackets(data, size, done, size, CGsPacketMetadata(pathIndex));
+			if(n == 0)
+			{
+				// Another path has the GIF: let the VU finish its XGKICK first.
+				RunVu1(h);
+				if(++stalls > 64)
+				{
+					std::printf("[webgs] GIF path %u busy, dropping %u bytes\n", pathIndex, size - done);
+					break;
+				}
+				continue;
+			}
+			done += n;
+		}
+	}
+
+	// Processes whole packets until a vsync (drawn) or the data runs out. True if a frame was drawn.
+	bool ProcessPackets(Host& h)
+	{
+		if(!h.headerDone)
+		{
+			if(Available(h) < 8)
+				return false;
+			const uint32_t crc = PeekValue<uint32_t>(h, 0);
+			const uint32_t headerSize = PeekValue<uint32_t>(h, 4);
+			uint64_t stateSize = headerSize;
+			uint64_t headerBytes = 0;
+			if(crc == 0xFFFFFFFFu)
+			{
+				headerBytes = headerSize;
+				if(Available(h) < 8 + headerBytes)
+					return false;
+				std::vector<uint8_t> header(headerBytes);
+				Peek(h, 8, header.data(), headerBytes);
+				uint32_t dumpStateSize = 0;
+				std::memcpy(&dumpStateSize, header.data() + 4, sizeof(dumpStateSize)); // GSDumpHeader.state_size
+				stateSize = dumpStateSize;
+			}
+			const uint64_t total = 8 + headerBytes + stateSize + kPrivRegsSize;
+			if(Available(h) < total)
+				return false;
+			Peek(h, 8 + headerBytes + stateSize, h.privRegs.data(), kPrivRegsSize);
+			Consume(h, total);
+			ApplyPrivRegisters(h);
+			h.headerDone = true;
+			std::printf("[webgs] live GS stream connected\n");
+		}
+
+		for(;;)
+		{
+			const uint64_t avail = Available(h);
+			if(avail < 1)
+				return false;
+			const uint8_t id = PeekValue<uint8_t>(h, 0);
+			switch(id)
+			{
+			case kTypeLiveVif1:
+			{
+				if(avail < 5)
+					return false;
+				const uint32_t length = PeekValue<uint32_t>(h, 1);
+				if(avail < 5ull + length)
+					return false;
+				h.packet.resize(length);
+				Peek(h, 5, h.packet.data(), length);
+				Consume(h, 5ull + length);
+				h.nVif++;
+				FeedVif1(h, h.packet.data(), length & ~3u);
+				break;
+			}
+			case kTypeLiveVif1Reg:
+			{
+				if(avail < 9)
+					return false;
+				const uint32_t address = PeekValue<uint32_t>(h, 1);
+				const uint32_t value = PeekValue<uint32_t>(h, 5);
+				Consume(h, 9);
+				h.nVifReg++;
+				h.vifRegWrites[address]++;
+				h.vifRegLast[address] = value;
+				h.vpu1->GetVif().SetRegister(address, value);
+				break;
+			}
+			case kTypeTransfer:
+			{
+				if(avail < 6)
+					return false;
+				const uint8_t path = PeekValue<uint8_t>(h, 1);
+				const uint32_t length = PeekValue<uint32_t>(h, 2);
+				if(avail < 6ull + length)
+					return false;
+				h.packet.resize(length);
+				Peek(h, 6, h.packet.data(), length);
+				Consume(h, 6ull + length);
+				h.nXfer++;
+				Transfer(h, path, h.packet.data(), length);
+				break;
+			}
+			case kTypeVSync:
+			{
+				if(avail < 2)
+					return false;
+				Consume(h, 2);
+				h.nVsync++;
+				h.totalVsyncs++;
+				if(g_traceState == 2)
+				{
+					h.gsWeb->traceOn = false;
+					g_traceState = 0;
+					std::printf("[trace] end\n");
+				}
+				else if(g_traceState == 1)
+				{
+					g_traceState = 2;
+					h.gsWeb->traceOn = true;
+					h.gsWeb->traceLines = 0;
+					std::printf("[trace] begin\n");
+				}
+				// Queues the frame's end and the flip for the page thread. With two frames already
+				// queued (Play!'s MAX_INFLIGHT_FRAMES) this waits: the picture never lags far behind.
+				const double waitStart = emscripten_get_now();
+				h.gs->SetVBlank();
+				h.gs->ResetVBlank();
+				h.vblankWaitMs += emscripten_get_now() - waitStart;
+				return true;
+			}
+			case kTypeReadFifo2:
+			{
+				if(avail < 5)
+					return false;
+				const uint32_t qwc = PeekValue<uint32_t>(h, 1);
+				Consume(h, 5);
+				h.nFifo++;
+				std::vector<uint8_t> discard((static_cast<size_t>(qwc) + 1) * 16);
+				h.gs->ReadImageData(discard.data(), qwc * 16);
+				h.gs->SendGSCall([]() {}, true, true); // the page thread has read it: the buffer can go
+				break;
+			}
+			case kTypeRegisters:
+			{
+				if(avail < 1 + kPrivRegsSize)
+					return false;
+				Peek(h, 1, h.privRegs.data(), kPrivRegsSize);
+				Consume(h, 1 + kPrivRegsSize);
+				h.nRegs++;
+				ApplyPrivRegisters(h);
+				break;
+			}
+			default:
+				std::printf("[webgs] unknown packet 0x%02X, stopping\n", id);
+				h.ring->consumerQuit = 1;
+				return false;
+			}
+		}
+	}
+
+	// Follows the canvas' size on the page (window resize, fullscreen): drawing buffer and GS
+	// presentation in device pixels.
+	void UpdatePresentation(Host& h)
+	{
+		const uint32 width = g_wantedWidth.load();
+		const uint32 height = g_wantedHeight.load();
+		if(width == 0 || height == 0 || (width == h.presentWidth && height == h.presentHeight))
+			return;
+		h.presentWidth = width;
+		h.presentHeight = height;
+		emscripten_set_canvas_element_size("#canvas", static_cast<int>(width), static_cast<int>(height));
+		CGSHandler::PRESENTATION_PARAMS presentation;
+		presentation.mode = CGSHandler::PRESENTATION_MODE_FIT;
+		presentation.windowWidth = width;
+		presentation.windowHeight = height;
+		h.gs->SetPresentationParams(presentation);
+	}
+
+	EM_BOOL OnAnimationFrame(double time, void*)
+	{
+		Host& h = *g_host;
+		UpdatePresentation(h);
+		// The GS calls the worker thread queued (draws, transfers, flips) run here, in the thread
+		// that owns the canvas (OffscreenCanvas); the last flip is what the page shows.
+		const double gsStart = emscripten_get_now();
+		// WebGL state cache, once: Play! sets the whole texture/buffer state for every draw (about
+		// 3000 WebGL calls per frame in a match). Each call goes to Chrome's GPU process, which
+		// on phones made this thread too slow for 60 fps. Calls that change nothing are dropped
+		// here, below all of Play!'s 58 places that touch the state, so none can disagree.
+		// It also counts the calls that remain (statistics).
+		EM_ASM({
+			if (self.ps2xGlWrapped || typeof GLctx === 'undefined' || !GLctx) return;
+			self.ps2xGlWrapped = true;
+			self.ps2xGlCalls = 0;
+			self.ps2xGlMs = 0;
+			self.ps2xGlSkipped = 0;
+			self.ps2xGlByName = {};
+			const gl = GLctx;
+			const raw = {};
+			const proto = Object.getPrototypeOf(gl);
+			for (const name of Object.getOwnPropertyNames(proto)) {
+				let original;
+				try { original = gl[name]; } catch (e) { continue; }
+				if (typeof original !== 'function' || name === 'constructor') continue;
+				raw[name] = original.bind(gl);
+			}
+			const counted = raw;
+			const skip = () => { self.ps2xGlSkipped++; };
+			let activeUnit = gl.TEXTURE0;
+			const boundTextures = new Map(); // unit -> texture (TEXTURE_2D)
+			const boundBuffers = new Map();  // target -> buffer
+			const boundBases = new Map();    // target:index -> buffer
+			let vertexArray = null;
+			let program = null;
+			let readFramebuffer = null;
+			let drawFramebuffer = null;
+			const enabled = new Map();
+			let viewport = '';
+			let scissor = '';
+			let colorMask = '';
+			let depthMask = null;
+			let blendFunc = '';
+			let blendEquation = '';
+			let depthFunc = null;
+			gl.activeTexture = function(unit) { if (unit === activeUnit) return skip(); activeUnit = unit; counted.activeTexture(unit); };
+			gl.bindTexture = function(target, texture) {
+				if (target === gl.TEXTURE_2D) {
+					if (boundTextures.get(activeUnit) === texture) return skip();
+					boundTextures.set(activeUnit, texture);
+				}
+				counted.bindTexture(target, texture);
+			};
+			gl.texParameteri = function(target, pname, value) {
+				const texture = target === gl.TEXTURE_2D ? boundTextures.get(activeUnit) : null;
+				if (texture) {
+					const params = texture.ps2xParams || (texture.ps2xParams = {});
+					if (params[pname] === value) return skip();
+					params[pname] = value;
+				}
+				counted.texParameteri(target, pname, value);
+			};
+			gl.bindBuffer = function(target, buffer) {
+				if (boundBuffers.get(target) === buffer) return skip();
+				boundBuffers.set(target, buffer);
+				counted.bindBuffer(target, buffer);
+			};
+			gl.bindBufferBase = function(target, index, buffer) {
+				// (It also binds the generic target; skipped, that one keeps its cached value.)
+				const key = target + ':' + index;
+				if (boundBases.get(key) === buffer) return skip();
+				boundBases.set(key, buffer);
+				boundBuffers.set(target, buffer);
+				counted.bindBufferBase(target, index, buffer);
+			};
+			// Shader parameter blocks re-sent unchanged: compared with the last upload
+			gl.bufferData = function(target, data, usage, offset, length) {
+				const buffer = boundBuffers.get(target);
+				if (target === gl.UNIFORM_BUFFER && buffer && data && data.buffer && typeof offset === 'number' && length > 0 && length <= 1024) {
+					const bytes = new Uint8Array(data.buffer, data.byteOffset + offset, length);
+					const last = buffer.ps2xLast;
+					if (last && last.length === length && usage === buffer.ps2xUsage) {
+						let same = true;
+						for (let i = 0; i < length; i++) if (last[i] !== bytes[i]) { same = false; break; }
+						if (same) return skip();
+					}
+					buffer.ps2xLast = bytes.slice();
+					buffer.ps2xUsage = usage;
+				} else if (buffer) {
+					buffer.ps2xLast = null;
+				}
+				return counted.bufferData.apply(null, arguments);
+			};
+			gl.bindBufferRange = function(target, index, buffer, offset, size) {
+				boundBases.delete(target + ':' + index);
+				boundBuffers.set(target, buffer);
+				counted.bindBufferRange(target, index, buffer, offset, size);
+			};
+			gl.bindVertexArray = function(vao) {
+				if (vao === vertexArray) return skip();
+				vertexArray = vao;
+				boundBuffers.delete(gl.ELEMENT_ARRAY_BUFFER);
+				counted.bindVertexArray(vao);
+			};
+			gl.useProgram = function(p) { if (p === program) return skip(); program = p; counted.useProgram(p); };
+			gl.bindFramebuffer = function(target, fb) {
+				if (target === gl.FRAMEBUFFER) {
+					if (fb === drawFramebuffer && fb === readFramebuffer) return skip();
+					drawFramebuffer = readFramebuffer = fb;
+				} else if (target === gl.DRAW_FRAMEBUFFER) {
+					if (fb === drawFramebuffer) return skip();
+					drawFramebuffer = fb;
+				} else if (target === gl.READ_FRAMEBUFFER) {
+					if (fb === readFramebuffer) return skip();
+					readFramebuffer = fb;
+				}
+				counted.bindFramebuffer(target, fb);
+			};
+			gl.enable = function(cap) { if (enabled.get(cap) === true) return skip(); enabled.set(cap, true); counted.enable(cap); };
+			gl.disable = function(cap) { if (enabled.get(cap) === false) return skip(); enabled.set(cap, false); counted.disable(cap); };
+			gl.viewport = function(x, y, w, h) { const k = x + ',' + y + ',' + w + ',' + h; if (k === viewport) return skip(); viewport = k; counted.viewport(x, y, w, h); };
+			gl.scissor = function(x, y, w, h) { const k = x + ',' + y + ',' + w + ',' + h; if (k === scissor) return skip(); scissor = k; counted.scissor(x, y, w, h); };
+			gl.colorMask = function(r, g, b, a) { const k = '' + r + g + b + a; if (k === colorMask) return skip(); colorMask = k; counted.colorMask(r, g, b, a); };
+			gl.depthMask = function(f) { if (f === depthMask) return skip(); depthMask = f; counted.depthMask(f); };
+			gl.depthFunc = function(f) { if (f === depthFunc) return skip(); depthFunc = f; counted.depthFunc(f); };
+			gl.blendFuncSeparate = function(a, b, c, d) { const k = a + ',' + b + ',' + c + ',' + d; if (k === blendFunc) return skip(); blendFunc = k; counted.blendFuncSeparate(a, b, c, d); };
+			gl.blendFunc = function(a, b) { blendFunc = ''; counted.blendFunc(a, b); };
+			gl.blendEquationSeparate = function(a, b) { const k = a + ',' + b; if (k === blendEquation) return skip(); blendEquation = k; counted.blendEquationSeparate(a, b); };
+			gl.blendEquation = function(a) { blendEquation = ''; counted.blendEquation(a); };
+			// Deleted objects leave the bindings (as GL does)
+			gl.deleteTexture = function(t) { for (const [u, b] of boundTextures) if (b === t) boundTextures.set(u, null); counted.deleteTexture(t); };
+			gl.deleteBuffer = function(b) {
+				for (const [k, v] of boundBuffers) if (v === b) boundBuffers.set(k, null);
+				for (const [k, v] of boundBases) if (v === b) boundBases.set(k, null);
+				counted.deleteBuffer(b);
+			};
+			gl.deleteFramebuffer = function(f) {
+				if (drawFramebuffer === f) drawFramebuffer = null;
+				if (readFramebuffer === f) readFramebuffer = null;
+				counted.deleteFramebuffer(f);
+			};
+			gl.deleteVertexArray = function(v) { if (vertexArray === v) vertexArray = null; counted.deleteVertexArray(v); };
+			gl.deleteProgram = function(p) { if (program === p) program = null; counted.deleteProgram(p); };
+			// Wrapped elsewhere in Emscripten's code paths: keep the cache right if anything
+			// saves and restores bindings with getParameter
+		});
+		h.gsWeb->Pump();
+		const double pumpMs = emscripten_get_now() - gsStart;
+		h.gsMs += pumpMs;
+		h.glMs += pumpMs;
+		h.glMaxMs = std::max(h.glMaxMs, pumpMs);
+		if(h.lastRaf != 0.0)
+			h.rafMaxMs = std::max(h.rafMaxMs, time - h.lastRaf);
+		h.lastRaf = time;
+		h.rafs++;
+		if(g_debug)
+			DebugStats(h);
+		if(h.statsStart == 0.0)
+			h.statsStart = time; // rAF time is page-relative; emscripten_get_now() is absolute with pthreads
+		if(time - h.statsStart >= 5000.0)
+		{
+			// Also where time goes on the GL thread (GPU-bound devices show it here)
+			auto& gs = *h.gsWeb;
+			std::printf("[webgs] %.1f game fps on screen (gl %.1f ms/frame, max %.0f ms, longest frame gap %.0f ms, fb copies %.0f/frame; "
+			            "shaders %u in %.0f ms (%u precompiled), read-backs %u in %.0f ms, texture uploads %u (%u unchanged, skipped), hd loaded %u)\n",
+			            h.frames * 1000.0 / (time - h.statsStart), h.rafs ? h.glMs / h.rafs : 0.0, h.glMaxMs, h.rafMaxMs,
+			            h.frames ? static_cast<double>(gs.m_dstCopies) / h.frames : 0.0, gs.m_shaderCompiles, gs.m_shaderCompileMs, gs.m_shadersPrecompiled,
+			            gs.m_framebufferWriteBacks, gs.m_writeBackMs, gs.m_textureUploads,
+			            gs.m_textureUploadsSkipped, gs.m_hdTexturesLoaded - h.hdLoadedBefore);
+			if(auto added = gs.TakeNewShaderCaps(); !added.empty())
+			{
+				// Remembered for the next session (precompiled then)
+				std::string list;
+				for(uint64_t caps : added)
+				{
+					char hex[20];
+					std::snprintf(hex, sizeof(hex), "%s%016llx", list.empty() ? "" : ",", static_cast<unsigned long long>(caps));
+					list += hex;
+				}
+				EM_ASM({
+					const added = UTF8ToString($0).split(',');
+					try
+					{
+						const open = indexedDB.open('ps2x', 1);
+						open.onupgradeneeded = () => open.result.createObjectStore('kv');
+						open.onsuccess = () => {
+							const store = open.result.transaction('kv', 'readwrite').objectStore('kv');
+							const get = store.get('shaders-v1');
+							get.onsuccess = () => {
+								const known = new Set((get.result || '').split(',').filter((c) => c.length == 16));
+								for(const c of added) known.add(c);
+								store.put([...known].slice(-1024).join(','), 'shaders-v1');
+							};
+						};
+					}
+					catch(e)
+					{
+					}
+				}, list.c_str());
+			}
+			gs.m_slowestBatchMs = 0.0;
+			for(double& slowest : gs.m_slowestMs)
+				slowest = 0.0;
+			h.hdLoadedBefore = gs.m_hdTexturesLoaded;
+			h.glMs = h.glMaxMs = h.rafMaxMs = 0.0;
+			h.rafs = 0;
+			gs.m_dstCopies = gs.m_shaderCompiles = gs.m_textureUploads = gs.m_textureUploadsSkipped = 0;
+			gs.m_shaderCompileMs = gs.m_writeBackMs = gs.m_textureUploadMs = 0.0;
+			if(!g_debug)
+				gs.m_framebufferWriteBacks = 0;
+			h.frames = 0;
+			h.statsStart = time;
+		}
+		return h.ring->producerAlive ? EM_TRUE : EM_FALSE;
+	}
+
+	void RegisterJitFunctions();
+
+	// DMAC/GIF/VIF1/VU1 for the worker thread: built there, because the VU1 JIT adds its code to
+	// the function table of the thread that compiles it (each WebAssembly thread has its own).
+	void SetupEmulation(Host* h)
+	{
+		h->dmac = std::make_unique<CDMAC>(h->ram, h->spr, h->vuMem0, h->vuMem1, h->ee);
+		h->gif = std::make_unique<CGIF>(h->gs, *h->dmac, h->ram, h->spr);
+		h->vpu1 = std::make_shared<CVpu>(1, CVpu::VPUINIT(h->microMem1, h->vuMem1, &h->vu1), *h->gif, h->intc, h->ram, h->spr);
+
+		// VU1 context, as Play!'s EE subsystem sets it up.
+		CMIPS& vu1 = h->vu1;
+		vu1.m_executor = std::make_unique<CVuExecutor>(vu1, PS2::MICROMEM1SIZE);
+		vu1.m_pMemoryMap->InsertReadMap(0x00000000, 0x00003FFF, h->vuMem1, 0x00);
+		vu1.m_pMemoryMap->InsertReadMap(0x00008000, 0x00008FFF, [h](uint32 address, uint32) -> uint32 {
+			if(address == CVpu::VU_ADDR_ITOP)
+				return h->vpu1->GetVif().GetITOP();
+			if(address == CVpu::VU_ADDR_TOP)
+				return h->vpu1->GetVif().GetTOP();
+			return 0xCCCCCCCC;
+		}, 0x01);
+		vu1.m_pMemoryMap->InsertWriteMap(0x00000000, 0x00003FFF, h->vuMem1, 0x00);
+		vu1.m_pMemoryMap->InsertWriteMap(0x00008000, 0x00008FFF, [h](uint32 address, uint32 value) -> uint32 {
+			if(address == CVpu::VU_ADDR_XGKICK)
+			{
+				h->xgkicks++;
+				h->vpu1->ProcessXgKick(value);
+			}
+			return 0;
+		}, 0x01);
+		vu1.m_pMemoryMap->InsertInstructionMap(0x00000000, 0x00003FFF, h->microMem1, 0x01);
+		vu1.m_pArch = &h->maVu1;
+		vu1.m_pAddrTranslator = CMIPS::TranslateAddress64;
+		vu1.m_vuMem = h->vuMem1;
+		h->vuStateConnection = h->vpu1->VuStateChanged.Connect([h](CVpu::VU_STATE state) {
+			if(state == CVpu::VU_STATE_RUNNING)
+				h->vuStarts++;
+		});
+		h->vpu1->Reset();
+	}
+
+	// Worker thread: the live stream, VIF1, VU1 (its JIT code lives in this thread's function
+	// table) and the GIF; everything for the GS goes to the page thread through Play!'s mailbox.
+	void* HostThread(void* arg)
+	{
+		Host& h = *static_cast<Host*>(arg);
+		RegisterJitFunctions();
+		SetupEmulation(&h);
+		for(;;)
+		{
+			bool drew = false;
+			for(int i = 0; i < 4 && ProcessPackets(h); i++)
+				drew = true;
+			if(!drew)
+			{
+				if(!h.ring->producerAlive && h.headerDone)
+					break;
+				const double sleepStart = emscripten_get_now();
+				usleep(300); // the game writes a frame every ~16 ms
+				h.idleMs += emscripten_get_now() - sleepStart;
+			}
+		}
+		return nullptr;
+	}
+
+	void RegisterJitFunctions()
+	{
+		using Jitter::CWasmFunctionRegistry;
+		CWasmFunctionRegistry::RegisterFunction(reinterpret_cast<uintptr_t>(&EmptyBlockHandler), "_EmptyBlockHandler", "vi");
+		CWasmFunctionRegistry::RegisterFunction(reinterpret_cast<uintptr_t>(&MemoryUtils_GetByteProxy), "_MemoryUtils_GetByteProxy", "iii");
+		CWasmFunctionRegistry::RegisterFunction(reinterpret_cast<uintptr_t>(&MemoryUtils_GetHalfProxy), "_MemoryUtils_GetHalfProxy", "iii");
+		CWasmFunctionRegistry::RegisterFunction(reinterpret_cast<uintptr_t>(&MemoryUtils_GetWordProxy), "_MemoryUtils_GetWordProxy", "iii");
+		CWasmFunctionRegistry::RegisterFunction(reinterpret_cast<uintptr_t>(&MemoryUtils_GetDoubleProxy), "_MemoryUtils_GetDoubleProxy", "jii");
+		CWasmFunctionRegistry::RegisterFunction(reinterpret_cast<uintptr_t>(&MemoryUtils_SetByteProxy), "_MemoryUtils_SetByteProxy", "viii");
+		CWasmFunctionRegistry::RegisterFunction(reinterpret_cast<uintptr_t>(&MemoryUtils_SetHalfProxy), "_MemoryUtils_SetHalfProxy", "viii");
+		CWasmFunctionRegistry::RegisterFunction(reinterpret_cast<uintptr_t>(&MemoryUtils_SetWordProxy), "_MemoryUtils_SetWordProxy", "viii");
+		CWasmFunctionRegistry::RegisterFunction(reinterpret_cast<uintptr_t>(&MemoryUtils_SetDoubleProxy), "_MemoryUtils_SetDoubleProxy", "viji");
+		CWasmFunctionRegistry::RegisterFunction(reinterpret_cast<uintptr_t>(&LWL_Proxy), "_LWL_Proxy", "iiii");
+		CWasmFunctionRegistry::RegisterFunction(reinterpret_cast<uintptr_t>(&LWR_Proxy), "_LWR_Proxy", "iiii");
+		CWasmFunctionRegistry::RegisterFunction(reinterpret_cast<uintptr_t>(&LDL_Proxy), "_LDL_Proxy", "jiji");
+		CWasmFunctionRegistry::RegisterFunction(reinterpret_cast<uintptr_t>(&LDR_Proxy), "_LDR_Proxy", "jiji");
+		CWasmFunctionRegistry::RegisterFunction(reinterpret_cast<uintptr_t>(&SWL_Proxy), "_SWL_Proxy", "viii");
+		CWasmFunctionRegistry::RegisterFunction(reinterpret_cast<uintptr_t>(&SWR_Proxy), "_SWR_Proxy", "viii");
+		CWasmFunctionRegistry::RegisterFunction(reinterpret_cast<uintptr_t>(&SDL_Proxy), "_SDL_Proxy", "viji");
+		CWasmFunctionRegistry::RegisterFunction(reinterpret_cast<uintptr_t>(&SDR_Proxy), "_SDR_Proxy", "viji");
+	}
+
+	// Main thread: builds the GS/VIF1/VU1/GIF and starts the frame loop.
+	// GL thread: owns the canvas (transferred as an OffscreenCanvas), the WebGL context and Play!'s
+	// GS; draws in its own requestAnimationFrame loop.
+	void* GlThread(void* arg)
+	{
+		auto* ring = static_cast<ps2live::RingHeader*>(arg);
+
+		EmscriptenWebGLContextAttributes attr;
+		emscripten_webgl_init_context_attributes(&attr);
+		attr.majorVersion = 2;
+		attr.minorVersion = 0;
+		attr.alpha = EM_FALSE;
+		attr.antialias = EM_FALSE;
+		// Not preserved: the browser swaps instead of copying the whole picture every frame (a
+		// heavy copy on phone GPUs). A frame with no flip draws nothing, so the last one stays.
+		attr.preserveDrawingBuffer = EM_FALSE;
+		attr.powerPreference = EM_WEBGL_POWER_PREFERENCE_HIGH_PERFORMANCE;
+		attr.proxyContextToMainThread = EMSCRIPTEN_WEBGL_CONTEXT_PROXY_DISALLOW;
+		g_context = emscripten_webgl_create_context("#canvas", &attr);
+		if(g_context <= 0)
+		{
+			std::printf("[webgs] WebGL2 is not available (%d)\n", static_cast<int>(g_context));
+			ring->consumerQuit = 1;
+			return nullptr;
+		}
+
+		Host* h = new Host();
+		h->ring = ring;
+		h->ringData = ps2live::ringData(ring);
+		h->ringCapacity = ring->capacity;
+		h->ram = static_cast<uint8*>(std::aligned_alloc(16, PS2::EE_RAM_SIZE));
+		h->spr = static_cast<uint8*>(std::aligned_alloc(16, PS2::EE_SPR_SIZE));
+		h->vuMem0 = static_cast<uint8*>(std::aligned_alloc(16, PS2::VUMEM0SIZE));
+		h->vuMem1 = static_cast<uint8*>(std::aligned_alloc(16, PS2::VUMEM1SIZE));
+		h->microMem1 = new uint8[PS2::MICROMEM1SIZE];
+		std::memset(h->ram, 0, PS2::EE_RAM_SIZE);
+		std::memset(h->vuMem1, 0, PS2::VUMEM1SIZE);
+		std::memset(h->microMem1, 0, PS2::MICROMEM1SIZE);
+
+		CGSH_OpenGL::RegisterPreferences();
+		CAppConfig::GetInstance().SetPreferenceInteger(PREF_CGSH_OPENGL_RESOLUTION_FACTOR, g_scale);
+		std::printf("[webgs] internal resolution x%d\n", g_scale);
+
+		h->gsWeb = new CGSH_Web(g_context);
+		h->gsWeb->debug = g_debug;
+		h->gs = h->gsWeb;
+		h->gs->SetIntc(&h->intc);
+
+		h->newFrameConnection = h->gs->OnNewFrame.Connect([h](uint32 drawCalls) {
+			h->drawCalls += drawCalls;
+			h->frames++; // a game frame finished on screen (runs on the page thread)
+		});
+		h->flipConnection = h->gs->OnFlipComplete.Connect([h]() { h->flips++; });
+		h->gs->Initialize();
+		h->gsWeb->Pump();
+		UpdatePresentation(*h);
+		h->gs->Reset();
+		h->gsWeb->Pump();
+		if(g_hd)
+			h->gsWeb->EnableHdTextures("data/hd");
+		h->gsWeb->SetHalfRateImage(g_halfRate);
+		h->gsWeb->SetFsr(g_fsr);
+		{
+			// Shaders built ahead of time: the game's known variants, then the ones this browser
+			// met in earlier sessions (IndexedDB). With KHR_parallel_shader_compile the driver
+			// builds them in the background; without it, one per frame.
+			const bool parallel = EM_ASM_INT({ return GLctx.getExtension('KHR_parallel_shader_compile') ? 1 : 0; }) != 0;
+			h->gsWeb->SetParallelShaderCompile(parallel);
+			static const uint64_t knownShaders[] = {
+#include "known_shaders.inc"
+			    0};
+			h->gsWeb->PrecompileShaders(knownShaders, std::size(knownShaders) - 1);
+			std::printf("[webgs] %zu known shaders queued (parallel compile %s)\n", std::size(knownShaders) - 1, parallel ? "yes" : "no");
+			EM_ASM({
+				try
+				{
+					const open = indexedDB.open('ps2x', 1);
+					open.onupgradeneeded = () => open.result.createObjectStore('kv');
+					open.onsuccess = () => {
+						const get = open.result.transaction('kv').objectStore('kv').get('shaders-v1');
+						get.onsuccess = () => {
+							if(get.result) _ps2xPrecompileShaderList(stringToNewUTF8(get.result));
+						};
+					};
+				}
+				catch(e)
+				{
+				}
+			});
+		}
+		std::printf("[webgs] picture at %d fps\n", g_halfRate ? 30 : 60);
+
+		ring->consumerAlive = 1;
+		ring->consumerFlags = 1; // never waits on the data event: no wake-ups needed
+		g_host = h;
+		h->statsStart = 0.0;
+		pthread_t thread;
+		pthread_create(&thread, nullptr, &HostThread, h);
+		pthread_detach(thread);
+		std::printf("[webgs] GS host started (Play! GS on WebGL2 in its own thread, VIF1/VU1/GIF in another)\n");
+		emscripten_request_animation_frame_loop(&OnAnimationFrame, nullptr);
+		emscripten_exit_with_live_runtime(); // back to this worker's event loop, which runs the frames
+		return nullptr;
+	}
+
+	// Page thread: only what needs the DOM: keyboard, gamepads and the canvas size.
+	EM_BOOL OnPageFrame(double, void*)
+	{
+		double cssWidth = 0.0, cssHeight = 0.0;
+		emscripten_get_element_css_size("#canvas", &cssWidth, &cssHeight);
+		const double ratio = emscripten_get_device_pixel_ratio();
+		g_wantedWidth.store(static_cast<uint32_t>(cssWidth * ratio + 0.5));
+		g_wantedHeight.store(static_cast<uint32_t>(cssHeight * ratio + 0.5));
+		PublishPad(g_ring);
+		return g_ring->producerAlive ? EM_TRUE : EM_FALSE;
+	}
+
+	void StartOnMainThread(void* arg)
+	{
+		g_ring = static_cast<ps2live::RingHeader*>(arg);
+		// Internal resolution: <page>?scale=N (1 = native PS2). Default 2, or 1 on phones, tablets
+		// and machines with few cores, where the GPU has less room.
+		g_scale = EM_ASM_INT({
+			const small = /Android|iPhone|iPad|Mobile/i.test(navigator.userAgent) || (navigator.hardwareConcurrency || 8) <= 4;
+			const fallback = small ? 1 : 2;
+			const value = parseInt(new URLSearchParams(location.search).get('scale') || String(fallback), 10);
+			return value >= 1 && value <= 4 ? value : fallback;
+		});
+		g_debug = EM_ASM_INT({ return new URLSearchParams(location.search).has('debug') ? 1 : 0; }) != 0;
+		g_hd = EM_ASM_INT({ return new URLSearchParams(location.search).get('hd') === '0' ? 0 : 1; }) != 0;
+		g_fsr = EM_ASM_INT({ return new URLSearchParams(location.search).get('fsr') === '0' ? 0 : 1; }) != 0;
+		g_halfRate = EM_ASM_INT({
+			const fps = new URLSearchParams(location.search).get('fps');
+			return fps === '30' ? 1 : 0;
+		}) != 0;
+		OnPageFrame(0.0, nullptr); // first size, before the GL thread starts
+
+		emscripten_set_keydown_callback(EMSCRIPTEN_EVENT_TARGET_WINDOW, nullptr, EM_TRUE, &OnKey);
+		emscripten_set_keyup_callback(EMSCRIPTEN_EVENT_TARGET_WINDOW, nullptr, EM_TRUE, &OnKey);
+		emscripten_set_blur_callback(EMSCRIPTEN_EVENT_TARGET_WINDOW, nullptr, EM_TRUE, &OnBlur);
+		emscripten_request_animation_frame_loop(&OnPageFrame, nullptr);
+
+		pthread_attr_t attr;
+		pthread_attr_init(&attr);
+		emscripten_pthread_attr_settransferredcanvases(&attr, "#canvas");
+		pthread_t thread;
+		const int error = pthread_create(&thread, &attr, &GlThread, g_ring);
+		pthread_attr_destroy(&attr);
+		if(error != 0)
+		{
+			std::printf("[webgs] could not give the canvas to a thread (%d)\n", error);
+			g_ring->consumerQuit = 1;
+			return;
+		}
+		pthread_detach(thread);
+	}
+} // namespace
+
+// Called by gs_dump_writer.cpp on the game's thread when PS2X_GS_LIVE=1.
+bool ps2xWebStartGsHost(ps2live::RingHeader* header)
+{
+	emscripten_async_run_in_main_runtime_thread(EM_FUNC_SIG_VI, &StartOnMainThread, header);
+	return true;
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE void ps2xPrecompileShaderList(char* list)
+{
+	std::vector<uint64_t> caps;
+	for(char* item = std::strtok(list, ","); item; item = std::strtok(nullptr, ","))
+		caps.push_back(std::strtoull(item, nullptr, 16));
+	std::free(list);
+	if(g_host && !caps.empty())
+	{
+		g_host->gsWeb->PrecompileShaders(caps.data(), caps.size());
+		std::printf("[webgs] %zu shaders from earlier sessions queued\n", caps.size());
+	}
+}
diff --git a/ps2xRuntime/web/raylib_headless.cpp b/ps2xRuntime/web/raylib_headless.cpp
new file mode 100644
index 0000000..ac06b4b
--- /dev/null
+++ b/ps2xRuntime/web/raylib_headless.cpp
@@ -0,0 +1,122 @@
+// Headless raylib for the WebAssembly build: the subset of raylib the runtime uses, with no
+// window or input (the page reads those), and audio handed to the platform. The main loop still runs at the target FPS
+// (EndDrawing paces it) and PS2X_WASM_SECONDS makes WindowShouldClose() end the run.
+
+#include "raylib.h"
+
+#include <chrono>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <thread>
+
+namespace
+{
+    using Clock = std::chrono::steady_clock;
+    int s_targetFps = 60;
+    Clock::time_point s_start = Clock::now();
+    Clock::time_point s_nextFrame = Clock::now();
+    double s_runSeconds = []
+    {
+        const char* value = std::getenv("PS2X_WASM_SECONDS");
+        return value && *value ? std::atof(value) : 0.0;
+    }();
+} // namespace
+
+void InitWindow(int, int, const char*) { s_start = s_nextFrame = Clock::now(); }
+void CloseWindow(void) {}
+void SetConfigFlags(unsigned int) {}
+bool IsWindowReady(void) { return false; } // no input backend: the pad code skips raylib
+bool WindowShouldClose(void)
+{
+    return s_runSeconds > 0.0 && std::chrono::duration<double>(Clock::now() - s_start).count() >= s_runSeconds;
+}
+void SetTargetFPS(int fps) { s_targetFps = fps > 0 ? fps : 60; }
+int GetScreenWidth(void) { return 640; }
+int GetScreenHeight(void) { return 448; }
+
+void BeginDrawing(void) {}
+void EndDrawing(void)
+{
+    s_nextFrame += std::chrono::microseconds(1000000 / s_targetFps);
+    const Clock::time_point now = Clock::now();
+    if (s_nextFrame < now)
+        s_nextFrame = now;
+    std::this_thread::sleep_until(s_nextFrame);
+}
+void ClearBackground(Color) {}
+void DrawTexturePro(Texture2D, Rectangle, Rectangle, Vector2, float, Color) {}
+
+Image GenImageColor(int width, int height, Color)
+{
+    Image image{};
+    image.width = width;
+    image.height = height;
+    image.mipmaps = 1;
+    image.format = PIXELFORMAT_UNCOMPRESSED_R8G8B8A8;
+    return image; // no pixel data: textures are never drawn
+}
+void UnloadImage(Image) {}
+Texture2D LoadTextureFromImage(Image image)
+{
+    Texture2D texture{};
+    texture.width = image.width;
+    texture.height = image.height;
+    texture.mipmaps = 1;
+    texture.format = image.format;
+    return texture;
+}
+void UpdateTexture(Texture2D, const void*) {}
+void UnloadTexture(Texture2D) {}
+
+bool IsKeyDown(int) { return false; }
+bool IsKeyPressed(int) { return false; }
+bool IsGamepadAvailable(int) { return false; }
+bool IsGamepadButtonDown(int, int) { return false; }
+float GetGamepadAxisMovement(int, int) { return 0.0f; }
+
+// Audio goes to the platform (web_platform.cpp: a ring buffer read by an AudioWorklet;
+// node_platform.cpp: none). Only the runtime's 48 kHz 16-bit stereo stream is supported.
+bool ps2xHostAudioInit();
+bool ps2xHostAudioWantsFrames(int frames);
+void ps2xHostAudioWrite(const int16_t* samples, int frames);
+
+namespace
+{
+    bool s_audioReady = false;
+}
+
+void InitAudioDevice(void) { s_audioReady = ps2xHostAudioInit(); }
+void CloseAudioDevice(void) { s_audioReady = false; }
+bool IsAudioDeviceReady(void) { return s_audioReady; }
+void SetAudioStreamBufferSizeDefault(int) {}
+AudioStream LoadAudioStream(unsigned int sampleRate, unsigned int sampleSize, unsigned int channels)
+{
+    AudioStream stream{};
+    stream.sampleRate = sampleRate;
+    stream.sampleSize = sampleSize;
+    stream.channels = channels;
+    return stream;
+}
+void UnloadAudioStream(AudioStream) {}
+void UpdateAudioStream(AudioStream, const void* data, int frames)
+{
+    ps2xHostAudioWrite(static_cast<const int16_t*>(data), frames);
+}
+void PlayAudioStream(AudioStream) {}
+bool IsAudioStreamProcessed(AudioStream) { return s_audioReady && ps2xHostAudioWantsFrames(1024); }
+bool IsAudioStreamValid(AudioStream stream)
+{
+    return s_audioReady && stream.sampleRate == 48000 && stream.sampleSize == 16 && stream.channels == 2;
+}
+void StopAudioStream(AudioStream) {}
+
+Wave LoadWaveFromMemory(const char*, const unsigned char*, int) { return Wave{}; }
+void UnloadWave(Wave) {}
+Sound LoadSoundFromWave(Wave) { return Sound{}; }
+void UnloadSound(Sound) {}
+void PlaySound(Sound) {}
+void StopSound(Sound) {}
+bool IsSoundPlaying(Sound) { return false; }
+void SetSoundVolume(Sound, float) {}
+void SetSoundPitch(Sound, float) {}
diff --git a/ps2xRuntime/web/site/index.html b/ps2xRuntime/web/site/index.html
new file mode 100644
index 0000000..9f04f73
--- /dev/null
+++ b/ps2xRuntime/web/site/index.html
@@ -0,0 +1,295 @@
+<!doctype html>
+<html lang="es">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>NBA Street V3</title>
+<style>
+  :root { color-scheme: dark; --bg: #0b0b0d; --fg: #e8e6e3; --dim: #8b8a88; --accent: #e8792b; }
+  * { box-sizing: border-box; }
+  html, body { margin: 0; height: 100%; background: var(--bg); color: var(--fg); font: 14px/1.4 system-ui, sans-serif; }
+  main { height: 100%; display: grid; grid-template-rows: 1fr auto; }
+  #stage { position: relative; display: grid; place-items: center; overflow: hidden; }
+  #canvas { width: min(100vw, calc((100vh - 40px) * 4 / 3)); aspect-ratio: 4 / 3; background: #000; outline: none; }
+  /* Fullscreen: the whole screen; the game keeps 4:3 inside (black bars) */
+  #stage:fullscreen { background: #000; }
+  #stage:fullscreen #canvas { width: 100vw; height: 100vh; aspect-ratio: auto; }
+  #status { position: absolute; inset: 0; display: grid; place-items: center; pointer-events: none; text-align: center; }
+  #status[hidden] { display: none; }
+  #status b { display: block; font-size: 18px; margin-bottom: 6px; }
+  #play { pointer-events: auto; margin-top: 18px; font: 600 16px system-ui, sans-serif; color: #111; background: var(--accent);
+          border: 0; border-radius: 6px; padding: 10px 28px; cursor: pointer; }
+  #settings { pointer-events: auto; margin: 16px auto 0; display: grid; grid-template-columns: auto auto; gap: 8px 12px;
+              align-items: center; text-align: left; font-size: 13px; color: var(--dim); width: max-content; max-width: calc(100vw - 32px); }
+  #settings select { font: 13px system-ui, sans-serif; color: var(--fg); background: #1a1a1d; border: 1px solid #333; border-radius: 4px; padding: 4px 6px; }
+  #bar { width: 260px; height: 4px; background: #222; border-radius: 2px; overflow: hidden; margin: 10px auto 0; }
+  #bar i { display: block; height: 100%; width: 0; background: var(--accent); transition: width .2s; }
+  footer { display: flex; gap: 16px; align-items: center; padding: 8px 16px; color: var(--dim); font-size: 12px; }
+  footer button { background: none; border: 1px solid #333; color: var(--fg); border-radius: 4px; padding: 3px 8px; cursor: pointer; }
+  #log { display: none; position: fixed; right: 0; bottom: 36px; width: min(640px, 100vw); height: 40vh; overflow: auto;
+         background: rgba(0,0,0,.85); color: #bdbdbd; font: 11px/1.35 ui-monospace, monospace; padding: 8px; white-space: pre-wrap; }
+  #log.open { display: block; }
+</style>
+</head>
+<body>
+<main>
+  <div id="stage">
+    <canvas id="canvas" tabindex="0" oncontextmenu="event.preventDefault()"></canvas>
+    <div id="status"><div><b id="statusTitle">Cargando…</b><span id="statusText">Descargando el juego (solo la primera vez)</span><div id="bar"><i></i></div>
+      <button id="play">▶ Jugar</button>
+      <div id="settings">
+        <label for="optScale">Resolución</label>
+        <select id="optScale">
+          <option value="auto">Automática</option>
+          <option value="1">1x · nativa PS2 (más rápida)</option>
+          <option value="2">2x · 1280×896</option>
+          <option value="3">3x · 1920×1344</option>
+          <option value="4">4x · 2560×1792</option>
+        </select>
+        <label for="optFsr">Escalado</label>
+        <select id="optFsr">
+          <option value="1">FSR 1 (más nítido)</option>
+          <option value="0">Normal (bilineal)</option>
+        </select>
+        <label for="optFps">Imagen</label>
+        <select id="optFps">
+          <option value="auto">60 fps</option>
+          <option value="30">30 fps (menos trabajo gráfico; el juego sigue a 60)</option>
+        </select>
+        <label for="optHd">Texturas HD</label>
+        <select id="optHd"><option value="1">Sí</option><option value="0">No (menos memoria y datos)</option></select>
+        <label for="optAudio">Sonido</label>
+        <select id="optAudio">
+          <option value="auto">Automático</option>
+          <option value="stable">Estable (más búfer, para teléfonos)</option>
+          <option value="normal">Normal</option>
+          <option value="low">Baja latencia (PC rápido)</option>
+        </select>
+        <label for="optOnline">Online</label>
+        <select id="optOnline"><option value="1">Sí</option><option value="0">No</option></select>
+      </div></div></div>
+  </div>
+  <footer>
+    <span>Flechas/WASD · Z X C V · Q E 1 3 · Enter = START · mando compatible</span>
+    <span id="fps"></span>
+    <button id="sound" hidden>Activar sonido</button>
+    <span style="flex:1"></span>
+    <button id="full">Pantalla completa</button>
+    <button id="diagBtn">Enviar diagnóstico</button>
+    <button id="logBtn">Log</button>
+  </footer>
+</main>
+<pre id="log"></pre>
+<script>
+  const log = document.getElementById('log');
+  const statusBox = document.getElementById('status');
+  const statusTitle = document.getElementById('statusTitle');
+  const statusText = document.getElementById('statusText');
+  const bar = document.querySelector('#bar i');
+  const fps = document.getElementById('fps');
+  const lines = [];
+  const maxLines = new URLSearchParams(location.search).has('debug') ? 400000 : 2000;
+  function append(text) {
+    text = text.replace(/\[MC\][^\[]*/g, ''); // memory card chatter (several lines per frame)
+    if (!text.trim()) return;
+    lines.push(text);
+    if (lines.length > maxLines) lines.splice(0, maxLines / 4);
+    if (log.classList.contains('open')) { log.textContent = lines.join('\n'); log.scrollTop = log.scrollHeight; }
+    const m = /\[webgs\] ([\d.]+) game fps/.exec(text);
+    if (m) fps.textContent = m[1] + ' fps';
+    if (text.includes('[webgs] live GS stream connected')) statusBox.hidden = true;
+  }
+  // Sends this session's statistics (frame times, sound, disc waits) and the device's details to
+  // the server, only when the player presses the button, to find what slows a given device down.
+  const diagBtn = document.getElementById('diagBtn');
+  diagBtn.onclick = async () => {
+    let gpu = '?';
+    try {
+      const gl = document.createElement('canvas').getContext('webgl2');
+      const info = gl.getExtension('WEBGL_debug_renderer_info');
+      gpu = info ? gl.getParameter(info.UNMASKED_RENDERER_WEBGL) : gl.getParameter(gl.RENDERER);
+    } catch (e) {}
+    const report = [
+      'url: ' + location.href, 'agent: ' + navigator.userAgent, 'gpu: ' + gpu,
+      `cores: ${navigator.hardwareConcurrency} memory: ${navigator.deviceMemory || '?'} GB screen: ${screen.width}x${screen.height} @${devicePixelRatio}`,
+      'audio: ' + (typeof audioContext !== 'undefined' && audioContext ? `${audioContext.state} base latency ${audioContext.baseLatency} output latency ${audioContext.outputLatency}` : 'none'),
+      '', ...lines.slice(-3000)].join('\n');
+    diagBtn.disabled = true; diagBtn.textContent = 'Enviando…';
+    try {
+      const response = await fetch('diag', { method: 'POST', body: report });
+      diagBtn.textContent = response.ok ? 'Enviado ✓' : 'Error al enviar';
+    } catch (e) { diagBtn.textContent = 'Error al enviar'; }
+    setTimeout(() => { diagBtn.disabled = false; diagBtn.textContent = 'Enviar diagnóstico'; }, 4000);
+  };
+  document.getElementById('logBtn').onclick = () => { log.classList.toggle('open'); log.textContent = lines.join('\n'); };
+  document.getElementById('full').onclick = () => document.getElementById('stage').requestFullscreen?.();
+  if (!crossOriginIsolated) {
+    statusTitle.textContent = 'El navegador no permite hilos aquí';
+    statusText.textContent = 'La página necesita las cabeceras COOP/COEP del servidor.';
+  }
+  let audioContext = null;
+  const isMobile = /Android|iPhone|iPad|Mobile/i.test(navigator.userAgent);
+  var Module = {
+    canvas: document.getElementById('canvas'),
+    print: append,
+    printErr: append,
+    setStatus: (text) => {
+      const m = /\((\d+(\.\d+)?)\/(\d+)\)/.exec(text);
+      if (m) bar.style.width = (100 * m[1] / m[3]).toFixed(1) + '%';
+    },
+    onAbort: (what) => { statusBox.hidden = false; statusTitle.textContent = 'Se detuvo'; statusText.textContent = String(what); },
+    monitorRunDependencies: (left) => { if (!left) { statusText.textContent = 'Arrancando el juego…'; bar.style.width = '100%'; } },
+    // The game starts on the "Jugar" click: browsers only allow sound after one, and this way the
+    // sound is there from the first video. The download goes on meanwhile.
+    preRun: [() => Module.addRunDependency('play-click')],
+  };
+  // Settings on the start screen: kept in this browser, handed to the game as page parameters
+  // (?scale, ?fsr, ?hd, ?audio, ?online), which a link can also set.
+  const settingNames = { scale: 'optScale', fsr: 'optFsr', fps: 'optFps', hd: 'optHd', audio: 'optAudio', online: 'optOnline' };
+  const saved = (() => { try { return JSON.parse(localStorage.getItem('ps2x-settings') || '{}'); } catch (e) { return {}; } })();
+  const params = new URLSearchParams(location.search);
+  for (const [name, id] of Object.entries(settingNames)) {
+    const value = params.get(name) ?? saved[name];
+    const select = document.getElementById(id);
+    if (value !== undefined && [...select.options].some((o) => o.value === value)) select.value = value;
+  }
+  function applySettings() {
+    const chosen = {};
+    for (const [name, id] of Object.entries(settingNames)) {
+      chosen[name] = document.getElementById(id).value;
+      if (chosen[name] === 'auto') params.delete(name); else params.set(name, chosen[name]);
+    }
+    try { localStorage.setItem('ps2x-settings', JSON.stringify(chosen)); } catch (e) {}
+    history.replaceState(null, '', location.pathname + (params.toString() ? '?' + params : ''));
+  }
+  const audioMode = () => { const m = new URLSearchParams(location.search).get('audio'); return m && m !== 'auto' ? m : (isMobile ? 'stable' : 'normal'); };
+  const playButton = document.getElementById('play');
+  playButton.onclick = () => {
+    applySettings();
+    document.getElementById('settings').remove();
+    playButton.remove();
+    // Stable sound (phones): larger output buffers ('playback'), fewer glitches when the CPU is busy
+    audioContext = new AudioContext({ sampleRate: 48000, latencyHint: audioMode() === 'stable' ? 'playback' : 'interactive' });
+    audioContext.resume();
+    document.getElementById('canvas').focus();
+    Module.removeRunDependency('play-click');
+  };
+  document.getElementById('canvas').focus();
+
+  // Sound: the game writes 48 kHz stereo into a ring buffer in its (shared) memory and this
+  // worklet plays it from there. Browsers only start audio after a click or a key press.
+  const audioWorklet = `
+    class Ps2xOutput extends AudioWorkletProcessor {
+      constructor(options) {
+        super();
+        const o = options.processorOptions;
+        this.ring = new Int16Array(o.buffer, o.ring, o.frames * 2);
+        this.index = new Uint32Array(o.buffer, o.index, 2);
+        this.frames = o.frames;
+        this.waiting = true;
+        this.lastL = this.lastR = 0;
+        this.fadeLeft = 0; this.fadeFrom = 0; this.fadeIn = 128;
+        this.underruns = this.skips = this.blocks = 0;
+        this.frac = 0;
+        // Frames kept queued: ~50 ms (phones ~100 ms), growing after each underrun up to 150 ms
+        // (phones 200 ms), whose threads get descheduled more often
+        // [starting target, largest target] in frames (48 kHz); stable rides out ~1/3 s hiccups
+        const sizes = { low: [1600, 4800], normal: [2400, 7200], stable: [6000, 16000] }[o.mode] || [2400, 7200];
+        this.target = sizes[0];
+        this.maxTarget = sizes[1];
+        this.level = this.target;
+        this.capture = null;
+        this.port.onmessage = (e) => { if (e.data === 'capture') this.capture = []; };
+      }
+      // No allocations in here: the audio thread must never wait for the garbage collector
+      // (on phones its pauses were heard as glitches).
+      left16(pos) { return this.ring[(pos % this.frames) * 2] * (1 / 32768); }
+      right16(pos) { return this.ring[(pos % this.frames) * 2 + 1] * (1 / 32768); }
+      process(inputs, outputs) {
+        const left = outputs[0][0], right = outputs[0][1];
+        const written = Atomics.load(this.index, 0);
+        let read = Atomics.load(this.index, 1);
+        let queued = (written - read) >>> 0;
+        // Far too much queued (the game caught up after a stall): jump ahead, cross-fading from the
+        // old position over 128 samples (a speed-up would be heard as faster, higher sound)
+        if (queued > Math.min(this.frames - 2048, this.target * 2.5)) {
+          this.fadeFrom = read; this.fadeLeft = 128;
+          read = (written - this.target) >>> 0; queued = this.target; this.level = queued; this.skips++;
+        }
+        // Back from a gap as soon as some sound is queued (it fades in), not after a long silence
+        if (this.waiting && queued >= this.target * 0.4) { this.waiting = false; this.fadeIn = 0; }
+        if (!this.waiting && queued < left.length + 2) {
+          // Ran dry: keep a bit more sound queued from now on
+          this.waiting = true; this.underruns++;
+          this.target = Math.min(this.target + 600, this.maxTarget);
+        }
+        // The game's clock and the sound card's differ (the game makes ~48-49 kHz): play slightly
+        // faster or slower, at most 3% (not heard), to keep the target queued
+        this.level += (queued - this.level) * 0.01;
+        const step = 1 + Math.max(-0.03, Math.min(0.03, (this.level - this.target) / this.target * 0.04));
+        for (let i = 0; i < left.length; i++) {
+          if (!this.waiting && ((written - read) >>> 0) > 1) {
+            const next = (read + 1) >>> 0;
+            const l0 = this.left16(read), r0 = this.right16(read);
+            let outL = l0 + (this.left16(next) - l0) * this.frac;
+            let outR = r0 + (this.right16(next) - r0) * this.frac;
+            if (this.fadeLeft > 0) { // cross-fade from where it was before a jump
+              const k = this.fadeLeft / 128;
+              outL = outL * (1 - k) + this.left16(this.fadeFrom) * k;
+              outR = outR * (1 - k) + this.right16(this.fadeFrom) * k;
+              this.fadeFrom = (this.fadeFrom + 1) >>> 0; this.fadeLeft--;
+            }
+            if (this.fadeIn < 128) { // back from a gap: fade in instead of a click
+              const g = ++this.fadeIn / 128;
+              outL = this.lastL + (outL - this.lastL) * g; outR = this.lastR + (outR - this.lastR) * g;
+            }
+            this.lastL = outL;
+            this.lastR = outR;
+            this.frac += step;
+            const whole = Math.floor(this.frac);
+            this.frac -= whole;
+            read = (read + whole) >>> 0;
+          } else {
+            this.lastL *= 0.995; this.lastR *= 0.995;
+          }
+          left[i] = this.lastL;
+          right[i] = this.lastR;
+          if (this.capture && !this.waiting) { this.capture.push(this.lastL); if (this.capture.length >= 48000 * 8) { this.port.postMessage({ capture: this.capture }); this.capture = null; } }
+        }
+        Atomics.store(this.index, 1, read);
+        if (++this.blocks % 1500 === 0) {
+          const produced = ((written - (this.lastWritten ?? written)) >>> 0) / (currentTime - (this.lastTime ?? currentTime) || 1);
+          this.lastWritten = written; this.lastTime = currentTime;
+          this.port.postMessage({ underruns: this.underruns, skips: this.skips, queued, step, produced, target: this.target });
+        }
+        return true;
+      }
+    }
+    registerProcessor('ps2x-output', Ps2xOutput);`;
+  async function ps2xStartAudio(buffer, ring, frames, index) {
+    audioContext ??= new AudioContext({ sampleRate: 48000, latencyHint: audioMode() === 'stable' ? 'playback' : 'interactive' });
+    const url = URL.createObjectURL(new Blob([audioWorklet], { type: 'text/javascript' }));
+    await audioContext.audioWorklet.addModule(url);
+    const node = new AudioWorkletNode(audioContext, 'ps2x-output', {
+      numberOfInputs: 0, outputChannelCount: [2],
+      processorOptions: { buffer, ring, frames, index, mode: audioMode() },
+    });
+    node.connect(audioContext.destination);
+    node.port.onmessage = (e) => {
+      if (e.data.capture) { window.ps2xAudioCapture = e.data.capture; return; }
+      append(`[audio] underruns ${e.data.underruns}, skips ${e.data.skips}, queued ${e.data.queued}, rate ${e.data.step.toFixed(4)}, target ${e.data.target}, game makes ${e.data.produced.toFixed(0)} Hz`);
+    };
+    window.ps2xAudioNode = node;
+    if (audioContext.state !== 'running') sound.hidden = false;
+  }
+  const sound = document.getElementById('sound');
+  function resumeAudio() {
+    if (audioContext && audioContext.state !== 'running') audioContext.resume().then(() => { sound.hidden = true; });
+  }
+  for (const type of ['pointerdown', 'keydown']) window.addEventListener(type, resumeAudio, { capture: true });
+  window.addEventListener('gamepadconnected', resumeAudio);
+  sound.onclick = resumeAudio;
+</script>
+<script src="ps2EntryRunner.js"></script>
+</body>
+</html>
diff --git a/ps2xRuntime/web/web_platform.cpp b/ps2xRuntime/web/web_platform.cpp
new file mode 100644
index 0000000..5d7c3b0
--- /dev/null
+++ b/ps2xRuntime/web/web_platform.cpp
@@ -0,0 +1,195 @@
+// Browser platform for the WebAssembly build, run at the start of main() (on a worker: the build
+// uses PROXY_TO_PTHREAD, so the page's main thread stays free for the GS host).
+//
+// Files (WasmFS):
+//   /game        fetch backend on <page>/data/: read on demand in 1 MB HTTP Range requests,
+//                so the 4.7 GB ISO is never downloaded whole, only the sectors the game reads
+//   /saves/mc0   OPFS (the browser's private file system): the memory card survives reloads;
+//                the network configuration (BWNETCNF) comes from data/mc0/ the first time
+// Environment: the GS host is the page (PS2X_GS_LIVE=1); online through the page's /net relay.
+// Audio: the runtime's 48 kHz stereo stream goes into a ring buffer in the wasm memory, which an
+// AudioWorklet on the page reads directly (the memory is a SharedArrayBuffer).
+
+#include <emscripten.h>
+#include <emscripten/wasmfs.h>
+
+#include <atomic>
+#include <cerrno>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+// Opens a file the way the runtime will and reports what WasmFS answers (size, first bytes).
+static void ProbeFile(const char* path)
+{
+	const int fd = open(path, O_RDONLY);
+	if(fd < 0)
+	{
+		std::printf("[web] %s: open failed (%s)\n", path, std::strerror(errno));
+		return;
+	}
+	const off_t size = lseek(fd, 0, SEEK_END);
+	lseek(fd, 0, SEEK_SET);
+	unsigned char head[4] = {};
+	const ssize_t got = read(fd, head, sizeof(head));
+	std::printf("[web] %s: size %lld, read %d -> %02x %02x %02x %02x\n", path, static_cast<long long>(size),
+	            static_cast<int>(got), head[0], head[1], head[2], head[3]);
+	close(fd);
+}
+
+// Copies a file from data/ onto the memory card unless it is there already.
+static void SeedSaveFile(const char* from, const char* to)
+{
+	struct stat st;
+	if(stat(to, &st) == 0)
+		return;
+	const int in = open(from, O_RDONLY);
+	if(in < 0)
+		return;
+	const int out = open(to, O_WRONLY | O_CREAT | O_TRUNC, 0666);
+	char buffer[4096];
+	ssize_t got;
+	while(out >= 0 && (got = read(in, buffer, sizeof(buffer))) > 0)
+		write(out, buffer, static_cast<size_t>(got));
+	std::printf("[web] memory card: %s %s\n", to, out >= 0 ? "added" : "failed");
+	if(out >= 0)
+		close(out);
+	close(in);
+}
+
+// web/disc_files.inc: the disc files the game opens through cdrom0: besides the raw ISO sectors
+// (found with PS2X_VFS_LOG=1), served under data/iso/.
+static const char* const kDiscFiles[] = {
+#include "disc_files.inc"
+};
+
+void ps2xWasmPlatformInit(int& argc, char**& argv)
+{
+	backend_t data = wasmfs_create_fetch_backend("data", 1u << 20);
+	int rc = wasmfs_create_directory("/game", 0777, data);
+	std::printf("[web] mkdir /game -> %d\n", rc);
+	rc = wasmfs_create_file("/game/NBAStreetV3.iso", 0444, data);
+	std::printf("[web] create /game/NBAStreetV3.iso -> %d\n", rc);
+	if(rc >= 0)
+		close(rc);
+	rc = mkdir("/game/iso", 0777); // a directory in the fetch backend: its files map to data/iso/
+	std::printf("[web] mkdir /game/iso -> %d\n", rc);
+	for(const char* name : kDiscFiles)
+	{
+		char path[256];
+		std::snprintf(path, sizeof(path), "/game/iso/%s", name);
+		rc = wasmfs_create_file(path, 0444, data);
+		std::printf("[web] create %s -> %d\n", path, rc);
+		if(rc >= 0)
+			close(rc);
+	}
+	ProbeFile("/game/iso/SLUS_211.26");
+	ProbeFile("/game/NBAStreetV3.iso");
+
+	backend_t opfs = wasmfs_create_opfs_backend();
+	wasmfs_create_directory("/saves", 0777, opfs);
+	mkdir("/saves/mc0", 0777);
+	// The network configuration the online menu asks for ("Your Network Configuration file").
+	static const char* const kNetConfig[] = {"BWNETCNF", "dev000.dat", "ifc000.dat", "net000.cnf"};
+	mkdir("/game/mc0", 0777);
+	mkdir("/game/mc0/BWNETCNF", 0777);
+	mkdir("/saves/mc0/BWNETCNF", 0777);
+	for(const char* name : kNetConfig)
+	{
+		char from[96], to[96];
+		std::snprintf(from, sizeof(from), "/game/mc0/BWNETCNF/%s", name);
+		std::snprintf(to, sizeof(to), "/saves/mc0/BWNETCNF/%s", name);
+		const int fd = wasmfs_create_file(from, 0444, data);
+		if(fd >= 0)
+			close(fd);
+		SeedSaveFile(from, to);
+	}
+
+	setenv("PS2X_GS_LIVE", "1", 1);
+	// The page reads keyboard and gamepads and publishes them in the live ring; the raylib pad
+	// backend is headless here and would answer "no buttons" ahead of it.
+	setenv("PS2X_NO_GAMEPAD", "1", 1);
+	// <page>?nosleep: the game's wait loops spin instead of sleeping (comparisons)
+	if(MAIN_THREAD_EM_ASM_INT({ return new URLSearchParams(location.search).has('nosleep') ? 1 : 0; }))
+		setenv("PS2X_NO_IDLE_SLEEP", "1", 1);
+	// <page>?debug: also what the game reads from the pad
+	if(MAIN_THREAD_EM_ASM_INT({ return new URLSearchParams(location.search).has('debug') ? 1 : 0; }))
+	{
+		setenv("PS2X_PAD_LOG", "1", 1);
+		setenv("PS2X_NET_LOG", "1", 1);
+	}
+	setenv("PS2X_MC_ROOT", "/saves/mc0", 1);
+	// Online: the network adapter's traffic goes over a WebSocket to the page's server (/net),
+	// whose relay reaches the game server. Each browser keeps its own id (a different MAC for
+	// the server, which tells players apart by it).
+	// <page>?online=0 (start screen setting): no network adapter
+	if(MAIN_THREAD_EM_ASM_INT({ return new URLSearchParams(location.search).get('online') === '0' ? 1 : 0; }))
+		setenv("PS2X_NET", "0", 1);
+	else
+		setenv("PS2X_NET", "1", 1);
+	setenv("PS2X_NET_SERVER", "nbas3.xellrecomp.party", 1);
+	char* netId = reinterpret_cast<char*>(MAIN_THREAD_EM_ASM_PTR({
+		let id = null;
+		try { id = localStorage.getItem('ps2x-net-id'); } catch (e) {}
+		if (!id) {
+			id = Array.from(crypto.getRandomValues(new Uint8Array(8)), (b) => b.toString(16).padStart(2, '0')).join('');
+			try { localStorage.setItem('ps2x-net-id', id); } catch (e) {}
+		}
+		return stringToNewUTF8(id);
+	}));
+	setenv("PS2X_NET_ID", netId, 1);
+	std::free(netId);
+	setenv("PS2X_CD_IMAGE", "/game/NBAStreetV3.iso", 1);
+	chdir("/game/iso");
+
+	static char arg0[] = "ps2EntryRunner";
+	static char arg1[] = "/game/iso/SLUS_211.26";
+	static char* args[] = {arg0, arg1, nullptr};
+	argc = 2;
+	argv = args;
+	std::printf("[web] files: /game -> data/ (on demand), saves: OPFS\n");
+}
+
+namespace
+{
+	// Single producer (the game thread) and single consumer (the AudioWorklet), counted in frames.
+	constexpr uint32_t kAudioRingFrames = 32768; // ~680 ms
+	alignas(16) int16_t g_audioRing[kAudioRingFrames * 2];
+	alignas(8) std::atomic<uint32_t> g_audioIndex[2]; // [0] written, [1] read (by the worklet)
+}
+
+bool ps2xHostAudioInit()
+{
+	// The page owns the AudioContext (it may only start after a click or key press).
+	MAIN_THREAD_ASYNC_EM_ASM(
+	    {
+		    if(typeof ps2xStartAudio == 'function')
+			    ps2xStartAudio(HEAP16.buffer, $0, $1, $2);
+	    },
+	    g_audioRing, kAudioRingFrames, g_audioIndex);
+	return true;
+}
+
+bool ps2xHostAudioWantsFrames(int)
+{
+	return true; // ps2xHostAudioWrite drops what doesn't fit
+}
+
+void ps2xHostAudioWrite(const int16_t* samples, int frames)
+{
+	uint32_t write = g_audioIndex[0].load(std::memory_order_relaxed);
+	const uint32_t queued = write - g_audioIndex[1].load(std::memory_order_acquire);
+	if(queued + static_cast<uint32_t>(frames) > kAudioRingFrames - 256)
+		return; // the page isn't playing (no click yet) or fell far behind: drop
+	for(int i = 0; i < frames; i++, write++)
+	{
+		const uint32_t slot = (write % kAudioRingFrames) * 2;
+		g_audioRing[slot] = samples[i * 2];
+		g_audioRing[slot + 1] = samples[i * 2 + 1];
+	}
+	g_audioIndex[0].store(write, std::memory_order_release);
+}
