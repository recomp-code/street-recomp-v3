+        const uint8_t *ptr(uint32_t pos, uint32_t) const { return data + pos; }
+        void copy(void *dst, uint32_t pos, uint32_t length) const { std::memcpy(dst, data + pos, length); }
+        uint32_t read32(uint32_t pos) const
+        {
+            uint32_t value;
+            std::memcpy(&value, data + pos, sizeof(value));
+            return value;
+        }
+        // Calls emit(span) for the bytes [begin, end), in order.
+        template <typename Emit>
+        void spans(uint32_t begin, uint32_t end, Emit &&emit) const
+        {
+            if (end > begin)
+                emit(ByteSpan{data + begin, end - begin});
+        }
+    };
+
+    // The concatenation of 'count' spans. Reads are sequential in practice: a cursor remembers the
+    // span of the last access.
+    class Segmented
+    {
+    public:
+        Segmented(const ByteSpan *spans, size_t count) : m_spans(spans), m_count(count)
+        {
+            m_starts.resize(count + 1u);
+            uint64_t total = 0;
+            for (size_t i = 0; i < count; ++i)
+            {
+                m_starts[i] = static_cast<uint32_t>(total);
+                total += spans[i].size;
+            }
+            m_size = total > 0xFFFFFFFFull ? 0xFFFFFFFFu : static_cast<uint32_t>(total);
+            m_starts[count] = m_size;
+        }
+
+        uint32_t size() const { return m_size; }
+
+        const uint8_t *ptr(uint32_t pos, uint32_t length) const
+        {
+            const size_t i = locate(pos);
+            if (i < m_count && pos - m_starts[i] + length <= m_spans[i].size)
+                return m_spans[i].data + (pos - m_starts[i]);
+            // Crosses into the next span(s): a contiguous copy
+            m_scratch.resize(length);
+            copy(m_scratch.data(), pos, length);
+            return m_scratch.data();
+        }
+
+        void copy(void *dst, uint32_t pos, uint32_t length) const
+        {
+            uint8_t *out = static_cast<uint8_t *>(dst);
+            size_t i = locate(pos);
+            while (length != 0u && i < m_count)
+            {
+                const uint32_t offset = pos - m_starts[i];
+                const uint32_t take = std::min(length, m_spans[i].size - offset);
+                std::memcpy(out, m_spans[i].data + offset, take);
+                out += take;
+                pos += take;
+                length -= take;
+                ++i;
+            }
+        }
+
+        uint32_t read32(uint32_t pos) const
+        {
+            const size_t i = locate(pos);
+            if (i < m_count && pos - m_starts[i] + 4u <= m_spans[i].size)
+            {
+                uint32_t value;
+                std::memcpy(&value, m_spans[i].data + (pos - m_starts[i]), sizeof(value));
+                return value;
+            }
+            uint32_t value = 0;
+            copy(&value, pos, sizeof(value));
+            return value;
+        }
+
+        template <typename Emit>
+        void spans(uint32_t begin, uint32_t end, Emit &&emit) const
+        {
+            if (end <= begin)
+                return;
+            size_t i = locate(begin);
+            uint32_t pos = begin;
+            while (pos < end && i < m_count)
+            {
+                const uint32_t offset = pos - m_starts[i];
+                const uint32_t take = std::min(end - pos, m_spans[i].size - offset);
+                if (take != 0u)
+                    emit(ByteSpan{m_spans[i].data + offset, take});
+                pos += take;
+                ++i;
+            }
+        }
+
+    private:
+        // Index of the span holding byte pos (m_count when pos == size()).
+        size_t locate(uint32_t pos) const
+        {
+            size_t i = m_cursor;
+            if (i >= m_count || pos < m_starts[i])
+                i = 0;
+            while (i < m_count && pos >= m_starts[i + 1u])
+                ++i;
+            m_cursor = i;
+            return i;
+        }
+
+        const ByteSpan *m_spans;
+        size_t m_count;
+        uint32_t m_size = 0;
+        std::vector<uint32_t> m_starts;
+        mutable size_t m_cursor = 0;
+        mutable std::vector<uint8_t> m_scratch;
+    };
+}
