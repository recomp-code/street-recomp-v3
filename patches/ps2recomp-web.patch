index 0000000..f0cd657
--- /dev/null
+++ b/ps2xRuntime/web/play_gs_host.cpp
@@ -0,0 +1,1647 @@
+// GS host for the browser build: the consumer side of the live ring (gs_dump_writer.cpp) running
+// on the page's main thread, drawing with the GS, VIF1/VU1 and GIF of the Play! emulator
+// (https://github.com/jpd002/Play-, BSD-2-Clause): GSH_OpenGL on WebGL2, VU1 on Play!'s
+// WebAssembly JIT.
+//
+// It does what pcsx2-gsrunner -live does with the same stream (GSDumpReplayer.cpp):
+//   header + privileged GS registers, then packets
+//   Transfer(path, data) -> GIF path 1/2/3      VSync(field) -> vblank, flip
+//   Registers(8 KB)      -> privileged regs     ReadFIFO2    -> local->host transfer
+//   0x10 VIF1 stream     -> VIF1 (UNPACK/MPG fill VU1, MSCAL runs it, XGKICK/DIRECT reach the GIF)
+//   0x11 VIF1 register   -> FBRST / ERR / MARK
+// It runs once per browser frame (requestAnimationFrame) and never blocks: whole packets only,
+// the rest waits for the next frame. The game side runs on workers and blocks on a full ring.
+// Keyboard and gamepad are read here and published through the ring header, like the Mac host.
+
+#include "../src/lib/gs/ps2_live_ring.h"
+
+#include <emscripten.h>
+#include <emscripten/html5.h>
+#include <emscripten/threading.h>
+
+#include "BasicBlock.h"
+#include "FrameDump.h"
+#include "Jitter_CodeGen_Wasm.h"
+#include "MIPS.h"
+#include "MemoryUtils.h"
+#include "Ps2Const.h"
+#include "ee/DMAC.h"
+#include "ee/GIF.h"
+#include "ee/INTC.h"
+#include "ee/MA_VU.h"
+#include "ee/Vif.h"
+#include "ee/Vpu.h"
+#include "ee/VuExecutor.h"
