--- /dev/null
+++ b/ps2xIOP/src/emulator/spu2/spu2_bridge.h
@@ -0,0 +1,34 @@
+// ps2recomp: interface between the IOP (core/iop_spu2.cpp) and PCSX2's SPU2 (SPU2/), which keeps its
+// state in globals. Addresses are IOP physical addresses; `cycle` is the IOP clock (36.864 MHz).
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace ps2x::spu2
+{
+    void reset(uint8_t *iopRam);
+
+    uint16_t read(uint32_t cycle, uint32_t address);
+    void write(uint32_t cycle, uint32_t address, uint16_t value);
+
+    // IOP DMA 4 (core 0) / 7 (core 1). Data is read from (or written to) IOP RAM at `madr` as the
+    // SPU2 consumes it; completion is reported through takeDmaDone().
+    void dmaWrite(uint32_t cycle, int core, uint32_t madr, uint32_t halfwords);
+    void dmaRead(uint32_t cycle, int core, uint32_t madr, uint32_t halfwords);
+    uint32_t dmaMadr(int core);
+    void setDmaMadr(int core, uint32_t madr);
+
+    // Mixes every 48 kHz sample up to `cycle`; the frames are appended to output().
+    void advance(uint32_t cycle);
+    std::vector<int16_t> &output();
+
+    // True once per raised SPU2 interrupt (IOP line 9) / finished DMA of the given core.
+    bool takeIrq();
+    bool takeDmaDone(int core);
+
+    // One line of core state for the periodic [spu2] log.
+    std::string describe();
+}
