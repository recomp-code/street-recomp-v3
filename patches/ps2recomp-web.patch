+        case LibsdRoutine::GetAddr:
+        {
+            r[7] = 0x1FFFFu;
+            r[2] = (a0 >> 6) & 0x3FCu;
+            r[3] = (a0 & 1u) << 10;
+            r[5] = bus.lw(table + r[2]) + r[3];
+            r[3] = a0 & 0x3Eu;
