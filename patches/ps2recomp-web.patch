diff --git a/ps2xRuntime/web/play_gs_host.cpp b/ps2xRuntime/web/play_gs_host.cpp
new file mode 100644
index 0000000..8d8c4ed
--- /dev/null
+++ b/ps2xRuntime/web/play_gs_host.cpp
@@ -0,0 +1,1233 @@
+// GS host for the browser build: the consumer side of the live ring (gs_dump_writer.cpp) running
+// on the page's main thread, drawing with the GS, VIF1/VU1 and GIF of the Play! emulator
+// (https://github.com/jpd002/Play-, BSD-2-Clause): GSH_OpenGL on WebGL2, VU1 on Play!'s
+// WebAssembly JIT.
+//
+// It does what pcsx2-gsrunner -live does with the same stream (GSDumpReplayer.cpp):
+//   header + privileged GS registers, then packets
+//   Transfer(path, data) -> GIF path 1/2/3      VSync(field) -> vblank, flip
+//   Registers(8 KB)      -> privileged regs     ReadFIFO2    -> local->host transfer
+//   0x10 VIF1 stream     -> VIF1 (UNPACK/MPG fill VU1, MSCAL runs it, XGKICK/DIRECT reach the GIF)
+//   0x11 VIF1 register   -> FBRST / ERR / MARK
+// It runs once per browser frame (requestAnimationFrame) and never blocks: whole packets only,
+// the rest waits for the next frame. The game side runs on workers and blocks on a full ring.
+// Keyboard and gamepad are read here and published through the ring header, like the Mac host.
+
+#include "../src/lib/gs/ps2_live_ring.h"
+
+#include <emscripten.h>
+#include <emscripten/html5.h>
+#include <emscripten/threading.h>
+
+#include "BasicBlock.h"
+#include "FrameDump.h"
+#include "Jitter_CodeGen_Wasm.h"
+#include "MIPS.h"
+#include "MemoryUtils.h"
+#include "Ps2Const.h"
+#include "ee/DMAC.h"
+#include "ee/GIF.h"
+#include "ee/INTC.h"
+#include "ee/MA_VU.h"
+#include "ee/Vif.h"
+#include "ee/Vpu.h"
+#include "ee/VuExecutor.h"
+#include "gs/GSH_OpenGL/GSH_OpenGL.h"
+#include "gs/GsPixelFormats.h"
+#include "DefaultAppConfig.h" // CAppConfig::GetBasePath, defined once per Play! app
+
+#include <pthread.h>
+#include <unistd.h>
+
+#include <array>
+#include <map>
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <iterator>
+#include <memory>
+#include <string>
+#include <vector>
+
+extern "C" uint32 LWL_Proxy(uint32, uint32, CMIPS*);
+extern "C" uint32 LWR_Proxy(uint32, uint32, CMIPS*);
+extern "C" uint64 LDL_Proxy(uint32, uint64, CMIPS*);
+extern "C" uint64 LDR_Proxy(uint32, uint64, CMIPS*);
+extern "C" void SWL_Proxy(uint32, uint32, CMIPS*);
+extern "C" void SWR_Proxy(uint32, uint32, CMIPS*);
+extern "C" void SDL_Proxy(uint32, uint64, CMIPS*);
+extern "C" void SDR_Proxy(uint32, uint64, CMIPS*);
+
+EM_JS_DEPS(ps2xShaderList, "$stringToNewUTF8,$UTF8ToString");
+
+// The shader list kept by an earlier session ("hex,hex,..."), read from IndexedDB (GL thread)
+extern "C" EMSCRIPTEN_KEEPALIVE void ps2xPrecompileShaderList(char* list);
+
+namespace
+{
+	// PCSX2 GS dump packet types and the live extensions (gs_dump_writer.cpp).
+	constexpr uint8_t kTypeTransfer = 0;
+	constexpr uint8_t kTypeVSync = 1;
+	constexpr uint8_t kTypeReadFifo2 = 2;
+	constexpr uint8_t kTypeRegisters = 3;
+	constexpr uint8_t kTypeLiveVif1 = 0x10;
+	constexpr uint8_t kTypeLiveVif1Reg = 0x11;
+	constexpr uint8_t kPath2 = 1, kPath3 = 2, kPath1New = 3;
+	constexpr uint32_t kPrivRegsSize = 8192;
+
+	// Where VIF1 data is staged in the emulated EE RAM for CVif::ReceiveDMA (end of the 32 MB).
+	constexpr uint32_t kVifStageAddr = 0x01F00000;
+	constexpr uint32_t kVifStageSize = 0x00100000;
+
+	class CGSH_Web : public CGSH_OpenGL
+	{
+	public:
+		explicit CGSH_Web(EMSCRIPTEN_WEBGL_CONTEXT_HANDLE context)
+		    : CGSH_OpenGL(false) // not threaded: everything runs on the page's main thread
+		    , m_context(context)
+		{
+		}
+
+		// Runs the GS calls queued by the GIF / vblank (draws, flip) on this thread.
+		void Pump()
+		{
+			ProcessPendingCalls();
+		}
+
+	protected:
+		void InitializeImpl() override
+		{
+			emscripten_webgl_make_context_current(m_context);
+			CGSH_OpenGL::InitializeImpl();
+		}
+	public:
+		bool debug = false;
+		uint64_t regCounts[0x80] = {};
+		bool traceOn = false;
+		uint32_t traceVertexRun = 0, traceLines = 0, traceWb = 0;
+		std::map<uint64, uint64_t> regValues[0x80];
+
+	protected:
+		void WriteRegisterImpl(uint8 reg, uint64 value) override
+		{
+			if(!debug)
+			{
+				CGSH_OpenGL::WriteRegisterImpl(reg, value);
+				return;
+			}
+			regCounts[reg & 0x7F]++;
+			if(traceOn)
+			{
+				const bool vertex = reg == 0x01 || reg == 0x02 || reg == 0x03 || reg == 0x04 || reg == 0x05 || reg == 0x0C || reg == 0x0D;
+				if(vertex && traceVertexRun > 8)
+					traceVertexRun++;
+				else
+				{
+					if(!vertex && traceVertexRun > 8)
+						std::printf("[trace]   ... %u vertex writes\n", traceVertexRun - 8);
+					traceVertexRun = vertex ? traceVertexRun + 1 : 0;
+					if(traceLines++ < 4000)
+						std::printf("[trace] %02x %016llx%s\n", reg, (unsigned long long)value, m_framebufferWriteBacks != traceWb ? " (after write-back)" : "");
+					traceWb = m_framebufferWriteBacks;
+				}
+			}
+			if(reg == 0x06 || reg == 0x07 || reg == 0x4C || reg == 0x4D || reg == 0x4E || reg == 0x4F || reg == 0x00 || reg == 0x50 || reg == 0x52)
+				regValues[reg][value]++;
+			CGSH_OpenGL::WriteRegisterImpl(reg, value);
+		}
+		void PresentBackbuffer() override
+		{
+			// The browser presents the canvas when the animation frame returns.
+		}
+
+	private:
+		EMSCRIPTEN_WEBGL_CONTEXT_HANDLE m_context;
+	};
+
+	struct alignas(16) Host
+	{
+		ps2live::RingHeader* ring = nullptr;
+		uint8_t* ringData = nullptr;
+		uint64_t ringCapacity = 0;
+		bool headerDone = false;
+
+		uint8* ram = nullptr;
+		uint8* spr = nullptr;
