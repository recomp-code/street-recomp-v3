+    static_assert(std::size(kEaVoiceLoopWords) == (kEaVoiceLoopEnd - kEaVoiceLoopAddress) / 4u);
+
+    inline bool eaVoiceLoopMatches(const uint8_t *ram)
+    {
+        return std::memcmp(ram + kEaVoiceLoopAddress, kEaVoiceLoopWords, sizeof(kEaVoiceLoopWords)) == 0;
+    }
+
+    struct EaVoiceLibsd
+    {
+        uint32_t table[4]; // per kEaVoiceStubRoutines entry: libsd's register table and lui half
+        uint32_t high[4];
+    };
+
+    // True when the iteration at the loop head calls the driver's 0x54F88 (left to the guest).
+    template <class Regs, class Bus>
+    bool eaVoiceCallsDriver(const Regs &c, Bus &bus)
+    {
+        const uint32_t s0 = c.gpr[16], fp = c.gpr[30];
+        const uint32_t s1 = bus.lw(c.gpr[29] + 0x20u) + kEaVoiceShadow;
+        const auto s8 = [&](uint32_t address) { return static_cast<int8_t>(bus.lbu(address)); };
+        return s8(s0 + 6u) != s8(s1 + 6u) || bus.lbu(fp - 1u) != 0u || s8(s0 + 7u) != s8(s1 + 7u) || bus.lbu(fp) != 0u;
+    }
+
+    // One iteration from the loop head, with the guest's exact effects on registers (pc ends at
+    // the next head or kEaVoiceLoopExit), memory and SPU2 (Bus::io16 index = cycle offset from the
+    // head). Bus also has lbu/lhu/sb/sh/sw. Returns the instructions the interpreter executes, 0
+    // (nothing done) if the iteration calls the driver.
+    template <class Regs, class Bus>
+    uint32_t eaVoiceIteration(Regs &c, Bus &bus, const EaVoiceLibsd &libsd)
+    {
+        if (eaVoiceCallsDriver(c, bus))
+            return 0u;
+        enum : uint32_t { v0 = 2, v1 = 3, a0 = 4, a1 = 5, a2 = 6, a3 = 7, s0 = 16, s1 = 17, s2 = 18, s3 = 19, s4 = 20, s6 = 22, s7 = 23, sp = 29, fp = 30, ra = 31 };
+        auto &r = c.gpr;
+        uint32_t n = 0;
+        const auto call = [&](int which, uint32_t returnAddress, uint32_t before)
+        {
+            // jal + delay slot + the stub's own instruction, then the routine
+            r[ra] = returnAddress;
+            n += before;
+            n += libsdRun(kEaVoiceStubRoutines[which], c, bus, libsd.table[which], libsd.high[which], n);
+        };
+        const auto sext8 = [](uint32_t value) { return static_cast<uint32_t>(static_cast<int32_t>(static_cast<int8_t>(value))); };
+        // v1:v0 = 1 << s3 as a 64-bit mask; one, zero and shift are the registers the guest uses
+        const auto bit64 = [&](uint32_t one, uint32_t zero, uint32_t shift)
+        {
+            r[zero] = 0u;
+            r[one] = 1u;
+            r[shift] = r[s3] << 26;
+            n += 5u;
+            const uint32_t k = r[s3] & 31u;
+            if (static_cast<int32_t>(r[shift]) < 0)
+            {
+                r[v1] = r[one] << k;
+                r[v0] = 0u;
+                n += 3u;
+                return;
+            }
+            r[v1] = r[zero] << k;
+            n += 2u;
+            if (r[shift] != 0u)
+            {
+                r[shift] = 0u - r[s3];
+                r[shift] = r[one] >> (r[shift] & 31u);
+                r[v1] |= r[shift];
+                n += 3u;
+            }
+            r[v0] = r[one] << k;
+            n += 1u;
+        };
+
+        // 0x55738: s2 = SPU2 voice number ((s3 % 24) << 1 | core), s1 = shadow entry
+        r[v0] = 0x2AAAAAABu;
+        const int64_t product = static_cast<int64_t>(static_cast<int32_t>(r[s3])) * 0x2AAAAAABll;
+        c.lo = static_cast<uint32_t>(product);
+        c.hi = static_cast<uint32_t>(static_cast<uint64_t>(product) >> 32);
+        r[s4] = 0u;
+        r[v1] = static_cast<uint32_t>(static_cast<int32_t>(r[s3]) >> 31);
+        r[a1] = 0x00060000u;
+        r[a2] = bus.lw(r[sp] + 0x20u);
+        r[v0] = static_cast<uint32_t>(static_cast<int32_t>(c.hi) >> 2) - r[v1];
+        r[a0] = ((r[v0] << 1) + r[v0]) << 3;
+        r[a0] = (r[s3] - r[a0]) << 1;
+        r[v1] = (static_cast<int32_t>(r[s3]) < 24 ? 1u : 0u) ^ 1u;
+        r[v0] = kEaVoiceShadow;
+        r[s1] = r[a2] + r[v0];
+        r[a1] = bus.lhu(r[s0] + 4u);
+        r[v0] = bus.lhu(r[s1] + 4u);
+        r[s2] = r[a0] | r[v1];
+        n = 24u;
