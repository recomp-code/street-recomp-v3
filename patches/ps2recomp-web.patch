+                    r[a0] = r[s2] & 0xFFFFu;
+                    n += 4u;
+                    volume(v1);
+                    call(0, 0x000558B8u, 3u);
+                    r[v0] = bus.lbu(r[s0] + 6u);
+                    r[v1] = r[s2] | 0x100u;
+                    bus.sb(r[fp] - 1u, 0u);
+                    bus.sb(r[s1] + 6u, static_cast<uint8_t>(r[v0]));
+                    r[a1] = sext8(bus.lbu(r[s0] + 7u));
+                    r[a0] = r[v1] & 0xFFFFu;
+                    n += 8u;
+                    volume(a1);
+                    r[s4] = 1u;
+                    call(0, 0x000558F8u, 3u);
+                    bit64(a0, a1, a2);
+                    // 0x55930: key-on mask, shadow updated
+                    r[a2] = bus.lw(r[sp] + 0x10u) | r[v0];
+                    r[a3] = bus.lw(r[sp] + 0x14u) | r[v1];
+                    r[a0] = bus.lbu(r[s0] + 7u);
+                    bus.sw(r[sp] + 0x10u, r[a2]);
+                    bus.sw(r[sp] + 0x14u, r[a3]);
+                    bus.sb(r[fp], 0u);
+                    bus.sb(r[s1] + 7u, static_cast<uint8_t>(r[a0]));
+                    r[v0] = bus.lw(r[s0]);
+                    bus.sw(r[s1], r[v0]);
+                    n += 12u;
+                }
+                else
+                {
+                    // 0x55960: still sounding: key off first
+                    bit64(a2, a3, a0);
+                    r[s6] |= r[v0];
+                    r[s7] |= r[v1];
+                    r[s4] = 1u;
+                    n += 4u;
+                }
+            }
+            else
+            {
+                // 0x559A8: no sample: key off
+                bit64(a2, a3, a0);
+                r[s6] |= r[v0];
+                r[s7] |= r[v1];
+                bus.sw(r[s1], r[a1]);
+                n += 3u;
+            }
+        }
+        // 0x559EC: NAX read back
+        r[a0] = (r[s2] | 0x2240u) & 0xFFFFu;
+        r[a3] = kEaVoiceState;
+        r[a1] = bus.lw(r[sp] + 0x20u);
+        r[v1] = bus.lw(r[s0]);
+        r[v0] = r[a3] + r[a1];
+        bus.sw(r[v0] + 0x3Cu, r[v1]);
+        call(3, 0x00055A10u, 10u);
+        r[a2] = bus.lw(r[sp] + 0x1Cu);
+        bus.sw(r[a2], r[v0]);
+        n += 3u;
+        if (r[s4] != 0u)
+        {
+            r[a3] = bus.lw(r[sp] + 0x18u);
+            bus.sw(r[a2], r[a3]);
+            n += 3u;
+        }
+        else
+        {
+            r[v0] = r[v0] < 0x5040u ? 1u : 0u;
+            n += 3u;
+            if (r[v0] != 0u)
+            {
+                r[v0] = bus.lw(r[sp] + 0x1Cu);
+                bus.sw(r[v0], 0u);
+                n += 3u;
+            }
+        }
+        // 0x55A40: next voice
+        r[fp] += 2u;
+        r[s0] += 8u;
+        r[s3] += 1u;
+        r[v0] = static_cast<int32_t>(r[s3]) < 48 ? 1u : 0u;
+        r[v1] = bus.lw(r[sp] + 0x1Cu) + 8u;
+        r[a0] = bus.lw(r[sp] + 0x20u) + 8u;
+        bus.sw(r[sp] + 0x1Cu, r[v1]);
+        bus.sw(r[sp] + 0x20u, r[a0]);
+        n += 11u;
+        c.pc = r[v0] ? kEaVoiceLoopAddress : kEaVoiceLoopExit;
+        return n;
+    }
