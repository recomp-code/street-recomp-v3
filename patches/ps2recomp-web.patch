+    // Looks a disc path up in the CD image's ISO9660 directory: its first sector and size.
+    bool findInCdImage(const std::string &ps2Path, uint32_t &lbnOut, uint32_t &sizeOut)
+    {
+        const std::filesystem::path image = getCdImagePath();
+        if (image.empty())
+            return false;
+        auto readLe32 = [](const uint8_t *p) { return static_cast<uint32_t>(p[0] | (p[1] << 8) | (p[2] << 16) | (p[3] << 24)); };
+        uint8_t sector[kCdSectorSize];
+        if (!readHostRange(image, 16ull * kCdSectorSize, sector, sizeof(sector)) || sector[0] != 1 ||
+            std::memcmp(sector + 1, "CD001", 5) != 0)
+            return false;
+        uint32_t dirLbn = readLe32(sector + 156 + 2);
+        uint32_t dirSize = readLe32(sector + 156 + 10);
+
+        std::string rel = normalizeCdPathNoPrefix(ps2Path);
+        for (char &ch : rel)
+            ch = (ch == '\\') ? '/' : static_cast<char>(std::toupper(static_cast<unsigned char>(ch)));
+        std::vector<std::string> parts;
+        for (size_t pos = 0; pos <= rel.size();)
+        {
+            const size_t end = rel.find('/', pos);
+            std::string part = rel.substr(pos, end == std::string::npos ? std::string::npos : end - pos);
+            if (const size_t semi = part.find(';'); semi != std::string::npos)
+                part.resize(semi);
+            if (!part.empty())
+                parts.push_back(part);
+            if (end == std::string::npos)
+                break;
+            pos = end + 1;
+        }
+        if (parts.empty())
+            return false;
+
+        for (size_t i = 0; i < parts.size(); ++i)
+        {
+            const bool last = i + 1 == parts.size();
+            bool found = false;
+            std::vector<uint8_t> dir(dirSize);
+            if (dirSize == 0 || !readHostRange(image, static_cast<uint64_t>(dirLbn) * kCdSectorSize, dir.data(), dir.size()))
+                return false;
+            for (size_t off = 0; off < dir.size();)
+            {
+                const uint8_t len = dir[off];
+                if (len == 0)
+                {
+                    off = (off / kCdSectorSize + 1) * kCdSectorSize; // records never cross a sector
+                    continue;
+                }
+                if (off + len > dir.size() || len < 34)
+                    break;
+                const uint8_t *rec = dir.data() + off;
+                std::string name(reinterpret_cast<const char *>(rec + 33), rec[32]);
+                if (const size_t semi = name.find(';'); semi != std::string::npos)
+                    name.resize(semi);
+                if (!name.empty() && name.back() == '.')
+                    name.pop_back();
+                for (char &ch : name)
+                    ch = static_cast<char>(std::toupper(static_cast<unsigned char>(ch)));
+                const bool isDir = (rec[25] & 2) != 0;
+                if (name == parts[i] && isDir != last)
+                {
+                    dirLbn = readLe32(rec + 2);
+                    dirSize = readLe32(rec + 10);
+                    found = true;
+                    break;
+                }
+                off += len;
+            }
+            if (!found)
+                return false;
+        }
+        lbnOut = dirLbn;
+        sizeOut = dirSize;
+        return true;
+    }
